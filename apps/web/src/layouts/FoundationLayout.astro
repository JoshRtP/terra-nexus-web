---
import '../styles/foundation.css';

interface Props {
  title: string;
  preview: boolean;
}

const { title, preview } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
