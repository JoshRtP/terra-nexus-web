---
import '../styles/design-system.css';
// Tailwind v4 (M4) — Tailwind's own reset/base rules load inside CSS
// cascade layers (@layer theme/base/...), which always lose to
// design-system.css's plain, unlayered base rules (html/body/headings)
// regardless of import order — so this coexists safely either way. Kept
// after design-system.css to match the "existing tokens first" mental
// model. Both files stay indefinitely during progressive adoption (see
// terra-nexus-design-system skill).
import '../styles/tailwind.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { getBuildMode } from '../lib/build-mode.js';
import { breadcrumbList, toJsonLd, type Crumb } from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  preview?: boolean;
  /** Site-root-relative canonical path, e.g. '/expertise/regenerative-rangeland/'.
   * Resolved against astro.config.ts's `site` and emitted as an absolute
   * <link rel="canonical"> and og:url — a relative canonical is legal but
   * absolute is the recommendation, and og:url has to be absolute to work at
   * all. Optional: pages that don't pass one behave exactly as before. */
  canonical?: string;
  /** Overrides the default /brand/og-image.png for og:image. */
  ogImage?: string;
  /** Trail after Home, e.g. [{ name: 'Capabilities', path: '/capabilities/' }].
   * Emits a BreadcrumbList in the page's JSON-LD graph. Added 2026-09-13. */
  breadcrumbs?: Crumb[];
  /** Extra schema.org objects for the JSON-LD graph (see lib/structured-data). */
  jsonLd?: object[];
}

const { title, description, preview = false, canonical, ogImage, breadcrumbs, jsonLd = [] } = Astro.props;
const mode = getBuildMode();
// Astro.site comes from astro.config.ts. Falling back to the raw path rather
// than throwing keeps a `site`-less build working, which is what every
// consumer got before 2026-09-12.
const canonicalUrl = canonical && Astro.site ? new URL(canonical, Astro.site).href : canonical;
const resolvedOgImage = ogImage ?? '/brand/og-image.png';
const ogImageUrl = Astro.site ? new URL(resolvedOgImage, Astro.site).href : resolvedOgImage;
const isPreview = preview || mode === 'preview';
const fullTitle = title.includes('Terra Nexus') ? title : `${title} | Terra Nexus`;
const graph = [...(breadcrumbs ? [breadcrumbList(Astro.site, breadcrumbs)] : []), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Fonts are self-hosted (design-system.css); the two faces the first paint
         needs are preloaded so the hero text does not wait on CSS discovery. -->
    <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#131f48" />

    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageUrl} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
    {graph.length > 0 && <script type="application/ld+json" is:inline set:html={toJsonLd(graph)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {isPreview && (
      <div class="prototype-banner" role="status">
        Protected Preview — This is a prototype for review. Content is not approved for public production.
      </div>
    )}
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
