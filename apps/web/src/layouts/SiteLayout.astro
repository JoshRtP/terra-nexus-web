---
import '../styles/design-system.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getBuildMode } from '../lib/build-mode.js';

interface Props {
  title: string;
  description?: string;
  preview?: boolean;
}

const { title, description, preview = false } = Astro.props;
const mode = getBuildMode();
const isPreview = preview || mode === 'preview';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1a1f24" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {isPreview && (
      <div class="prototype-banner" role="status">
        Protected Preview — This is a prototype for review. Content is not approved for public production.
      </div>
    )}
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
