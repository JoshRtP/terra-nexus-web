---
// Primary navigation — Industries/Insights IA prototype
// (prototype/industries-insights-ia, 2026-08-17). Replaces the earlier
// homepage-anchor-nav trial (Expertise/Capabilities/Who We Work With
// pointing at /#section) with six top-level items, four of which open a
// mega menu: Expertise, Capabilities, Industries, Insights. About and
// Contact remain plain links. See CLAUDE.md for the IA brief.
//
// Menu markup is shared between desktop (absolute dropdown) and mobile
// (inline accordion inside the drawer) — one DOM per menu, toggled by the
// same button/aria-expanded state; only the CSS positioning differs per
// breakpoint. This keeps keyboard/AX behavior identical at both sizes.
import { expertiseMenu, capabilitiesMenu, industriesMenu, insightsMenu, valueChainMenu, approachMenu } from '../data/nav-data';

const currentPath = Astro.url.pathname;

const directLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header" role="banner">
  <div class="header-inner container">
    <a class="site-wordmark" href="/" aria-label="Terra Nexus home">
      <img class="wordmark-logo" src="/brand/logo-wordmark-dark.png" alt="Terra Nexus" width="600" height="105" />
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open navigation menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      <ul class="nav-list" role="list">
        <li class="nav-item has-menu">
          <button
            type="button"
            class:list={['nav-link', 'nav-menu-trigger', { 'nav-link-active': isActive('/expertise/') }]}
            aria-expanded="false"
            aria-controls="menu-expertise"
            data-menu-trigger="expertise"
          >
            Expertise
          </button>
          <div id="menu-expertise" class="nav-menu-panel" data-menu-panel="expertise" hidden>
            <div class="panel-inner">
              <ul class="panel-links" role="list">
                {expertiseMenu.map((item) => (
                  <li>
                    <a href={item.href} class="panel-link">
                      <span class="panel-link-title">{item.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/expertise/" class="panel-view-all">View All Expertise &rarr;</a>
            </div>
          </div>
        </li>

        <li class="nav-item has-menu">
          <button
            type="button"
            class:list={['nav-link', 'nav-menu-trigger', { 'nav-link-active': isActive('/capabilities/') }]}
            aria-expanded="false"
            aria-controls="menu-capabilities"
            data-menu-trigger="capabilities"
          >
            Capabilities
          </button>
          <div id="menu-capabilities" class="nav-menu-panel" data-menu-panel="capabilities" hidden>
            <div class="panel-inner">
              <div class="panel-columns">
                <div class="panel-col">
                  <span class="panel-col-heading">Our Approach</span>
                  <ul class="panel-links" role="list">
                    {approachMenu.map((item) => (
                      <li>
                        <a href={item.href} class="panel-link">
                          <span class="panel-link-title">{item.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="panel-col">
                  <span class="panel-col-heading">Capabilities</span>
                  <ul class="panel-links" role="list">
                    {capabilitiesMenu.map((item) => (
                      <li>
                        <a href={item.href} class="panel-link">
                          <span class="panel-link-title">{item.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <a href="/capabilities/" class="panel-view-all">View All Capabilities &rarr;</a>
            </div>
          </div>
        </li>

        <li class="nav-item has-menu">
          <button
            type="button"
            class:list={['nav-link', 'nav-menu-trigger', { 'nav-link-active': isActive('/industries/') }]}
            aria-expanded="false"
            aria-controls="menu-industries"
            data-menu-trigger="industries"
          >
            Industries
          </button>
          <div id="menu-industries" class="nav-menu-panel" data-menu-panel="industries" hidden>
            <div class="panel-inner">
              <div class="panel-columns">
                <div class="panel-col">
                  <span class="panel-col-heading">By Role</span>
                  <ul class="panel-roles" role="list">
                    {industriesMenu.map((role) => (
                      <li>
                        <a href={role.href} class={`panel-role-card panel-role-${role.key}`}>
                          <span class="panel-role-title">{role.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="panel-col">
                  <span class="panel-col-heading">By Value-Chain Segment</span>
                  <ul class="panel-links" role="list">
                    {valueChainMenu.map((item) => (
                      <li>
                        <a href={item.href} class="panel-link">
                          <span class="panel-link-title">{item.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <a href="/industries/" class="panel-view-all">View All Industries &rarr;</a>
            </div>
          </div>
        </li>

        <li class="nav-item has-menu">
          <button
            type="button"
            class:list={['nav-link', 'nav-menu-trigger', { 'nav-link-active': isActive('/insights/') || isActive('/case-studies/') || isActive('/digital-solutions/') }]}
            aria-expanded="false"
            aria-controls="menu-insights"
            data-menu-trigger="insights"
          >
            Insights
          </button>
          <div id="menu-insights" class="nav-menu-panel" data-menu-panel="insights" hidden>
            <div class="panel-inner">
              <ul class="panel-links" role="list">
                {insightsMenu.map((item) => (
                  <li>
                    <a href={item.href} class="panel-link">
                      <span class="panel-link-title">{item.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>

        {directLinks.map((link) => (
          <li class="nav-item">
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link-active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--color-dark);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .site-header[data-scrolled="true"] {
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-md);
  }

  .header-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-6); padding-block: var(--space-4);
  }

  .site-wordmark {
    display: flex; align-items: center;
    text-decoration: none; color: var(--color-text);
    flex-shrink: 0; transition: opacity var(--transition-fast);
  }
  .site-wordmark:hover { opacity: 0.85; color: var(--color-text); }
  .wordmark-logo {
    height: 1.75rem; width: auto; display: block;
  }

  .nav-toggle {
    display: none; flex-direction: column; gap: 5px;
    padding: var(--space-2); background: none; border: none; cursor: pointer;
    touch-action: manipulation; border-radius: var(--radius-sm);
  }
  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .nav-toggle-bar {
    display: block; width: 22px; height: 2px;
    background: #fff; border-radius: 1px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-list {
    display: flex; align-items: center; gap: var(--space-1);
    list-style: none; margin: 0; padding: 0;
  }
  .nav-item { position: relative; }

  .nav-link {
    display: flex; align-items: center; gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm); font-weight: var(--font-medium);
    color: var(--c-accent-200); text-decoration: none;
    border-radius: var(--radius-sm);
    background: none; border: none; cursor: pointer; font-family: inherit;
    transition: color var(--transition-fast), background var(--transition-fast);
    position: relative;
  }
  .nav-link:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .nav-link-active { color: #fff; }
  .nav-link-active::after {
    content: ''; position: absolute; bottom: -2px; left: var(--space-3); right: var(--space-3);
    height: 2px; background: var(--c-accent-400); border-radius: var(--radius-full);
  }

  .nav-menu-trigger[aria-expanded="true"] { color: #fff; background: rgba(255, 255, 255, 0.1); }

  /* ── Mega menu panels — desktop: absolute dropdown ─────────────── */
  .nav-menu-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    min-width: 12rem;
    max-width: min(44rem, calc(100vw - 2rem));
    background: var(--color-surface-elevated, #fff);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2xl);
    border: 1px solid var(--color-border);
    z-index: 55;
  }
  .panel-inner { padding: var(--space-4) var(--space-5); }

  /* Vertical, single-column by default — every panel (Expertise, Insights,
     and each column within Industries/Capabilities) is one stacked list,
     not a multi-column grid. */
  .panel-links {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; gap: var(--space-1);
    width: 16rem;
  }

  /* Two-column groups — Industries (By Role / By Value-Chain Segment) and
     Capabilities (Our Approach / Capabilities) — each column is itself a
     vertical list. */
  .panel-columns {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: var(--space-2) var(--space-8);
  }
  .panel-col-heading {
    display: block;
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .panel-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .panel-link:hover,
  .panel-link:focus-visible { background: var(--color-surface); }
  .panel-link:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  .panel-link-title {
    font-size: var(--text-sm); font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .panel-view-all {
    display: inline-flex; margin-top: var(--space-3);
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    letter-spacing: 0.02em; text-decoration: none;
    color: var(--color-eyebrow);
  }
  .panel-view-all:hover { color: var(--color-accent); text-decoration: underline; }

  .panel-roles {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; gap: var(--space-2);
    width: 16rem;
  }
  .panel-role-card {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--c-sky-300);
    text-decoration: none;
    background: var(--color-surface);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .panel-role-card:hover,
  .panel-role-card:focus-visible {
    border-inline-start-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .panel-role-card:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .panel-role-title {
    font-size: var(--text-sm); font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  @media (max-width: 64rem) {
    .nav-toggle { display: flex; }
    .primary-nav {
      position: fixed; top: 0; right: 0; bottom: 0;
      width: min(360px, 90vw); background: var(--color-dark);
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      padding: var(--space-20) var(--space-6) var(--space-8);
      transform: translateX(100%); transition: transform var(--transition-base);
      overflow-y: auto; z-index: 60; box-shadow: var(--shadow-2xl);
      overscroll-behavior: contain;
      display: flex; flex-direction: column; gap: var(--space-6);
    }
    .primary-nav[data-open="true"] { transform: translateX(0); }
    .nav-list { flex-direction: column; align-items: stretch; gap: var(--space-1); }
    .nav-link { font-size: var(--text-base); padding: var(--space-3) var(--space-4); width: 100%; text-align: left; justify-content: space-between; }
    .nav-link-active::after { display: none; }
    .nav-link-active { background: rgba(255, 255, 255, 0.08); }

    /* Mobile: panels become inline accordion content, not a dropdown */
    .nav-menu-panel {
      position: static; transform: none; width: auto; min-width: 0; max-width: none;
      background: rgba(255, 255, 255, 0.04);
      border: none; box-shadow: none;
      border-radius: var(--radius-sm);
      margin: 0 var(--space-2) var(--space-2);
    }
    .panel-inner { padding: var(--space-2) var(--space-2) var(--space-3); }
    .panel-links,
    .panel-roles { width: auto; }
    /* Two-column groups stack to one column in the mobile drawer — there's
       no room for Producers/Buyers/Enablers or Our Approach beside their
       second column at 360px. */
    .panel-columns { grid-template-columns: 1fr; gap: var(--space-4); }
    .panel-col-heading { color: rgba(255, 255, 255, 0.5); }
    .panel-link-title { color: #fff; }
    .panel-link:hover, .panel-link:focus-visible { background: rgba(255, 255, 255, 0.08); }
    .panel-role-card { background: rgba(255, 255, 255, 0.04); border-color: rgba(255, 255, 255, 0.12); }
    .panel-role-title { color: #fff; }
    .panel-view-all { color: var(--c-accent-300); }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  const header = document.getElementById('site-header');
  const menuTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]'));

  function closeAllMenus(except?: HTMLButtonElement) {
    menuTriggers.forEach((trigger) => {
      if (trigger === except) return;
      trigger.setAttribute('aria-expanded', 'false');
      const panel = document.getElementById(trigger.getAttribute('aria-controls') || '');
      panel?.setAttribute('hidden', '');
    });
  }

  menuTriggers.forEach((trigger) => {
    const panel = document.getElementById(trigger.getAttribute('aria-controls') || '');
    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAllMenus(isOpen ? undefined : trigger);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        panel?.setAttribute('hidden', '');
      } else {
        panel?.removeAttribute('hidden');
      }
    });
  });

  // Click outside any nav item closes all open menus.
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    const withinNavItem = menuTriggers.some((trigger) => trigger.closest('.nav-item')?.contains(target));
    if (!withinNavItem) closeAllMenus();
  });

  // Escape closes the open menu and returns focus to its trigger.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openTrigger = menuTriggers.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (openTrigger) {
      closeAllMenus();
      openTrigger.focus();
    }
  });

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.getAttribute('data-open') === 'true';
      nav.setAttribute('data-open', String(!isOpen));
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
      document.body.style.overflow = isOpen ? '' : 'hidden';
      if (isOpen) closeAllMenus();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.getAttribute('data-open') === 'true') {
        nav.setAttribute('data-open', 'false');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        document.body.style.overflow = '';
        (toggle as HTMLElement).focus();
      }
    });

    // Close the mobile drawer on a full-page-link click (leaf links only —
    // menu triggers toggle their own panel and shouldn't close the drawer).
    nav.querySelectorAll('a.nav-link, a.panel-link, a.panel-role-card, a.panel-view-all').forEach((link) => {
      link.addEventListener('click', () => {
        if (nav.getAttribute('data-open') === 'true') {
          nav.setAttribute('data-open', 'false');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open navigation menu');
          document.body.style.overflow = '';
        }
      });
    });
  }

  if (header) {
    const updateScroll = () => { header.setAttribute('data-scrolled', String(window.scrollY > 20)); };
    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();
  }
</script>
