---
// MechanismSelector — the "flow diagram + selectable card stack + deep-dive
// detail panel" webpart, extracted 2026-08-18 from the Carbon & Ecosystem
// Services capability page (its original, only consumer) so the homepage's
// new "Our Markets" section can reuse it verbatim instead of duplicating
// ~150 lines of markup/CSS/script. Data comes from
// src/data/market-mechanisms.ts — both consumers pass the same array so
// content can't drift between them.
//
// Interaction: left column is a stacked flow diagram (Environmental
// Performance → How Is the Value Carried? → Credible Claim & Market Value)
// with the 4 mechanism cards in the middle; right column is the selected
// mechanism's full deep-dive content. All 4 detail panels are pre-rendered
// and toggled via [hidden] (same pattern as StrategyFrameworkDVF's content
// panels on the Regenerative Agriculture page) — works without JS, no
// innerHTML swapping, one aria-live region announces the change.
import type { MarketMechanism } from '../data/market-mechanisms';

interface Props {
  mechanisms: MarketMechanism[];
  /** Which mechanism is shown/selected on load. Defaults to the first. */
  initialId?: string;
}

const { mechanisms, initialId = mechanisms[0]?.id } = Astro.props;
---

<div class="mech-diagram card card-static">
  <div class="mech-diagram-grid">
    <div class="mech-flow">
      <p class="mech-flow-label">Environmental Performance</p>
      <div class="mech-flow-rule" aria-hidden="true"></div>
      <p class="mech-flow-label mech-flow-label-muted">How Is the Value Carried?</p>
      <div class="mech-flow-rule" aria-hidden="true"></div>

      <ul class="mech-selector-stack" role="list" data-mech-selector>
        {mechanisms.map((m) => (
          <li>
            <button
              type="button"
              class="mech-selector-card"
              data-mech-select={m.id}
              aria-pressed={m.id === initialId ? 'true' : 'false'}
            >
              <span class="mech-selector-num">{m.num}</span>
              <span class="mech-selector-title">{m.title}</span>
              <span class="mech-selector-carrier">{m.carrier}</span>
            </button>
          </li>
        ))}
      </ul>

      <div class="mech-flow-rule" aria-hidden="true"></div>
      <p class="mech-flow-label">Credible Claim &amp; Market Value</p>
    </div>

    <div class="mech-detail-panel" aria-live="polite">
      {mechanisms.map((m) => (
        <div class="mech-detail-content" data-mech-detail={m.id} hidden={m.id !== initialId}>
          <p class="mech-detail-deck">{m.headline}</p>
          <div class="mech-examples">
            <span class="mech-examples-label">Examples</span>
            <p class="mech-examples-text">{m.examples}</p>
          </div>
          <div class="mech-detail-body">
            {m.body.map((para) => <p>{para}</p>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .mech-diagram { padding: var(--space-10) var(--space-8); }
  /* Centered — shows the flow moving through the connecting lines from
     Environmental Performance through How Is the Value Carried? to
     Credible Claim & Market Value. */
  .mech-flow-label {
    text-align: center;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .mech-flow-label-muted { color: var(--color-text-muted); }
  .mech-flow-rule {
    height: 1.75rem;
    width: 1px;
    background: var(--color-border-strong);
    margin: var(--space-2) auto;
  }

  /* Selector + deep-dive, embedded side by side: the flow diagram narrows
     to one stacked column on the left, and the selected mechanism's full
     deep-dive content (deck, examples, body paragraphs) renders beside it
     on the right — all mechanisms pre-rendered, toggled via [hidden]. */
  .mech-diagram-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .mech-diagram-grid { grid-template-columns: 17rem 1fr; gap: var(--space-12); }
  }

  .mech-selector-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mech-selector-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .mech-selector-card:hover { border-color: var(--c-sky-300); }
  .mech-selector-card:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .mech-selector-num { font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--c-sky-600); }
  .mech-selector-title { font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--color-text); line-height: 1.25; }
  .mech-selector-carrier { font-size: var(--text-xs); line-height: 1.4; color: var(--color-text-muted); }
  .mech-selector-card[aria-pressed="true"] {
    background: var(--color-dark);
    border-color: var(--color-dark);
  }
  .mech-selector-card[aria-pressed="true"] .mech-selector-num { color: var(--c-sky-300); }
  .mech-selector-card[aria-pressed="true"] .mech-selector-title { color: #fff; }
  .mech-selector-card[aria-pressed="true"] .mech-selector-carrier { color: rgba(248, 250, 252, 0.65); }

  .mech-detail-panel { min-width: 0; }
  /* Full column width, not capped to a reading-width — matches the owner
     mockup this webpart was originally built from ("Full Margin"). */
  .mech-detail-deck { font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--color-text); line-height: 1.35; }
  .mech-examples { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-border); }
  .mech-examples-label { display: block; font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .mech-examples-text { font-size: var(--text-sm); line-height: 1.7; color: var(--color-text-secondary); }
  .mech-detail-body {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--line-relaxed);
    color: var(--color-text-secondary);
  }

  @media (max-width: 40rem) {
    .mech-diagram { padding: var(--space-6) var(--space-5); }
    .mech-flow-rule { height: 1.25rem; }
  }
</style>

<script>
  // Mechanism selector — sets the active card and reveals that mechanism's
  // pre-rendered deep-dive panel beside it. Scoped per-instance via
  // closest('[data-mech-selector]') / a shared document query for panels —
  // if a page ever renders two instances of this component, each instance's
  // cards only toggle panels within that same instance's stack, since panels
  // are looked up relative to the selector root's parent, not globally.
  document.querySelectorAll<HTMLElement>('[data-mech-selector]').forEach((root) => {
    const scope = root.closest('.mech-diagram') ?? document;
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mech-select]'));
    const panels = Array.from(scope.querySelectorAll<HTMLElement>('[data-mech-detail]'));

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.mechSelect;
        if (!id) return;

        cards.forEach((c) => c.setAttribute('aria-pressed', String(c === card)));
        panels.forEach((p) => { p.hidden = p.dataset.mechDetail !== id; });
      });
    });
  });
</script>
