---
// `items` is an array of `posts` collection slugs (Keystatic multiRelationship
// values) — resolve them here rather than expecting the MDX author to pass
// resolved entries.
import { getEntry } from 'astro:content';

interface Props {
  heading?: string;
  items: string[];
}

const { heading = 'Related reading', items } = Astro.props;
const entries = (await Promise.all(items.map((slug) => getEntry('posts', slug)))).filter(
  (entry) => entry !== undefined
);
---

{entries.length > 0 && (
  <aside class="mdx-related">
    <p class="mdx-related-heading">{heading}</p>
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/insights/${entry.id}`}>{entry.data.title}</a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .mdx-related {
    margin-block: var(--space-8);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .mdx-related-heading {
    margin: 0 0 var(--space-3);
    font-weight: var(--font-semibold);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .mdx-related ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mdx-related a {
    font-weight: var(--font-medium);
  }
</style>
