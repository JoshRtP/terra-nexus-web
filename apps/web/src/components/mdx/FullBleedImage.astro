---
// See Figure.astro for why `image` is a plain public/-relative URL string.
interface Props {
  image: string;
  alt: string;
  caption?: string;
}

const { image, alt, caption } = Astro.props;
---

<figure class="mdx-fullbleed">
  <img src={image} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .mdx-fullbleed {
    margin-block: var(--space-10);
    margin-inline: calc(var(--space-8) * -1);
  }
  .mdx-fullbleed img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    margin-top: var(--space-3);
    margin-inline: var(--space-8);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  @media (max-width: 640px) {
    .mdx-fullbleed {
      margin-inline: calc(var(--space-4) * -1);
    }
    figcaption {
      margin-inline: var(--space-4);
    }
  }
</style>
