    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .fw .fw-map-item:last-child { border-bottom: 0; }
  .fw .fw-map-item.is-on { background: var(--c-accent-50); }
  .fw .fw-map-item-body { position: relative; min-width: 0; }
  .fw .fw-map-item-area {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
