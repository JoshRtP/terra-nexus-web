---
// FrameworkViewer — the interactive reference for a three-level framework
// (categories → types → tactics) from src/data/frameworks/. First used for
// the Ten Types of Innovation (2026-09-13); built generically so a second
// framework is a data record, not a component change.
//
// Two variants:
//  * `full` (the /tools/<slug>/ page): the board, one detail panel per type,
//    a tactic drawer, and a play sheet the reader assembles, persists,
//    shares by URL and prints.
//  * `compact` (a capability family page): the board only, with each type
//    linking into the full tool. No script; a plain set of links.
//
// Architecture, following StrategyFrameworkDVF and MechanismSelector rather
// than a client-side framework (CLAUDE.md rule 1):
//  * Everything a reader can read is server-rendered: the board, all ten
//    detail panels and every tactic card are in the HTML, toggled with
//    [hidden]. The tactics are crawlable, and the board works before the
//    script runs.
//  * The only client-built DOM is the play sheet's rows, cloned from a
//    <template> and filled from a small JSON blob of tactic titles.
//  * View state lives in the URL hash (#type-<id>, #play-sheet,
//    #tactic-<id>), so a type or a tactic is linkable, Back works, and the
//    compact variant can deep-link straight into the tool. The play sheet
//    persists to localStorage and travels in a `?play=` query for sharing.
//  * Every control is a real <button> or <a>. The drawer is a <dialog>, so
//    focus trapping and Escape come from the platform.
//  * Colours are data (each type and category carries its own hex), so they
//    are emitted once as custom properties in an inline <style> element,
//    keyed by data attributes. No inline `style=""` attributes anywhere:
//    the capability page tests assert there are none.
import type { Framework } from '../data/frameworks';
import { tacticId, tacticCount, frameworkHref } from '../data/frameworks';

export interface Props {
  framework: Framework;
  variant?: 'full' | 'compact';
  /** Where the compact variant's types link. Defaults to the framework's own route. */
  toolHref?: string;
}

const { framework: fw, variant = 'full', toolHref = frameworkHref(fw.slug) } = Astro.props;
const compact = variant === 'compact';
const L = fw.labels;

const pad = (n: number) => String(n).padStart(2, '0');
const firstSentence = (s: string) => {
  const i = s.indexOf('. ');
  return i < 0 ? s : s.slice(0, i + 1);
};
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Relative luminance decides whether a tint takes light or dark text; the
// palette's lightest type (sage-light, #9AA89B) needs navy text to pass.
const luminance = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  return (0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255;
};
const onTint = (hex: string) => (luminance(hex) > 0.5 ? '#131f48' : '#ffffff');
// Hover colour for a category header: the tint pulled 35% toward the
// brand's deep navy, as the prototype did.
const deepen = (hex: string) => {
  const v = parseInt(hex.slice(1), 16);
  const target = [6, 25, 39];
  const ch = [(v >> 16) & 255, (v >> 8) & 255, v & 255].map((c, i) => Math.round(c + (target[i] - c) * 0.35));
  return '#' + ch.map((c) => c.toString(16).padStart(2, '0')).join('');
};

const types = fw.types.map((t, i) => ({ ...t, n: pad(i + 1), index: i + 1 }));
const columns = fw.categories.map((c, i) => ({
  ...c,
  index: i,
  types: types.filter((t) => t.category === c.name),
}));
const total = tacticCount(fw);

// Per-framework colour rules. Emitted as a <style> element (not attributes)
// and scoped by data-fw so two frameworks on one page cannot collide.
const scope = `[data-fw="${fw.slug}"]`;
const colourCss = [
  `${scope} .fw-board{--fw-cols:${columns.length}}`,
  ...columns.map((c) =>
    `${scope} [data-fw-cat="${c.index}"]{--fw-cat:${c.color};--fw-cat-hover:${deepen(c.color)};--fw-on-cat:${onTint(c.color)};--fw-cat-eyebrow:${luminance(c.color) > 0.5 ? '#131f48' : '#e7d77f'}}`,
  ),
  ...types.map((t) => `${scope} [data-fw-type="${t.id}"]{--fw-tint:${t.color};--fw-on-tint:${onTint(t.color)}}`),
  // Focusing a category widens its column; the others narrow and dim.
  `@media (min-width:64rem){${columns
    .map(
      (c) =>
        `${scope} .fw-board[data-fw-focus="${c.index}"]{grid-template-columns:${columns
          .map((o) => (o.index === c.index ? '1.7fr' : '.65fr'))
          .join(' ')}}`,
    )
    .join('')}}`,
].join('\n');

// What the script needs beyond the DOM: tactic titles for play-sheet rows,
// type names for the drawer breadcrumb, the starter set.
const clientData = compact
  ? null
  : JSON.stringify({
      slug: fw.slug,
      labels: L,
      tactics: Object.fromEntries(
        types.flatMap((t) => t.tactics.map((k) => [tacticId(t, k), { t: k.title, d: k.description, y: t.id }])),
      ),
      types: Object.fromEntries(types.map((t) => [t.id, { t: t.title, c: t.category, n: t.n }])),
      starter: fw.starter?.tactics ?? [],
    }).replace(/</g, '\\u003c');

// Heading levels follow the page: the tool page has its own h1, so the board
// starts at h2; on a capability page the board sits under the section's h2.
const CatH = compact ? 'h3' : 'h2';
const TypeH = compact ? 'h4' : 'h3';
const uid = `fw-${fw.slug}`;
---

<div class={`fw ${compact ? 'fw-compact' : 'fw-full'}`} id={compact ? undefined : 'framework'} data-fw={fw.slug} data-fw-variant={variant} data-fw-total={total}>
  <style is:inline set:html={colourCss}></style>

  {!compact && (
    <div class="fw-toolbar" data-print-hide>
      <nav class="fw-tabs" aria-label={`${fw.name} views`}>
        <a href="#framework" data-fw-tab="board" aria-current="page">Framework</a>
        <a href="#play-sheet" data-fw-tab="play">Play sheet <span class="fw-tab-count" data-fw-play-count>0</span></a>
      </nav>
      <p class="fw-stats">
        <span><b>{types.length}</b> {L.typePlural}</span>
        <span><b>{total}</b> {L.tacticPlural}</span>
        <span><b data-fw-play-count>0</b> in play</span>
      </p>
    </div>
  )}

  {/* ── Board ─────────────────────────────────────────────────────────── */}
  <section class="fw-view" data-fw-view="board" aria-label={`${fw.name} board`}>
    {!compact && <p class="fw-intro">{fw.intro}</p>}

    {!compact && (
      <p class="fw-focus-note" data-fw-focus-note hidden data-print-hide>
        <span>Focused on <b data-fw-focus-name></b>. Other {L.groupPlural} are dimmed.</span>
        <button type="button" class="fw-btn-sm" data-fw-focus-clear>Show all {columns.length}</button>
      </p>
    )}

    <div class="fw-board" data-fw-board>
      {columns.map((col) => (
        <section class="fw-col" data-fw-cat={col.index} aria-labelledby={`${uid}-cat-${col.index}`}>
          {compact ? (
            <div class="fw-col-head">
              <span class="fw-col-label">{col.name}</span>
              <CatH class="fw-col-focus" id={`${uid}-cat-${col.index}`}>{col.focus}</CatH>
              <span class="fw-col-meta">{col.types.length} {L.typePlural} · {col.types.reduce((n, t) => n + t.tactics.length, 0)} {L.tacticPlural}</span>
            </div>
          ) : (
            <button type="button" class="fw-col-head" data-fw-focus={col.index} aria-pressed="false">
              <span class="fw-col-label">{col.name}</span>
              <CatH class="fw-col-focus" id={`${uid}-cat-${col.index}`}>{col.focus}</CatH>
              <span class="fw-col-meta">{col.types.length} {L.typePlural} · {col.types.reduce((n, t) => n + t.tactics.length, 0)} {L.tacticPlural} · <span class="fw-col-hint">focus</span></span>
            </button>
          )}

          {col.types.map((t) => (
            <article class="fw-type" data-fw-type={t.id} data-fw-type-row={t.id}>
              <span class="fw-pill" aria-hidden="true">{t.n}</span>
              <div class="fw-type-body">
                <TypeH class="fw-type-title">
                  <a href={compact ? `${toolHref}#type-${t.id}` : `#type-${t.id}`} class="fw-type-link" data-fw-open={t.id}>{t.title}</a>
                </TypeH>
                <p class="fw-type-blurb">{firstSentence(t.description)}</p>
                {!compact && (
                  <ul class="fw-chips" data-fw-chips role="list" hidden>
                    {t.tactics.map((k) => (
                      <li>
                        <button type="button" class="fw-chip" data-fw-drawer={tacticId(t, k)} data-fw-on={tacticId(t, k)} aria-pressed="false">{k.title}</button>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="fw-type-meta">
                  <span>{t.tactics.length} {L.tacticPlural}</span>
                  {!compact && <span class="fw-inplay" data-fw-inplay={t.id} hidden></span>}
                </p>
              </div>
            </article>
          ))}

          {col.note && (
            <div class="fw-col-note">
              <span class="field-label">{col.note.label}</span>
              <p>{col.note.text}</p>
            </div>
          )}
        </section>
      ))}
    </div>

    {compact && (
      <p class="fw-compact-foot">{total} {L.tacticPlural} across {types.length} {L.typePlural}. Each {L.type} opens in the full tool.</p>
    )}
  </section>

  {/* ── One detail panel per type ─────────────────────────────────────── */}
  {!compact &&
    types.map((t) => {
      const col = columns.find((c) => c.name === t.category)!;
      const siblings = col.types;
      return (
        <section class="fw-view fw-detail" id={`type-${t.id}`} data-fw-view="detail" data-fw-detail={t.id} data-fw-type={t.id} aria-labelledby={`type-${t.id}-h`} hidden>
          <aside class="fw-rail" data-print-hide data-fw-cat={col.index}>
            <span class="fw-rail-cat">{col.name}</span>
            <a href="#framework" class="fw-back">Back to all {types.length} {L.typePlural}</a>
            <ul class="fw-rail-list" role="list">
              {siblings.map((s) => (
                <li>
                  <a href={`#type-${s.id}`} data-fw-type={s.id} aria-current={s.id === t.id ? 'page' : undefined}>
                    <span class="fw-rail-n">{s.n}</span>
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
            <p class="fw-rail-blurb">{col.blurb}</p>
          </aside>

          <div class="fw-detail-main">
            <header class="fw-detail-head">
              <div>
                <p class="fw-detail-crumb">
                  <span class="fw-pill" aria-hidden="true">{t.n}</span>
                  <span class="field-label">{t.category} · {cap(L.type)} {t.index} of {types.length}</span>
                </p>
                <h2 id={`type-${t.id}-h`}>{t.title}</h2>
                <p class="fw-detail-desc">{t.description}</p>
              </div>
              <p class="fw-detail-stat"><b>{t.tactics.length}</b><span>{L.tacticPlural} in this {L.type}</span></p>
            </header>

            {t.examples && t.examples.length > 0 && (
              <div class="fw-examples">
                <span class="field-label">How this {L.type} shows up</span>
                <ul class="fw-example-list" role="list">
                  {t.examples.map((e) => (
                    <li><b>{e.who}</b><span>{e.what}</span></li>
                  ))}
                </ul>
              </div>
            )}

            <div class="fw-tactics-head">
              <span class="field-label">{L.tacticPlural}</span>
              <span class="fw-hint" data-print-hide>Open one for examples. Use Add to build the play sheet.</span>
            </div>
            <ul class="fw-tactics" role="list">
              {t.tactics.map((k) => {
                const id = tacticId(t, k);
                const n = k.examples?.length ?? 0;
                return (
                  <li class="fw-tactic" id={`tactic-${id}`} data-fw-tactic={id} data-fw-on={id}>
                    <div class="fw-tactic-body">
                      <h3 class="fw-tactic-title">
                        <button type="button" class="fw-tactic-open" data-fw-drawer={id} aria-haspopup="dialog">{k.title}</button>
                      </h3>
                      <p class="fw-tactic-desc">{k.description}</p>
                    </div>
                    <div class="fw-tactic-foot">
                      <span class:list={['fw-tactic-ex', { 'fw-tactic-ex-none': n === 0 }]}>{n === 0 ? 'No examples yet' : `${n} ${n === 1 ? 'example' : 'examples'}`}</span>
                      <button type="button" class="fw-add" data-fw-toggle={id} aria-pressed="false"><span data-fw-toggle-label>Add</span></button>
                    </div>
                    {n > 0 && (
                      <div class="fw-tactic-examples" data-fw-examples hidden>
                        <ul class="fw-example-list" role="list">
                          {k.examples!.map((e) => (
                            <li><b>{e.who}</b><span>{e.what}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      );
    })}

  {/* ── Play sheet ────────────────────────────────────────────────────── */}
  {!compact && (
    <section class="fw-view fw-play" id="play-sheet" data-fw-view="play" aria-labelledby="play-sheet-h" hidden>
      <header class="fw-play-head">
        <div>
          <span class="eyebrow">Play sheet</span>
          <h2 id="play-sheet-h">Session play sheet</h2>
          <p class="fw-play-summary" data-fw-play-summary>Empty. {cap(L.tacticPlural)} you add from any {L.type} land here, grouped by {L.type}, ready to print or share.</p>
        </div>
        <div class="fw-play-actions" data-print-hide>
          <button type="button" class="btn btn-secondary fw-btn-sm" data-fw-share>Copy share link</button>
          <button type="button" class="btn btn-secondary fw-btn-sm" data-fw-print>Print / PDF</button>
          <button type="button" class="btn btn-secondary fw-btn-sm" data-fw-clear>Clear sheet</button>
        </div>
      </header>
      <p class="fw-status" role="status" aria-live="polite" data-fw-status></p>

      <div class="fw-coverage">
        <div class="fw-coverage-head">
          <span class="field-label">Coverage across the {types.length} {L.typePlural}</span>
          <span class="fw-hint" data-fw-filter-note data-print-hide>Click a {L.type} to filter the list below.</span>
          <span class="fw-hint" data-fw-filter-on data-print-hide hidden>
            Filtered to <b data-fw-filter-name></b>
            <button type="button" class="fw-btn-sm" data-fw-filter-clear>Show all</button>
          </span>
        </div>
        <ul class="fw-cov-list" role="list">
          {types.map((t) => (
            <li>
              <button type="button" class="fw-cov" data-fw-cov={t.id} data-fw-type={t.id} aria-pressed="false" disabled>
                <span class="fw-cov-n">{t.n}</span>
                <span class="fw-cov-title">{t.title}</span>
                <span class="fw-cov-meta" data-fw-cov-meta>untouched</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="fw-play-empty" data-fw-play-empty>
        <h3>Nothing on the sheet yet</h3>
        <p>Open a {L.type} and add {L.tacticPlural}, or click a {L.tactic} chip straight from a focused {L.group} on the board.</p>
        <div class="fw-play-empty-actions" data-print-hide>
          <a href="#framework" class="btn btn-secondary fw-btn-sm">Go to the framework</a>
          {fw.starter && <button type="button" class="btn btn-secondary fw-btn-sm" data-fw-starter>Load the {fw.starter.name} example</button>}
        </div>
        {fw.starter && <p class="fw-play-note">{fw.starter.note}</p>}
      </div>

      <div data-fw-play-groups>
        {types.map((t) => (
          <section class="fw-play-group" data-fw-play-group={t.id} data-fw-type={t.id} aria-labelledby={`play-${t.id}-h`} hidden>
            <h3 id={`play-${t.id}-h`} class="fw-play-group-h">
              <span class="fw-pill" aria-hidden="true">{t.n}</span>
              <span>{t.title}</span>
              <span class="fw-play-cat">{t.category}</span>
            </h3>
            <ul class="fw-play-list" role="list" data-fw-play-list></ul>
          </section>
        ))}
      </div>
      <template data-fw-row>
        <li class="fw-play-row">
          <div>
            <b class="fw-play-title"></b>
            <p class="fw-play-desc"></p>
          </div>
          <button type="button" class="fw-btn-sm" data-fw-remove data-print-hide>Remove</button>
        </li>
      </template>
    </section>
  )}

  {/* ── Tactic drawer ─────────────────────────────────────────────────── */}
  {!compact && (
    <dialog class="fw-drawer" data-fw-dialog aria-labelledby="fw-drawer-h">
      <div class="fw-drawer-inner">
        <div class="fw-drawer-head" data-fw-drawer-head>
          <div class="fw-drawer-top">
            <span class="fw-drawer-crumb" data-fw-drawer-crumb></span>
            <button type="button" class="fw-drawer-close" data-fw-drawer-close aria-label="Close">×</button>
          </div>
          <h2 id="fw-drawer-h" data-fw-drawer-title></h2>
        </div>
        <div class="fw-drawer-body">
          <p class="fw-drawer-desc" data-fw-drawer-desc></p>
          <button type="button" class="btn btn-primary fw-drawer-toggle" data-fw-drawer-toggle aria-pressed="false"><span data-fw-toggle-label>Add to play sheet</span></button>
          <div class="fw-drawer-ex">
            <span class="field-label">In the field</span>
            <div data-fw-drawer-examples></div>
            <p class="fw-drawer-none" data-fw-drawer-none hidden>No examples logged for this {L.tactic} yet.</p>
          </div>
        </div>
      </div>
    </dialog>
  )}

  {clientData && <script is:inline type="application/json" data-fw-data set:html={clientData}></script>}
</div>

<style>
  .fw {
    color: var(--color-text);
    scroll-margin-top: var(--space-24);
  }

  /* ── Small shared pieces ──────────────────────────────────────────── */
  .fw-pill {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: var(--radius-full);
    background: var(--fw-tint, var(--color-dark));
    color: var(--fw-on-tint, #fff);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.02em;
  }
  .fw-btn-sm {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    line-height: 1;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .fw-btn-sm:hover { background: var(--c-sky-50); border-color: var(--c-sky-500); }
  .fw button:focus-visible,
  .fw a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .fw-hint {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .fw .field-label { margin: 0; }
  .fw-example-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .fw-example-list li {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--c-sky-300);
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
    color: var(--color-text-secondary);
  }
  .fw-example-list b { color: var(--color-text); font-weight: var(--font-semibold); }

  /* ── Toolbar (full) ───────────────────────────────────────────────── */
  .fw-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .fw-tabs { display: flex; gap: var(--space-1); }
  .fw-tabs a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3);
    margin-bottom: -1px;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .fw-tabs a:hover { color: var(--color-text); }
  .fw-tabs a[aria-current="page"] {
    color: var(--color-text);
    border-bottom-color: var(--color-eyebrow);
  }
  .fw-tab-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: var(--space-1);
    border-radius: var(--radius-full);
    background: var(--color-surface-alt);
    font-size: var(--text-xs);
  }
  .fw-stats {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding-bottom: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .fw-stats span { display: inline-flex; align-items: baseline; gap: var(--space-2); }
  .fw-stats b {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--font-semibold);
    line-height: 1;
    color: var(--color-dark);
  }
  .fw-intro {
    max-width: var(--max-width-text);
    margin: 0 0 var(--space-6);
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
  }
  .fw-focus-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .fw-focus-note b { color: var(--color-text); }

  /* ── Board ────────────────────────────────────────────────────────── */
  .fw-board {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    /* clip, not hidden: overflow:hidden makes the board the scrollport for
       the sticky column headers below 64rem, which then pin inside the
       board (pushed down over the first type) instead of to the viewport.
       Measured 2026-09-13. */
    overflow: clip;
    transition: grid-template-columns var(--transition-base);
  }
  @media (min-width: 64rem) {
