    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    line-height: var(--line-snug);
    color: inherit;
  }
  .fw-col-meta {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    opacity: 0.8;
  }
  .fw-col-hint { text-decoration: underline; text-underline-offset: 2px; }
  button.fw-col-head[aria-pressed="true"] .fw-col-hint::before { content: 'un'; }
  /* Below the wide breakpoint the column headers stay put while a long
     column scrolls, so the reader always knows which category they are in. */
  @media (max-width: 63.99rem) {
    .fw-full .fw-col-head { position: sticky; top: 4.375rem; z-index: 2; }
  }

  /* Matrix layout: axis labels around the board at wide widths; a plain
     stacked list, in row-major order, below. */
  .fw-matrix-on { display: grid; gap: var(--space-3); }
  .fw-axis {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .fw-axis-label { color: var(--color-eyebrow); letter-spacing: 0.1em; }
