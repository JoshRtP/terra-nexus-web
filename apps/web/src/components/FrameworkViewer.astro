    overflow: clip;
    transition: grid-template-columns var(--transition-base);
  }
  .fw-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-bg);
  }
  .fw-col-head {
    display: block;
    width: 100%;
    padding: var(--space-5) var(--space-5) var(--space-4);
    text-align: left;
    background: var(--fw-cat);
    color: var(--fw-on-cat);
    border: 0;
    font: inherit;
  }
  button.fw-col-head { cursor: pointer; transition: background var(--transition-fast); }
  button.fw-col-head:hover,
  button.fw-col-head[aria-pressed="true"] { background: var(--fw-cat-hover); }
  button.fw-col-head:focus-visible { outline-offset: -4px; }
