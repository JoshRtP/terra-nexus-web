    border-bottom: 1px solid var(--color-border);
  }
  .fw-tabs { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .fw-tabs a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3);
    margin-bottom: -1px;
    font-size: var(--text-sm);
