<style>
  .fw {
    color: var(--color-text);
    scroll-margin-top: var(--space-24);
  }

  /* ── Small shared pieces ──────────────────────────────────────────── */
  .fw-pill {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: var(--radius-full);
    background: var(--fw-tint, var(--color-dark));
    color: var(--fw-on-tint, #fff);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.02em;
  }
  .fw-btn-sm {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    line-height: 1;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .fw-btn-sm:hover { background: var(--c-sky-50); border-color: var(--c-sky-500); }
  .fw button:focus-visible,
  .fw a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .fw-hint {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .fw .field-label { margin: 0; }
  .fw-example-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .fw-example-list li {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--c-sky-300);
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
    color: var(--color-text-secondary);
  }
  .fw-example-list b { color: var(--color-text); font-weight: var(--font-semibold); }

  /* ── Toolbar (full) ───────────────────────────────────────────────── */
  .fw-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
