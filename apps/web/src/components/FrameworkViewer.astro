<script>
  // Framework viewer, full variant. State: the selected view (from the URL
  // hash), the focused category, the play sheet (persisted), a play filter,
  // and for a value map the current branch and picked cell. All DOM is
  // pre-rendered except play rows, the map after an interaction, and the
  // plays-by-value-line table.
  interface ValueNode { code: string; name: string; children?: ValueNode[] }
  interface FwData {
    slug: string;
    labels: Record<string, string>;
    tactics: Record<string, { y: string; a?: string[] }>;
    types: Record<string, { t: string; c: string; s: string; n: string }>;
    typeOrder: string[];
    starter: string[];
    map: { tree: ValueNode[]; rootCrumb: string; sheetCols: Array<{ code: string; name: string; root: string }> } | null;
  }

  document.querySelectorAll<HTMLElement>('[data-fw][data-fw-variant="full"]').forEach((root) => {
    const dataEl = root.querySelector<HTMLScriptElement>('[data-fw-data]');
    if (!dataEl) return;
    const data: FwData = JSON.parse(dataEl.textContent || '{}');
    const L = data.labels;
    const STORAGE_KEY = `tnx:framework:${data.slug}:play`;
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const $$ = <T extends Element>(sel: string) => Array.from(root.querySelectorAll<T>(sel));
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    const views = $$<HTMLElement>('[data-fw-view]');
    const board = $<HTMLElement>('[data-fw-board]');
    const dialog = $<HTMLDialogElement>('[data-fw-dialog]');
    const status = $<HTMLElement>('[data-fw-status]');
    const rowTemplate = $<HTMLTemplateElement>('template[data-fw-row]');

    let play: string[] = [];
    let filter: string | null = null;
    let drawerId: string | null = null;

    // Titles and descriptions live in the cards already on the page.
    const textOf = (id: string) => {
      const card = document.getElementById(`tactic-${id}`);
      return {
        t: card?.querySelector('.fw-tactic-title')?.textContent?.trim() ?? id,
        d: card?.querySelector('.fw-tactic-desc')?.textContent?.trim() ?? '',
      };
    };
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
    const under = (code: string, ancestor: string) => code === ancestor || code.startsWith(`${ancestor}.`);

    // ── Persistence ─────────────────────────────────────────────────
    const readStored = (): string[] => {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed.filter((id) => typeof id === 'string' && data.tactics[id]) : [];
      } catch {
        return [];
      }
    };
    const store = () => {
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(play));
      } catch {
        // Private mode or quota: the sheet still works for the session.
      }
    };

    // ── Rendering ───────────────────────────────────────────────────
    const inPlayByType = () => {
      const counts: Record<string, number> = {};
      play.forEach((id) => {
        const y = data.tactics[id].y;
        counts[y] = (counts[y] ?? 0) + 1;
      });
      return counts;
    };

    const setToggleState = (btn: Element, on: boolean, onLabel: string, offLabel: string) => {
      btn.setAttribute('aria-pressed', String(on));
      const label = btn.querySelector('[data-fw-toggle-label]');
      if (label) label.textContent = on ? onLabel : offLabel;
    };

    const renderSheet = () => {
      const sheet = $<HTMLElement>('[data-fw-sheet]');
      const host = $<HTMLElement>('[data-fw-sheet-table]');
      if (!sheet || !host || !data.map) return;
      sheet.hidden = play.length === 0;
      host.replaceChildren();
      if (play.length === 0) return;
      const cols = data.map.sheetCols;
      const rootName = (code: string) => data.map!.tree.find((r) => r.code === code)?.name ?? code;
      const table = el('table', 'fw-sheet-table');
      const thead = el('thead');
      const rootRow = el('tr');
      rootRow.appendChild(el('th', '', ''));
      rootRow.appendChild(el('th', '', ''));
      data.map.tree.forEach((r) => {
        const span = cols.filter((c) => c.root === r.code).length;
        const th = el('th', 'fw-sheet-root', r.name);
        th.colSpan = span;
        rootRow.appendChild(th);
      });
      const colRow = el('tr');
      colRow.appendChild(el('th', '', cap(L.type)));
      colRow.appendChild(el('th', '', 'Play on the sheet'));
      cols.forEach((c) => colRow.appendChild(el('th', 'fw-sheet-col', c.name)));
      thead.append(rootRow, colRow);
      const tbody = el('tbody');
      const totals = cols.map(() => 0);
      data.typeOrder.forEach((typeId) => {
        const items = play.filter((k) => data.tactics[k].y === typeId);
        items.forEach((k, i) => {
          const tr = el('tr');
          tr.setAttribute('data-fw-type', typeId);
          const area = el('th', 'fw-sheet-area', i === 0 ? data.types[typeId].t : '');
          tr.appendChild(area);
          tr.appendChild(el('td', 'fw-sheet-play', textOf(k).t));
          cols.forEach((c, ci) => {
            const on = (data.tactics[k].a ?? []).some((code) => under(code, c.code));
            if (on) totals[ci]++;
            const td = el('td', 'fw-sheet-dot');
            if (on) {
              const dot = el('span');
              dot.setAttribute('title', `${rootName(c.root)} · ${c.name}`);
              td.appendChild(dot);
            }
            tr.appendChild(td);
          });
          tbody.appendChild(tr);
        });
      });
      const tfoot = el('tfoot');
      const tr = el('tr');
      const th = el('th', '', `Plays touching each line`);
      th.colSpan = 2;
      tr.appendChild(th);
      totals.forEach((n) => {
        const td = el('td', n === 0 ? 'is-zero' : '', n === 0 ? '·' : String(n));
        tr.appendChild(td);
      });
      tfoot.appendChild(tr);
      table.append(thead, tbody, tfoot);
      host.appendChild(table);
    };

    const render = () => {
      const counts = inPlayByType();
      const touched = Object.keys(counts).length;
      const typeIds = data.typeOrder;

      $$<HTMLElement>('[data-fw-play-count]').forEach((n) => { n.textContent = String(play.length); });
      $$<HTMLElement>('[data-fw-on]').forEach((node) => {
        const on = play.includes(node.dataset.fwOn || '');
        if (node instanceof HTMLButtonElement) node.setAttribute('aria-pressed', String(on));
        node.classList.toggle('is-on', on);
      });
      $$<HTMLButtonElement>('[data-fw-toggle]').forEach((btn) => setToggleState(btn, play.includes(btn.dataset.fwToggle || ''), 'On sheet', 'Add'));
      $$<HTMLButtonElement>('[data-fw-map-toggle]').forEach((btn) => {
        const id = btn.dataset.fwMapToggle || '';
        setToggleState(btn, play.includes(id), 'On sheet', 'Add');
        btn.closest('.fw-map-item')?.classList.toggle('is-on', play.includes(id));
      });
      $$<HTMLElement>('[data-fw-inplay]').forEach((node) => {
        const n = counts[node.dataset.fwInplay || ''] ?? 0;
        node.hidden = n === 0;
        node.textContent = `${n} in play`;
      });

      // Play sheet: summary, coverage, groups.
      const summary = $<HTMLElement>('[data-fw-play-summary]');
      if (summary) {
        summary.textContent = touched === 0
          ? `Empty. ${cap(L.tacticPlural)} you add from any ${L.type} land here, grouped by ${L.type}, ready to print or share.`
          : `${plural(play.length, L.tactic, L.tacticPlural)} across ${plural(touched, L.type, L.typePlural)}. ${typeIds.length - touched} ${L.typePlural} untouched.`;
      }
      $$<HTMLButtonElement>('[data-fw-cov]').forEach((btn) => {
        const id = btn.dataset.fwCov || '';
        const n = counts[id] ?? 0;
        btn.disabled = n === 0;
        btn.classList.toggle('is-on', n > 0);
        btn.setAttribute('aria-pressed', String(filter === id));
        const meta = btn.querySelector('[data-fw-cov-meta]');
        if (meta) meta.textContent = n ? `${n} selected` : 'untouched';
      });
      const filterOn = $<HTMLElement>('[data-fw-filter-on]');
      const filterNote = $<HTMLElement>('[data-fw-filter-note]');
      if (filterOn && filterNote) {
        filterOn.hidden = !filter;
        filterNote.hidden = !!filter || touched === 0;
        const name = filterOn.querySelector('[data-fw-filter-name]');
        if (name && filter) name.textContent = data.types[filter].t;
      }
      const empty = $<HTMLElement>('[data-fw-play-empty]');
      if (empty) empty.hidden = play.length > 0;

      $$<HTMLElement>('[data-fw-play-group]').forEach((group) => {
        const id = group.dataset.fwPlayGroup || '';
        const items = play.filter((k) => data.tactics[k].y === id);
        const show = items.length > 0 && (!filter || filter === id);
        group.hidden = !show;
        const list = group.querySelector<HTMLElement>('[data-fw-play-list]');
        if (!list || !rowTemplate) return;
        list.replaceChildren();
        if (!show) return;
        items.forEach((k) => {
          const row = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const text = textOf(k);
          row.querySelector('.fw-play-title')!.textContent = text.t;
          row.querySelector('.fw-play-desc')!.textContent = text.d;
          const remove = row.querySelector<HTMLButtonElement>('[data-fw-remove]')!;
          remove.setAttribute('aria-label', `Remove ${text.t}`);
          remove.addEventListener('click', () => toggle(k));
          list.appendChild(row);
        });
      });
      renderSheet();

      // Drawer button, if open.
      const drawerToggle = $<HTMLButtonElement>('[data-fw-drawer-toggle]');
      if (drawerToggle && drawerId) setToggleState(drawerToggle, play.includes(drawerId), 'Remove from play sheet', 'Add to play sheet');
    };

    const say = (text: string) => { if (status) status.textContent = text; };

    const toggle = (id: string) => {
      if (!data.tactics[id]) return;
      const was = play.includes(id);
      play = was ? play.filter((k) => k !== id) : play.concat(id);
      store();
      render();
      say(`${textOf(id).t} ${was ? 'removed from' : 'added to'} the play sheet. ${plural(play.length, L.tactic, L.tacticPlural)} on it.`);
    };

    // ── Views (URL hash) ────────────────────────────────────────────
    const showView = (view: string, typeId?: string) => {
      views.forEach((v) => {
        const kind = v.dataset.fwView;
        v.hidden = !(kind === view && (kind !== 'detail' || v.dataset.fwDetail === typeId));
      });
      $$<HTMLAnchorElement>('[data-fw-tab]').forEach((tab) => {
        const current = tab.dataset.fwTab === (view === 'detail' ? 'board' : view);
        if (current) tab.setAttribute('aria-current', 'page');
        else tab.removeAttribute('aria-current');
      });
    };

    const route = () => {
      const hash = decodeURIComponent(location.hash.slice(1));
      if (hash === 'play-sheet') {
        showView('play');
        root.scrollIntoView({ block: 'start' });
        return;
      }
      if (hash === 'value-map' && data.map) {
        showView('map');
        root.scrollIntoView({ block: 'start' });
        return;
      }
      if (hash.startsWith('type-') && data.types[hash.slice(5)]) {
        showView('detail', hash.slice(5));
        root.scrollIntoView({ block: 'start' });
        return;
      }
      if (hash.startsWith('tactic-') && data.tactics[hash.slice(7)]) {
        const id = hash.slice(7);
        showView('detail', data.tactics[id].y);
        const card = document.getElementById(`tactic-${id}`);
        (card ?? root).scrollIntoView({ block: card ? 'center' : 'start' });
        return;
      }
      showView('board');
      if (hash === 'framework') root.scrollIntoView({ block: 'start' });
    };

    // ── Category focus ──────────────────────────────────────────────
    const setFocus = (index: string | null) => {
      if (!board) return;
      if (index === null) board.removeAttribute('data-fw-focus');
      else board.setAttribute('data-fw-focus', index);
      $$<HTMLElement>('.fw-col').forEach((col) => {
        const on = index !== null && col.dataset.fwCat === index;
        if (on) col.setAttribute('data-fw-focused', '');
        else col.removeAttribute('data-fw-focused');
        const head = col.querySelector('[data-fw-focus]');
        if (head) head.setAttribute('aria-pressed', String(on));
        col.querySelectorAll<HTMLElement>('[data-fw-chips]').forEach((chips) => { chips.hidden = !on; });
      });
      const note = $<HTMLElement>('[data-fw-focus-note]');
      if (note) {
        note.hidden = index === null;
        const name = note.querySelector('[data-fw-focus-name]');
        const head = index !== null ? board.querySelector(`[data-fw-cat="${index}"] .fw-col-label`) : null;
        if (name && head) name.textContent = head.textContent;
      }
    };
    $$<HTMLButtonElement>('[data-fw-focus]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.fwFocus ?? null;
        setFocus(board?.getAttribute('data-fw-focus') === idx ? null : idx);
      });
    });
    $<HTMLButtonElement>('[data-fw-focus-clear]')?.addEventListener('click', () => setFocus(null));

    // ── Drawer ──────────────────────────────────────────────────────
    const openDrawer = (id: string) => {
      if (!dialog || !data.tactics[id]) return;
      const tactic = data.tactics[id];
      const type = data.types[tactic.y];
      const text = textOf(id);
      drawerId = id;
      $<HTMLElement>('[data-fw-drawer-head]')?.setAttribute('data-fw-type', tactic.y);
      const crumb = $<HTMLElement>('[data-fw-drawer-crumb]');
      if (crumb) crumb.textContent = `${type.c} · ${type.t}`;
      const title = $<HTMLElement>('[data-fw-drawer-title]');
      if (title) title.textContent = text.t;
      const desc = $<HTMLElement>('[data-fw-drawer-desc]');
      if (desc) desc.textContent = text.d;
      const examples = $<HTMLElement>('[data-fw-drawer-examples]');
      const none = $<HTMLElement>('[data-fw-drawer-none]');
      const source = document.getElementById(`tactic-${id}`)?.querySelector('[data-fw-examples]');
      if (examples) examples.replaceChildren(...(source ? [source.firstElementChild!.cloneNode(true)] : []));
      if (none) none.hidden = !!source;
      render();
      dialog.showModal();
    };
    const closeDrawer = () => { dialog?.close(); };
    $$<HTMLButtonElement>('[data-fw-drawer]').forEach((btn) => {
      btn.addEventListener('click', () => openDrawer(btn.dataset.fwDrawer || ''));
    });
    $<HTMLButtonElement>('[data-fw-drawer-close]')?.addEventListener('click', closeDrawer);
    $<HTMLButtonElement>('[data-fw-drawer-toggle]')?.addEventListener('click', () => { if (drawerId) toggle(drawerId); });
    dialog?.addEventListener('click', (event) => {
      // A click on the backdrop lands on the dialog element itself.
      if (event.target === dialog) closeDrawer();
    });
    dialog?.addEventListener('close', () => { drawerId = null; });

    // ── Value map ───────────────────────────────────────────────────
    if (data.map) {
      const map = data.map;
      const grid = $<HTMLElement>('[data-fw-map-grid]');
      const crumbsHost = $<HTMLElement>('[data-fw-map-crumbs]');
      const listHost = $<HTMLElement>('[data-fw-map-list]');
      const itemTemplate = $<HTMLTemplateElement>('template[data-fw-map-item]');
      const CAP = 60;
      let code: string | null = null;
      let cell: { type: string | null; code: string } | null = null;

      const nodeAt = (c: string | null): ValueNode | null => {
        if (!c) return null;
        let list: ValueNode[] | undefined = map.tree;
        let found: ValueNode | null = null;
        const parts = c.split('.');
        for (let i = 0; i < parts.length; i++) {
          const want = parts.slice(0, i + 1).join('.');
          const hit: ValueNode | undefined = (list ?? []).find((n) => n.code === want);
          if (!hit) return null;
          found = hit;
          list = hit.children;
        }
        return found;
      };
      const countIn = (typeId: string, c: string) =>
        Object.entries(data.tactics).filter(([, v]) => v.y === typeId && (v.a ?? []).some((x) => under(x, c))).length;
      const pickedIds = () => {
        const filterCode = cell ? cell.code : code;
        return Object.entries(data.tactics)
          .filter(([, v]) => (!cell || !cell.type || v.y === cell.type) && (!filterCode || (v.a ?? []).some((x) => under(x, filterCode))))
          .map(([id]) => id);
      };
      const orderedPicked = () => {
        const ids = new Set(pickedIds());
        const out: string[] = [];
        data.typeOrder.forEach((typeId) => {
          $$<HTMLElement>(`[data-fw-detail="${typeId}"] [data-fw-tactic]`).forEach((card) => {
            const id = card.dataset.fwTactic || '';
            if (ids.has(id)) out.push(id);
          });
        });
        return out;
      };
      const pathName = (id: string) =>
        (data.tactics[id].a ?? []).map((c) => c.split('.').map((_, i, arr) => nodeAt(arr.slice(0, i + 1).join('.'))?.name ?? '').filter(Boolean).join(' · ')).join(' / ');

      const renderMap = () => {
        if (!grid || !crumbsHost) return;
        const cur = nodeAt(code);
        const cols = cur ? cur.children ?? [cur] : map.tree;
        const leafLevel = !!cur && !cur.children;

        // Crumbs
        crumbsHost.replaceChildren();
        const crumb = (name: string, target: string | null, current: boolean) => {
          const b = el('button', 'fw-crumb', name);
          b.type = 'button';
          if (current) b.setAttribute('aria-current', 'page');
          b.addEventListener('click', () => { code = target; cell = null; renderMap(); });
          crumbsHost.appendChild(b);
        };
        crumb(map.rootCrumb, null, !code);
        (code ?? '').split('.').filter(Boolean).forEach((_, i, arr) => {
          const c = arr.slice(0, i + 1).join('.');
          crumb(nodeAt(c)?.name ?? c, c, i === arr.length - 1);
        });
        const note = $<HTMLElement>('[data-fw-map-cell-note]');
        if (note) {
          note.hidden = !cell;
          const name = note.querySelector('[data-fw-map-cell-name]');
          if (name && cell) name.textContent = `${nodeAt(cell.code)?.name ?? map.rootCrumb}${cell.type ? ` × ${data.types[cell.type].t}` : ' × all'}`;
        }

        // Grid
        grid.setAttribute('data-fw-map-cols', String(cols.length));
        const counts = data.typeOrder.map((t) => cols.map((c) => countIn(t, c.code)));
        const max = Math.max(1, ...counts.flat());
        const heat = (n: number) => (n === 0 ? 0 : 1 + Math.min(4, Math.floor((n / max) * 4)));
        const frag = document.createDocumentFragment();
        const corner = grid.querySelector('.fw-map-corner')!.cloneNode(true);
        frag.appendChild(corner);
        cols.forEach((c) => {
          const b = el('button', 'fw-map-col');
          b.type = 'button';
          const sel = !!cell && !cell.type && cell.code === c.code;
          b.classList.toggle('is-sel', sel);
          b.appendChild(el('span', 'fw-map-col-hint', c.children ? 'Drill in' : 'Filter to line'));
          b.appendChild(el('span', 'fw-map-col-name', c.name));
          const total = data.typeOrder.reduce((n, t) => n + countIn(t, c.code), 0);
          b.appendChild(el('span', 'fw-map-col-total', `${total} ${L.tacticPlural}`));
          b.addEventListener('click', () => {
            if (c.children) { code = c.code; cell = null; }
            else cell = sel ? null : { type: null, code: c.code };
            renderMap();
          });
          frag.appendChild(b);
        });
        data.typeOrder.forEach((typeId, ti) => {
          const rowSel = !!cell && cell.type === typeId && cell.code === (code ?? '') && !cols.some((c) => c.code === cell!.code);
          const row = el('div', 'fw-map-row');
          row.setAttribute('data-fw-type', typeId);
          row.classList.toggle('is-sel', rowSel);
          const pick = el('button', 'fw-map-row-pick');
          pick.type = 'button';
          pick.appendChild(el('span', 'fw-map-row-dim', data.types[typeId].s));
          pick.appendChild(el('span', 'fw-map-row-title', data.types[typeId].t));
          pick.addEventListener('click', () => { cell = rowSel ? null : { type: typeId, code: code ?? '' }; renderMap(); });
          row.appendChild(pick);
          const open = el('a', 'fw-map-row-open', `Open ${L.type}`);
          open.href = `#type-${typeId}`;
          row.appendChild(open);
          frag.appendChild(row);
          cols.forEach((c, ci) => {
            const n = counts[ti][ci];
            const b = el('button', 'fw-map-cell', n === 0 ? '—' : String(n));
            b.type = 'button';
            b.setAttribute('data-fw-heat', String(heat(n)));
            b.disabled = n === 0;
            const sel = !!cell && cell.type === typeId && cell.code === c.code;
            b.classList.toggle('is-sel', sel);
            b.addEventListener('click', () => { cell = sel ? null : { type: typeId, code: c.code }; renderMap(); });
            frag.appendChild(b);
          });
        });
        grid.replaceChildren(frag);

        // List
        if (!listHost || !itemTemplate) return;
        const picked = orderedPicked();
        const show = !!cell || leafLevel;
        listHost.hidden = !show;
        if (!show) return;
        const label = listHost.querySelector('[data-fw-map-list-label]');
        const sub = listHost.querySelector('[data-fw-map-list-sub]');
        const nodeName = (c: string | null) => nodeAt(c)?.name ?? map.rootCrumb;
        if (label) label.textContent = cell ? `${cap(L.tacticPlural)} in this cell` : `${cap(L.tacticPlural)} under ${nodeName(code)}`;
        if (sub) sub.textContent = picked.length === 0
          ? `Nothing at this intersection. That part of the tree is not addressed by this ${L.type}.`
          : cell && cell.type
            ? `${nodeName(cell.code)} × ${data.types[cell.type].t}.`
            : `${nodeName(cell ? cell.code : code)} across every ${L.type}. Pick a cell above to cut it to one.`;
        const addAll = listHost.querySelector<HTMLButtonElement>('[data-fw-map-add-all]');
        if (addAll) {
          const n = Math.min(picked.length, CAP);
          addAll.hidden = n === 0;
          addAll.textContent = `Add ${n} to play sheet`;
          addAll.onclick = () => {
            const fresh = picked.slice(0, CAP).filter((id) => !play.includes(id));
            play = play.concat(fresh);
            store();
            render();
            say(`Added ${plural(fresh.length, L.tactic, L.tacticPlural)}.`);
          };
        }
        const items = listHost.querySelector<HTMLElement>('[data-fw-map-items]')!;
        items.replaceChildren();
        picked.slice(0, CAP).forEach((id) => {
          const li = itemTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
          li.setAttribute('data-fw-type', data.tactics[id].y);
          li.querySelector('.fw-map-item-area')!.textContent = data.types[data.tactics[id].y].t;
          const openBtn = li.querySelector<HTMLButtonElement>('[data-fw-map-open]')!;
          openBtn.textContent = textOf(id).t;
          openBtn.addEventListener('click', () => openDrawer(id));
          li.querySelector('.fw-map-item-path')!.textContent = pathName(id);
          const tg = li.querySelector<HTMLButtonElement>('[data-fw-map-toggle]')!;
          tg.setAttribute('data-fw-map-toggle', id);
          tg.addEventListener('click', () => toggle(id));
          items.appendChild(li);
        });
        const truncated = listHost.querySelector<HTMLElement>('[data-fw-map-truncated]');
        if (truncated) {
          truncated.hidden = picked.length <= CAP;
          truncated.textContent = `Showing the first ${CAP} of ${picked.length} ${L.tacticPlural}. Drill further into the tree, or pick a single cell, to narrow it.`;
        }
        render();
      };

      $<HTMLButtonElement>('[data-fw-map-cell-clear]')?.addEventListener('click', () => { cell = null; renderMap(); });
      // The server-rendered root grid becomes live on first interaction;
      // wiring the static buttons through one re-render keeps one code path.
      grid?.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>('[data-fw-map-col], [data-fw-map-cell], [data-fw-map-row]');
        if (!target || !grid.contains(target)) return;
        event.preventDefault();
        if (target.dataset.fwMapCol !== undefined) {
          const c = target.dataset.fwMapCol!;
          if (target.dataset.fwMapBranch === 'true') { code = c; cell = null; }
          else cell = { type: null, code: c };
        } else if (target.dataset.fwMapCell !== undefined) {
          const [type, c] = target.dataset.fwMapCell!.split('|');
          cell = { type, code: c };
        } else if (target.dataset.fwMapRow !== undefined) {
          cell = { type: target.dataset.fwMapRow!, code: '' };
        }
        renderMap();
      }, { once: true });
    }

    // ── Play-sheet controls ─────────────────────────────────────────
    $$<HTMLButtonElement>('[data-fw-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => toggle(btn.dataset.fwToggle || ''));
    });
    $$<HTMLButtonElement>('[data-fw-cov]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.fwCov || '';
        filter = filter === id ? null : id;
        render();
      });
    });
    $<HTMLButtonElement>('[data-fw-filter-clear]')?.addEventListener('click', () => { filter = null; render(); });
    $<HTMLButtonElement>('[data-fw-starter]')?.addEventListener('click', () => {
      play = data.starter.filter((id) => data.tactics[id]);
      store();
      render();
      say(`Loaded ${plural(play.length, L.tactic, L.tacticPlural)}.`);
    });
    $<HTMLButtonElement>('[data-fw-clear]')?.addEventListener('click', () => {
      if (play.length === 0) return;
      play = [];
      filter = null;
      store();
      render();
      say('Play sheet cleared.');
    });
    $<HTMLButtonElement>('[data-fw-print]')?.addEventListener('click', () => {
      showView('play');
      window.print();
    });
    $<HTMLButtonElement>('[data-fw-share]')?.addEventListener('click', async () => {
      if (play.length === 0) {
        say('Add something to the sheet first.');
        return;
      }
      const url = new URL(location.href);
      url.search = '';
      url.searchParams.set('play', play.join(','));
      url.hash = 'play-sheet';
      const link = url.toString();
      try {
        await navigator.clipboard.writeText(link);
        say('Link copied. Anyone who opens it sees this sheet and can add to their own.');
      } catch {
        say(`Copy this link: ${link}`);
      }
    });

    // ── Init ────────────────────────────────────────────────────────
    play = readStored();
    const shared = new URLSearchParams(location.search).get('play');
    if (shared) {
      const incoming = shared.split(',').filter((id) => data.tactics[id] && !play.includes(id));
      if (incoming.length) {
        play = play.concat(incoming);
        store();
      }
    }
    render();
    route();
    window.addEventListener('hashchange', route);
  });
</script>
