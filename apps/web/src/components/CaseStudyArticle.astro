---
import type { CaseStudyPageModel } from '../lib/okf/case-study-pages.js';

interface Props {
  page: CaseStudyPageModel;
  renderedBody: string;
}

const { page, renderedBody } = Astro.props;

const relByField = (field: string) => page.relationships.outbound
  .filter((e) => e.field === field)
  .map((e) => e.to.replace(/^.*\//, '').replace(/-/g, ' '))
  .join(', ');

const capabilities = relByField('related_services');
const expertise = relByField('related_expertise');
const audience = relByField('related_audiences');
const engagementModel = relByField('engagement_models');

const overview = [
  { label: 'Capabilities used', value: capabilities },
  { label: 'Area of Expertise', value: expertise },
  { label: 'Audience', value: audience },
  { label: 'Engagement model', value: engagementModel },
].filter((item) => item.value);
---

<section class="section">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/case-studies/">Case Studies</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{page.title}</span>
    </nav>

    <article class="case-study-article">
      <header class="page-header">
        <p class="eyebrow">{page.label}</p>
        <h1>{page.title}</h1>
        {page.description && <p class="hero-description">{page.description}</p>}
      </header>

      {overview.length > 0 && (
        <aside class="case-overview" aria-label="Case study overview">
          <h2 class="overview-heading">At a Glance</h2>
          <dl class="overview-list">
            {overview.map((item) => (
              <div class="overview-item">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      )}

      <div class="markdown-body" set:html={renderedBody}></div>
      <p class="return-link"><a href="/case-studies/" class="btn btn-secondary">Back to Case Studies</a></p>
    </article>
  </div>
</section>

<style>
  .breadcrumb { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-8); }
  .breadcrumb a { color: var(--color-accent); }
  .page-header { margin-bottom: var(--space-8); }
  .page-header .eyebrow { display: block; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-3); }
  .page-header h1 { margin-bottom: var(--space-4); }
  .hero-description { font-size: var(--text-lg); color: var(--color-text-secondary); max-width: var(--max-width-text); }
  .case-overview { padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); margin-bottom: var(--space-8); }
  .overview-heading { font-size: var(--text-base); margin-bottom: var(--space-4); }
  .overview-list { display: grid; gap: var(--space-4); margin: 0; }
  @media (min-width: 40rem) { .overview-list { grid-template-columns: repeat(2, 1fr); } }
  .overview-item { display: flex; flex-direction: column; gap: var(--space-1); }
  .overview-item dt { font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); }
  .overview-item dd { margin: 0; font-size: var(--text-sm); color: var(--color-text); }
  .markdown-body > :first-child { margin-top: 0; }
  .markdown-body h2 { margin-top: var(--space-10); margin-bottom: var(--space-4); }
  .markdown-body h3 { margin-top: var(--space-8); margin-bottom: var(--space-3); }
  .markdown-body p { margin-bottom: var(--space-4); line-height: var(--line-relaxed); }
  .markdown-body ul, .markdown-body ol { margin-bottom: var(--space-4); padding-left: var(--space-6); }
  .markdown-body li { margin-bottom: var(--space-2); }
  .markdown-body table { width: 100%; border-collapse: collapse; margin-block: var(--space-6); }
  .markdown-body th, .markdown-body td { padding: var(--space-3); text-align: left; vertical-align: top; border: 1px solid var(--color-border); }
  .markdown-body th { background: var(--color-surface); font-weight: 600; }
  .return-link { margin-top: var(--space-12); }
</style>
