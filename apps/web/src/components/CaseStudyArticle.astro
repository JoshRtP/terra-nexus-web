---
import type { CaseStudyPageModel } from '../lib/okf/case-study-pages.js';

interface Props {
  page: CaseStudyPageModel;
  renderedBody: string;
}

const { page, renderedBody } = Astro.props;

const relByField = (field: string) =>
  page.relationships.outbound
    .filter((e) => e.field === field)
    .map((e) => e.to.replace(/^.*\//, '').replace(/-/g, ' '))
    .join(', ');

const capabilities = relByField('related_services');
const expertise = relByField('related_expertise');
const audience = relByField('related_audiences');

const hasStats = page.quantifiedResults && page.quantifiedResults.length > 0;
const hasFrameworks = page.frameworksReviewed && page.frameworksReviewed.length > 0;
const hasDeliverables = page.deliverables && page.deliverables.length > 0;

const profileItems = [
  { label: 'Client Type', value: page.clientType },
  { label: 'Engagement Year', value: page.engagementYear },
  { label: 'Status', value: page.engagementStatus },
  { label: 'Geography', value: page.geographyContext },
  { label: 'Value Chain', value: page.valueChain },
  { label: 'Production System', value: page.productionSystem },
  { label: 'Solution', value: page.solutionType },
  { label: 'Engagement Model', value: page.engagementModel },
  { label: 'Attribution', value: page.attribution },
].filter((item) => item.value);

const overviewItems = [
  { label: 'Capabilities', value: capabilities },
  { label: 'Area of Expertise', value: expertise },
  { label: 'Audience', value: audience },
].filter((item) => item.value);
---

<section class="case-hero" aria-labelledby="case-title">
  <div class="container case-hero-inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/case-studies/">Case Studies</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{page.title}</span>
    </nav>
    <span class="eyebrow eyebrow-light">{page.label}</span>
    <h1 id="case-title">{page.title}</h1>
    {page.description && <p class="case-lead">{page.description}</p>}
  </div>
</section>

<div class="container case-body-grid">
  <article class="case-main">
    {hasStats && (
      <section class="stats-band" aria-label="Key results">
        {page.quantifiedResults!.map((stat) => (
          <div class="stat-item">
            <span class="stat-value stat-value-accent stat-value-fluid">{stat.value}</span>
            <span class="stat-label">{stat.metric}</span>
            {stat.resultType && <span class="stat-type">{stat.resultType}</span>}
          </div>
        ))}
      </section>
    )}

    {page.challenge && (
      <section class="content-block" aria-labelledby="challenge-heading">
        <span class="eyebrow">The Challenge</span>
        <h2 id="challenge-heading">The Challenge</h2>
        <p class="block-text">{page.challenge}</p>
      </section>
    )}

    {page.workPerformed && (
      <section class="content-block" aria-labelledby="approach-heading">
        <span class="eyebrow">Our Approach</span>
        <h2 id="approach-heading">Our Approach</h2>
        <p class="block-text">{page.workPerformed}</p>
      </section>
    )}

    {hasDeliverables && (
      <section class="content-block" aria-labelledby="deliverables-heading">
        <span class="eyebrow">Deliverables</span>
        <h2 id="deliverables-heading">Deliverables</h2>
        <ul class="deliverable-list">
          {page.deliverables!.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {page.outcome && (
      <section class="content-block content-block-accent" aria-labelledby="outcome-heading">
        <span class="eyebrow">Outcomes</span>
        <h2 id="outcome-heading">Outcomes</h2>
        <p class="block-text">{page.outcome}</p>
      </section>
    )}

    <section class="content-block details-block" aria-labelledby="details-heading">
      <span class="eyebrow">Detailed Narrative</span>
      <h2 id="details-heading">How the Engagement Created Value</h2>
      <p class="details-intro">The summary above captures the engagement at a glance. The narrative below provides the additional context behind the analysis, workstreams, decision criteria, and commercial implications.</p>
      <div class="details-panel">
        <div class="markdown-body" set:html={renderedBody}></div>
      </div>
    </section>

    <p class="return-link"><a href="/case-studies/" class="btn btn-secondary">Back to Case Studies</a></p>
  </article>

  <aside class="case-sidebar" aria-label="Case study details">
    {overviewItems.length > 0 && (
      <div class="card card-static sidebar-card">
        <h3 class="sidebar-heading">At a Glance</h3>
        <dl class="sidebar-list">
          {overviewItems.map((item) => (
            <div class="sidebar-item">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {profileItems.length > 0 && (
      <div class="card card-static sidebar-card">
        <h3 class="sidebar-heading">Engagement Profile</h3>
        <dl class="sidebar-list">
          {profileItems.map((item) => (
            <div class="sidebar-item">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {hasFrameworks && (
      <div class="card card-static sidebar-card">
        <h3 class="sidebar-heading">Frameworks Reviewed</h3>
        <ul class="framework-list">
          {page.frameworksReviewed!.map((fw) => (
            <li>
              <span class="framework-name">{fw.name}</span>
              {fw.role && <span class="framework-role">{fw.role}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}

    {page.marketMechanisms && page.marketMechanisms.length > 0 && (
      <div class="card card-static sidebar-card">
        <h3 class="sidebar-heading">Market Mechanisms</h3>
        <div class="tag-cloud">
          {page.marketMechanisms!.map((mech) => <span class="tag">{mech}</span>)}
        </div>
      </div>
    )}

    <div class="sidebar-cta">
      <h3 class="sidebar-heading">Explore Further</h3>
      <p class="cta-text">Want to discuss a similar engagement?</p>
      <a href="/contact/" class="btn btn-primary">Contact Terra Nexus</a>
    </div>
  </aside>
</div>

<style>
  /* ── Hero ── */
  .case-hero {
    background: var(--gradient-dark);
    color: var(--c-secondary-400);
    padding-block: var(--space-12) var(--space-10);
    position: relative;
    overflow: hidden;
  }
  .case-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top right, rgba(231, 215, 127, 0.1) 0%, transparent 60%);
    pointer-events: none;
  }
  .case-hero-inner { position: relative; }
  .case-hero .breadcrumb {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--c-secondary-400);
    margin-bottom: var(--space-6);
  }
  .case-hero .breadcrumb a {
    color: var(--c-accent-300); font-weight: var(--font-medium);
  }
  .case-hero .breadcrumb a:hover { color: var(--c-accent-200); }
  .case-hero h1 {
    color: var(--color-text-inverse);
    font-size: clamp(1.75rem, 4vw, var(--text-4xl));
    max-width: 44rem;
    margin-bottom: var(--space-4);
  }
  .case-lead {
    font-size: var(--text-lg);
    color: rgba(248, 250, 252, 0.82);
    max-width: 44rem;
    line-height: var(--line-relaxed);
  }

  /* ── Body grid: main + sidebar ── */
  .case-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding-block: var(--space-12);
  }
  @media (min-width: 56rem) {
    .case-body-grid {
      /* minmax(0, 1fr), not a bare 1fr — a bare `1fr` grid track's implicit
         min-width is `auto` (its content's min-content size), not 0. At
         1024px (this breakpoint's low end) .case-main's content min-content
         width could exceed the space actually available once the 20rem
         sidebar + 40px gap are subtracted, pushing .case-sidebar past the
         container edge (confirmed via computed getBoundingClientRect() in
         M7 baseline QA: ~18-33px horizontal overflow at exactly 1024px).
         minmax(0, 1fr) lets the main column actually shrink to the
         available space instead of forcing the grid wider than its
         container. */
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-10);
      align-items: start;
    }
  }
  @media (min-width: 72rem) {
    .case-body-grid { grid-template-columns: minmax(0, 1fr) 22rem; }
  }

  /* ── Stats band ── */
  .stats-band {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-12);
  }
  @media (min-width: 40rem) {
    .stats-band { grid-template-columns: repeat(2, 1fr); }
  }
  /* Typography for .stat-value/.stat-label/.stat-type comes from the
     shared primitives in design-system.css (.stat-value-accent for the sky
     color, .stat-value-fluid for this card's clamped size); only the
     card-chrome (border/padding/gap) and this component's specific
     .stat-label weight and .stat-type position are local. */
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border-left: 3px solid var(--c-sky-600);
  }
  .stat-item .stat-label {
    color: var(--color-text-secondary);
    font-weight: var(--font-medium);
    margin-top: 0;
  }
  .stat-item .stat-type {
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0;
    margin-top: var(--space-1);
  }

  /* ── Content blocks ── */
  .content-block {
    margin-bottom: var(--space-12);
  }
  .content-block h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-5);
    scroll-margin-top: var(--space-16);
  }
  .block-text {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
    max-width: 42rem;
  }

  .content-block-accent {
    padding: var(--space-8);
    background: var(--c-sky-50);
    border: 1px solid var(--c-sky-300);
    border-radius: var(--radius-lg);
  }
  .content-block-accent h2 { color: var(--c-sky-700); }
  .content-block-accent .block-text { color: var(--color-text); }

  /* ── Deliverable list ── */
  .deliverable-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .deliverable-list li {
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--line-normal);
  }
  .deliverable-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-sky-600);
  }

  /* ── Detailed narrative ── */
  .details-block { margin-top: var(--space-16); }
  .details-intro {
    max-width: 42rem;
    margin-bottom: var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--line-relaxed);
  }
  .details-panel {
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  /* markdown-body styles are in the global style block below */

  .return-link { margin-top: var(--space-12); }

  /* ── Sidebar ── */
  .case-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: sticky;
    top: var(--space-6);
  }
  @media (max-width: 55rem) {
    .case-sidebar { position: static; }
  }
  /* .card-static provides the non-hover base recipe; padding (smaller than
     .card's default) and background (surface, not surface-elevated) are
     genuinely distinct here and kept as local overrides. */
  .sidebar-card {
    padding: var(--space-6);
    background: var(--color-surface);
  }
  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .sidebar-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .sidebar-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .sidebar-item dt {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .sidebar-item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: var(--line-normal);
  }

  /* ── Framework list ── */
  .framework-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .framework-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .framework-name {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }
  .framework-role {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-normal);
  }

  /* ── Tag cloud ── */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    background: var(--c-sky-50);
    color: var(--c-sky-700);
    border: 1px solid var(--c-sky-300);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    line-height: 1.4;
  }

  /* ── Sidebar CTA ── */
  .sidebar-cta {
    padding: var(--space-6);
    background: linear-gradient(135deg, var(--c-sky-200) 0%, var(--c-sky-300) 100%);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .sidebar-cta .sidebar-heading {
    color: var(--color-eyebrow);
    border-bottom-color: rgba(19, 31, 72, 0.15);
  }
  .cta-text {
    color: var(--c-sky-700);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    line-height: var(--line-normal);
  }
  .sidebar-cta .btn-primary {
    width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 48rem) {
    .stats-band { padding: var(--space-6); }
    .content-block-accent { padding: var(--space-6); }
  }
</style>

<style is:global>
  /* ── Markdown body (global: set:html content lacks scoped attributes) ── */
  .markdown-body {
    counter-reset: narrative-section;
    overflow-x: auto;
  }
  .markdown-body > :first-child { margin-top: 0; }
  .markdown-body h2 {
    counter-increment: narrative-section;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-10);
    margin-bottom: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-2xl);
    scroll-margin-top: var(--space-16);
  }
  .markdown-body h2:first-child { margin-top: 0; border-top: 0; padding-top: 0; }
  .markdown-body h2::before {
    content: counter(narrative-section, decimal-leading-zero);
    flex-shrink: 0;
    color: var(--c-sky-600);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    letter-spacing: 0;
  }
  .markdown-body h3 {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--c-sky-700);
    font-size: var(--text-lg);
    scroll-margin-top: var(--space-16);
  }
  .markdown-body p {
    max-width: 42rem;
    margin-bottom: var(--space-4);
    line-height: var(--line-relaxed);
    color: var(--color-text-secondary);
  }
  .markdown-body h2 + p { font-size: var(--text-lg); }
  .markdown-body ul, .markdown-body ol {
    max-width: 42rem;
    margin: var(--space-4) 0 var(--space-5);
    padding: var(--space-5) var(--space-6) var(--space-5) var(--space-10);
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .markdown-body li { margin-bottom: var(--space-2); padding-left: var(--space-1); }
  .markdown-body li:last-child { margin-bottom: 0; }
  .markdown-body table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    margin-block: var(--space-6);
    background: var(--color-bg);
  }
  .markdown-body th, .markdown-body td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--color-border);
    line-height: var(--line-normal);
  }
  .markdown-body th {
    background: var(--c-sky-50);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--c-sky-700);
  }
  .markdown-body td { color: var(--color-text-secondary); font-size: var(--text-sm); }
  .markdown-body strong { color: var(--color-text); }

  @media (max-width: 48rem) {
    .markdown-body table { min-width: 0; }
  }
</style>
