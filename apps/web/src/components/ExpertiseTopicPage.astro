    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .xp-argument { border-top: 2px solid var(--color-dark); padding-top: var(--space-3); }
  .xp-argument-title { font-size: var(--text-base); font-weight: var(--font-semibold); margin: 0; }
  .xp-argument-text {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
