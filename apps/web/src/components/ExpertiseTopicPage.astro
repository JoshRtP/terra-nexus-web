    display: flex;
    flex-direction: column;
  }
  .xp-tool-media {
    background: var(--color-surface);
    padding: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
  }
  .xp-tool-media img { max-width: 100%; height: auto; max-height: 14rem; width: auto; border-radius: var(--radius-sm); }
  .xp-tool-body { padding: var(--space-5); }
  .xp-tool-name { font-size: var(--text-base); font-weight: var(--font-semibold); margin: 0; text-wrap: pretty; }
