  }

  /* ── 02 The Potential ── */
  .xp-transition {
    margin: var(--space-5) 0 0;
    max-width: 44rem;
    font-size: var(--text-xl);
    font-weight: var(--font-medium);
    line-height: var(--line-snug);
    color: var(--color-text);
    text-wrap: pretty;
  }
  .xp-pillars {
    margin-top: var(--space-8);
