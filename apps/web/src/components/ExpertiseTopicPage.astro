---
// ExpertiseTopicPage — the expertise topic template.
//
// Ten sections in a fixed order, plus hero and closing CTA, driven by one
// content record per topic (src/data/expertise/<slug>.ts). The order is Josh's
// and carries the argument: Overview → The Potential → Course Correcting →
// Priority Investments → Accelerating Adoption → Validating Market Fit →
// Verifying What Matters Most → Market Pathways → Digital Enablers. Do not
// reorder. Section rail labels are the short menu names in shared.ts's
// `sectionRail`; the headings keep their longer titles.
//
// Implements the design prototype handed over 2026-09-12
// (plans/ExpertiseTemplate-Upgrade.zip, EXPERTISE-TEMPLATE-HANDOVER.md). The
// prototype is inline-styled because the environment it was built in streams
// that way — everything here is classed instead, with real media queries. Four
// production components do the heavy lifting and are imported rather than
// reproduced: PageHero (media variant), StrategyFrameworkDVF, MechanismSelector
// and the lifecycle stage data the homepage Approach band also renders.
//
// Traps this deliberately designs against, all of which cost rework before
// (handover section 5):
//  * Every selector panel is in the served HTML with `hidden` on the inactive
//    ones — never rendered conditionally. 4 pathways, 6 stages, every
//    intervention, 5 framework regions. Roughly three times the indexable body
//    copy, and the reader still sees one panel at a time.
//  * `[hidden]` loses to any author `display` rule, so every class that both
//    uses `hidden` and sets `display` restates `[hidden] { display: none }`.
//  * The rail is sticky in a grid gutter. That needs the column to stretch the
//    full row AND no `overflow: hidden` anywhere in the ancestor chain, or it
//    silently will not move. See the .topic-shell CSS.
//  * No `gap: 1px` hairline separators (they paint empty cells when the
//    auto-fit track count does not divide the item count, and disappear to
//    subpixel rounding); real per-row borders instead.
//  * No inline grid-template-columns — it cannot carry a media query, which is
//    what ribbons rows on a phone.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from './PageHero.astro';
import StrategyFrameworkDVF from './StrategyFrameworkDVF.astro';
import MechanismSelector, { type MechanismDetailBlock } from './MechanismSelector.astro';
import { getBuildMode } from '../lib/build-mode.js';
import type { MarketMechanism } from '../data/market-mechanisms';
import type { ExpertiseTopic } from '../data/expertise/types';
import {
  lifecycle,
  sectionRail,
  impactLabels,
  impactOrder,
  validationRows,
  validationQuestions,
  validationLead,
  categoryToRegion,
  toolAsset,
} from '../data/expertise/shared';

interface Props {
  topic: ExpertiseTopic;
}

const { topic } = Astro.props;
const mode = getBuildMode();

const railIndex = Object.fromEntries(sectionRail.map((s) => [s.id, s.n]));
const num = (id: string) => railIndex[id] ?? '';

// Section 06 — the same grouping the regenerative-agriculture page did before
// the template existed: validation rows grouped by category, in first-seen
// order, then fed to the DVF component as each base dimension's content.
// variant="validation-only" renders the validation side as a checklist rather
// than pitfall/fix pairs (Josh, 2026-09-12).
const rows = validationRows[topic.slug] ?? [];
const dvfContent: Record<string, { beforeAfter: Array<{ pitfall: string; validation: string }> }> = {};
for (const row of rows) {
  const regionId = categoryToRegion[row.category];
  if (!regionId) continue;
  dvfContent[regionId] ??= { beforeAfter: [] };
  dvfContent[regionId].beforeAfter.push({ pitfall: row.pitfall, validation: row.validation });
}
const questionGroups = validationQuestions[topic.slug] ?? [];

// Section 04 — chips in display order; the first intervention is selected on
// load. Every intervention renders; the filter only toggles `hidden`.
const chips = impactOrder.map((id) => ({ id, label: impactLabels[id] }));
const interventions = topic.investments.interventions;
const initialIntervention = interventions[0]?.id ?? '';

// Section 08 — the topic's pathways expressed as MarketMechanism records so
// MechanismSelector renders them unchanged. `summary` and `examples` are empty
// on purpose: the overview grid is not used here, and the topic-specific
// "When to use it" / "Programs & instruments" blocks come through the
// component's detailBlocks prop instead of its generic Examples block.
const mechanisms: MarketMechanism[] = topic.pathways.items
  .filter((p) => p.applicable !== false)
  .map((p) => ({
    id: p.id,
    num: p.n,
    title: p.name,
    carrier: p.carrier,
    headline: p.tagline,
    summary: '',
    body: [p.detail],
    examples: '',
  }));
const initialPathway = mechanisms[0]?.id ?? '';

// The two blocks the homepage's mechanism selector does not have: when to
// reach for this pathway, and the named programs and instruments that apply to
// this topic specifically. Both are per topic, so they come in through the
// component's detailBlocks extension point rather than living in
// market-mechanisms.ts.
const detailBlocks: Record<string, MechanismDetailBlock[]> = Object.fromEntries(
  topic.pathways.items
    .filter((p) => p.applicable !== false)
    .map((p) => [
      p.id,
      [
        { label: 'When to use it', text: p.whenToUse, position: 'before' as const },
        { label: `Programs & instruments in ${topic.name}`, items: p.examples, position: 'after' as const },
      ],
    ]),
);

const initialStage = lifecycle[0]?.id ?? '';
const tools = topic.enablers.tools.map((t) => ({ ...t, ...toolAsset(t.asset, t.shape) }));
---

<SiteLayout
  title={topic.meta.title}
  description={topic.meta.description}
  canonical={topic.meta.canonical}
  ogImage={topic.meta.ogImage}
  preview={mode === 'preview'}
>
  <PageHero
    variant="media"
    heroImage={topic.heroImage}
    heroImageAlt={topic.heroImageAlt}
    eyebrow={topic.eyebrow}
    title={topic.hero}
    lead={topic.heroLead}
    primaryCta={{ label: 'Discuss Your Opportunity', href: '/contact/' }}
    secondaryCta={{ label: topic.heroCta, href: topic.heroCtaHref }}
  />

  <article class="topic-article" aria-label={`${topic.name} expertise`}>
    <div class="container">
      <div class="topic-shell">
        <div class="topic-body">

          <!-- 01 Overview — why this topic, now. -->
          <section class="xp-section" id="overview" aria-labelledby="overview-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('overview')}</span>
              <span class="xp-eyebrow">{topic.overview.label}</span>
            </div>
            <h2 class="xp-h2" id="overview-h">{topic.overview.heading}</h2>
            <p class="xp-lead">{topic.overview.lead}</p>

            <div class="xp-stats">
              {topic.overview.stats.map((stat) => (
                <div class="xp-stat">
                  <span class="xp-stat-figure">{stat.figure}</span>
                  <p class="xp-stat-label">{stat.label}</p>
                </div>
              ))}
            </div>

            <div class="xp-arguments">
              {topic.overview.body.map((block) => (
                <div class="xp-argument">
                  <h3 class="xp-argument-title">{block.title}</h3>
                  <p class="xp-argument-text">{block.text}</p>
                </div>
              ))}
            </div>

            {/* Influence / incentive / mechanism — what actually differs
                between the nine topics when the practices are shared. */}
            <dl class="xp-positioning">
              <div class="xp-positioning-item">
                <dt>Influence over production</dt>
                <dd>{topic.positioning.influence}</dd>
              </div>
              <div class="xp-positioning-item">
                <dt>What pays for the change</dt>
                <dd>{topic.positioning.incentive}</dd>
              </div>
              <div class="xp-positioning-item">
                <dt>Preferred market mechanism</dt>
                <dd>{topic.positioning.mechanism}</dd>
              </div>
            </dl>
          </section>

          <!-- 02 The Potential — Resilient / Sustainable / Prosperous. The
               order is the argument: an operation that cannot survive its
               climate will never be sustainable or prosperous. -->
          <section class="xp-section xp-section-alt" id="potential" aria-labelledby="potential-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('potential')}</span>
              <span class="xp-eyebrow">{topic.potential.label}</span>
            </div>
            <h2 class="xp-h2" id="potential-h">{topic.potential.heading}</h2>
            <p class="xp-body-lead">{topic.potential.lead}</p>
            <p class="xp-transition">{topic.potential.transition}</p>

            <div class="xp-pillars">
              {topic.potential.pillars.map((pillar) => (
                <div class="xp-pillar">
                  <div class="xp-pillar-head">
                    <span class="xp-pillar-tag">{pillar.tag}</span>
                    <h3 class="xp-pillar-title">{pillar.title}</h3>
                  </div>
                  <p class="xp-pillar-text">{pillar.text}</p>
                  <ul class="xp-dash-list" role="list">
                    {pillar.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              ))}
            </div>
            <p class="xp-kicker">{topic.potential.kicker}</p>
          </section>

          <!-- 03 Challenges — five accordions, one per indicator. Open state
               splits the category definition from the topic-specific issues so
               the indicator and the erosion read as different things. No
               "reversed by" line: section 04 is where the reversal lives. -->
          <section class="xp-section xp-section-navy" id="correcting" aria-labelledby="correcting-h">
            <div class="xp-head">
              <span class="xp-num xp-num-light" aria-hidden="true">{num('correcting')}</span>
              <span class="xp-eyebrow xp-eyebrow-light">{topic.correcting.label}</span>
            </div>
            <h2 class="xp-h2" id="correcting-h">{topic.correcting.heading}</h2>
            <p class="xp-lead">{topic.correcting.lead}</p>

            <div class="xp-indicators">
              {topic.correcting.indicators.map((indicator) => (
                <details class="xp-indicator">
                  <summary class="xp-indicator-summary">
                    <h3 class="xp-indicator-name">{indicator.name}</h3>
                    <span class="xp-indicator-count">
                      {indicator.issues.length} {indicator.issues.length === 1 ? 'indicator' : 'indicators'}
                    </span>
                    <span class="xp-chevron" aria-hidden="true">▼</span>
                  </summary>
                  <div class="xp-indicator-body">
                    <div class="xp-indicator-col">
                      <span class="xp-micro-label xp-micro-gold">What it means</span>
                      <p class="xp-indicator-definition">{indicator.definition}</p>
                    </div>
                    <div class="xp-indicator-col">
                      <span class="xp-micro-label xp-micro-sky">Where the value is going</span>
                      <ul class="xp-dash-list xp-dash-list-sky" role="list">
                        {indicator.issues.map((issue) => <li>{issue}</li>)}
                      </ul>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- 04 Investments — the three-part frame, an indicator filter, then
               the intervention list beside a detail panel. -->
          <section class="xp-section" id="investments" aria-labelledby="investments-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('investments')}</span>
              <span class="xp-eyebrow">{topic.investments.label}</span>
            </div>
            <h2 class="xp-h2" id="investments-h">{topic.investments.heading}</h2>
            <p class="xp-lead">{topic.investments.lead}</p>

            <div class="xp-frame">
              {topic.investments.frame.map((f) => (
                <div class="xp-frame-card">
                  <h3 class="xp-frame-title">{f.title}</h3>
                  <p class="xp-frame-text">{f.text}</p>
                </div>
              ))}
            </div>

            <div class="xp-filter" data-iv-filter>
              <span class="xp-filter-label" id="iv-filter-label">Filter by indicator</span>
              <div class="xp-chips" role="group" aria-labelledby="iv-filter-label">
                {chips.map((chip) => (
                  <button
                    type="button"
                    class="xp-chip"
                    data-impact={chip.id}
                    aria-pressed={chip.id === 'all' ? 'true' : 'false'}
                  >
                    {chip.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="xp-iv-layout">
              <div class="xp-iv-col">
                <p class="xp-iv-count" data-iv-count aria-live="polite">
                  {interventions.length} {interventions.length === 1 ? 'intervention' : 'interventions'}
                </p>
                <div class="xp-iv-list" role="tablist" aria-label="Interventions" aria-orientation="vertical" data-iv-tablist>
                  {interventions.map((iv) => (
                    <button
                      type="button"
                      class="xp-iv"
                      role="tab"
                      id={`iv-tab-${iv.id}`}
                      aria-controls={`iv-panel-${iv.id}`}
                      aria-selected={iv.id === initialIntervention ? 'true' : 'false'}
                      tabindex={iv.id === initialIntervention ? '0' : '-1'}
                      data-iv={iv.id}
                      data-impacts={iv.impacts.join(' ')}
                    >
                      <span class="xp-iv-group">{iv.group}</span>
                      <span class="xp-iv-name">{iv.name}</span>
                    </button>
                  ))}
                </div>
              </div>

              <div class="xp-iv-col">
                <p class="xp-iv-empty" data-iv-empty hidden>
                  No interventions in this topic are tagged to that indicator. Select another
                  indicator, or choose All.
                </p>
                {/* tabindex="0" on each panel because they hold no focusable
                    content of their own — without it a keyboard user can
                    select a tab but never reach what it reveals. */}
                {interventions.map((iv) => (
                  <div
                    class="xp-iv-panel"
                    role="tabpanel"
                    id={`iv-panel-${iv.id}`}
                    aria-labelledby={`iv-tab-${iv.id}`}
                    tabindex="0"
                    data-iv-panel={iv.id}
                    hidden={iv.id !== initialIntervention}
                  >
                    <span class="xp-micro-label xp-micro-sky">{iv.group}</span>
                    <p class="xp-iv-panel-name">{iv.name}</p>
                    <ul class="xp-tags" role="list">
                      {iv.impacts.map((k) => <li class="xp-tag">{impactLabels[k]}</li>)}
                    </ul>
                    <dl class="xp-iv-rows">
                      <div class="xp-iv-row">
                        <dt class="xp-micro-label xp-micro-gold">How it works</dt>
                        <dd>{iv.mechanism}</dd>
                      </div>
                      <div class="xp-iv-row">
                        <dt class="xp-micro-label xp-micro-gold">Value created</dt>
                        <dd>{iv.value}</dd>
                      </div>
                      <div class="xp-iv-row">
                        <dt class="xp-micro-label xp-micro-gold">What the evidence supports</dt>
                        <dd>{iv.evidence}</dd>
                      </div>
                      <div class="xp-iv-row">
                        <dt class="xp-micro-label xp-micro-gold">Adoption barrier</dt>
                        <dd>{iv.barrier}</dd>
                      </div>
                    </dl>
                  </div>
                ))}
              </div>
            </div>

            <p class="xp-onward-wrap">
              <a class="xp-onward" href={topic.links.whoWeWorkWith.href}>{topic.links.whoWeWorkWith.label}</a>
            </p>
          </section>

          <!-- 05 Incentives — one card of five constraints, each naming the
               constraint as an action beside what blocks the decision and how a
               program relieves it. -->
          <section class="xp-section xp-section-alt" id="adoption" aria-labelledby="adoption-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('adoption')}</span>
              <span class="xp-eyebrow">{topic.adoption.label}</span>
            </div>
            <h2 class="xp-h2" id="adoption-h">{topic.adoption.heading}</h2>
            <p class="xp-lead">{topic.adoption.lead}</p>

            <div class="xp-constraints">
              <span class="xp-micro-label xp-micro-gold">{topic.adoption.constraintEyebrow}</span>
              <h3 class="xp-constraints-title">{topic.adoption.constraintHeading}</h3>
              <p class="xp-constraints-lead">{topic.adoption.constraintLead}</p>
              <div class="xp-constraint-list">
                {topic.adoption.constraints.map((c) => (
                  <div class="xp-constraint-row">
                    <span class="xp-constraint-num" aria-hidden="true">{c.n}</span>
                    <h4 class="xp-constraint-title">{c.title}</h4>
                    <p class="xp-constraint-text">{c.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <!-- 06 Program Fit — the DVF diagram with Strategic Fit as the
               boundary rather than a fourth criterion, then the functional-fit
               question cards in the site's Offerings order. -->
          <section class="xp-section" id="fit" aria-labelledby="fit-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('fit')}</span>
              <span class="xp-eyebrow">{topic.fit.label}</span>
            </div>
            <h2 class="xp-h2" id="fit-h">{topic.fit.heading}</h2>
            <p class="xp-lead">{validationLead}</p>

            <div class="xp-dvf">
              <StrategyFrameworkDVF
                heading="Evaluating an Opportunity"
                eyebrow="Interactive Framework"
                content={dvfContent}
                variant="validation-only"
              />
            </div>

            <div class="xp-questions">
              <h3 class="xp-subhead">Addressing the Functional Fit Questions</h3>
              <div class="xp-question-grid">
                {questionGroups.map((group) => (
                  <article class="card card-static xp-question-card">
                    <h4 class="xp-question-team">{group.team}</h4>
                    <ul class="xp-question-list" role="list">
                      {group.questions.map((q) => <li>{q}</li>)}
                    </ul>
                    <p class="xp-onward-wrap">
                      <a class="xp-onward xp-onward-sm" href={group.capHref}>{group.capName}</a>
                    </p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <!-- 07 Performance — five evidence layers. The claim decides how far
               up the reader has to go; no claim-ladder callouts. -->
          <section class="xp-section xp-section-alt" id="verifying" aria-labelledby="verifying-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('verifying')}</span>
              <span class="xp-eyebrow">{topic.verifying.label}</span>
            </div>
            <h2 class="xp-h2" id="verifying-h">{topic.verifying.heading}</h2>
            <p class="xp-lead">{topic.verifying.lead}</p>

            <div class="xp-layers">
              {topic.verifying.layers.map((layer) => (
                <div class="xp-layer">
                  <span class="xp-layer-num" aria-hidden="true">{layer.n}</span>
                  <span class="xp-layer-id">
                    <h3 class="xp-layer-name">{layer.name}</h3>
                    <span class="xp-layer-question">{layer.question}</span>
                  </span>
                  <span class="xp-layer-examples">{layer.examples}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- 08 Market Access — the production mechanism selector, with the
               topic's own instruments pushed in through its per-mechanism
               slots rather than forking the component. -->
          <section class="xp-section" id="pathways" aria-labelledby="pathways-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('pathways')}</span>
              <span class="xp-eyebrow">{topic.pathways.label}</span>
            </div>
            <h2 class="xp-h2" id="pathways-h">{topic.pathways.heading}</h2>
            <p class="xp-lead">{topic.pathways.lead}</p>

            <MechanismSelector
              mechanisms={mechanisms}
              initialId={initialPathway}
              showDetailHeading
              detailBlocks={detailBlocks}
            />

            <p class="xp-onward-wrap">
              <a class="xp-onward" href={topic.links.markets.href}>{topic.links.markets.label}</a>
            </p>
          </section>

          <!-- 09 Delivery Approach — the same six lifecycle stages the
               homepage Approach band renders, from src/data/lifecycle.ts. No
               Focus band, no Function band. -->
          <section class="xp-section xp-section-alt" id="approach" aria-labelledby="approach-h">
            <div class="xp-head">
              <span class="xp-num" aria-hidden="true">{num('approach')}</span>
              <span class="xp-eyebrow">{topic.approach.label}</span>
            </div>
            <h2 class="xp-h2" id="approach-h">{topic.approach.heading}</h2>
            <p class="xp-lead">{topic.approach.lead}</p>

            <div class="xp-stages" role="tablist" aria-label="Development lifecycle" data-stage-tablist>
              {lifecycle.map((stage) => (
                <button
                  type="button"
                  class="xp-stage"
                  role="tab"
                  id={`stage-tab-${stage.id}`}
                  aria-controls={`stage-panel-${stage.id}`}
                  aria-selected={stage.id === initialStage ? 'true' : 'false'}
                  tabindex={stage.id === initialStage ? '0' : '-1'}
                  data-stage={stage.id}
                >
                  <span class="xp-stage-num">{stage.n}</span>
                  <span class="xp-stage-short">{stage.short}</span>
                </button>
              ))}
            </div>

            <div class="xp-stage-panels">
              {lifecycle.map((stage) => (
                <div
                  class="xp-stage-panel"
                  role="tabpanel"
                  id={`stage-panel-${stage.id}`}
                  aria-labelledby={`stage-tab-${stage.id}`}
                  tabindex="0"
                  data-stage-panel={stage.id}
                  hidden={stage.id !== initialStage}
                >
                  <span class="xp-micro-label xp-micro-gold">Stage {stage.n}</span>
                  <p class="xp-stage-title">{stage.title}</p>
                  <p class="xp-stage-text">{stage.description}</p>
                </div>
              ))}
            </div>

            <p class="xp-onward-wrap">
              <a class="xp-onward" href={topic.links.capabilities.href}>{topic.links.capabilities.label}</a>
            </p>
          </section>

          <!-- 10 Tools & Enablers — the tools in order, no phase rail, no
               per-tool phase tags, no filtering (the tool count stays small
               until several more expertise areas exist). Omitted entirely when
               a topic has no tools yet. -->
          {tools.length > 0 && (
            <section class="xp-section" id="enablers" aria-labelledby="enablers-h">
              <div class="xp-head">
                <span class="xp-num" aria-hidden="true">{num('enablers')}</span>
                <span class="xp-eyebrow">{topic.enablers.label}</span>
              </div>
              <h2 class="xp-h2" id="enablers-h">{topic.enablers.heading}</h2>
              <p class="xp-lead">{topic.enablers.lead}</p>
              <p class="xp-body-lead">{topic.enablers.leadTwo}</p>

              <div class="xp-tools">
                {tools.map((tool) => (
                  <div class="xp-tool">
                    <div class="xp-tool-media">
                      {/* TODO (P3 11): alt text is "<tool name> interface" by
                          decision. Replace with a description of what each
                          screen actually shows, for accessibility and image
                          SEO. */}
                      <img
                        src={tool.src}
                        srcset={tool.srcset}
                        sizes="(max-width: 56rem) 100vw, 26rem"
                        width={tool.width}
                        height={tool.height}
                        alt={`${tool.name} interface`}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="xp-tool-body">
                      <h3 class="xp-tool-name">{tool.name}</h3>
                      <p class="xp-tool-text">{tool.text}</p>
                    </div>
                  </div>
                ))}
              </div>

              <p class="xp-onward-wrap">
                <a class="xp-onward" href={topic.links.digital.href}>{topic.links.digital.label}</a>
              </p>
            </section>
          )}

          <!-- Closing CTA — its own section. Not ClosingCta.astro: that
               component is the centred light-blue banner and has no link row,
               and this is the prototype's maroon band with one. -->
          <section class="xp-cta" aria-labelledby="cta-h">
            <div class="xp-cta-eyebrow">
              <span class="xp-cta-rule" aria-hidden="true"></span>
              <span>Expert guidance for what comes next</span>
            </div>
            <h2 class="xp-cta-heading" id="cta-h">{topic.cta.heading}</h2>
            <p class="xp-cta-text">{topic.cta.text}</p>
            <div class="xp-cta-actions">
              <a class="xp-cta-primary" href="/contact/">Discuss Your Opportunity</a>
              <a class="xp-cta-secondary" href="#investments">Explore Priority Investments</a>
            </div>
            <div class="xp-cta-links">
              <a href={topic.links.expertise.href}>{topic.links.expertise.label}</a>
              <a href={topic.links.whoWeWorkWith.href}>{topic.links.whoWeWorkWith.label}</a>
              <a href={topic.links.capabilities.href}>{topic.links.capabilities.label}</a>
              <a href={topic.links.digital.href}>{topic.links.digital.label}</a>
              <a href={topic.links.caseStudies.href}>{topic.links.caseStudies.label}</a>
            </div>
          </section>

        </div>

        <!-- Section rail. Ported from digital-solutions/index.astro's
             .journey-rail, with the five departures handover section 5.1 calls
             for and says to keep: shown above 56rem via a plain media query
             (no container-type anywhere above it), sticky in this grid gutter
             rather than position: fixed, anchors rather than buttons so it is
             real in-page navigation that works without JS, every label visible
             (inheriting the item's colour — never --color-text-muted, which
             measures 2.56:1 on white at this size), and a geometric scroll
             pick rather than an IntersectionObserver band. -->
        <div class="topic-rail-col">
          <nav class="journey-rail" data-section-rail aria-label="Sections on this page">
            <ol class="journey-rail-list" role="list">
              {sectionRail.map((s) => (
                <li>
                  <a
                    class="journey-rail-item"
                    href={`#${s.id}`}
                    data-rail-item={s.id}
                    aria-current={s.id === 'overview' ? 'true' : 'false'}
                  >
                    <span class="journey-rail-num" aria-hidden="true">{s.n}</span>
                    <span class="journey-rail-label">{s.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  /* ── Shell + section rail ──
     Sticky needs two things here or it silently will not travel:
     1. the rail's grid column must stretch the full row, so the column has
        somewhere to travel within — align-items: stretch plus a full-height
        wrapper around the nav. With align-items: start the column is only as
        tall as the rail itself and there is no range at all.
     2. no ancestor may set overflow: hidden, which would become the sticky
        scrollport and pin it. Nothing in this component, SiteLayout, or
        design-system.css's html/body/main does — keep it that way. */
  .topic-article { background: var(--color-bg); }
  .topic-shell { position: relative; }
  .topic-body { min-width: 0; }
  .topic-rail-col { display: none; }

  @media (min-width: 56rem) {
    .topic-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: var(--space-8);
      align-items: stretch;
    }
    .topic-rail-col { display: block; height: 100%; }
    .journey-rail { position: sticky; top: var(--space-12); }
  }

  .journey-rail-list {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0;
    border-left: 1px solid var(--color-border);
  }
  .journey-rail-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: -1px;
    padding: var(--space-1) var(--space-3);
    border-left: 2px solid transparent;
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .journey-rail-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    flex-shrink: 0;
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }
  /* Inherits the item's colour rather than taking a lighter one of its own:
     at 12px/500 the 4.5:1 contrast floor applies, --color-text-muted measures
     2.56:1 on white and inheriting gives 7.58:1. */
  .journey-rail-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    overflow: hidden;
    max-width: 7.5rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--transition-fast), font-weight var(--transition-fast);
  }
  /* Active state differs on colour, weight and border, so it still reads
     under forced-colors and for colourblind visitors. */
  .journey-rail-item[aria-current='true'] {
    color: var(--color-text);
    border-left-color: var(--color-dark);
  }
  .journey-rail-item[aria-current='true'] .journey-rail-num {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: #fff;
  }
  .journey-rail-item[aria-current='true'] .journey-rail-label {
    font-weight: var(--font-semibold);
  }
  .journey-rail-item:hover { color: var(--color-text); }
  .journey-rail-item:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* ── Section shell ── */
  .xp-section {
    padding: var(--space-12) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    /* The site header is sticky and 70px tall, so an anchor jump from the
       rail would otherwise land with the section's number/eyebrow row hidden
       behind it. Same idiom as CaseStudyArticle.astro's anchored headings. */
    scroll-margin-top: var(--space-16);
  }
  @media (min-width: 48rem) {
    .xp-section { padding-inline: var(--space-8); }
  }
  .xp-section-alt { background: var(--color-surface); }
  .xp-section-navy { background: var(--color-dark); border-bottom: 0; }

  .xp-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
