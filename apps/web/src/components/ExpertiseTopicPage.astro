  /* ── Closing CTA ── */
  .xp-cta { background: var(--c-primary-600); padding: var(--space-12) var(--space-6); }
  @media (min-width: 48rem) {
    .xp-cta { padding-inline: var(--space-8); }
  }
  .xp-cta-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent-400);
  }
  .xp-cta-rule { display: block; width: 1.5rem; height: 2px; background: var(--c-accent-400); }
  .xp-cta-heading {
    color: #fff;
    font-size: var(--text-4xl);
    line-height: var(--line-tight);
    margin: var(--space-4) 0 0;
    max-width: 28ch;
    text-wrap: pretty;
  }
  .xp-cta-text {
    margin: var(--space-5) 0 0;
    max-width: 44rem;
    font-size: var(--text-lg);
    line-height: var(--line-relaxed);
    color: #f3dfe3;
    text-wrap: pretty;
  }
  .xp-cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .xp-cta-primary,
  .xp-cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }
  .xp-cta-primary { background: #fff; color: var(--c-primary-600); }
  .xp-cta-primary:hover { background: #f3dfe3; }
  .xp-cta-secondary { border: 1.5px solid rgba(255, 255, 255, 0.5); color: #fff; }
  .xp-cta-secondary:hover { border-color: #fff; }
  .xp-cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }
  .xp-cta-links a {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: #f3dfe3;
    text-decoration: none;
  }
  .xp-cta-links a:hover { color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .journey-rail-item,
    .journey-rail-num,
    .journey-rail-label,
    .xp-chevron { transition: none; }
  }
</style>

<script>
  // Three interactions plus the section rail. The pathway selector in section
  // 08 is MechanismSelector's own script and is untouched here.
  //
  // Tab lists implement the full model — roving tabindex, arrow/Home/End keys,
  // real tabpanels — the same pattern the homepage's Approach rail and Who We
  // Work With tabs use. Declaring role="tab" without the behaviour is worse
  // than no ARIA at all.

  /** Wires one roving-tabindex tablist. `isEnabled` lets the caller exclude
   * tabs that are currently filtered out. */
  function wireTabs(
    tabs: HTMLElement[],
    onSelect: (id: string) => void,
    idOf: (el: HTMLElement) => string,
    isEnabled: (el: HTMLElement) => boolean = () => true,
  ) {
    const focusTab = (el: HTMLElement) => {
      onSelect(idOf(el));
      el.focus();
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => onSelect(idOf(tab)));
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
        const usable = tabs.filter(isEnabled);
        if (!usable.length) return;
        e.preventDefault();
        const i = usable.indexOf(tab);
        let next = i;
        if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = usable.length - 1;
        else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % usable.length;
        else next = (i - 1 + usable.length) % usable.length;
        focusTab(usable[next]);
      });
    });
  }

  // ── Section 04: indicator filter + intervention tabs ──
  const ivTablist = document.querySelector<HTMLElement>('[data-iv-tablist]');
  if (ivTablist) {
    const ivTabs = Array.from(ivTablist.querySelectorAll<HTMLElement>('[data-iv]'));
    const ivPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-iv-panel]'));
    const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-impact]'));
    const countEl = document.querySelector<HTMLElement>('[data-iv-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-iv-empty]');
    let impact = 'all';

    const matches = (tab: HTMLElement) =>
      impact === 'all' || (tab.dataset.impacts ?? '').split(' ').includes(impact);

    const select = (id: string, reveal = false) => {
      ivTabs.forEach((tab) => {
        const on = tab.dataset.iv === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.setAttribute('tabindex', on ? '0' : '-1');
      });
      ivPanels.forEach((panel) => {
        panel.hidden = panel.dataset.ivPanel !== id;
      });
      // Below 60rem the panel sits under the whole list, so choosing an
      // intervention on a phone otherwise looks like it did nothing. Only
      // when the panel is actually off-screen, and never on a filter change
      // the reader did not initiate from the list.
      if (!reveal) return;
      const panel = ivPanels.find((p) => p.dataset.ivPanel === id);
      if (!panel) return;
      const box = panel.getBoundingClientRect();
      if (box.top >= 0 && box.top < window.innerHeight) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      panel.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
    };

    const applyFilter = () => {
      const visible = ivTabs.filter(matches);
      ivTabs.forEach((tab) => {
        tab.hidden = !matches(tab);
      });
      if (countEl) {
        countEl.textContent = `${visible.length} ${visible.length === 1 ? 'intervention' : 'interventions'}`;
      }
      if (emptyEl) emptyEl.hidden = visible.length > 0;
      // The detail panel follows the first still-visible item rather than
      // stranding a selection the reader can no longer see.
      const selected = ivTabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (visible.length === 0) {
        ivPanels.forEach((panel) => { panel.hidden = true; });
      } else if (!selected || !matches(selected)) {
        select(visible[0].dataset.iv ?? '');
      }
    };

    wireTabs(ivTabs, (id) => select(id, true), (el) => el.dataset.iv ?? '', matches);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        impact = chip.dataset.impact ?? 'all';
        chips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
        applyFilter();
      });
    });
  }

  // ── Section 09: lifecycle stage tabs ──
  const stageTablist = document.querySelector<HTMLElement>('[data-stage-tablist]');
  if (stageTablist) {
    const stageTabs = Array.from(stageTablist.querySelectorAll<HTMLElement>('[data-stage]'));
    const stagePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const selectStage = (id: string) => {
      stageTabs.forEach((tab) => {
        const on = tab.dataset.stage === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.setAttribute('tabindex', on ? '0' : '-1');
      });
      stagePanels.forEach((panel) => {
        panel.hidden = panel.dataset.stagePanel !== id;
      });
    };
    wireTabs(stageTabs, selectStage, (el) => el.dataset.stage ?? '');
  }

  // ── Section rail ──
  // A rAF-throttled scroll read takes the last section whose top has passed
  // the viewport midpoint. A thin IntersectionObserver band batches unreliably
  // when sections are several viewports tall, which these are. The listener is
  // capture-phase on document so it works whether the window or a container is
  // the thing that scrolls.
  const rail = document.querySelector<HTMLElement>('[data-section-rail]');
  if (rail) {
    const items = Array.from(rail.querySelectorAll<HTMLElement>('[data-rail-item]'));
    const sections = items
      .map((item) => document.getElementById(item.dataset.railItem ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    let frame = 0;
    const pick = () => {
      frame = 0;
      if (!sections.length) return;
      const mid = window.innerHeight / 2;
      let active = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= mid) active = section;
        else break;
      }
      items.forEach((item) => {
        item.setAttribute('aria-current', item.dataset.railItem === active.id ? 'true' : 'false');
      });
    };
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(pick);
    };
    document.addEventListener('scroll', onScroll, { passive: true, capture: true });
    window.addEventListener('resize', onScroll, { passive: true });
    pick();
  }
</script>
