  .xp-indicator { border-top: 1px solid rgba(255, 255, 255, 0.16); }
  .xp-indicator:first-child { border-top: 0; }
  /* summary needs both of these or the default marker shows through. */
  .xp-indicator-summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: rgba(255, 255, 255, 0.03);
