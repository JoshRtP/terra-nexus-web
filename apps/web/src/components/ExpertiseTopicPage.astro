  /* ── 08 Market Access ── */
  .xp-section :global(.mech-diagram) { margin-top: var(--space-8); }
  .xp-section :global(.mech-examples .xp-dash-list) { margin-top: 0; }

  /* ── 09 Delivery Approach ── */
  .xp-stages { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-8); }
  .xp-stage {
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-secondary);
    transition: background var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }
  .xp-stage:hover { border-color: var(--c-sky-400); background: var(--c-sky-50); }
  .xp-stage:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .xp-stage[aria-selected='true'] { background: var(--color-dark); border-color: var(--color-dark); color: #fff; }
  .xp-stage-num { display: block; font-family: var(--font-serif); font-style: italic; font-size: var(--text-xs); }
  .xp-stage-short { display: block; font-size: var(--text-sm); font-weight: var(--font-semibold); margin-top: 2px; }

  .xp-stage-panels { margin-top: var(--space-5); }
  .xp-stage-panel { background: var(--color-dark); border-radius: var(--radius-lg); padding: var(--space-6); }
  .xp-stage-panel[hidden] { display: none; }
  .xp-stage-title {
    color: #fff;
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    line-height: var(--line-snug);
    margin: var(--space-2) 0 0;
    text-wrap: pretty;
  }
  .xp-stage-text {
    margin: var(--space-3) 0 0;
    max-width: 52rem;
    font-size: var(--text-base);
    line-height: var(--line-relaxed);
    color: #d7deef;
    text-wrap: pretty;
  }

  /* ── 10 Tools & Enablers ── */
  .xp-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .xp-tool {
    min-width: 0;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
