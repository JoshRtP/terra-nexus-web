  }
  .xp-chip:hover { border-color: var(--c-sky-400); background: var(--c-sky-50); }
  .xp-chip:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .xp-chip[aria-pressed='true'] { background: var(--color-dark); border-color: var(--color-dark); color: #fff; }

  .xp-iv-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
    align-items: start;
  }
  @media (min-width: 60rem) {
