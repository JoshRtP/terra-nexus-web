  .xp-indicator-summary::-webkit-details-marker { display: none; }
  .xp-indicator-summary:hover { background: rgba(255, 255, 255, 0.07); }
  .xp-indicator-summary:focus-visible { outline: 2px solid var(--c-accent-400); outline-offset: -2px; }
  .xp-indicator-name {
