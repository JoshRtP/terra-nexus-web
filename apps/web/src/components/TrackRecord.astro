---
// "Our Track Record" section — homepage. Promoted from the design lab
// (branch design/track-record-options, 2026-09-14; owner pick V4 after six
// review rounds; the lab's round-by-round captures are in artifacts/qa/
// track-record-option-*.png).
//
// Layout: the section's split header, then a two-column grid on the
// header's own column template so the left block sits under the heading
// and the ledger under the lead paragraph. Left: one stacked block — the
// headline value in the navy panel the homepage already uses for How We
// Work and Who We Work With, a light lever band, a closing navy band.
// Right: a flat ledger of seven figures with a maroon line icon each.
//
// Alignment (owner asks, measured at 1440, 0px): block top on the ledger's
// first rule, block bottom on its last — the grid row stretches both
// columns and the ledger rows share the slack; the lead paragraph's cap
// tops level with the heading's (2px nudge; the boxes were already flush).
//
// Type comes from the shared stat primitives (.stat-value/.stat-label in
// design-system.css); this file only sets sizes and the layout.
import {
  trackRecordHeadline as headline,
  trackRecordStats as stats,
  trackRecordLevers as levers,
  trackRecordBand as band,
} from '../data/track-record';
import { trackRecordIcons as icons } from '../data/track-record-icons';

interface Props {
  headingId?: string;
}
const { headingId = 'track-record-heading' } = Astro.props;

const arrows = {
  up: '<path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/>',
  down: '<path d="M12 5v14M5.5 12.5 12 19l6.5-6.5"/>',
};
---

<section class="section section-alt track-record" aria-labelledby={headingId}>
  <div class="container">
    <header class="section-header split-header">
      <span class="eyebrow split-header-eyebrow">Our Track Record</span>
      <div class="split-header-title">
        <h2 id={headingId}>Proven Portfolio of Successful Impact</h2>
      </div>
      <div class="split-header-lead">
        <p class="section-lead">There is absolutely no legitimate reason that creating a better planet should be so damn complicated, especially when it means the world to so many.</p>
      </div>
    </header>

    <div class="tr-grid" data-track-record>
      <div class="tr-stack">
        <div class="tr-stack-value">
          <p class="stat-value tr-num tr-num-hero" data-count={headline.count} data-prefix={headline.prefix} data-suffix={headline.suffix} data-decimals={headline.decimals}>{headline.value}</p>
          <p class="stat-label tr-label tr-label-hero">{headline.label}</p>
        </div>
        <div class="tr-stack-levers">
          {(['up', 'down'] as const).map((dir) => (
            <div class={`tr-lever tr-lever-${dir}`}>
              <p class="tr-lever-label">
                <span class="tr-lever-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" set:html={arrows[dir]} />
                </span>
                <span>{levers[dir].label}</span>
              </p>
              <ul class="tr-lever-list" role="list">
                {levers[dir].items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="tr-stack-band">
          {band.map((word, i) => (
            <Fragment>
              {i > 0 && <span class="tr-stack-band-dot" aria-hidden="true">·</span>}
              <span>{word}</span>
            </Fragment>
          ))}
        </p>
      </div>

      <div class="tr-ledger">
        {stats.map((s) => (
          <div class="tr-row">
            <span class="tr-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            </span>
            <p class="stat-value tr-num tr-num-row" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
            <p class="stat-label tr-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="section-cta">
      <a href="/about/" class="btn btn-primary">Learn More About Us</a>
    </div>
  </div>
</section>

<style>
  /* Header: the heading (30px, tight leading) and the lead (18px, relaxed
     leading) share a box top, but their cap tops differ by ~2px because of
     the leading. Nudge the lead so the caps align. */
  .track-record .split-header-lead .section-lead { margin-top: -2px; }

  .tr-num { font-variant-numeric: lining-nums tabular-nums; }
  .tr-label { margin: 0; font-size: var(--text-base); line-height: var(--line-relaxed); color: var(--color-text-secondary); }

  /* Same column template as .split-header, so the block sits under the
     heading and the ledger under the lead. `stretch` + flexible ledger rows
     keep the block's top and bottom edges on the ledger's first and last
     rules whatever the content height. */
  .tr-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) 1fr;
    column-gap: var(--space-10);
    row-gap: var(--space-8);
    align-items: stretch;
  }

  /* ── Left: the stacked block ──────────────────────────────────────── */
  .tr-stack {
    display: flex; flex-direction: column;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-2xl);
  }
  /* Same recipe as the homepage's .approach-card. */
  .tr-stack-value {
    position: relative;
    padding: var(--space-8);
    background: var(--gradient-dark);
  }
  .tr-stack-value::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 65% at 100% 100%, rgba(168, 208, 219, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }
  .tr-stack-value > * { position: relative; z-index: 1; }
  .tr-num-hero { font-size: clamp(3.75rem, 6.2vw, 5.5rem); letter-spacing: -0.03em; color: var(--c-accent-400); }
  .tr-label-hero { margin-top: var(--space-4); font-size: var(--text-lg); max-width: 20rem; color: var(--c-sky-300); }

  .tr-stack-levers {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-surface-elevated);
    border-inline: 1px solid var(--color-border);
  }
  .tr-lever { padding: var(--space-5) var(--space-5) var(--space-6); }
  .tr-lever + .tr-lever { border-inline-start: 1px solid var(--color-border); }
  .tr-lever-label {
    display: inline-flex; align-items: center; gap: var(--space-3);
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-dark);
  }
  /* Square badges in brand colours: up in sky, down in maroon (the palette
     has no green). */
  .tr-lever-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem;
    border-radius: var(--radius-xs);
    color: var(--color-text-inverse);
  }
  .tr-lever-up .tr-lever-badge { background: var(--c-sky-600); }
  .tr-lever-down .tr-lever-badge { background: var(--color-accent); }
  .tr-lever-list { margin: 0; padding: 0 0 0 calc(1.5rem + var(--space-3)); list-style: none; }
  .tr-lever-list li { font-size: var(--text-base); line-height: var(--line-relaxed); color: var(--color-text); }

  /* One line at 1440 and 390; wraps centred below ~380px. */
  .tr-stack-band {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) var(--space-3);
    background: var(--color-dark);
    border-top: 2px solid var(--c-accent-400);
    font-size: var(--text-xs); font-weight: var(--font-bold); letter-spacing: 0.12em; text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-inverse);
  }
  .tr-stack-band-dot { color: var(--c-accent-400); }

  /* ── Right: the ledger ────────────────────────────────────────────── */
  .tr-ledger { display: flex; flex-direction: column; }
  .tr-row {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--c-secondary-300);
  }
  .tr-row:last-child { border-bottom: 1px solid var(--c-secondary-300); }
  .tr-icon {
    flex: 0 0 auto;
    display: inline-flex; align-items: center;
    width: 2rem;
    color: var(--color-accent);
  }
  .tr-num-row { flex: 0 0 auto; min-width: 6.4ch; font-size: clamp(1.875rem, 2.2vw, 2.25rem); }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 56rem) {
    /* Stacked: nothing to align with, so no stretching. */
    .tr-grid { grid-template-columns: 1fr; align-items: start; }
    .tr-row { flex: none; }
    .tr-num-hero { font-size: clamp(3.5rem, 12vw, 4.5rem); }
  }
  @media (max-width: 34rem) {
    .tr-row { gap: var(--space-4); }
    .tr-icon { width: 1.5rem; }
    .tr-icon svg { width: 20px; height: 20px; }
    .tr-lever { padding: var(--space-4); }
    .tr-stack-band { letter-spacing: 0.08em; }
  }
</style>

<script>
  // Count-up: the About page's easing (1-(1-t)^3), triggered once by an
  // IntersectionObserver on the grid; decimals for $2.65B, thousands
  // separators for 2,000+, duration capped at 1.8s. Skipped under reduced
  // motion — the SSR text stays.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number, decimals: number) =>
    n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  const run = (group: HTMLElement) => {
    group.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count || 0);
      const decimals = Number(el.dataset.decimals || 0);
      const pre = el.dataset.prefix || '';
      const suf = el.dataset.suffix || '';
      const duration = Math.min(1800, 1200 + target * 10);
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = pre + fmt(target * eased, decimals) + suf;
        if (k < 1) requestAnimationFrame(step);
      };
      el.textContent = pre + fmt(0, decimals) + suf;
      requestAnimationFrame(step);
    });
  };
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-track-record]'));
  if (!reduce && 'IntersectionObserver' in window && groups.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } });
    }, { threshold: 0.35 });
    groups.forEach((g) => io.observe(g));
  }
</script>
