---
// ProfileRoster — expanding profile roster (About team-trial, Option A).
//
// Interaction principle borrowed from ogilvy.com/team (NOT its branding,
// layout, assets, or code): a closed horizontal row of portrait tiles;
// selecting one collapses the row down to that single portrait on the
// left, with a large biography panel opening to its right; a close
// control restores the closed roster. This is a composition/interaction
// reference only — visuals here are Terra Nexus tokens throughout.
//
// Page-local (not promoted to the shared design-system vocabulary) —
// exactly one consumer (about/index.astro) exists today. Promote only if
// a second page genuinely needs "a group of expanding profile tiles."
//
// Reuses existing M7 primitives: .tag, focus-ring/token colors, spacing
// scale, .eyebrow-style caption treatment. Portrait/bio layout is new —
// no existing primitive covers "editorial headshot tile + adjacent large
// bio panel."
export interface Props {
  heading: string;
  members: Array<{
    id: string;
    name: string;
    role: string;
    initials: string;
    variant?: 'person' | 'network';
    // Optional headshot — path under public/ (e.g. "/images/team/josh-mellinger/photo.jpg").
    // Renders as a cover image over the initials tile; the initials stay in
    // the DOM underneath as a no-JS/broken-image fallback (see the inline
    // onerror handler below — this is the one sanctioned inline-script use,
    // matching the "graceful img fallback" pattern, not a new mechanism).
    photo?: string;
    // A real bio reads better as a couple of short paragraphs than one
    // wall of text — pass an array for that; a single string still works
    // for the "coming soon" placeholders and renders as one <p>.
    bio: string | string[];
    tags?: Array<{ label: string; href: string }>;
    tagsCaption?: string;
    showLinkedIn?: boolean;
    // Real profile URL — when set, renders as an actual link instead of
    // the grayed-out "coming soon" placeholder. showLinkedIn:false still
    // wins (hides it entirely) regardless of this.
    linkedin?: string;
  }>;
}

const { heading, members } = Astro.props;
---

<div class="roster" data-roster>
  <h4 class="roster-heading">{heading}</h4>

  <div class="roster-row" data-roster-row role="list">
    {members.map((member) => (
      <div class="roster-tile-wrap" role="listitem">
        <button
          type="button"
          class="roster-tile"
          id={`roster-tile-${member.id}`}
          aria-expanded="false"
          aria-controls={`roster-panel-${member.id}`}
          data-roster-tile
          data-target={`roster-panel-${member.id}`}
        >
          <span
            class={`roster-portrait roster-portrait-${member.variant ?? 'person'}`}
            data-has-photo={member.photo ? 'true' : undefined}
            aria-hidden="true"
          >
            {member.variant === 'network' ? (
              <svg class="roster-fallback-icon" viewBox="0 0 48 48" width="26" height="26" aria-hidden="true">
                <circle cx="24" cy="10" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                <circle cx="10" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                <circle cx="38" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M24 14 L12 30 M24 14 L36 30 M14 34 L34 34" stroke="currentColor" stroke-width="1.5" fill="none" />
              </svg>
            ) : (
              <span class="roster-initials roster-fallback-icon">{member.initials}</span>
            )}
            {member.photo && (
              <img
                class="roster-photo"
                src={member.photo}
                alt=""
                loading="lazy"
                onerror="this.style.display='none'; this.parentElement?.removeAttribute('data-has-photo')"
              />
            )}
          </span>
          <span class="roster-tile-meta">
            <span class="roster-tile-name">{member.name}</span>
            {member.role && <span class="roster-tile-role">{member.role}</span>}
          </span>
        </button>
        {/* Hover-revealed icon badge on the closed tile itself — owner
            reference, 2026-09-07 (terra.nexus homepage team photos). A
            sibling of the trigger button, not nested inside it: an <a>
            inside a <button> is invalid HTML/inaccessible, so this sits
            layered on top via position:absolute on the shared wrapper
            instead. Only LinkedIn goes here per owner direction — any
            other links (email, etc.) belong inside the opened bio, not on
            the closed tile. */}
        {member.linkedin && member.showLinkedIn !== false && (
          <a
            class="roster-tile-linkedin"
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${member.name} on LinkedIn`}
            title="LinkedIn"
          >
            <svg viewBox="0 0 448 512" width="14" height="14" aria-hidden="true">
              <path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
            </svg>
          </a>
        )}
      </div>
    ))}
  </div>

  {members.map((member) => (
    <div
      class="roster-expanded"
      data-roster-expanded
      id={`roster-panel-${member.id}`}
      aria-labelledby={`roster-tile-${member.id}`}
      hidden
    >
      <button
        type="button"
        class={`roster-expanded-portrait roster-portrait-${member.variant ?? 'person'}`}
        data-has-photo={member.photo ? 'true' : undefined}
        data-roster-portrait-close
        aria-label={`Close ${member.name}`}
      >
        {member.variant === 'network' ? (
          <svg class="roster-fallback-icon" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true">
            <circle cx="24" cy="10" r="4" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="10" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="38" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M24 14 L12 30 M24 14 L36 30 M14 34 L34 34" stroke="currentColor" stroke-width="1.5" fill="none" />
          </svg>
        ) : (
          <span class="roster-initials roster-fallback-icon">{member.initials}</span>
        )}
        {member.photo && (
          <img
            class="roster-photo"
            src={member.photo}
            alt=""
            loading="lazy"
            onerror="this.style.display='none'; this.parentElement?.removeAttribute('data-has-photo')"
          />
        )}
      </button>
      <div class="roster-bio">
        <button type="button" class="roster-close" data-roster-close aria-label={`Close ${member.name}`}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
        <p class="roster-bio-eyebrow">{heading}</p>
        <h5 class="roster-bio-name">{member.name}</h5>
        {member.role && <p class="roster-bio-role">{member.role}</p>}
        <div class="roster-bio-body">
          {(Array.isArray(member.bio) ? member.bio : [member.bio]).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {member.tags && member.tags.length > 0 && (
          <div class="roster-bio-tags">
            {member.tagsCaption && <p class="roster-bio-tags-caption">{member.tagsCaption}</p>}
            <ul class="exec-tags" role="list">
              {member.tags.map((tag) => (
                <li><a href={tag.href} class="tag">{tag.label}</a></li>
              ))}
            </ul>
          </div>
        )}
        <div class="roster-bio-links">
          {member.showLinkedIn !== false && (
            member.linkedin ? (
              <a class="exec-icon-link" href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`} title="LinkedIn">
                <svg viewBox="0 0 448 512" width="16" height="16" aria-hidden="true">
                  <path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
                </svg>
              </a>
            ) : (
              <span class="exec-icon-link is-placeholder" title="LinkedIn — link coming soon" aria-label="LinkedIn — link coming soon">
                <svg viewBox="0 0 448 512" width="16" height="16" aria-hidden="true">
                  <path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
                </svg>
              </span>
            )
          )}
          <a class="exec-social-link" href="/contact/">Contact</a>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .roster { margin-top: var(--space-10); }
  .roster:first-of-type { margin-top: var(--space-2); }
  .roster-heading {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }

  /* Closed state — horizontal row of editorial portrait tiles. */
  .roster-row { display: flex; flex-wrap: wrap; gap: var(--space-6); }
  .roster-tile-wrap {
    position: relative;
    /* Sized up from an earlier 12rem — no roster row here carries more than
       two tiles, so there's room for a larger, more editorial portrait
       (owner request, 2026-09-07) without ever forcing a wrap. */
    width: 18rem;
  }
  .roster-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    border-radius: var(--radius-lg);
  }
  .roster-tile:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .roster-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
    overflow: hidden;
    transition: box-shadow var(--transition-fast);
  }
  /* Hover/focus source is the wrap, not just the button — the LinkedIn
     badge below is a sibling overlay, and moving the pointer onto it
     shouldn't drop the "hovered" look (it visually sits on the same
     portrait, so it should read as still hovering the tile). */
  .roster-tile-wrap:hover .roster-portrait,
  .roster-tile-wrap:focus-within .roster-portrait { box-shadow: var(--shadow-md); }

  /* LinkedIn badge — hover-revealed icon in the portrait's top-right
     corner (owner reference, 2026-09-07: terra.nexus homepage team
     photos). Only rendered when a real linkedin URL exists. Hidden-until-
     hover is scoped to devices with real hover; touch devices have no
     hover gesture to reveal it with, so there it just stays visible
     (a hidden, unreachable link would otherwise be a mobile dead end). */
  .roster-tile-linkedin {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text);
  }
  .roster-tile-linkedin:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  @media (hover: hover) and (pointer: fine) {
    .roster-tile-linkedin {
      opacity: 0;
      transform: translateY(-0.25rem);
      transition: opacity var(--transition-fast), transform var(--transition-fast);
      pointer-events: none;
    }
    .roster-tile-wrap:hover .roster-tile-linkedin,
    .roster-tile-wrap:focus-within .roster-tile-linkedin,
    .roster-tile-linkedin:focus-visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  .roster-portrait-person {
    background: var(--gradient-dark);
    color: var(--c-accent-400);
  }
  .roster-portrait-person .roster-initials {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
  }
  /* Network variant now carries the real Expert Network mark (a
     transparent gold PNG designed for a dark ground — owner-supplied
     asset, 2026-09-07) — same dark gradient as the person tiles rather
     than the earlier light surface-alt + dashed "placeholder" treatment,
     which read wrong once this stopped being a schematic stand-in. */
  .roster-portrait-network {
    background: var(--gradient-dark);
    color: var(--c-accent-400);
  }

  .roster-tile-name { display: block; font-family: var(--font-serif); font-size: var(--text-base); color: var(--color-text); }
  .roster-tile-role { display: block; font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-1); }

  /* Expanded state — selected portrait (left) + large bio panel (right).
     Portrait column is a fixed 18rem — same box size as the closed
     .roster-tile — rather than growing to fill the column (owner
     request, 2026-09-07): the photo shouldn't get visibly larger/softer
     just because it's selected. */
  .roster-expanded {
    display: grid;
    grid-template-columns: 18rem 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  .roster-expanded-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* Now an interactive control (click to close/collapse), not a
       decorative div — reset button chrome so it keeps reading as a
       plain portrait. */
    padding: 0;
    border: none;
    cursor: pointer;
    transition: box-shadow var(--transition-fast);
  }
  .roster-expanded-portrait:hover,
  .roster-expanded-portrait:focus-visible { box-shadow: var(--shadow-md); }
  .roster-expanded-portrait:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .roster-expanded-portrait.roster-portrait-person .roster-initials { font-family: var(--font-serif); font-size: var(--text-4xl); }

  /* Photo layers over the initials/icon fallback; onerror hides the img
     AND clears data-has-photo so the fallback becomes visible again. While
     a photo is present, the fallback stays hidden outright (not just
     covered) — with object-fit: cover this never mattered since the photo
     always fully occluded it, but the network mark below uses
     object-fit: contain, which can otherwise let the fallback icon show
     through the letterboxed padding around a non-cover image. */
  [data-has-photo] .roster-fallback-icon { display: none; }

  .roster-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Network variant's "photo" is a wordmark/logo, not a headshot — contain
     instead of cover so it never gets cropped to fit the 3:4 box, and pad
     it off the edges so it reads as a mark sitting on the tile rather than
     stretched to fill it. */
  .roster-portrait-network .roster-photo {
    object-fit: contain;
    padding: var(--space-4);
  }

  /* Grayscale → color reveal on hover/focus — matches the existing
     terra.nexus homepage team-photo treatment (owner reference,
     2026-09-07). Only the closed-row tile gets the grayscale default; the
     expanded/selected portrait renders in full color, since opening a
     profile is itself the "selected" state the hover reveals toward. */
  .roster-tile .roster-photo {
    filter: grayscale(100%);
    transition: filter var(--transition-base);
  }
  .roster-tile:hover .roster-photo,
  .roster-tile:focus-visible .roster-photo {
    filter: grayscale(0%);
  }

  .roster-bio {
    position: relative;
    min-width: 0;
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .roster-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .roster-close:hover { background: var(--color-surface-alt); color: var(--color-text); }
  .roster-close:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .roster-bio-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-eyebrow);
    margin-bottom: var(--space-2);
    padding-right: var(--space-8);
  }
  .roster-bio-name { font-family: var(--font-serif); font-size: var(--text-2xl); margin-bottom: var(--space-1); }
  .roster-bio-role { font-size: var(--text-sm); color: var(--color-text-secondary); }
  .roster-bio-body { margin-top: var(--space-5); max-width: 52ch; }
  .roster-bio-body p { color: var(--color-text-secondary); line-height: var(--line-relaxed); }
  .roster-bio-body p + p { margin-top: var(--space-3); }
  .roster-bio-tags { margin-top: var(--space-5); }
  .roster-bio-tags-caption { font-size: var(--text-xs); color: var(--color-text-muted); font-style: italic; margin-bottom: var(--space-2); }
  .exec-tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .roster-bio-links { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-6); }
  .exec-social-link { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-link); text-decoration: none; }
  .exec-social-link:hover { color: var(--color-link-hover); }
  .exec-social-link.is-placeholder { color: var(--color-text-muted); cursor: not-allowed; }

  /* Icon-badge link (LinkedIn inside the opened bio) — same small circular
     treatment as the closed-tile badge above, rather than a plain text
     link (owner request, 2026-09-07: use the actual LinkedIn mark). */
  .exec-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-alt);
    color: var(--color-link);
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .exec-icon-link:hover { background: var(--color-border); color: var(--color-link-hover); }
  .exec-icon-link:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .exec-icon-link.is-placeholder { color: var(--color-text-muted); cursor: not-allowed; }
  .exec-icon-link.is-placeholder:hover { background: var(--color-surface-alt); color: var(--color-text-muted); }

  @media (max-width: 40rem) {
    .roster-tile-wrap { width: 13rem; }
    .roster-expanded { grid-template-columns: 1fr; }
    .roster-expanded-portrait { max-width: 13rem; }
    .roster-bio { padding: var(--space-6); }
  }
</style>

<script>
  // ProfileRoster interaction (shared across every roster instance on the
  // page). Progressive enhancement: SSR renders the roster row AND every
  // bio panel visible/stacked (fully readable without JS); this script
  // hides the bio panels on load and wires up select/close. No animation
  // library; hover/focus transitions already covered by
  // design-system.css's global reduced-motion override.
  document.querySelectorAll<HTMLElement>('[data-roster]').forEach((roster) => {
    const row = roster.querySelector<HTMLElement>('[data-roster-row]');
    const tiles = Array.from(roster.querySelectorAll<HTMLButtonElement>('[data-roster-tile]'));
    const panels = Array.from(roster.querySelectorAll<HTMLElement>('[data-roster-expanded]'));

    const closeAll = (focusTileId?: string | null) => {
      panels.forEach((panel) => { panel.hidden = true; });
      tiles.forEach((tile) => tile.setAttribute('aria-expanded', 'false'));
      if (row) row.hidden = false;
      if (focusTileId) document.getElementById(focusTileId)?.focus();
    };

    const openMember = (tile: HTMLButtonElement) => {
      const targetId = tile.getAttribute('data-target');
      const panel = targetId ? document.getElementById(targetId) : null;
      if (!panel) return;
      panels.forEach((p) => { p.hidden = p !== panel; });
      tiles.forEach((t) => t.setAttribute('aria-expanded', String(t === tile)));
      if (row) row.hidden = true;
      panel.querySelector<HTMLButtonElement>('[data-roster-close]')?.focus();
    };

    // Start closed (JS-enhanced roster look); no-JS visitors keep the
    // SSR-default fully visible/stacked state.
    closeAll();

    tiles.forEach((tile) => {
      tile.addEventListener('click', () => openMember(tile));
    });
    panels.forEach((panel) => {
      panel.querySelector<HTMLButtonElement>('[data-roster-close]')?.addEventListener('click', () => {
        closeAll(panel.getAttribute('aria-labelledby'));
      });
      // Click/tap the now-selected portrait itself to collapse back —
      // same close behavior as the X button, just re-using the picture as
      // the trigger (owner request, 2026-09-07).
      panel.querySelector<HTMLButtonElement>('[data-roster-portrait-close]')?.addEventListener('click', () => {
        closeAll(panel.getAttribute('aria-labelledby'));
      });
      panel.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Escape') closeAll(panel.getAttribute('aria-labelledby'));
      });
    });
  });
</script>
