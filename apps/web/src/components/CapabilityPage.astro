---
// One template for the five capability family pages, rendering from
// src/data/capabilities/<slug>.ts, the way ExpertiseTopicPage.astro renders
// the nine expertise topics from src/data/expertise/.
//
// Rebuilt 2026-09-13 (Phase 2 of plans/capabilities-consolidation-plan.md)
// onto the site's current vocabulary: .split-header section headers,
// .card-entry rows, .disclosure accordions for the sub-offering taxonomy
// (three families carry 28–34 named sub-offerings; the previous always-open
// three-column grid was the largest single block on the site), and
// ClosingCta with the onward links every expertise topic closes with.
//
// Extended the same day with the sections the site's own service-page
// template (knowledge/website/page-templates/service-page.md) requires and
// the pages had never rendered: the family's core question, decision owners
// and scope boundary (all five families, from their stable overview
// records), and per-offering detail where an approved offering record
// exists (Carbon & Ecosystem Services' seven, owner-approved 2026-09-13).
// Audiences the work matters to are inverted from /who-we-work-with/'s own
// capability lists, so all three families of pages now link both ways.
//
// Carbon & Ecosystem Services, previously a bespoke page with 57 local `cs-`
// classes, renders through this template too. Its extra sections
// (mechanism selector, lifecycle notes, comparison band) render only when
// the record carries them, in the order the owner settled on 2026-08-19:
// hero → mechanisms → lifecycle → offerings → comparison → CTA.
//
// Section ids are stable (`overview`, `decisions`, `mechanisms`,
// `lifecycle`, `offerings`, `expertise`, `proof`); the mega-menu deep-links
// to `#mechanisms` and to the selector's own `#m01`–`#m04`. Sections
// alternate white and tinted by their rendered position, so the rhythm
// holds whichever optional sections a family carries.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from './PageHero.astro';
import ClosingCta from './ClosingCta.astro';
import MechanismSelector from './MechanismSelector.astro';
import { getBuildMode } from '../lib/build-mode.js';
import { stages } from '../data/lifecycle';
import { marketMechanisms } from '../data/market-mechanisms';
import { segmentsForCapability } from '../data/who-we-work-with';
import { expertiseForCapability, offeringAnchor, type CapabilityFamily } from '../data/capabilities';
import { service } from '../lib/structured-data';

interface Props {
  /** One of the five records in src/data/capabilities/. */
  family: CapabilityFamily;
}

const { family } = Astro.props;
const mode = getBuildMode();

// Derived from the expertise topics' own team-to-capability mapping and the
// audience segments' own capability lists, not from per-page lists.
const relatedExpertise = expertiseForCapability[family.slug] ?? [];
const audiences = segmentsForCapability[family.slug] ?? [];

// The six stages from lifecycle.ts, each with this family's note under it.
// Empty unless the record carries a lifecycle section.
const lifecycle = family.lifecycle
  ? stages.map((stage) => {
      const note = family.lifecycle!.notes[stage.id];
      if (!note) throw new Error(`${family.name} has no lifecycle note for stage '${stage.id}'`);
      return { ...stage, note };
    })
  : [];

// Rendered sections in order, so surfaces can alternate by position.
const sectionOrder = [
  ...(family.orientation.length > 0 ? ['overview'] : []),
  'decisions',
  ...(family.mechanisms ? ['mechanisms'] : []),
  ...(lifecycle.length > 0 ? ['lifecycle'] : []),
  'offerings',
  ...(relatedExpertise.length > 0 || audiences.length > 0 ? ['expertise'] : []),
  ...(family.proofNote ? ['proof'] : []),
];
const tone = (id: string) => (sectionOrder.indexOf(id) % 2 === 1 ? 'section section-alt' : 'section');

const ctaLinks = [
  { label: 'Our Approach & Capabilities', href: '/capabilities/' },
  { label: 'Areas of Expertise', href: '/expertise/' },
  { label: 'Who We Work With', href: '/who-we-work-with/' },
  { label: 'Digital Solutions', href: '/digital-solutions/' },
  { label: 'Glossary', href: '/glossary/' },
];

const pagePath = `/capabilities/${family.slug}/`;
const breadcrumbs = [
  { name: 'Capabilities', path: '/capabilities/' },
  { name: family.name, path: pagePath },
];
// The family as a schema.org Service with its offerings as an OfferCatalog;
// each offer's url is the offering's stable anchor on this page.
const serviceSchema = service(Astro.site, {
  name: family.name,
  description: family.metaDescription,
  path: pagePath,
  offerings: family.offerings.map((o) => ({ name: o.name, description: o.description, path: `${pagePath}#${offeringAnchor(o.name)}` })),
});
---

<SiteLayout
  title={family.metaTitle}
  description={family.metaDescription}
  canonical={pagePath}
  breadcrumbs={breadcrumbs}
  jsonLd={[serviceSchema]}
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow={family.eyebrow}
    title={family.title}
    lead={family.lead}
    primaryCta={family.primaryCta}
    secondaryCta={family.secondaryCta}
  />

  {/* ── Overview ─────────────────────────────────────────────────────── */}
  {family.orientation.length > 0 && (
    <section class={tone('overview')} id="overview" aria-labelledby="overview-h">
      <div class="container">
        <header class="section-header split-header cap-header-only">
          <span class="eyebrow split-header-eyebrow">Overview</span>
          <div class="split-header-title">
            <h2 id="overview-h">{family.name}</h2>
          </div>
          <div class="split-header-lead">
            {family.orientation.map((para) => <p class="section-lead">{para}</p>)}
          </div>
        </header>
      </div>
    </section>
  )}

  {/* ── The core question, its owners, its scope ─────────────────────── */}
  <section class={tone('decisions')} id="decisions" aria-labelledby="decisions-h">
    <div class="container">
      <header class="section-header split-header cap-header-only">
        <span class="eyebrow split-header-eyebrow">The Core Question</span>
        <div class="split-header-title">
          <h2 id="decisions-h" class="cap-question">“{family.coreQuestion}”</h2>
        </div>
        <div class="split-header-lead">
          <span class="field-label cap-field">Scope</span>
          <p class="section-lead">{family.scopeBoundary}</p>
          <span class="field-label cap-field cap-field-gap">Primary Decision Owners</span>
          <ul class="cap-tags" role="list">
            {family.decisionOwners.map((owner) => <li class="tag">{owner}</li>)}
          </ul>
        </div>
      </header>
    </div>
  </section>

  {/* ── Market mechanisms (C&ES) ─────────────────────────────────────── */}
  {family.mechanisms && (
    <section class={tone('mechanisms')} id="mechanisms" aria-labelledby="mechanisms-h">
      <div class="container">
        <header class="section-header split-header">
          <span class="eyebrow split-header-eyebrow">{family.mechanisms.eyebrow}</span>
          <div class="split-header-title">
            <h2 id="mechanisms-h">{family.mechanisms.heading}</h2>
          </div>
          <div class="split-header-lead">
            {family.mechanisms.lead.map((para) => <p class="section-lead">{para}</p>)}
          </div>
        </header>

        <MechanismSelector mechanisms={marketMechanisms} />
      </div>
    </section>
  )}

  {/* ── Lifecycle (C&ES) ─────────────────────────────────────────────── */}
  {family.lifecycle && (
    <section class={tone('lifecycle')} id="lifecycle" aria-labelledby="lifecycle-h">
      <div class="container">
        <header class="section-header split-header">
          <span class="eyebrow split-header-eyebrow">{family.lifecycle.eyebrow}</span>
          <div class="split-header-title">
            <h2 id="lifecycle-h">{family.lifecycle.heading}</h2>
          </div>
          <div class="split-header-lead">
            {family.lifecycle.lead.map((para) => <p class="section-lead">{para}</p>)}
          </div>
        </header>

        <ol class="card-grid card-grid-3" role="list">
          {lifecycle.map((stage) => (
            <li class="card card-static cap-stage">
              <span class="field-label cap-stage-label">
                <span class="cap-stage-num" aria-hidden="true">{stage.n}</span>
                {stage.title}
              </span>
              <h3>{stage.note.title}</h3>
              <p>{stage.note.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* ── Offerings ────────────────────────────────────────────────────── */}
  <section class={tone('offerings')} id="offerings" aria-labelledby="offerings-h">
    <div class="container">
      <header class="section-header split-header">
        <span class="eyebrow split-header-eyebrow">Our Offerings</span>
        <div class="split-header-title">
          <h2 id="offerings-h">What We Do</h2>
        </div>
        <div class="split-header-lead">
          <p class="section-lead">These offerings can be combined to match the decision at hand. Each engagement is tailored to the client's specific context, objectives, and constraints.</p>
        </div>
      </header>

      <ol class="card-entries" role="list">
        {family.offerings.map((offering) => (
          <li
            class="card card-static card-entry"
            class:list={{ 'cap-entry-single': offering.subOfferings.length === 0 && !offering.detail }}
            id={offeringAnchor(offering.name)}
          >
            <div class="card-entry-head">
              <h3>{offering.name}</h3>
              <p class="cap-offering-desc">{offering.description}</p>
              {offering.detail && (
                <div class="cap-owners">
                  <span class="field-label cap-field">Who Decides</span>
                  <ul class="dot-list" role="list">
                    {offering.detail.decisionOwners.map((owner) => <li>{owner}</li>)}
                  </ul>
                </div>
              )}
            </div>
            {offering.detail && (
              <div class="cap-detail">
                <p class="cap-detail-body">{offering.detail.description}</p>
                <p class="cap-detail-question">“{offering.detail.coreQuestion}”</p>
                <span class="field-label cap-field">Questions This Answers</span>
                <ul class="dot-list" role="list">
                  {offering.detail.problems.map((problem) => <li>{problem}</li>)}
                </ul>
                <span class="field-label cap-field cap-field-gap">What You Receive</span>
                <ul class="dot-list cap-deliverables" role="list">
                  {offering.detail.deliverables.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}
            {offering.subOfferings.length > 0 && (
              <div class="disclosure-list">
                {offering.subOfferings.map((sub) => (
                  <details class="disclosure">
                    <summary>
                      <span class="disclosure-name">{sub.name}</span>
                      <span class="disclosure-mark" aria-hidden="true"></span>
                    </summary>
                    <p class="disclosure-body">{sub.description}</p>
                  </details>
                ))}
              </div>
            )}
          </li>
        ))}
      </ol>

      {family.callout && (
        <p class="cap-callout">{family.callout}</p>
      )}
    </div>
  </section>

  {/* ── Related expertise and audiences ──────────────────────────────── */}
  {(relatedExpertise.length > 0 || audiences.length > 0) && (
    <section class={tone('expertise')} id="expertise" aria-labelledby="expertise-h">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">Connected</span>
          <h2 id="expertise-h">Where This Work Applies</h2>
        </header>
        <div class="cap-connections">
          {relatedExpertise.length > 0 && (
            <div>
              <span class="field-label cap-field">Related Areas of Expertise</span>
              <div class="cap-tags">
                {relatedExpertise.map((topic) => (
                  <a href={topic.href} class="tag">{topic.name}</a>
                ))}
              </div>
            </div>
          )}
          {audiences.length > 0 && (
            <div>
              <span class="field-label cap-field">Who This Matters To</span>
              <div class="cap-tags">
                {audiences.map((a) => (
                  <a href={`/who-we-work-with/#${a.slug}`} class="tag">{a.name}</a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {/* ── Proof ────────────────────────────────────────────────────────── */}
  {family.proofNote && (
    <section class={tone('proof')} id="proof" aria-labelledby="proof-h">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">Evidence</span>
          <h2 id="proof-h">Relevant Proof</h2>
        </header>
        <p class="cap-proof">{family.proofNote}</p>
        {family.proofLink && (
          <div class="cap-proof-cta">
            <a href={family.proofLink.href} class="btn btn-secondary">{family.proofLink.label}</a>
          </div>
        )}
      </div>
    </section>
  )}

  {/* ── Comparison band (C&ES) ───────────────────────────────────────── */}
  {family.comparison && (
    <section class="cap-comparison" aria-labelledby="comparison-h">
      <div class="container">
        <header class="section-header split-header">
          <div class="split-header-title">
            <h2 id="comparison-h">{family.comparison.heading}</h2>
          </div>
          <div class="split-header-lead">
            <p class="section-lead">{family.comparison.lead}</p>
          </div>
        </header>

        <ul class="cap-comparison-grid" role="list">
          {family.comparison.cells.map((cell) => (
            <li class="cap-comparison-cell">
              <span class="cap-comparison-label">{cell.label}</span>
              <span class="cap-comparison-body">{cell.body}</span>
            </li>
          ))}
        </ul>

        <p class="cap-comparison-quote">{family.comparison.quote}</p>
      </div>
    </section>
  )}

  <ClosingCta
    headingId="final-cta-heading"
    heading={family.ctaHeading}
    description={family.ctaBody}
    primaryCta={family.ctaButton}
    links={ctaLinks}
  />
</SiteLayout>

<style>
  /* Header-only sections (overview, core question): the header's own bottom
     margin would leave the section ending in empty space. */
  .cap-header-only { margin-bottom: 0; }

  /* The core question is the client's, so it is set as a quotation rather
     than a statement, and in the serif so it reads as a voice. */
  .cap-question {
    font-family: var(--font-serif);
    font-weight: var(--font-medium);
    text-wrap: balance;
  }
  .cap-field { margin-bottom: var(--space-3); }
  .cap-field-gap { margin-top: var(--space-6); }
  .cap-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Lifecycle notes. The stage's canonical number and title label the card;
     the family's one-liner is the heading. */
  .cap-stage { padding: var(--space-6); }
  .cap-stage-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .cap-stage-num {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--c-sky-600);
    letter-spacing: 0;
    text-transform: none;
  }
  .cap-stage h3 { font-size: var(--text-lg); }

  /* Offerings. An offering with neither sub-offerings nor detail collapses
     to one column rather than leaving the detail column empty. Scoped, so
     it outranks .card-entry's media rule. */
  .cap-entry-single { grid-template-columns: 1fr; }
  /* .card p sets the small size; the offering description is the row's
     lead and reads at body size, as it did before the rebuild. */
  .cap-offering-desc {
    margin: 0;
    font-size: var(--text-base);
  }
  .cap-owners {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .cap-owners .dot-list { gap: var(--space-2); }
  .cap-owners .dot-list li { font-size: var(--text-sm); }

  /* Offering detail, from the approved offering record. The description is
     the body; the client's question sits beneath it as a quotation, the
     same treatment as the family-level question above. */
  .cap-detail-body {
    margin: 0 0 var(--space-5);
    font-size: var(--text-base);
    line-height: var(--line-relaxed);
    color: var(--color-text);
  }
  .cap-detail-question {
    margin: 0 0 var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--c-sky-300);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--line-relaxed);
    color: var(--c-sky-700);
  }
  .cap-deliverables {
    display: grid;
    gap: var(--space-2) var(--space-6);
  }
  @media (min-width: 48rem) {
    .cap-deliverables { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .cap-deliverables li { font-size: var(--text-sm); }

  /* Said once under the list, as the Who We Work With footnotes are. */
  .cap-callout {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
    /* text-secondary: secondary-500 is 4.77:1 on white but 4.45:1 on the
       tinted section this can land on, and --color-text-muted is 2.56:1. */
    color: var(--color-text-secondary);
    max-width: var(--max-width-text);
  }

  .cap-connections {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 64rem) {
    .cap-connections { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-10); }
  }

  .cap-proof {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    max-width: var(--max-width-text);
  }
  .cap-proof-cta { margin-top: var(--space-6); }

  /* Comparison band: the page family's one navy moment, directly above the
     light-blue closing band, as /who-we-work-with/ closes. Cell and label
     values carried over from the bespoke page unchanged. */
  .cap-comparison {
    background: var(--gradient-dark);
    color: var(--color-text-inverse);
    padding-block: var(--space-16);
  }
  .cap-comparison h2 { color: #fff; }
  .cap-comparison .section-lead { color: rgba(248, 250, 252, 0.75); }
  .cap-comparison-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  @media (min-width: 40rem) { .cap-comparison-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .cap-comparison-grid { grid-template-columns: repeat(4, 1fr); } }
  .cap-comparison-cell {
    background: #131f48;
    padding: var(--space-6) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cap-comparison-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-sky-300);
  }
  .cap-comparison-body {
    font-size: var(--text-base);
    line-height: var(--line-relaxed);
    color: var(--color-text-inverse);
  }
  /* Full container width, not capped to 34em (owner mockup, 2026-08-19). */
  .cap-comparison-quote {
    margin: var(--space-10) 0 0;
    font-size: var(--text-2xl);
    font-weight: var(--font-medium);
    line-height: 1.4;
    color: #fff;
  }
</style>
