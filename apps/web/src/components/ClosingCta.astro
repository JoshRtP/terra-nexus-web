---
// Shared closing CTA banner (`.section.section-dark` > centered heading +
// optional description + one or two buttons). Extracted in M7 session 2
// from ten near-identical hand-rolled copies across page components — see
// docs/architecture/web-platform-architecture.md and the
// terra-nexus-design-system skill for the pattern this replaces.
interface Props {
  heading: string;
  description?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  headingId?: string;
  /** Optional row of onward links below the buttons, separated by a rule.
   * Added 2026-09-12 for the expertise topic template, which needs to hand
   * the reader the rest of the site from its closing band. Any page can use
   * it; pages that omit it render exactly as before. */
  links?: Array<{ label: string; href: string }>;
}

const { heading, description, primaryCta, secondaryCta, headingId, links } = Astro.props;
---

<section class="section section-dark" aria-labelledby={headingId ?? 'closing-cta-heading'}>
  <div class="container text-center">
    <h2 id={headingId ?? 'closing-cta-heading'}>{heading}</h2>
    {description && <p class="cta-description">{description}</p>}
    <div class="hero-actions">
      <a href={primaryCta.href} class="btn btn-primary">{primaryCta.label}</a>
      {secondaryCta && <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>}
    </div>
    {links && links.length > 0 && (
      <div class="cta-links">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    )}
  </div>
</section>

<style>
  /* Onward-link row. Borrows .section-dark's own foreground colour rather
     than introducing one, so it stays correct if that band is retoned. */
  .cta-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(19, 31, 72, 0.2);
  }
  .cta-links a {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-dark);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .cta-links a:hover { border-bottom-color: currentColor; }
  .cta-links a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
</style>
