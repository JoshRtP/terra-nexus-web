---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from './PageHero.astro';
import { getBuildMode } from '../lib/build-mode.js';

export interface Workstream {
  title: string;
  items: string[];
}

export interface AudiencePathway {
  title: string;
  description: string;
}

export interface DecisionGroup {
  heading: string;
  items: string[];
}

export interface PerformanceCategory {
  title: string;
  items: string[];
}

export interface SystemStep {
  title: string;
  body: string;
  detail?: string;
}

export interface ValuePathway {
  label: string;
}

export interface ValidationRow {
  category: string;
  pitfall: string;
  validation: string;
}

export interface ExpertisePageData {
  eyebrow: string;
  title: string;
  lead: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  metaTitle: string;
  metaDescription: string;
  orientation: string[];
  performanceCategories: PerformanceCategory[];
  systemSteps: SystemStep[];
  audiencePathways: AudiencePathway[];
  decisionGroups: DecisionGroup[];
  workstreams: Workstream[];
  valuePathways: ValuePathway[];
  validationRows: ValidationRow[];
  ctaHeading: string;
  ctaBody: string;
  ctaButton: { label: string; href: string };
}

interface Props {
  data: ExpertisePageData;
}

const { data } = Astro.props;
const mode = getBuildMode();
---

<SiteLayout title={data.metaTitle} description={data.metaDescription} preview={mode === 'preview'}>
  <PageHero
    eyebrow={data.eyebrow}
    title={data.title}
    lead={data.lead}
    primaryCta={data.primaryCta}
    secondaryCta={data.secondaryCta}
  />

  <!-- Topic Orientation -->
  <section class="section" aria-labelledby="orientation-heading">
    <div class="container">
      <div class="text-container">
        <span class="eyebrow">Overview</span>
        {data.orientation.map((para) => <p class="lead-paragraph">{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Performance Categories -->
  <section class="section section-alt" aria-labelledby="performance-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Better Performance</span>
        <h2 id="performance-heading">Benefits</h2>
      </header>
      <div class="card-grid card-grid-3">
        {data.performanceCategories.map((cat) => (
          <article class="card">
            <h3>{cat.title}</h3>
            <ul class="bullet-list">
              {cat.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- System Steps -->
  <section class="section" aria-labelledby="system-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">How It Works</span>
        <h2 id="system-heading">How an Opportunity Moves from Concept to Value</h2>
      </header>
      <ol class="steps-list" role="list">
        {data.systemSteps.map((step, i) => (
          <li class="step-item">
            <span class="step-number">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.detail && <p class="step-detail">{step.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Audience Pathways -->
  <section class="section section-alt" aria-labelledby="audiences-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Who We Support</span>
        <h2 id="audiences-heading">How We Support Different Participants</h2>
      </header>
      <div class="card-grid">
        {data.audiencePathways.map((aud) => (
          <article class="card">
            <h3>{aud.title}</h3>
            <p>{aud.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Market Validation & Decisions -->
  <section class="section" aria-labelledby="decisions-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Market Validation</span>
        <h2 id="decisions-heading">Market Validation</h2>
        <p class="section-lead">We pressure-test every opportunity across desirability, viability, feasibility, and strategic fit before capital is committed. The right questions differ by stakeholder, but every program must clear all four gates.</p>
      </header>
      <div class="decisions-grid">
        {data.decisionGroups.map((group) => (
          <article class="decision-card">
            <h3>{group.heading}</h3>
            <ul class="bullet-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How Terra Nexus Helps -->
  <section class="section section-alt" aria-labelledby="help-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Our Approach</span>
        <h2 id="help-heading">Our Approach</h2>
      </header>
      <div class="workstream-grid">
        {data.workstreams.map((ws) => (
          <article class="workstream-card">
            <h3>{ws.title}</h3>
            <ul class="bullet-list">
              {ws.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Avoiding Common Pitfalls: Market Validation Comparison -->
  <section class="section section-alt" aria-labelledby="pitfalls-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Experience</span>
        <h2 id="pitfalls-heading">Avoiding Common Pitfalls</h2>
        <p class="section-lead">A customer-centric approach &mdash; starting with desirability, then validating viability, feasibility, and strategic fit &mdash; prevents the most common reasons programs struggle. Each row pairs a frequent pitfall with the market-validation discipline that prevents it.</p>
      </header>
      <div class="validation-table-wrap">
        <table class="validation-table">
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col" class="col-pitfall">
                <span class="col-icon col-icon-x" aria-hidden="true">&times;</span>
                Common Pitfall
              </th>
              <th scope="col" class="col-validation">
                <span class="col-icon col-icon-check" aria-hidden="true">&check;</span>
                Market Validation
              </th>
            </tr>
          </thead>
          <tbody>
            {data.validationRows.map((row) => (
              <tr>
                <td class="cell-category">{row.category}</td>
                <td class="cell-pitfall">{row.pitfall}</td>
                <td class="cell-validation">{row.validation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark" aria-labelledby="final-cta-heading">
    <div class="container text-center">
      <h2 id="final-cta-heading">{data.ctaHeading}</h2>
      <p class="cta-description">{data.ctaBody}</p>
      <div class="hero-actions">
        <a href={data.ctaButton.href} class="btn btn-primary">{data.ctaButton.label}</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .lead-paragraph {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    line-height: var(--line-relaxed);
  }

  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bullet-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
    margin-bottom: var(--space-2);
    line-height: var(--line-normal);
  }
  .bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Steps */
  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }
  .step-item {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .step-item:last-child { border-bottom: 0; }
  .step-number {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--font-semibold);
    color: var(--color-accent);
    flex-shrink: 0;
    min-width: 3rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .step-content { flex: 1; min-width: 0; }
  .step-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .step-content p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
    line-height: var(--line-relaxed);
  }
  .step-detail { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* Decisions */
  .decisions-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .decisions-grid { grid-template-columns: repeat(2, 1fr); } }
  .decision-card {
    padding: var(--space-8);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .decision-card h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  /* Workstreams */
  .workstream-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .workstream-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .workstream-grid { grid-template-columns: repeat(3, 1fr); } }
  .workstream-card {
    padding: var(--space-8);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .workstream-card:hover {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-md);
  }
  .workstream-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  /* Validation Comparison Table */
  .validation-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-elevated);
  }
  .validation-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 48rem;
  }
  .validation-table thead th {
    text-align: left;
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    background: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }
  .validation-table .col-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    line-height: 1;
    margin-right: 0.3em;
  }
  .col-icon-x { background: var(--c-error-50); color: var(--c-error-500); }
  .col-icon-check { background: var(--c-success-50); color: var(--c-success-600); }
  .validation-table tbody td {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--line-normal);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .validation-table tbody tr:last-child td { border-bottom: 0; }
  .validation-table tbody tr:nth-child(even) td { background: var(--color-surface); }
  .cell-category {
    font-weight: var(--font-semibold);
    color: var(--color-text);
    white-space: nowrap;
  }
  .cell-pitfall { color: var(--color-text-secondary); }
  .cell-validation { color: var(--color-text-secondary); }
  @media (max-width: 48rem) {
    .validation-table { min-width: 0; }
    .validation-table thead { display: none; }
    .validation-table, .validation-table tbody, .validation-table tr, .validation-table td {
      display: block;
      width: 100%;
    }
    .validation-table tr {
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--color-border);
    }
    .validation-table tr:last-child { border-bottom: 0; }
    .validation-table td {
      padding: var(--space-2) var(--space-4);
      border: 0;
    }
    .cell-category::before {
      content: 'Category';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      margin-bottom: var(--space-1);
    }
    .cell-pitfall::before {
      content: '\2715  Common Pitfall';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--c-error-500);
      margin-bottom: var(--space-1);
      margin-top: var(--space-2);
    }
    .cell-validation::before {
      content: '\2713  Market Validation';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--c-success-600);
      margin-bottom: var(--space-1);
      margin-top: var(--space-2);
    }
  }


</style>
