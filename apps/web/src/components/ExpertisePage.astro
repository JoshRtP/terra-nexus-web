---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBuildMode } from '../lib/build-mode.js';

export interface Workstream {
  title: string;
  items: string[];
}

export interface AudiencePathway {
  title: string;
  description: string;
}

export interface DecisionGroup {
  heading: string;
  items: string[];
}

export interface PerformanceCategory {
  title: string;
  items: string[];
}

export interface SystemStep {
  title: string;
  body: string;
  detail?: string;
}

export interface ValuePathway {
  label: string;
}

export interface ValidationRow {
  category: string;
  pitfall: string;
  validation: string;
}

export interface ExpertisePageData {
  eyebrow: string;
  title: string;
  lead: string;
  heroImage: string;
  heroImageAlt?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  metaTitle: string;
  metaDescription: string;
  orientation: string[];
  performanceCategories: PerformanceCategory[];
  systemSteps: SystemStep[];
  audiencePathways: AudiencePathway[];
  decisionGroups: DecisionGroup[];
  workstreams: Workstream[];
  valuePathways: ValuePathway[];
  validationRows: ValidationRow[];
  ctaHeading: string;
  ctaBody: string;
  ctaButton: { label: string; href: string };
}

interface Props {
  data: ExpertisePageData;
}

const { data } = Astro.props;
const mode = getBuildMode();
---

<SiteLayout title={data.metaTitle} description={data.metaDescription} preview={mode === 'preview'}>

  <!-- Visual Hero -->
  <section class="expertise-hero" aria-labelledby="hero-heading">
    <div
      class="hero-bg"
      style={`background-image: url('${data.heroImage}')`}
      role="img"
      aria-label={data.heroImageAlt ?? data.title}
    ></div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="eyebrow eyebrow-light">{data.eyebrow}</span>
      <h1 id="hero-heading">{data.title}</h1>
      <p class="hero-lead">{data.lead}</p>
      <div class="hero-actions">
        <a href={data.primaryCta.href} class="btn btn-primary">{data.primaryCta.label}</a>
        {data.secondaryCta && (
          <a href={data.secondaryCta.href} class="btn btn-ghost">{data.secondaryCta.label}</a>
        )}
      </div>
    </div>
  </section>

  <!-- Overview + Benefits (split layout) -->
  <section class="section" aria-labelledby="overview-heading">
    <div class="container">
      <div class="overview-split">
        <div class="overview-left">
          <span class="eyebrow">Overview</span>
          <h2 id="overview-heading" class="overview-heading">{data.title}</h2>
          {data.orientation.map((para) => <p class="lead-paragraph">{para}</p>)}
          <div class="overview-cta">
            <a href={data.primaryCta.href} class="btn btn-primary">{data.primaryCta.label}</a>
          </div>
        </div>
        <div class="overview-right">
          <div class="benefits-stack">
            <div class="benefits-eyebrow">
              <span class="eyebrow">Better Performance</span>
              <h3 class="benefits-title">Key Benefits</h3>
            </div>
            {data.performanceCategories.map((cat) => (
              <article class="benefit-card">
                <h4>{cat.title}</h4>
                <ul class="bullet-list">
                  {cat.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach (directly under Benefits) -->
  <section class="section section-alt" aria-labelledby="help-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Our Approach</span>
        <h2 id="help-heading">Our Approach</h2>
      </header>
      <div class="workstream-grid">
        {data.workstreams.map((ws) => (
          <article class="card-plain">
            <h3>{ws.title}</h3>
            <ul class="bullet-list">
              {ws.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- System Steps -->
  <section class="section" aria-labelledby="system-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">How It Works</span>
        <h2 id="system-heading">How an Opportunity Moves from Concept to Value</h2>
      </header>
      <ol class="steps-list" role="list">
        {data.systemSteps.map((step, i) => (
          <li class="step-item">
            <span class="numbered-index">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.detail && <p class="step-detail">{step.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Audience Pathways -->
  <section class="section section-alt" aria-labelledby="audiences-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Who We Support</span>
        <h2 id="audiences-heading">How We Support Different Participants</h2>
      </header>
      <div class="card-grid">
        {data.audiencePathways.map((aud) => (
          <article class="card">
            <h3>{aud.title}</h3>
            <p>{aud.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Market Validation & Decisions -->
  <section class="section" aria-labelledby="decisions-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Market Validation</span>
        <h2 id="decisions-heading">Market Validation</h2>
        <p class="section-lead">A customer-centric approach &mdash; starting with desirability, then validating viability, feasibility, and strategic fit &mdash; prevents the most common reasons programs struggle. Each row pairs a frequent pitfall with the market-validation discipline that prevents it.</p>
      </header>
      <div class="decisions-grid">
        {data.decisionGroups.map((group) => (
          <article class="decision-card">
            <h3>{group.heading}</h3>
            <ul class="bullet-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark" aria-labelledby="final-cta-heading">
    <div class="container text-center">
      <h2 id="final-cta-heading">{data.ctaHeading}</h2>
      <p class="cta-description">{data.ctaBody}</p>
      <div class="hero-actions">
        <a href={data.ctaButton.href} class="btn btn-primary">{data.ctaButton.label}</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* ── Visual Hero ── */
  .expertise-hero {
    position: relative;
    min-height: clamp(28rem, 60vh, 48rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    transform: scale(1.03);
    transition: transform 8s ease-out;
  }
  .expertise-hero:hover .hero-bg { transform: scale(1); }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.88) 0%,
      rgba(15, 23, 42, 0.55) 50%,
      rgba(15, 23, 42, 0.25) 100%
    );
  }
  .hero-content {
    position: relative;
    padding-block: var(--space-16) var(--space-20);
    z-index: 1;
  }
  .hero-content h1 {
    color: var(--color-text-inverse);
    max-width: 40rem;
    margin-bottom: var(--space-5);
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .hero-lead {
    font-size: var(--text-lg);
    color: rgba(248, 250, 252, 0.88);
    max-width: 38rem;
    line-height: var(--line-relaxed);
    text-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  /* ── Overview + Benefits split ── */
  .overview-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .overview-split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-20);
    }
  }
  .overview-left { max-width: 40rem; }
  .overview-heading {
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .lead-paragraph {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    line-height: var(--line-relaxed);
  }
  .overview-cta { margin-top: var(--space-8); }

  /* Benefits stack */
  .benefits-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .benefits-eyebrow {
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-2);
  }
  .benefits-title {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }
  /* .card-accent-start provides the left-accent-border/no-hover-lift recipe;
     background, padding, and accent color here are genuinely distinct from
     its defaults (surface vs surface-elevated, space-5/6 vs space-8, and a
     darker sky-600 accent vs the primitive's sky-300), kept as local
     overrides. */
  .benefit-card {
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border-inline-start-color: var(--c-sky-600);
  }
  .benefit-card h4 {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Shared ── */
  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bullet-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
    margin-bottom: var(--space-2);
    line-height: var(--line-normal);
  }
  .bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-sky-600);
  }

  /* ── System Steps ── */
  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }
  .step-item {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .step-item:last-child { border-bottom: 0; }
  .numbered-index {
    font-weight: var(--font-semibold);
    flex-shrink: 0;
    min-width: 3rem;
    letter-spacing: -0.02em;
  }
  .step-content { flex: 1; min-width: 0; }
  .step-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .step-content p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
    line-height: var(--line-relaxed);
  }
  .step-detail { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ── Card grid (audience) ── */
  .card-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .card-grid { grid-template-columns: repeat(3, 1fr); } }
  .card {
    padding: var(--space-8);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .card:hover {
    border-color: var(--c-sky-300);
    box-shadow: var(--shadow-md);
  }
  .card h3 { font-size: var(--text-base); margin-bottom: var(--space-3); }
  .card p { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: var(--line-relaxed); }

  /* ── Decisions ── */
  .decisions-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .decisions-grid { grid-template-columns: repeat(2, 1fr); } }
  .decision-card {
    padding: var(--space-8);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .decision-card h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  /* ── Workstreams ── */
  .workstream-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .workstream-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .workstream-grid { grid-template-columns: repeat(3, 1fr); } }
  /* ── Validation Comparison Table ── */
  .validation-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-elevated);
  }
  .validation-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 48rem;
  }
  .validation-table thead th {
    text-align: left;
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    background: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }
  .validation-table .col-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    line-height: 1;
    margin-right: 0.3em;
  }
  .col-icon-x { background: var(--c-error-50); color: var(--c-error-500); }
  .col-icon-check { background: var(--c-success-50); color: var(--c-success-600); }
  .validation-table tbody td {
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--line-normal);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .validation-table tbody tr:last-child td { border-bottom: 0; }
  .validation-table tbody tr:nth-child(even) td { background: var(--color-surface); }
  .cell-category {
    font-weight: var(--font-semibold);
    color: var(--color-text);
    white-space: nowrap;
  }
  .cell-pitfall { color: var(--color-text-secondary); }
  .cell-validation { color: var(--color-text-secondary); }

  @media (max-width: 48rem) {
    .validation-table { min-width: 0; }
    .validation-table thead { display: none; }
    .validation-table, .validation-table tbody, .validation-table tr, .validation-table td {
      display: block;
      width: 100%;
    }
    .validation-table tr {
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--color-border);
    }
    .validation-table tr:last-child { border-bottom: 0; }
    .validation-table td {
      padding: var(--space-2) var(--space-4);
      border: 0;
    }
    .cell-category::before {
      content: 'Category';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      margin-bottom: var(--space-1);
    }
    .cell-pitfall::before {
      content: '\2715  Common Pitfall';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--c-error-500);
      margin-bottom: var(--space-1);
      margin-top: var(--space-2);
    }
    .cell-validation::before {
      content: '\2713  Market Validation';
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-bold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--c-success-700);
      margin-bottom: var(--space-1);
      margin-top: var(--space-2);
    }
  }

</style>
