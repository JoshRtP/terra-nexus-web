---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from './PageHero.astro';
import { getBuildMode } from '../lib/build-mode.js';

export interface Workstream {
  title: string;
  items: string[];
}

export interface AudiencePathway {
  title: string;
  description: string;
}

export interface DecisionGroup {
  heading: string;
  items: string[];
}

export interface PerformanceCategory {
  title: string;
  items: string[];
}

export interface SystemStep {
  title: string;
  body: string;
  detail?: string;
}

export interface ValuePathway {
  label: string;
}

export interface ExpertisePageData {
  eyebrow: string;
  title: string;
  lead: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  metaTitle: string;
  metaDescription: string;
  orientation: string[];
  performanceCategories: PerformanceCategory[];
  systemSteps: SystemStep[];
  audiencePathways: AudiencePathway[];
  decisionGroups: DecisionGroup[];
  workstreams: Workstream[];
  valuePathways: ValuePathway[];
  pitfalls: string[];
  ctaHeading: string;
  ctaBody: string;
  ctaButton: { label: string; href: string };
}

interface Props {
  data: ExpertisePageData;
}

const { data } = Astro.props;
const mode = getBuildMode();
---

<SiteLayout title={data.metaTitle} description={data.metaDescription} preview={mode === 'preview'}>
  <PageHero
    eyebrow={data.eyebrow}
    title={data.title}
    lead={data.lead}
    primaryCta={data.primaryCta}
    secondaryCta={data.secondaryCta}
  />

  <!-- Topic Orientation -->
  <section class="section" aria-labelledby="orientation-heading">
    <div class="container">
      <div class="text-container">
        <span class="eyebrow">Overview</span>
        <h2 id="orientation-heading">What This Area Covers</h2>
        {data.orientation.map((para) => <p class="lead-paragraph">{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Performance Categories -->
  <section class="section section-alt" aria-labelledby="performance-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Better Performance</span>
        <h2 id="performance-heading">What Better Performance Can Look Like</h2>
      </header>
      <div class="card-grid card-grid-3">
        {data.performanceCategories.map((cat) => (
          <article class="card">
            <h3>{cat.title}</h3>
            <ul class="bullet-list">
              {cat.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- System Steps -->
  <section class="section" aria-labelledby="system-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">How It Works</span>
        <h2 id="system-heading">How an Opportunity Moves from Concept to Value</h2>
      </header>
      <ol class="steps-list" role="list">
        {data.systemSteps.map((step, i) => (
          <li class="step-item">
            <span class="step-number">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.detail && <p class="step-detail">{step.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Audience Pathways -->
  <section class="section section-alt" aria-labelledby="audiences-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Who We Support</span>
        <h2 id="audiences-heading">How We Support Different Participants</h2>
      </header>
      <div class="card-grid">
        {data.audiencePathways.map((aud) => (
          <article class="card">
            <h3>{aud.title}</h3>
            <p>{aud.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Decisions -->
  <section class="section" aria-labelledby="decisions-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Real Decisions</span>
        <h2 id="decisions-heading">Decisions Clients Need to Resolve</h2>
      </header>
      <div class="decisions-grid">
        {data.decisionGroups.map((group) => (
          <article class="decision-card">
            <h3>{group.heading}</h3>
            <ul class="bullet-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How Terra Nexus Helps -->
  <section class="section section-alt" aria-labelledby="help-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Our Approach</span>
        <h2 id="help-heading">Our Approach</h2>
      </header>
      <div class="workstream-grid">
        {data.workstreams.map((ws) => (
          <article class="workstream-card">
            <h3>{ws.title}</h3>
            <ul class="bullet-list">
              {ws.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Value Pathways -->
  <section class="section" aria-labelledby="value-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">From Performance to Value</span>
        <h2 id="value-heading">Connecting Performance to the Right Form of Value</h2>
        <p class="section-lead">The same improvement may support different claims with different evidence, ownership, assurance, and commercial reach. The best pathway is not always the one with the highest nominal price.</p>
      </header>
      <div class="pathway-tags">
        {data.valuePathways.map((p) => <span class="pathway-tag">{p.label}</span>)}
      </div>
      <p class="pathway-note">These are categories of potential value, not promises that every pathway is available, stackable, transferable, or commercially superior. Detailed pathway analysis remains client-specific.</p>
    </div>
  </section>

  <!-- Common Pitfalls -->
  <section class="section section-alt" aria-labelledby="pitfalls-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Experience</span>
        <h2 id="pitfalls-heading">Common Reasons Programs Struggle</h2>
      </header>
      <ul class="pitfall-list" role="list">
        {data.pitfalls.map((pitfall) => (
          <li class="pitfall-item">
            <span class="pitfall-icon" aria-hidden="true">&times;</span>
            <span>{pitfall}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark" aria-labelledby="final-cta-heading">
    <div class="container text-center">
      <h2 id="final-cta-heading">{data.ctaHeading}</h2>
      <p class="cta-description">{data.ctaBody}</p>
      <div class="hero-actions">
        <a href={data.ctaButton.href} class="btn btn-primary">{data.ctaButton.label}</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .lead-paragraph {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    line-height: var(--line-relaxed);
  }

  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bullet-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
    margin-bottom: var(--space-2);
    line-height: var(--line-normal);
  }
  .bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Steps */
  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }
  .step-item {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .step-item:last-child { border-bottom: 0; }
  .step-number {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--font-semibold);
    color: var(--color-accent);
    flex-shrink: 0;
    min-width: 3rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .step-content { flex: 1; min-width: 0; }
  .step-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }
  .step-content p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
    line-height: var(--line-relaxed);
  }
  .step-detail { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* Decisions */
  .decisions-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .decisions-grid { grid-template-columns: repeat(2, 1fr); } }
  .decision-card {
    padding: var(--space-8);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .decision-card h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  /* Workstreams */
  .workstream-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .workstream-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .workstream-grid { grid-template-columns: repeat(3, 1fr); } }
  .workstream-card {
    padding: var(--space-8);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .workstream-card:hover {
    border-color: var(--color-accent-border);
    box-shadow: var(--shadow-md);
  }
  .workstream-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  /* Pathways */
  .pathway-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-4);
  }
  .pathway-tag {
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }
  .pathway-tag:hover {
    border-color: var(--color-accent-border);
    color: var(--color-accent);
  }
  .pathway-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    max-width: var(--max-width-text);
  }

  /* Pitfalls */
  .pitfall-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 40rem) {
    .pitfall-list { grid-template-columns: repeat(2, 1fr); }
  }
  .pitfall-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-normal);
  }
  .pitfall-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--c-error-50);
    color: var(--c-error-500);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    line-height: 1;
    margin-top: 0.1em;
  }


</style>
