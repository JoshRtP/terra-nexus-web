---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner container">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-wordmark">Terra Nexus</p>
        <p class="footer-summary">
          Terra Nexus is an innovation and insights studio at the intersection of food and climate. We advise and manage commercial sustainability programs at scale.
        </p>
        <p class="footer-tagline">Impact at the Intersection of Food &amp; Climate</p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-nav-group">
          <h3>Explore</h3>
          <ul role="list">
            <li><a href="/expertise/">Expertise</a></li>
            <li><a href="/capabilities/">Capabilities</a></li>
            <li><a href="/who-we-work-with/">Who We Work With</a></li>
            <li><a href="/case-studies/">Case Studies</a></li>
          </ul>
        </div>
        <div class="footer-nav-group">
          <h3>Company</h3>
          <ul role="list">
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <small>&copy; {currentYear} Terra Nexus. All rights reserved.</small>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: #1a1f24; color: #a3adb8; padding-block: var(--space-16) var(--space-6); margin-top: auto; }
  .footer-inner { display: flex; flex-direction: column; gap: var(--space-10); }
  .footer-top { display: grid; gap: var(--space-10); }
  .footer-brand { max-width: 28rem; }
  .footer-wordmark { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 600; color: #fff; margin: 0 0 var(--space-3) 0; }
  .footer-summary { font-size: var(--text-sm); color: #8e97a2; line-height: var(--line-relaxed); margin-bottom: var(--space-3); }
  .footer-tagline { font-size: var(--text-sm); color: #6e7987; font-style: italic; margin: 0; }
  .footer-nav { display: flex; flex-wrap: wrap; gap: var(--space-10); }
  .footer-nav-group h3 { font-size: var(--text-xs); font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-3); }
  .footer-nav-group ul { list-style: none; margin: 0; padding: 0; }
  .footer-nav-group li { margin-bottom: var(--space-2); }
  .footer-nav-group a { color: #8e97a2; font-size: var(--text-sm); text-decoration: none; transition: color var(--transition-fast); }
  .footer-nav-group a:hover { color: #fff; }
  .footer-bottom { padding-top: var(--space-6); border-top: 1px solid #2d343c; }
  .footer-bottom small { font-size: var(--text-xs); color: #6e7987; }
  @media (min-width: 48rem) { .footer-top { grid-template-columns: 1fr auto; } }
</style>
