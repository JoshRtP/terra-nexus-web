---
import type { CaseStudyPageModel } from '../lib/okf/case-study-pages.js';

interface Props {
  page: CaseStudyPageModel;
}

const { page } = Astro.props;
---

<a href={page.route} class="case-study-card">
  <article>
    <p class="eyebrow">{page.label}</p>
    <h2>{page.title}</h2>
    {page.description && <p>{page.description}</p>}
    <span class="read-link">Read case study<span class="sr-only">: {page.title}</span></span>
  </article>
</a>

<style>
  .case-study-card {
    display: block; text-decoration: none; color: inherit;
    padding: var(--space-8); background: var(--color-surface-elevated);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
    position: relative; overflow: hidden;
  }
  .case-study-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--gradient-accent); transform: scaleX(0); transform-origin: left;
    transition: transform var(--transition-base);
  }
  .case-study-card:hover {
    border-color: var(--color-accent-border); box-shadow: var(--shadow-lg); transform: translateY(-2px);
    color: inherit;
  }
  .case-study-card:hover::before { transform: scaleX(1); }
  .eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .eyebrow::before {
    content: ''; display: inline-block; width: 1.5rem; height: 2px;
    background: var(--color-accent); border-radius: var(--radius-full);
  }
  .case-study-card h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); line-height: 1.3; }
  .case-study-card p { color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: var(--space-4); line-height: var(--line-relaxed); }
  .read-link {
    font-weight: var(--font-semibold); color: var(--color-accent); font-size: var(--text-sm);
    display: inline-flex; align-items: center; gap: var(--space-1);
    transition: gap var(--transition-fast);
  }
  .read-link::after { content: '\2192'; transition: transform var(--transition-fast); }
  .case-study-card:hover .read-link { color: var(--color-accent-hover); }
  .case-study-card:hover .read-link::after { transform: translateX(3px); }
</style>
