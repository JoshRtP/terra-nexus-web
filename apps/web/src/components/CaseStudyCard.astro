---
import type { CaseStudyPageModel } from '../lib/okf/case-study-pages.js';

interface Props {
  page: CaseStudyPageModel;
}

const { page } = Astro.props;
---

<article class="case-study-card">
  <p class="eyebrow">{page.label}</p>
  <h2><a href={page.route}>{page.title}</a></h2>
  {page.description && <p>{page.description}</p>}
  <p><a class="text-link" href={page.route}>Read case study<span class="sr-only">: {page.title}</span></a></p>
</article>

<style>
  .case-study-card { padding: var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); transition: border-color var(--transition-base), box-shadow var(--transition-base); }
  .case-study-card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-md); }
  .eyebrow { display: block; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); margin-bottom: var(--space-2); }
  .case-study-card h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .case-study-card h2 a { color: var(--color-text); text-decoration: none; }
  .case-study-card h2 a:hover { color: var(--color-accent); }
  .case-study-card p { color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: var(--space-3); }
  .text-link { font-weight: 600; color: var(--color-accent); font-size: var(--text-sm); }
  .text-link:hover { color: var(--color-accent-hover); }
</style>
