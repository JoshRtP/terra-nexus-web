---
import type { CaseStudyPageModel } from '../lib/okf/case-study-pages.js';

interface Props {
  page: CaseStudyPageModel;
}

const { page } = Astro.props;
---

<a href={page.route} class="card case-study-card">
  <article>
    <p class="eyebrow eyebrow-sky">{page.label}</p>
    <h2>{page.title}</h2>
    {page.description && <p>{page.description}</p>}
    <span class="read-link">Read case study<span class="sr-only">: {page.title}</span></span>
  </article>
</a>

<style>
  .case-study-card {
    display: block; text-decoration: none; color: inherit;
  }
  /* .card's default top accent bar is --gradient-sky; case studies use the
     maroon --gradient-accent instead — the one genuinely distinct part of
     this card's recipe, kept as a local override. */
  .case-study-card::before {
    background: var(--gradient-accent);
  }
  .case-study-card:hover {
    color: inherit;
  }
  .case-study-card h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); line-height: 1.3; }
  .case-study-card p { color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: var(--space-4); line-height: var(--line-relaxed); }
  .read-link {
    font-weight: var(--font-semibold); color: var(--c-sky-600); font-size: var(--text-sm);
    display: inline-flex; align-items: center; gap: var(--space-1);
    transition: gap var(--transition-fast);
  }
  .read-link::after { content: '\2192'; transition: transform var(--transition-fast); }
  .case-study-card:hover .read-link { color: var(--c-sky-700); }
  .case-study-card:hover .read-link::after { transform: translateX(3px); }
</style>
