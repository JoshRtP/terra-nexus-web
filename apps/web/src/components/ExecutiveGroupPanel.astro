---
// Shared content renderer for a Studio Executives review group — used by
// BOTH team-section trials on /about/ (Option A: Executive Accordion,
// Option B: Executive Index + Detail Panel) so the underlying profile
// markup/CSS is defined once instead of duplicated per layout shell.
//
// Kept page-local (not promoted to the shared design-system component
// vocabulary in terra-nexus-design-system SKILL.md) because there is
// exactly one real consumer today, both instances of it. Promote to a
// generic pattern only if a second page genuinely needs "a group of
// executive/team profiles" — see CLAUDE.md rule 2 on not pre-building
// abstractions without a second real use case.
//
// Reuses existing M7 primitives: .card / .card-static, .tag. Avatar and
// profile layout are page-local (About team trial only), not a shared
// pattern yet — see about/index.astro's local styles for why.
export interface Props {
  group: {
    kind: 'people' | 'person' | 'network';
    people?: Array<{
      name: string;
      title: string;
      initials: string;
      bio: string;
      focusAreas: Array<{ label: string; href: string }>;
    }>;
    person?: { name: string; title: string; initials: string; bio: string };
    network?: { note: string; tags: Array<{ label: string; href: string }> };
  };
}

const { group } = Astro.props;
---

{group.kind === 'people' && group.people && (
  <div class="exec-panel-people">
    {group.people.map((person) => (
      <article class="card card-static exec-profile">
        <div class="exec-avatar" aria-hidden="true">{person.initials}</div>
        <h4>{person.name}</h4>
        <p class="exec-role">{person.title}</p>
        <p class="exec-bio">{person.bio}</p>
        <ul class="exec-tags" role="list">
          {person.focusAreas.map((area) => (
            <li><a href={area.href} class="tag">{area.label}</a></li>
          ))}
        </ul>
        <div class="exec-socials">
          <span class="exec-social-link is-placeholder" title="LinkedIn — link coming soon">LinkedIn</span>
          <a class="exec-social-link" href="/contact/">Email</a>
        </div>
      </article>
    ))}
  </div>
)}

{group.kind === 'person' && group.person && (
  <div class="exec-panel-person">
    <article class="card card-static exec-profile exec-profile-lg">
      <div class="exec-avatar exec-avatar-xl" aria-hidden="true">{group.person.initials}</div>
      <div class="exec-profile-lg-body">
        <h4>{group.person.name}</h4>
        <p class="exec-role">{group.person.title}</p>
        <p class="exec-bio">{group.person.bio}</p>
        <div class="exec-socials">
          <span class="exec-social-link is-placeholder" title="Details coming soon">LinkedIn</span>
          <a class="exec-social-link" href="/contact/">Email</a>
        </div>
      </div>
    </article>
  </div>
)}

{group.kind === 'network' && group.network && (
  <div class="exec-panel-network">
    <article class="card card-static exec-network-card">
      <p class="exec-network-note">{group.network.note}</p>
      <p class="exec-network-caption">Illustrative coverage areas — existing Terra Nexus capability taxonomy, shown for design-review purposes only.</p>
      <ul class="exec-tags" role="list">
        {group.network.tags.map((tag) => (
          <li><a href={tag.href} class="tag">{tag.label}</a></li>
        ))}
      </ul>
    </article>
  </div>
)}

<style>
  /* Two-person composition (Studio Executives) */
  .exec-panel-people {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 40rem) {
    .exec-panel-people { grid-template-columns: minmax(0, 1fr); }
  }

  .exec-profile { display: flex; flex-direction: column; }
  .exec-avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-dark);
    color: var(--c-accent-400);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
    flex-shrink: 0;
  }
  .exec-role { font-size: var(--text-sm); color: var(--color-text-secondary); margin-top: var(--space-1); }
  .exec-bio { margin-top: var(--space-3); color: var(--color-text-secondary); line-height: var(--line-relaxed); }
  .exec-tags { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .exec-socials { display: flex; gap: var(--space-4); margin-top: var(--space-4); }
  .exec-social-link { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-link); text-decoration: none; }
  .exec-social-link:hover { color: var(--color-link-hover); }
  .exec-social-link.is-placeholder { color: var(--color-text-muted); cursor: not-allowed; }

  /* Single larger composition (Executive in Residence) */
  .exec-profile-lg { flex-direction: row; align-items: flex-start; gap: var(--space-6); max-width: 34rem; }
  @media (max-width: 30rem) { .exec-profile-lg { flex-direction: column; } }
  .exec-avatar-xl { width: 6rem; height: 6rem; font-size: var(--text-2xl); margin-bottom: 0; }
  .exec-profile-lg-body { flex: 1; min-width: 0; }

  /* Network / capability-group composition */
  .exec-network-card { max-width: 40rem; }
  .exec-network-note { color: var(--color-text-secondary); line-height: var(--line-relaxed); }
  .exec-network-caption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .exec-network-card .exec-tags { margin-top: var(--space-4); }
</style>
