---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
const mode = getBuildMode();

// Placeholder solution set — first pass at the product suite visible in
// terranexus-terrain-family-16x9-dark.png (Herds / Paddocks / Fields
// screens). Full per-solution detail pages are a future milestone; this
// page exists so the homepage "See our Digital Solutions" button has a
// real, on-brand destination in the meantime. See CLAUDE.md — no invented
// client/case-study claims; descriptions below only restate what the
// mockup screens themselves show.
const solutions = [
  {
    title: 'Herd Emissions Intelligence',
    summary: 'Enteric methane tracking by herd and cohort, with emission-factor adjustments that hold up to verifier scrutiny.',
  },
  {
    title: 'Grazing & Biomass Monitoring',
    summary: 'Satellite-verified rotational grazing events and biomass recovery, paddock by paddock.',
  },
  {
    title: 'Crop Carbon Intensity',
    summary: 'Field-level GHG breakdowns and volume-weighted carbon intensity, benchmarked against GREET defaults.',
  },
];
---

<SiteLayout
  title="Digital Solutions | Terra Nexus"
  description="Digital MRV and verification tools that turn on-the-ground and remote-sensed data into investment-grade emissions accounting."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Digital Solutions"
    title="Digital Solutions that Catalyze Change"
    lead="It's not what you do, but where, how, and who you partner with that drives results. From digital MRV to next-generation verification systems, we build fit-for-purpose tools that turn on-the-ground and remote-sensed data into investment-grade emissions accounting — the evidence standard 3rd-party verifiers, regulators, investors, and premium buyers expect."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Capabilities', href: '/capabilities/' }}
  />

  <section class="section" aria-labelledby="showcase-heading">
    <div class="container">
      <figure class="solutions-showcase">
        <img
          class="solutions-showcase-image"
          src="/images/live-site/terranexus-terrain-family-16x9-dark.png"
          alt="Three Terra Nexus mobile app screens: enteric emissions tracking with herd composition, a satellite biomass map showing a detected rotational grazing event, and crop carbon intensity with a GHG breakdown."
        />
        <figcaption>Product interfaces shown are in active development.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="solutions-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">The Product Suite</span>
        <h2 id="solutions-heading">Built for Investment-Grade Evidence</h2>
        <p class="section-lead">Detailed product pages are on the way. Here's a first look at what we're building.</p>
      </header>
      <div class="card-grid card-grid-3">
        {solutions.map((solution) => (
          <article class="card solution-card">
            <span class="status-badge">Coming Soon</span>
            <h3>{solution.title}</h3>
            <p>{solution.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container text-center">
      <h2>Discuss Your Challenge</h2>
      <p class="cta-description">Tell us what you are evaluating, building, or trying to improve.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .solutions-showcase {
    margin: 0;
  }
  .solutions-showcase-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  .solutions-showcase figcaption {
    margin-top: var(--space-4);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .solution-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .status-badge {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent-bg);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-full);
  }
  .solution-card h3 { margin-bottom: 0; }
</style>
