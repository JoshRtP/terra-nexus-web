---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
import ClosingCta from '../../components/ClosingCta.astro';
const mode = getBuildMode();

// Visual + copy redesign pass (2026-09-09) — see
// plans/content/digital-solutions-2026-09/README.md for the prior
// capability-grouping rationale (Quantify → Verify → Commercialize, kept
// unchanged this pass) and the task brief that drove this specific rework:
// the owner rejected every "device floating on a synthetic AI-gradient
// scene" image outright, and asked for the framing to move away from
// white-label/brand-flexibility and onto "Terra Nexus builds these tools
// itself to run its own programs."
//
// New asset strategy: transparent, real-photographed device cutouts
// (monitor/phone) composited onto the SITE's own dark surface tokens
// (--color-dark / --gradient-dark), not a rendered gradient backdrop; plus
// one real photographed office-desk composite used once, large, right
// after the hero, as the page's one deliberate "wow" moment. All served as
// WebP with a real srcset ladder (480/960/1440w for device shots,
// 960/1440/1672w for the office-desk composite) copied from
// brand/product-ui/09-web-export/** — see
// plans/content/digital-solutions-2026-09/product-ui-srcset-reference.md
// for the exact markup pattern this is built from.
//
// Every product image is addressed by a stable `tool` id (e.g.
// "dmrv-audit-verification") plus a `kind` ("monitor" | "phone" |
// "office-desk" | "laptop" | "tablet" | "tablet-portrait" | "tablet-split")
// so the colorway switcher's client-side script can reconstruct both `src`
// and `srcset` for any colorway without a full re-render — see the
// `assetFor()` helper in the page script. No invented client/case-study
// claims; descriptions only restate what the mockup screens themselves
// show — see CLAUDE.md.
//
// Device-mix pass (2026-09-10): owner feedback that repeating only
// "phone" (Quantify) and "monitor" (Verify/Commercialize) across all eight
// products read as redundant. Each product below now carries a distinct
// device kind within its section (tablet-portrait, tablet-split, laptop,
// tablet), keeping the same real dashboard content per product — only the
// device photographed around it changed. The closing full-width
// `terranexus-suite-office-ultrawide-*` figure below the Commercialize
// section is a Default-colorway-only asset (no `data-tool`/`data-kind`
// attributes, so the colorway switcher's `[data-tool]` query intentionally
// does not pick it up) bookending the office-desk hero at the top of the
// page.

const quantifySolutions = [
  {
    tool: 'grazing-detection',
    kind: 'phone' as const,
    title: 'Grazing & Biomass Monitoring',
    summary: 'Satellite-verified rotational grazing events and biomass recovery, paddock by paddock.',
    altBase: 'Terra Nexus Grazing Detection tool on a real mobile phone, showing a rotational grazing event on an NDVI paddock map with a 10-week biomass recovery curve.',
  },
  {
    tool: 'enteric-emissions',
    kind: 'tablet-portrait' as const,
    title: 'Herd Emissions Intelligence',
    summary: 'Enteric methane tracking by herd and cohort, with emission-factor adjustments that hold up to verifier scrutiny.',
    altBase: 'Terra Nexus Enteric Emissions tool on a real tablet held in portrait orientation, showing VM0042 herd methane for 350 head across two cohorts with the emission-factor adjustment, the screen filling the height with a workspace column of navigation and activity cards beside it.',
  },
  {
    tool: 'crop-carbon-intensity',
    kind: 'tablet-split' as const,
    title: 'Crop Carbon Intensity',
    summary: 'Field-level GHG breakdowns and volume-weighted carbon intensity, benchmarked against GREET defaults.',
    altBase: 'Terra Nexus Crop Carbon Intensity tool on a real white tablet with a stylus, in landscape split view: GREET volume-weighted carbon intensity for corn with a seven-line GHG breakdown beside a workspace column of navigation and activity cards.',
  },
];

const verifySolutions = [
  {
    tool: 'dmrv-audit-verification',
    kind: 'laptop' as const,
    title: 'Audit & Diligence Verification',
    summary: 'Independent, remote-sensing verification of regenerative practices and soil health indicators (NDVI, tillage, and cover-crop detection), with an audit-ready export a third-party reviewer can act on directly.',
    altBase: 'Terra Nexus Audit & Diligence Verification tool on a real laptop screen, showing cover-crop and tillage classification over a Sentinel-2 field polygon, with a 24-frame MODIS NDVI season curve.',
  },
  {
    tool: 'soil-carbon-prediction',
    kind: 'tablet' as const,
    title: 'Soil Carbon Prediction',
    summary: "Digital soil mapping and biogeochemical modeling that forecasts soil organic carbon trajectories and quantifies the carbon benefit of a practice change before it's implemented.",
    altBase: 'Terra Nexus Soil Carbon Prediction tool on a real tablet in landscape orientation, showing a 50-year six-model ensemble with 1,000 Monte Carlo iterations, SOC trajectories and benefit and economic-value distributions, top-aligned with a compact workspace strip (projects, season summary, recent runs, alerts, data sources) beneath it.',
  },
];

const commercializeSolutions = [
  {
    tool: 'biofuels-origination',
    kind: 'monitor' as const,
    eyebrow: 'Feedstock Sourcing',
    title: 'Biofuels Origination Economics',
    summary: 'Low-carbon-intensity feedstock evaluation for biofuel producers, mapping supply against processing capacity so sourcing decisions are grounded in where the qualifying material actually is.',
    altBase: 'Terra Nexus Biofuels Origination Economics tool on a real desktop monitor, showing a US county-level heat map of carbon-intensity impact for corn feedstock under a cover-crop and no-till scenario, with county results and feedstock-to-facility mapping actions.',
    // Bullets paraphrase real capabilities from plans/content/digital-solutions-2026-09/
    // product-ui-mockup-brief.md §4.2 — no invented figures, no raw KPI dump.
    bullets: [
      '~800 counties evaluated against real carbon-intensity deltas, not a blanket regional estimate.',
      'Maps qualifying feedstock straight to processing capacity, so sourcing decisions start from where the material actually is.',
      'Every scenario carries its own side-by-side 45Z and incentive comparison, not a generic one-size-fits-all estimate.',
    ],
  },
  {
    tool: 'asset-pricing-optimization',
    kind: 'tablet' as const,
    eyebrow: 'Insetting Economics',
    title: 'Environmental Asset Pricing & Stranded Claims Optimization',
    summary: 'Optimizes bid allocation and carbon-development economics across an insetting program, and surfaces the value left on the table when eligible supply goes undeveloped.',
    altBase: "Terra Nexus Environmental Asset Pricing & Stranded Claims Optimization tool on a real tablet in landscape orientation, showing a supply-to-demand insetting allocation with the unenrolled farm's stranded claim broken out.",
    // §4.5 — no raw KPI dump (e.g. exact dollar figures), paraphrased.
    bullets: [
      'Surfaces the dollar value of undeveloped supply, not just what’s enrolled.',
      'Optimizes bid allocation across an insetting program’s full supply-to-demand pool, not farm by farm.',
      'Quantifies exactly what enrolling the next farm would add to a program’s reduction rate.',
    ],
  },
  {
    tool: 'food-waste-platform',
    kind: 'laptop' as const,
    eyebrow: 'Food Waste Credits',
    title: 'Food Waste Collaboration Platform',
    summary: 'Quantifies prevented food-waste reductions under VM0046 and converts them into carbon credits and monetized value across the supply chain.',
    altBase: 'Terra Nexus Food Waste Collaboration Platform tool on a real laptop screen, showing a simulated food-system waste flow, the gross-to-issuable credit waterfall, and 10-year stakeholder economics under VM0046.',
    // §4.4 — no raw KPI dump, paraphrased.
    bullets: [
      'Reconciles diverted volume to monetized, VM0046-aligned credits.',
      'Tracks food from origin through shipped, accepted, and sold, accounting for what’s donated versus diverted along the way.',
      'Splits verified value across solution provider, CPG-farmer, and administrator on a transparent, auditable basis.',
    ],
  },
];

const colorways = [
  { id: 'default', label: 'Default' },
  { id: 'terrain', label: 'Terrain' },
  { id: 'copper', label: 'Copper' },
  { id: 'slate', label: 'Slate' },
];
const DEFAULT_COLORWAY = 'terrain'; // matches what has been live on this page

// Server-side mirror of the client `assetFor()` helper below — kept in
// sync manually (see that function's own comment for why it isn't shared
// via a module import).
const DEVICE_WIDTHS = [480, 960, 1440];
const OFFICE_DESK_WIDTHS = [960, 1440, 1672];
type Kind = 'monitor' | 'phone' | 'office-desk' | 'laptop' | 'tablet' | 'tablet-portrait' | 'tablet-split';
function assetFor(colorway: string, tool: string, kind: Kind) {
  const widths = kind === 'office-desk' ? OFFICE_DESK_WIDTHS : DEVICE_WIDTHS;
  const prefix = colorway === 'default' ? '' : `${colorway}-`;
  const suffix = kind === 'office-desk' ? 'office-desk' : kind;
  const base = `terranexus-${prefix}${tool}-${suffix}`;
  const srcset = widths.map((w) => `/images/product-ui/${base}-${w}w.webp ${w}w`).join(', ');
  const src = `/images/product-ui/${base}-${widths[widths.length - 1]}w.webp`;
  return { src, srcset };
}
function dims(kind: Kind): { width: number; height: number } {
  if (kind === 'office-desk') return { width: 1672, height: 941 };
  if (kind === 'phone') return { width: 1520, height: 2780 };
  if (kind === 'tablet-portrait') return { width: 1740, height: 2400 };
  return { width: 2400, height: 1740 };
}
const SIZES = '(max-width: 900px) 100vw, 1440px';
---

<SiteLayout
  title="Digital Solutions | Terra Nexus"
  description="The fit-for-purpose digital tools Terra Nexus builds to run its own carbon, food-system, and verification programs: quantify, verify, and commercialize environmental outcomes."
  preview={mode === 'preview'}
>
  <!-- Scroll progress bar — copied 1:1 (markup/CSS/JS) from
       about/index.astro (itself copied from
       expertise/regenerative-agriculture/index.astro): a live scroll-
       position readout, not scroll-hijacking. -->
  <div class="scroll-progress" aria-hidden="true">
    <div class="scroll-progress-fill" data-scroll-progress-fill></div>
  </div>

  <!-- Journey rail — adapted from about/index.astro's sticky Origin Story
       chapter rail (`data-origin-rail`/`data-origin-chapter`/
       `data-origin-number`). The shape doesn't fit verbatim: About's rail
       sits beside a single dark section's prose chapters in a shared grid;
       this page's three stages (Quantify/Verify/Commercialize) are
       separate top-level <section> elements with alternating
       light/section-alt backgrounds spanning the full container width, so
       there's no single wrapping column to put a grid-sibling rail into
       without either breaking those full-bleed section backgrounds or
       shrinking their content width. Instead this is a fixed-position rail
       anchored to the viewport edge, using the exact same centered-band
       IntersectionObserver technique (see script below) to mark whichever
       of the three sections is centered as active. This is a legitimate
       numbered sequence (quantify → verify → commercialize is a real
       pipeline order, not decorative), so a persistent "you are here"
       indicator is earned — see task brief. Hidden below 56rem (matches
       the breakpoint where about/index.astro's own rail drops its sticky
       side-column treatment) rather than converted to a horizontal bar:
       unlike the Origin Story rail, there's no single content column this
       rail could sit inline within (it spans three full-bleed sections),
       so removing the "persistent side rail eating horizontal space"
       problem outright (hide it) follows the same underlying judgment call
       About's own mobile treatment makes, adapted to a shape without a
       natural inline insertion point. -->
  <nav class="journey-rail" data-journey-rail aria-label="Product suite stages">
    <ol class="journey-rail-list" role="list">
      <li>
        <button type="button" class="journey-rail-item" data-journey-rail-item data-journey-index="0">
          <span class="journey-rail-num" aria-hidden="true">01</span>
          <span class="journey-rail-label">Quantify</span>
        </button>
      </li>
      <li>
        <button type="button" class="journey-rail-item" data-journey-rail-item data-journey-index="1">
          <span class="journey-rail-num" aria-hidden="true">02</span>
          <span class="journey-rail-label">Verify</span>
        </button>
      </li>
      <li>
        <button type="button" class="journey-rail-item" data-journey-rail-item data-journey-index="2">
          <span class="journey-rail-num" aria-hidden="true">03</span>
          <span class="journey-rail-label">Commercialize</span>
        </button>
      </li>
    </ol>
  </nav>

  <PageHero
    eyebrow="Digital Solutions"
    title="Tools We Built Because the Work Demanded Them"
    lead="Terra Nexus is an Innovation & Insight Studio that advises, manages, and operates climate and food-system programs, not a software vendor. Running that work at investment grade meant building instruments that did not exist off the shelf, so our own team built them: eight proprietary tools that quantify what is happening on the ground, verify it holds up to scrutiny, and commercialize the result into credits, contracts, and value. Every one stays in the hands of the same team that is accountable for the program it supports."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Capabilities', href: '/capabilities/' }}
  />

  <section class="section" aria-labelledby="showcase-heading">
    <div class="container">
      <figure class="solutions-showcase solutions-showcase-hero" data-reveal>
        {(() => {
          const asset = assetFor(DEFAULT_COLORWAY, 'dmrv-audit-verification', 'office-desk');
          const d = dims('office-desk');
          const altBase = "A real office desk with an ultrawide monitor showing the Terra Nexus Audit & Diligence Verification tool: field NDVI, cover-crop and tillage classification, and a season-long biomass curve, with the Flatirons visible through the window behind it.";
          return (
            <img
              class="product-ui-img"
              id="showcase-heading-img"
              data-tool="dmrv-audit-verification"
              data-kind="office-desk"
              data-alt-base={altBase}
              src={asset.src}
              srcset={asset.srcset}
              sizes={SIZES}
              width={d.width}
              height={d.height}
              loading="eager"
              decoding="async"
              alt={`${altBase} Terrain colorway.`}
            />
          );
        })()}
        <figcaption class="solutions-showcase-caption" id="showcase-heading">This is a real desk, not a rendered scene. It is where the evidence from all eight tools below gets reviewed and exported before it goes to a verifier.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="suite-heading">
    <div class="container">
      <header class="section-header text-center">
        <span class="eyebrow" data-reveal>The Full Suite</span>
        <h2 id="suite-heading" data-reveal>Eight Tools, One Evidence Chain</h2>
        <p class="section-lead section-lead-centered" data-reveal>We did not buy this suite or white label someone else's platform. We built it because running a real environmental-outcomes program end to end meant we needed instruments that matched exactly how our programs get verified and paid, not a generic dashboard retrofitted to fit. It is organized the way a program actually runs, not by device tier: <strong>quantify</strong> what is happening on the ground, <strong>verify</strong> it holds up to scrutiny, then <strong>commercialize</strong> the result into credits, contracts, and value.</p>
      </header>
    </div>
  </section>

  <section class="section" aria-labelledby="quantify-heading" data-journey-section data-journey-index="0">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow" data-reveal>Quantify</span>
        <h2 id="quantify-heading" data-reveal>Turn Field and Herd Activity Into a Verifiable Number</h2>
        <p class="section-lead" data-reveal>Every program we run starts with the same measurement problem: what is happening on the ground, and how much of it counts. We built these tools to capture that activity directly: grazing events and biomass recovery from satellite, enteric methane by herd and cohort, field-level carbon intensity. Each one produces a base figure a verifier can trace back to source.</p>
      </header>

      <div class="quantify-viewer" data-reveal>
        <div class="quantify-tabs" role="tablist" aria-label="Quantify products">
          {quantifySolutions.map((solution, i) => (
            <button
              type="button"
              class="quantify-tab"
              class:list={{ 'is-active': i === 0 }}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="quantify-panel"
              id={`quantify-tab-${i}`}
              tabindex={i === 0 ? '0' : '-1'}
              data-index={i}
              data-tool={solution.tool}
              data-kind={solution.kind}
              data-title={solution.title}
              data-desc={solution.summary}
              data-alt-base={solution.altBase}
            >
              {solution.title}
            </button>
          ))}
        </div>

        <div class="quantify-panel" id="quantify-panel" role="tabpanel" aria-labelledby="quantify-tab-0">
          <figure class="quantify-viewer-media">
            {(() => {
              const first = quantifySolutions[0];
              const asset = assetFor(DEFAULT_COLORWAY, first.tool, first.kind);
              const d = dims(first.kind);
              return (
                <img
                  class="product-ui-img quantify-viewer-img"
                  data-tool={first.tool}
                  data-kind={first.kind}
                  data-alt-base={first.altBase}
                  src={asset.src}
                  srcset={asset.srcset}
                  sizes={SIZES}
                  width={d.width}
                  height={d.height}
                  loading="lazy"
                  decoding="async"
                  alt={`${first.altBase} Terrain colorway.`}
                />
              );
            })()}
          </figure>
          <div class="quantify-viewer-copy">
            <h3 id="quantify-viewer-title">{quantifySolutions[0].title}</h3>
            <p id="quantify-viewer-desc">{quantifySolutions[0].summary}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="verify-heading" data-journey-section data-journey-index="1">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow" data-reveal>Verify</span>
        <h2 id="verify-heading" data-reveal>Make the Evidence Hold Up to a Third Party</h2>
        <p class="section-lead" data-reveal>A number is only as good as what backs it up. We built these tools to produce the audit-ready record and the pre-commitment modeling our own programs' verifiers and investors need: remote-sensing evidence of the practice detected in the field, and biogeochemical forecasting that quantifies a soil carbon benefit before a program commits to it.</p>
      </header>

      <div class="card-grid card-grid-3">
        {verifySolutions.map((solution, i) => {
          const asset = assetFor(DEFAULT_COLORWAY, solution.tool, solution.kind);
          const d = dims(solution.kind);
          return (
            <article class="card card-static card-media solution-card-media" data-reveal style={`--reveal-i: ${i}`}>
              <img
                class="product-ui-img"
                data-tool={solution.tool}
                data-kind={solution.kind}
                data-alt-base={solution.altBase}
                src={asset.src}
                srcset={asset.srcset}
                sizes={SIZES}
                width={d.width}
                height={d.height}
                loading="lazy"
                decoding="async"
                alt={`${solution.altBase} Terrain colorway.`}
              />
              <div class="card-media-body">
                <h3>{solution.title}</h3>
                <p>{solution.summary}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="commercialize-heading" data-journey-section data-journey-index="2">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow" data-reveal>Commercialize</span>
        <h2 id="commercialize-heading" data-reveal>Convert Verified Performance Into Market Value</h2>
        <p class="section-lead" data-reveal>Once activity is measured and the evidence holds up, it has to become something transactable: credits, contracts, or margin. We built these tools to price low-carbon feedstock against real supply, to work out what an environmental asset is worth and what is left on the table when it goes undeveloped, and to turn prevented food waste into monetized, verified credits.</p>
      </header>

      <div class="product-rows">
        {commercializeSolutions.map((solution, i) => {
          const asset = assetFor(DEFAULT_COLORWAY, solution.tool, solution.kind);
          const d = dims(solution.kind);
          return (
            <article class="product-row" data-reveal style={`--reveal-i: ${i}`}>
              <figure class="product-row-media">
                <img
                  class="product-ui-img"
                  data-tool={solution.tool}
                  data-kind={solution.kind}
                  data-alt-base={solution.altBase}
                  src={asset.src}
                  srcset={asset.srcset}
                  sizes={SIZES}
                  width={d.width}
                  height={d.height}
                  loading="lazy"
                  decoding="async"
                  alt={`${solution.altBase} Terrain colorway.`}
                />
              </figure>
              <div class="product-row-copy">
                <span class="eyebrow">{solution.eyebrow}</span>
                <h3>{solution.title}</h3>
                <p>{solution.summary}</p>
                <ul class="product-row-bullets">
                  {solution.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="suite-closing-heading">
    <div class="container">
      <figure class="solutions-showcase solutions-showcase-suite" data-reveal>
        <img
          class="product-ui-img"
          src="/images/product-ui/terranexus-suite-office-ultrawide-1920w.webp"
          srcset="/images/product-ui/terranexus-suite-office-ultrawide-960w.webp 960w, /images/product-ui/terranexus-suite-office-ultrawide-1440w.webp 1440w, /images/product-ui/terranexus-suite-office-ultrawide-1920w.webp 1920w"
          sizes={SIZES}
          width="3832"
          height="1642"
          loading="lazy"
          decoding="async"
          alt="A real office desk with an ultrawide monitor showing three Terra Nexus dashboards side by side on one screen: a soil-health map, a set of GHG and Monte Carlo charts, and an asset-pricing flow diagram, with a taskbar along the bottom and the same window and mountain view behind it as the desk hero above."
        />
        <figcaption class="solutions-showcase-caption" id="suite-closing-heading">Same desk, same evidence chain, this time with the whole suite open at once. It is one connected workspace, not eight separate products bolted together.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-alt colorway-footnote-section" aria-labelledby="colorway-footnote-heading">
    <div class="container">
      <div class="colorway-switcher" data-colorway-switcher>
        <p class="colorway-switcher-copy" id="colorway-footnote-heading">Also available in your organization's colors.</p>
        <div class="colorway-options" role="radiogroup" aria-label="Preview a dashboard colorway">
          {colorways.map((cw) => (
            <button
              type="button"
              class="colorway-option"
              role="radio"
              data-colorway={cw.id}
              aria-checked={cw.id === DEFAULT_COLORWAY ? 'true' : 'false'}
              aria-label={`${cw.label} colorway`}
              tabindex={cw.id === DEFAULT_COLORWAY ? 0 : -1}
            >
              <span class={`colorway-chip colorway-chip-${cw.id}`} aria-hidden="true"></span>
              <span class="colorway-name">{cw.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="Discuss Your Challenge"
    description="Tell us what you are evaluating, building, or trying to improve."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
  />
</SiteLayout>

<style>
  .solutions-showcase {
    margin: 0;
  }
  .solutions-showcase-hero img,
  .solutions-showcase-suite img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }
  .section-lead-centered {
    margin-inline: auto;
  }
  .solutions-showcase-caption {
    margin-top: var(--space-4);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-style: italic;
    max-width: var(--max-width-text, 42rem);
    margin-inline: auto;
  }

  /* ── Quantify tabbed viewer — Fix 2, 2026-09-09. Reuses the tab-interaction
     idiom already established by index.astro's How We Work
     `.approach-track`/`.approach-stop` pattern (role="tablist"/"tab",
     aria-selected, roving tabindex) rather than inventing a new one; the
     visual treatment here is page-local because this section's light
     background differs from that pattern's dark `.approach-card`. ── */
  .quantify-viewer {
    margin: 0 0 var(--space-4);
  }
  .quantify-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .quantify-tab {
    padding: var(--space-3) var(--space-6);
    background: var(--color-surface-elevated);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast),
                box-shadow var(--transition-fast);
  }
  .quantify-tab:hover {
    border-color: var(--c-sky-300);
    color: var(--color-text);
  }
