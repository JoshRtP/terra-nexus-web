---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
import ClosingCta from '../../components/ClosingCta.astro';
const mode = getBuildMode();

// Product suite rebuild (2026-09-08) — see
// plans/content/digital-solutions-2026-09/README.md for the full brief.
// Tier 1 (field/herd, phone-screen products) copy is carried over verbatim
// from the original placeholder. Tier 2 (analyst-grade desktop products) is
// new copy drafted directly from the dashboard screenshots. Full
// per-solution detail pages remain a future milestone (out of scope here).
// See CLAUDE.md — no invented client/case-study claims; descriptions only
// restate what the mockup screens themselves show.
const fieldSolutions = [
  {
    title: 'Herd Emissions Intelligence',
    summary: 'Enteric methane tracking by herd and cohort, with emission-factor adjustments that hold up to verifier scrutiny.',
  },
  {
    title: 'Grazing & Biomass Monitoring',
    summary: 'Satellite-verified rotational grazing events and biomass recovery, paddock by paddock.',
  },
  {
    title: 'Crop Carbon Intensity',
    summary: 'Field-level GHG breakdowns and volume-weighted carbon intensity, benchmarked against GREET defaults.',
  },
];

const analystSolutions = [
  {
    title: 'Audit & Diligence Verification',
    summary: "Independent, remote-sensing-based verification of regenerative practices and soil health indicators — NDVI, tillage, and cover-crop detection — with an audit-ready export a third-party reviewer can act on directly.",
    image: '/images/live-site/terranexus-dmrv-audit-verification-16x9-dark.png',
    imageAlt: 'Terra Nexus audit and diligence verification dashboard showing a field boundary with NDVI vegetation-index imagery, cover-crop and tillage classification, a 24-frame MODIS NDVI time series, and soil covariates, with an export-audit-package action.',
  },
  {
    title: 'Soil Carbon Prediction',
    summary: 'Digital soil mapping and biogeochemical modeling that forecasts soil organic carbon trajectories and quantifies the carbon benefit of a practice change before it’s implemented.',
    image: '/images/live-site/terranexus-soil-carbon-prediction-16x9-dark.png',
    imageAlt: 'Terra Nexus soil carbon prediction dashboard showing project-versus-baseline soil organic carbon trajectories over 50 years, a carbon sequestration benefit curve, and a calibrated soil-carbon-model library with validated scenario presets.',
  },
  {
    title: 'Feedstock Origination Mapping',
    summary: 'Maps low-carbon-intensity feedstock supply against processing capacity, so sourcing decisions are grounded in where the qualifying material actually is.',
    image: '/images/live-site/terranexus-biofuels-origination-16x9-dark.png',
    imageAlt: 'Terra Nexus feedstock origination dashboard showing a U.S. county-level heat map of carbon-intensity impact for corn feedstock under a cover-crop and no-till scenario, with county results and feedstock-to-facility mapping actions.',
  },
];
---

<SiteLayout
  title="Digital Solutions | Terra Nexus"
  description="Digital MRV and verification tools that turn on-the-ground and remote-sensed data into investment-grade emissions accounting."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Digital Solutions"
    title="Digital Solutions that Catalyze Change"
    lead="From digital MRV to next-generation verification systems, we build fit-for-purpose tools that turn on-the-ground and remote-sensed data into investment-grade emissions accounting — the evidence standard 3rd-party verifiers, regulators, investors, and premium buyers expect."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Capabilities', href: '/capabilities/' }}
  />

  <section class="section" aria-labelledby="field-heading">
    <div class="container">
      <figure class="solutions-showcase">
        <img
          class="solutions-showcase-image"
          src="/images/live-site/terranexus-terrain-family-16x9-dark.png"
          alt="Three Terra Nexus mobile app screens: enteric emissions tracking with herd composition, a satellite biomass map showing a detected rotational grazing event, and crop carbon intensity with a GHG breakdown."
        />
      </figure>
      <header class="section-header">
        <span class="eyebrow">Field &amp; Herd Intelligence</span>
        <h2 id="field-heading">Built for Investment-Grade Evidence</h2>
        <p class="section-lead">On-the-ground data capture and satellite monitoring, purpose-built for herds, paddocks, and fields.</p>
      </header>
      <div class="card-grid card-grid-3">
        {fieldSolutions.map((solution) => (
          <article class="card solution-card">
            <h3>{solution.title}</h3>
            <p>{solution.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="analyst-heading">
    <div class="container">
      <figure class="solutions-showcase">
        <img
          class="solutions-showcase-image"
          src="/images/live-site/terranexus-desktop-suite-16x9-dark.png"
          alt="Three Terra Nexus desktop dashboards on separate monitors: soil carbon prediction with sequestration trajectories, audit and diligence verification with field NDVI imagery, and feedstock origination economics with a county-level carbon-intensity map."
        />
      </figure>
      <header class="section-header">
        <span class="eyebrow">Analyst-Grade Verification &amp; Modeling</span>
        <h2 id="analyst-heading">Desktop Tools for Diligence and Origination</h2>
        <p class="section-lead">Remote-sensing verification, biogeochemical modeling, and origination economics, built for analysts and third-party reviewers.</p>
      </header>
      <div class="card-grid card-grid-3">
        {analystSolutions.map((solution) => (
          <article class="card card-media solution-card-media">
            <img src={solution.image} alt={solution.imageAlt} loading="lazy" />
            <div class="card-media-body">
              <h3>{solution.title}</h3>
              <p>{solution.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta
    heading="Discuss Your Challenge"
    description="Tell us what you are evaluating, building, or trying to improve."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
  />
</SiteLayout>

<style>
  .solutions-showcase {
    margin: 0 0 var(--space-12);
  }
  .solutions-showcase-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .solution-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .solution-card h3 { margin-bottom: 0; }

  .solution-card-media .card-media-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .solution-card-media h3 { margin-bottom: 0; }
</style>
