---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBuildMode } from '../lib/build-mode.js';
import { compileForBuild } from '../lib/okf/build.js';
import { selectCaseStudyPages } from '../lib/okf/case-study-pages.js';

const mode = getBuildMode();
const compilation = await compileForBuild(mode);
const caseStudies = selectCaseStudyPages(compilation);
const hasCaseStudy = caseStudies.length > 0;

const expertiseAreas = [
  { title: 'Regenerative Agriculture', slug: 'regenerative-agriculture', description: 'Connect better crop-production systems with producer economics, supply-chain requirements, credible evidence, and market value.' },
  { title: 'Regenerative Rangeland', slug: 'regenerative-rangeland', description: 'Build resilient grazing and livestock systems that improve land performance, producer value, and downstream market opportunities.' },
  { title: 'Agroforestry', slug: 'agroforestry', description: 'Integrate trees, crops, livestock, long-term land value, environmental outcomes, and reliable routes to market.' },
  { title: 'Aquaculture', slug: 'aquaculture', description: 'Improve aquatic production, feed, operations, traceability, environmental performance, product strategy, and market access.' },
  { title: 'Biodiversity & Ecosystem Resilience', slug: 'biodiversity-and-ecosystem-resilience', description: 'Translate nature dependencies, impacts, risks, and opportunities into prioritized business and landscape action.' },
  { title: 'Sustainable Supply Chains', slug: 'sustainable-supply-chains', description: 'Connect responsible production with sourcing, traceability, operations, environmental attributes, products, customers, and credible claims.' },
  { title: 'Low Carbon Energy & Biofuels', slug: 'low-carbon-energy-and-biofuels', description: 'Create more value from feedstock, origination, processing, carbon-intensity, chain-of-custody, and regulatory opportunities.' },
  { title: 'Purpose-Driven Food Brands & Retailers', slug: 'purpose-driven-food-brands-and-retailers', description: 'Turn better products and sourcing into customer value through credible product, portfolio, pricing, channel, and claims strategies.' },
  { title: 'Food Waste: Prevention, Diversion & Recovery', slug: 'food-waste-prevention-diversion-recovery', description: 'Prevent loss, keep edible food in use, create value from byproducts, and recover remaining resources through the highest practical use.' },
];

const capabilities = [
  { title: 'Strategy & Innovation', slug: 'strategy-and-innovation', question: 'Where should we play, and how do we win at the intersection of food and climate?', description: 'Determine where to play, how to win, and how to create differentiated growth at the intersection of food and climate.' },
  { title: 'Financial Investments & New Venture Development', slug: 'financial-investments-and-new-venture-development', question: 'Which ideas, ventures, investments, assets, partnerships, or facilities should be screened, funded, incubated, acquired, or scaled?', description: 'Screen, value, fund, structure, incubate, acquire, and scale food, agriculture, climate, nature, and circularity opportunities.' },
  { title: 'Sustainable Supply Chain & Operations', slug: 'sustainable-supply-chain-and-operations', question: 'How can impact, risk, cost, and volatility be reduced by changing what is bought and how it is produced, moved, processed, used, or recovered?', description: 'Reduce impact, risk, cost, and volatility by changing what is sourced and how it is produced, moved, processed, used, and recovered.' },
  { title: 'Corporate Sustainability', slug: 'corporate-sustainability', question: 'How should the enterprise set targets and policies, prioritize action, account for progress, manage claims, and report performance?', description: 'Set enterprise ambition, prioritize action, account for progress, govern claims, engage stakeholders, and report performance.' },
  { title: 'Carbon & Ecosystem Services', slug: 'carbon-and-ecosystem-services', question: 'How are environmental assets, attributes, credits, insets, offsets, and claims created, accessed, valued, verified, accounted for, managed, and monetized?', description: 'Create, access, value, verify, account for, manage, and commercialize environmental assets, attributes, credits, insets, offsets, and claims.' },
];
---

<SiteLayout
  title="Terra Nexus — Impact at the Intersection of Food & Climate"
  description="Terra Nexus provides the insights, tools, and supporting capabilities food and agribusiness companies need to achieve commercial success while building a more resilient, sustainable, and prosperous food system."
  preview={mode === 'preview'}
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="hero-eyebrow">An Innovation &amp; Insights Studio</span>
      <h1 id="hero-heading">Impact at the Intersection of <span class="hero-highlight">Food &amp; Climate</span></h1>
      <p class="hero-engagement">We advise and manage commercial sustainability programs at scale.</p>
      <p class="hero-supporting">
        Terra Nexus provides the insights, tools, and supporting capabilities food and agribusiness companies need to achieve commercial success while building a more resilient, sustainable, and prosperous food system.
      </p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary btn-lg">Discuss Your Challenge</a>
        <a href="/expertise/" class="btn btn-secondary btn-lg">Explore Our Expertise</a>
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="section" aria-labelledby="expertise-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">What We Are Known For</span>
        <h2 id="expertise-heading">Expertise Across the Food and Agriculture System</h2>
        <p class="section-lead">We bring specialized food-and-climate knowledge to the production systems, supply chains, markets, products, and recovery pathways where change can create the greatest value.</p>
      </header>

      <div class="expertise-list">
        {expertiseAreas.map((area, i) => (
          <a href={`/expertise/${area.slug}/`} class="expertise-item">
            <span class="expertise-number">{String(i + 1).padStart(2, '0')}</span>
            <div class="expertise-content">
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </div>
            <span class="expertise-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>

      <div class="section-cta">
        <a href="/expertise/" class="btn btn-secondary">Explore All Areas of Expertise</a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section section-alt" aria-labelledby="capabilities-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Capabilities</span>
        <h2 id="capabilities-heading">Capabilities from Strategy Through Execution</h2>
        <p class="section-lead">Terra Nexus combines five capability families so clients can move from an opportunity or challenge to an operating, supportable, and commercially valuable solution.</p>
      </header>

      <div class="card-grid">
        {capabilities.map((cap) => (
          <a href={`/capabilities/${cap.slug}/`} class="card-link">
            <article class="card">
              <h3>{cap.title}</h3>
              <p class="capability-question">{cap.question}</p>
              <p>{cap.description}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="section-cta">
        <a href="/capabilities/" class="btn btn-secondary">Explore Our Capabilities</a>
      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="section" aria-labelledby="audiences-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Who We Work With</span>
        <h2 id="audiences-heading">We Work Across the Food and Agribusiness System</h2>
        <p class="section-lead">Terra Nexus works with every node of the food and agribusiness value chain — from inputs and agricultural production through trading, processing, brands, retail, energy, and resource recovery. We also work with the environmental markets, technology providers, assurance organizations, and capital partners that enable the system to change.</p>
      </header>

      <div class="diagram-container">
        <img
          src="/diagrams/value-chain-with-associated-enablers.png"
          alt="Food and agribusiness value chain diagram showing eight value-chain segments (Inputs, Agricultural Production, Commodity Trading, Ingredient & Feed Processing, Food & Beverage, Food Retail & Distribution, Energy & Biofuels, Food Waste Prevention Diversion & Recovery) and three enabling groups (Environmental Markets & Ecosystem Services, Enabling Tech & Solution Providers, Private Equity Venture Capital & Impact Investors)."
          loading="lazy"
          width="1200"
          height="400"
          class="diagram-img"
        />
      </div>

      <div class="card-grid">
        <a href="/who-we-work-with/food-and-agribusiness-value-chain/" class="card-link">
          <article class="card">
            <h3>Food &amp; Agribusiness Value Chain</h3>
            <p>Work with the organizations that produce, move, transform, sell, distribute, and recover food and agricultural materials.</p>
          </article>
        </a>
        <a href="/who-we-work-with/enabling-markets-technology-and-capital/" class="card-link">
          <article class="card">
            <h3>Enabling Markets, Technology &amp; Capital</h3>
            <p>Work with the organizations that provide environmental markets, data, technology, assurance, partnerships, and investment.</p>
          </article>
        </a>
      </div>

      <div class="section-cta">
        <a href="/who-we-work-with/" class="btn btn-secondary">See Who We Work With</a>
      </div>
    </div>
  </section>

  <!-- How We Create Value -->
  <section class="section section-alt" aria-labelledby="value-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">How We Create Value</span>
        <h2 id="value-heading">From Improved Performance to the Right Market Value</h2>
        <p class="section-lead">Improving performance does not automatically create value. The same operational or environmental improvement may support participation in a program, a certification, a product claim, a Scope 3 reduction, an inset, a tradable environmental asset, a regulatory incentive, corporate reporting, or greater resilience and supply security.</p>
        <p class="section-lead">Terra Nexus helps clients connect fit-for-purpose changes with the evidence, collaboration, operating model, and market mechanisms required to create the highest-value supportable outcome across the participants needed to deliver it.</p>
      </header>

      <div class="value-pillars">
        <article class="value-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M3 12h18" /><circle cx="12" cy="12" r="9" /></svg>
          </div>
          <h3>Transparency</h3>
          <p>Clarify the performance, evidence, costs, ownership, risks, and value available to each participant.</p>
        </article>
        <article class="value-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3" /><circle cx="15" cy="15" r="3" /><path d="M9 15v3M15 6v3" /></svg>
          </div>
          <h3>Collaboration</h3>
          <p>Align the producers, suppliers, traders, processors, brands, retailers, technology providers, investors, and market partners required to make the solution work.</p>
        </article>
        <article class="value-pillar">
          <div class="pillar-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12a10 10 0 0 0 20 0M2 12a10 10 0 0 1 20 0" /><path d="M12 2a10 10 0 0 0 0 20M12 2a10 10 0 0 1 0 20" /></svg>
          </div>
          <h3>Market Mechanisms</h3>
          <p>Design incentives, commercial structures, claims, attributes, and routes to market that reward the participants whose actions create the value.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How We Engage -->
  <section class="section" aria-labelledby="engage-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">How We Engage</span>
        <h2 id="engage-heading">From Advisory to Embedded Management</h2>
        <p class="section-lead">Terra Nexus offers two standard client engagement models so clients can start where the decision is and scale to the level of support the work requires.</p>
      </header>

      <div class="engage-grid">
        <article class="engage-card">
          <span class="engage-label">01</span>
          <h3>Advise</h3>
          <p>Terra Nexus helps clients evaluate decisions, opportunities, risks, markets, economics, technologies, partners, programs, claims, and strategies.</p>
        </article>
        <article class="engage-card">
          <span class="engage-label">02</span>
          <h3>Manage</h3>
          <p>Terra Nexus acts as an operating partner for a client-owned program or defined workstream, coordinating recurring work, data, partners, reporting, and continuous improvement.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Case Study -->
  {hasCaseStudy && (
    <section class="section section-alt" aria-labelledby="proof-heading">
      <div class="container">
        <header class="section-header">
          <span class="eyebrow">Proven Commercial Impact</span>
          <h2 id="proof-heading">Evaluating Commercial Pathways for Lower-Emissions Beef</h2>
          <p class="section-lead">For a global agricultural trading company, Terra Nexus connected methodology, claims, market readiness, competitive positioning, and commercialization strategy for a proprietary feed-optimization solution.</p>
        </header>

        <div class="stat-group">
          <div class="stat">
            <p class="stat-value">$12.5M</p>
            <p class="stat-label">Annual recurring contract value</p>
          </div>
          <div class="stat">
            <p class="stat-value">8.25%</p>
            <p class="stat-label">Normalized margin improvement</p>
          </div>
        </div>

        <p class="proof-note">Both results were modeled and subsequently achieved.</p>

        <div class="section-cta">
          <a href={caseStudies[0]?.route ?? '/case-studies/'} class="btn btn-primary">Read the Case Study</a>
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <section class="section section-dark" aria-labelledby="final-cta-heading">
    <div class="container text-center">
      <h2 id="final-cta-heading">Build the Right Path from Opportunity to Value</h2>
      <p class="cta-description">Whether the starting point is a sourcing challenge, environmental program, technology, investment, new product, regulatory opportunity, or operating problem, Terra Nexus helps determine what should happen next and how the participants required to deliver it can share in the value.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* Hero */
  .hero {
    position: relative; overflow: hidden;
    padding-block: var(--space-32) var(--space-24);
    background: var(--gradient-hero); color: #fff;
  }
  .hero-bg {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 20%, rgba(13, 148, 136, 0.15) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 20% 80%, rgba(13, 148, 136, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .hero-grid {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 30%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 30%, #000 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-content { position: relative; }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--c-primary-300); margin-bottom: var(--space-5);
  }
  .hero-eyebrow::before {
    content: ''; display: inline-block; width: 1.5rem; height: 2px;
    background: var(--c-primary-400); border-radius: var(--radius-full);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 5.5vw, var(--text-6xl));
    color: #fff; line-height: 1.05; max-width: 24ch;
    margin-bottom: var(--space-5);
  }
  .hero-highlight {
    background: var(--gradient-accent);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-engagement {
    font-size: var(--text-2xl); font-weight: var(--font-medium);
    color: var(--c-secondary-200); margin-bottom: var(--space-4);
    max-width: var(--max-width-text);
  }
  .hero-supporting {
    font-size: var(--text-lg); color: var(--c-secondary-400);
    max-width: var(--max-width-text); line-height: var(--line-relaxed);
  }
  .hero .hero-actions { margin-top: var(--space-10); }
  .btn-lg { padding: var(--space-4) var(--space-8); font-size: var(--text-lg); }
  .hero .btn-secondary {
    background: transparent; color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .hero .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4); color: #fff;
  }

  /* Expertise list */
  .expertise-list { display: flex; flex-direction: column; border-top: 1px solid var(--color-border); }
  .expertise-item {
    display: flex; align-items: flex-start; gap: var(--space-4);
    padding: var(--space-5) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none; color: inherit;
    transition: padding var(--transition-base), background var(--transition-base);
  }
  .expertise-item:hover {
    background: var(--color-surface);
    padding-left: var(--space-5); padding-right: var(--space-5);
  }
  .expertise-number {
    font-family: var(--font-serif); font-size: var(--text-lg);
    font-weight: var(--font-semibold); color: var(--color-text-muted);
    flex-shrink: 0; min-width: 2.5rem; transition: color var(--transition-base);
  }
  .expertise-item:hover .expertise-number { color: var(--color-accent); }
  .expertise-content { flex: 1; min-width: 0; }
  .expertise-content h3 { font-size: var(--text-lg); margin-bottom: var(--space-1); }
  .expertise-content p { font-size: var(--text-sm); color: var(--color-text-secondary); }
  .expertise-arrow {
    color: var(--color-text-muted); flex-shrink: 0; margin-top: var(--space-1);
    transition: transform var(--transition-base), color var(--transition-base);
  }
  .expertise-item:hover .expertise-arrow { transform: translateX(4px); color: var(--color-accent); }

  /* Capability question */
  .capability-question {
    font-style: italic; color: var(--color-text);
    margin-bottom: var(--space-2); font-size: var(--text-sm);
  }

  /* Value pillars */
  .value-pillars { display: grid; gap: var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .value-pillars { grid-template-columns: repeat(3, 1fr); } }
  .value-pillar {
    padding: var(--space-8); background: var(--color-surface-elevated);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .value-pillar:hover {
    box-shadow: var(--shadow-md); border-color: var(--color-accent-border);
  }
  .pillar-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: var(--radius-md);
    background: var(--color-accent-bg); color: var(--color-accent);
    margin-bottom: var(--space-5);
  }
  .value-pillar h3 { margin-bottom: var(--space-3); }
  .value-pillar p { font-size: var(--text-sm); color: var(--color-text-secondary); }

  /* Engage grid */
  .engage-grid { display: grid; gap: var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .engage-grid { grid-template-columns: repeat(2, 1fr); } }
  .engage-card {
    padding: var(--space-10); background: var(--color-surface-elevated);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    position: relative; overflow: hidden;
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .engage-card:hover { box-shadow: var(--shadow-lg); border-color: var(--color-accent-border); }
  .engage-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--gradient-accent); transform: scaleX(0); transform-origin: left;
    transition: transform var(--transition-base);
  }
  .engage-card:hover::before { transform: scaleX(1); }
  .engage-label {
    font-family: var(--font-serif); font-size: var(--text-3xl);
    font-weight: var(--font-semibold); color: var(--color-accent);
    display: block; margin-bottom: var(--space-4); letter-spacing: -0.02em;
  }
  .engage-card h3 { font-size: var(--text-2xl); margin-bottom: var(--space-4); }
  .engage-card p { font-size: var(--text-base); color: var(--color-text-secondary); }

  /* Proof */
  .proof-note {
    margin-top: var(--space-4); font-size: var(--text-sm);
    color: var(--color-text-muted); font-style: italic;
  }
</style>
