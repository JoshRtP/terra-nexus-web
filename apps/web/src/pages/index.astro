---
import FoundationLayout from '../layouts/FoundationLayout.astro';
import { getBuildMode } from '../lib/build-mode.js';
import { compileForBuild } from '../lib/okf/build.js';

const mode = getBuildMode();
await compileForBuild(mode);
---

<FoundationLayout title="Terra Nexus website foundation" preview={mode === 'preview'}>
  <main>
    <h1>Website foundation</h1>
    <p>This development foundation intentionally contains no governed-content pages.</p>
  </main>
</FoundationLayout>
