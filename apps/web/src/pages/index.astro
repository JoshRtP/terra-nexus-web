---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBuildMode } from '../lib/build-mode.js';

const mode = getBuildMode();

// Portfolio-wide stats for the "Our Track Record" section below. Real,
// confirmed figures (approved 2026-08-10) — not placeholders, no NOI flag.
const portfolioStats = [
  { value: '$3B+', label: 'Cumulative commercial value created for clients since Terra Nexus started' },
  { value: '25+', label: 'Global Projects Across 25+ Countries' },
  { value: '15+', label: 'Commodities worked with' },
  { value: '20+', label: '20+ Sustainable Food Systems Certifications' },
  { value: '10+', label: '10+ Carbon Registries Focused on Food, Agriculture, Land Management, Energy, & Fuels' },
  { value: '5M+', label: 'Acres of regenerative ecosystems' },
];

const expertiseAreas = [
  { title: 'Regenerative Agriculture', slug: 'regenerative-agriculture', description: 'Connect better crop-production systems with producer economics, supply-chain requirements, credible evidence, and market value.', heroImage: 'https://images.pexels.com/photos/38514489/pexels-photo-38514489.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Regenerative Rangeland', slug: 'regenerative-rangeland', description: 'Build resilient grazing and livestock systems that improve land performance, producer value, and downstream market opportunities.', heroImage: 'https://images.pexels.com/photos/29474130/pexels-photo-29474130.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Agroforestry', slug: 'agroforestry', description: 'Integrate trees, crops, livestock, long-term land value, environmental outcomes, and reliable routes to market.', heroImage: 'https://images.pexels.com/photos/5838949/pexels-photo-5838949.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Aquaculture', slug: 'aquaculture', description: 'Improve aquatic production, feed, operations, traceability, environmental performance, product strategy, and market access.', heroImage: 'https://images.pexels.com/photos/14992906/pexels-photo-14992906.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Biodiversity & Ecosystem Resilience', slug: 'biodiversity-and-ecosystem-resilience', description: 'Translate nature dependencies, impacts, risks, and opportunities into prioritized business and landscape action.', heroImage: 'https://images.pexels.com/photos/17475325/pexels-photo-17475325.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Sustainable Supply Chains', slug: 'sustainable-supply-chains', description: 'Connect responsible production with sourcing, traceability, operations, environmental attributes, products, customers, and credible claims.', heroImage: 'https://images.pexels.com/photos/4487383/pexels-photo-4487383.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Low Carbon Energy & Biofuels', slug: 'low-carbon-energy-and-biofuels', description: 'Create more value from feedstock, origination, processing, carbon-intensity, chain-of-custody, and regulatory opportunities.', heroImage: 'https://images.pexels.com/photos/35284297/pexels-photo-35284297.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Purpose-Driven Food Brands & Retailers', slug: 'purpose-driven-food-brands-and-retailers', description: 'Turn better products and sourcing into customer value through credible product, portfolio, pricing, channel, and claims strategies.', heroImage: 'https://images.pexels.com/photos/15455017/pexels-photo-15455017.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { title: 'Food Waste: Prevention, Diversion & Recovery', slug: 'food-waste-prevention-diversion-recovery', description: 'Prevent loss, keep edible food in use, create value from byproducts, and recover remaining resources through the highest practical use.', heroImage: 'https://images.pexels.com/photos/36751332/pexels-photo-36751332.jpeg?auto=compress&cs=tinysrgb&w=1200' },
];

const capabilities = [
  { title: 'Strategy & Innovation', slug: 'strategy-and-innovation', description: 'Determine where to play, how to win, and how to create differentiated growth at the intersection of food and climate.' },
  { title: 'Financial Investments & New Venture Development', slug: 'financial-investments-and-new-venture-development', description: 'Screen, value, fund, structure, incubate, acquire, and scale food, agriculture, climate, nature, and circularity opportunities.' },
  { title: 'Sustainable Supply Chain & Operations', slug: 'sustainable-supply-chain-and-operations', description: 'Reduce impact, risk, cost, and volatility by changing what is sourced and how it is produced, moved, processed, used, and recovered.' },
  { title: 'Corporate Sustainability', slug: 'corporate-sustainability', description: 'Set enterprise ambition, prioritize action, account for progress, govern claims, engage stakeholders, and report performance.' },
  { title: 'Carbon & Ecosystem Services', slug: 'carbon-and-ecosystem-services', description: 'Create, access, value, verify, account for, manage, and commercialize environmental assets, attributes, credits, insets, offsets, and claims.' },
];

// Condensed for the homepage — full "Decisions We Help Resolve" / related expertise & capabilities
// detail for each segment lives on /who-we-work-with/food-and-agribusiness-value-chain/#<slug>.
const valueChainSegments = [
  { name: 'Inputs Companies', slug: 'inputs-companies', description: 'Strategy, market entry, product innovation, customer insight, technology diligence, sustainability positioning, partnerships, claims, and commercialization for agricultural and animal-production solutions.', image: 'https://images.pexels.com/photos/17475325/pexels-photo-17475325.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Agricultural Producers & Integrated Protein Companies', slug: 'agricultural-producers', description: 'Program opportunity, producer economics, fit-for-place change, technology, measurement, incentives, traceability, commercialization, and buyer requirements.', image: 'https://images.pexels.com/photos/29474130/pexels-photo-29474130.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Commodity Traders', slug: 'commodity-traders', description: 'Market and program strategy, sourcing, producer engagement, traceability, data systems, environmental programs, commercialization, claims controls, managed operations, and diligence.', image: 'https://images.pexels.com/photos/38514489/pexels-photo-38514489.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Ingredient & Feed Processors', slug: 'ingredient-feed-processors', description: 'Sourcing, feed and ingredient strategy, process improvement, footprinting, traceability, low-emissions products, byproduct value, commercialization, and claims.', image: 'https://images.pexels.com/photos/4487383/pexels-photo-4487383.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Food & Beverage Companies', slug: 'food-beverage-companies', description: 'Product and portfolio strategy, supplier programs, traceability, Scope 3 and insetting, footprinting, certification, claims, pricing, commercialization, and managed value-chain programs.', image: 'https://images.pexels.com/photos/15455017/pexels-photo-15455017.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Food Retail & Distribution', slug: 'food-retail-distribution', description: 'Responsible sourcing, category and supplier strategy, private-label propositions, traceability, customer insight, logistics, food-waste programs, claims, and collaboration.', image: 'https://images.pexels.com/photos/5838949/pexels-photo-5838949.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Energy & Biofuels Refiners', slug: 'energy-biofuels-refiners', description: 'Feedstock assessment, low-CI sourcing, origination, chain of custody, CI analysis, program design, partner selection, audit readiness, operating workflows, and commercialization.', image: 'https://images.pexels.com/photos/35284297/pexels-photo-35284297.jpeg?auto=compress&cs=tinysrgb&w=1200' },
  { name: 'Food Waste Prevention, Diversion & Recovery', slug: 'food-waste-prevention-diversion-recovery', description: 'Material flows, business cases, technology and partner diligence, secondary markets, byproduct commercialization, program design, measurement, claims, and implementation.', image: 'https://images.pexels.com/photos/36751332/pexels-photo-36751332.jpeg?auto=compress&cs=tinysrgb&w=1200' },
];

// Condensed for the homepage — the full workstream detail (bullet lists) lives on /capabilities/.
// `caps` names the capability slugs (see `capabilities` above) each step draws on, driving the
// highlight state in the interactive rail below. Step 6 sets `loop: true` — rather than
// highlighting one or two capabilities, it lights up all five in a neutral grey sweep to signal
// "end-to-end value creation" (closing the loop back to Step 1) instead of "this step relates to
// this capability" (the maroon treatment steps 1-5 use).
const allCapSlugs = capabilities.map((cap) => cap.slug);
const approachSteps = [
  {
    title: 'Evaluate the Opportunity',
    description: 'Assess the market, economics, and strategic fit before committing to a path.',
    caps: ['strategy-and-innovation', 'financial-investments-and-new-venture-development'],
  },
  {
    title: 'Design the Program',
    description: 'Define the commercial model, governance, and route to market.',
    caps: ['financial-investments-and-new-venture-development', 'sustainable-supply-chain-and-operations', 'corporate-sustainability'],
  },
  {
    title: 'Build the Operating Infrastructure',
    description: 'Stand up the workflows, data, and controls a program needs to run.',
    caps: ['sustainable-supply-chain-and-operations', 'corporate-sustainability', 'carbon-and-ecosystem-services'],
  },
  {
    title: 'Launch and Scale',
    description: 'Pilot, prove, and expand across partners, geographies, and products.',
    caps: ['carbon-and-ecosystem-services'],
  },
  {
    title: 'Manage Client-Owned Programs',
    description: 'Run the recurring operations, ledgers, and reporting clients own.',
    caps: allCapSlugs,
  },
  {
    title: 'Connect Performance to Claims and Market Value',
    description: 'Translate results into credible claims and commercial value. This step closes the loop — connecting performance back to the original opportunity to drive continuous improvement toward best-in-class performance and profitability.',
    caps: allCapSlugs,
    loop: true,
  },
];
---

<SiteLayout
  title="Terra Nexus — Impact at the Intersection of Food & Climate"
  description="Terra Nexus provides the insights, tools, and supporting capabilities food and agribusiness companies need to achieve commercial success while building a more resilient, sustainable, and prosperous food system."
  preview={mode === 'preview'}
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="hero-eyebrow">An Innovation &amp; Insights Studio</span>
      <h1 id="hero-heading">Impact at the Intersection of <span class="hero-highlight">Food &amp; Climate</span></h1>
      <p class="hero-engagement">We help food and agribusiness companies create commercial sustainability programs at scale.</p>
      <p class="hero-supporting">
        Terra Nexus provides the insights, tools, and supporting capabilities food and agribusiness companies need to achieve commercial success while building a more resilient, sustainable, and prosperous food system.
      </p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary btn-lg">Discuss Your Challenge</a>
        <a href="/expertise/" class="btn btn-secondary btn-lg">Explore Our Expertise</a>
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="section" aria-labelledby="expertise-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">What We Are Known For</span>
        <h2 id="expertise-heading">Expertise Across the Food and Agriculture System</h2>
        <p class="section-lead">We bring specialized food-and-climate knowledge to the production systems, supply chains, markets, products, and recovery pathways where change can create the greatest value.</p>
      </header>

      <ul class="expertise-grid" role="list">
        {expertiseAreas.map((area) => (
          <li>
            <a
              href={`/expertise/${area.slug}/`}
              class="expertise-tile"
              aria-label={area.title}
            >
              <img
                src={area.heroImage}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="tile-bg-img"
              />
              <div class="tile-overlay" aria-hidden="true"></div>
              <div class="tile-content">
                <h3 class="tile-title">{area.title}</h3>
                <p class="tile-desc">{area.description}</p>
                <span class="tile-cta" aria-hidden="true">Learn More &rarr;</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How We Work: Approach + Capabilities, merged -->
  <section class="section" aria-labelledby="approach-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">How We Work</span>
        <h2 id="approach-heading">Terra Nexus Manages Every Step from Cultivation to Claim</h2>
        <p class="section-lead">We connect strategy, investments, operations, and sustainability to generate market value.</p>
        <p class="section-lead">Food-and-climate opportunities rarely fit inside one business function. Terra Nexus enables clients to make the right decision, build the right operating model, bring together the right partners, and capture the largest supportable sources of value.</p>
      </header>

      <div class="approach-card">
        <div class="approach-rail">
          <div class="approach-track" role="tablist" aria-label="Approach steps">
            {approachSteps.map((step, i) => (
              <button
                type="button"
                class="approach-stop"
                class:list={{ 'is-active': i === 0 }}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls="approach-panel"
                id={`approach-tab-${i}`}
                data-index={i}
                data-loop={step.loop ? 'true' : 'false'}
                data-caps={step.caps.join(',')}
                data-desc={step.description}
              >
                <span class="dot" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="label">{step.title}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="approach-panel" id="approach-panel" role="tabpanel" aria-labelledby="approach-tab-0">
          <p class="approach-desc" id="approach-desc">
            <strong>{approachSteps[0].title}</strong> — {approachSteps[0].description}
          </p>

          <div class="approach-cap-grid is-filtering" id="approach-cap-grid">
            {capabilities.map((cap) => (
              <a href={`/capabilities/${cap.slug}/`} class="approach-cap" data-cap={cap.slug} class:list={{ 'is-linked': approachSteps[0].caps.includes(cap.slug) }}>
                <h4>{cap.title}</h4>
                <p>{cap.description}</p>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="section-cta">
        <a href="/capabilities/" class="btn btn-secondary">Explore Our Approach &amp; Capabilities</a>
      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="section" aria-labelledby="audiences-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Who We Work With</span>
        <h2 id="audiences-heading">We Work Across the Food and Agribusiness System</h2>
        <p class="section-lead">Terra Nexus works with every node of the food and agribusiness value chain — from inputs and agricultural production through trading, processing, brands, retail, energy, and resource recovery. We also work with the environmental markets, technology providers, assurance organizations, and capital partners that enable the system to change.</p>
      </header>

      <div class="segment-slider">
        <div class="segment-slider-nav">
          <span class="segment-slider-label">By Value-Chain Segment</span>
          <div class="segment-tabs" role="tablist" aria-label="Value-chain segments" aria-orientation="vertical">
            {valueChainSegments.map((seg, i) => (
              <button
                type="button"
                class="segment-tab"
                class:list={{ 'is-active': i === 0 }}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`segment-panel-${seg.slug}`}
                id={`segment-tab-${seg.slug}`}
                data-index={i}
              >
                {seg.name}
              </button>
            ))}
          </div>
        </div>

        <div class="segment-slider-panel">
          <div class="segment-frame">
            {valueChainSegments.map((seg, i) => (
              <div
                class="segment-slide"
                class:list={{ 'is-active': i === 0 }}
                id={`segment-panel-${seg.slug}`}
                role="tabpanel"
                aria-labelledby={`segment-tab-${seg.slug}`}
              >
                <img
                  src={seg.image}
                  alt=""
                  aria-hidden="true"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="segment-slide-img"
                />
                <div class="segment-slide-copy">
                  <h3>{seg.name}</h3>
                  <p>{seg.description}</p>
                  <a href={`/who-we-work-with/food-and-agribusiness-value-chain/#${seg.slug}`} class="segment-explore">
                    Explore
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="card-grid">
        <a href="/who-we-work-with/food-and-agribusiness-value-chain/" class="card-link">
          <article class="card">
            <h3>Food &amp; Agribusiness Value Chain</h3>
            <p>Work with the organizations that produce, move, transform, sell, distribute, and recover food and agricultural materials.</p>
          </article>
        </a>
        <a href="/who-we-work-with/enabling-markets-technology-and-capital/" class="card-link">
          <article class="card">
            <h3>Enabling Markets, Technology &amp; Capital</h3>
            <p>Work with the organizations that provide environmental markets, data, technology, assurance, partnerships, and investment.</p>
          </article>
        </a>
      </div>

      <div class="section-cta">
        <a href="/who-we-work-with/" class="btn btn-secondary">See Who We Work With</a>
      </div>
    </div>
  </section>

  <!-- Our Track Record -->
  <section class="section section-alt" aria-labelledby="track-record-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Our Track Record</span>
        <h2 id="track-record-heading">Impact Across Every Engagement We've Taken On</h2>
        <p class="section-lead">One case study only shows one outcome. Across every client relationship since Terra Nexus started, our work spans a growing range of geographies, commodities, certification systems, and environmental markets — and has created measurable value throughout.</p>
      </header>

      <div class="stat-grid">
        {portfolioStats.map((stat) => (
          <div class="stat-cell">
            <p class="stat-value">{stat.value}</p>
            <p class="stat-label">{stat.label}</p>
          </div>
        ))}
      </div>

      <div class="section-cta">
        <a href="/case-studies/" class="btn btn-primary">Read Our Case Studies</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark" aria-labelledby="final-cta-heading">
    <div class="container text-center">
      <h2 id="final-cta-heading">Build the Right Path from Opportunity to Value</h2>
      <p class="cta-description">Whether the starting point is a sourcing challenge, environmental program, technology, investment, new product, regulatory opportunity, or operating problem, Terra Nexus helps determine what should happen next and how the participants required to deliver it can share in the value.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Who We Work With — segment slider tabs (mirrors the nav-toggle pattern in Header.astro)
  (function () {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.segment-tab'));
    const slides = Array.from(document.querySelectorAll<HTMLDivElement>('.segment-slide'));
    const panel = document.querySelector('.segment-slider-panel');
    if (!tabs.length || !slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function activate(index: number) {
      current = index;
      tabs.forEach((tab, idx) => {
        const active = idx === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      slides.forEach((slide, idx) => slide.classList.toggle('is-active', idx === index));
    }
    function advance() { activate((current + 1) % tabs.length); }
    function resetAuto() {
      if (timer) clearInterval(timer);
      if (!reduceMotion) timer = setInterval(advance, 6000);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { activate(i); resetAuto(); });
    });
    if (panel) {
      panel.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
      panel.addEventListener('mouseleave', resetAuto);
    }
    resetAuto();
  })();
</script>

<script>
  // How We Work — approach rail tabs. Step→capability relationships come from
  // each button's data-caps attribute (set server-side from approachSteps in
  // the frontmatter above), so this script has no content of its own to keep
  // in sync — it just reads the DOM.
  (function () {
    const stops = Array.from(document.querySelectorAll<HTMLButtonElement>('.approach-stop'));
    const capCards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.approach-cap'));
    const descElMaybe = document.getElementById('approach-desc');
    const gridElMaybe = document.getElementById('approach-cap-grid');
    const panelEl = document.getElementById('approach-panel');
    if (!stops.length || !descElMaybe || !gridElMaybe) return;
    const descEl = descElMaybe;
    const gridEl = gridElMaybe;

    function activate(index: number) {
      stops.forEach((stop, idx) => {
        const active = idx === index;
        stop.classList.toggle('is-active', active);
        stop.setAttribute('aria-selected', String(active));
      });
      const step = stops[index];
      const title = step.querySelector('.label')?.textContent ?? '';
      const desc = step.dataset.desc ?? '';
      panelEl?.setAttribute('aria-labelledby', `approach-tab-${index}`);
      descEl.innerHTML = `<strong>${title}</strong> — ${desc}`;

      const caps = (step.dataset.caps ?? '').split(',').filter(Boolean);
      if (step.dataset.loop === 'true') {
        gridEl.classList.remove('is-filtering');
        capCards.forEach((card) => card.classList.remove('is-linked'));
        gridEl.classList.remove('is-loop');
        void gridEl.offsetWidth; // force reflow so the sweep animation replays every time
        gridEl.classList.add('is-loop');
      } else {
        gridEl.classList.remove('is-loop');
        gridEl.classList.add('is-filtering');
        capCards.forEach((card) => card.classList.toggle('is-linked', caps.includes(card.dataset.cap ?? '')));
      }
    }
    stops.forEach((stop, i) => {
      stop.addEventListener('click', () => activate(i));
      stop.addEventListener('mouseenter', () => activate(i));
    });
  })();
</script>

<style>
  /* Hero */
  .hero {
    position: relative; overflow: hidden;
    padding-block: var(--space-24) var(--space-20);
    background: linear-gradient(135deg, var(--c-sky-200) 0%, var(--c-sky-300) 100%);
    color: var(--color-dark);
  }
  .hero-bg {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 20%, rgba(231, 215, 127, 0.22) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 20% 80%, rgba(255, 255, 255, 0.5) 0%, transparent 50%);
    pointer-events: none;
  }
  .hero-grid {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(19, 31, 72, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(19, 31, 72, 0.05) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 30%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 30%, #000 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-content { position: relative; }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); font-weight: var(--font-semibold);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-eyebrow); margin-bottom: var(--space-5);
  }
  .hero-eyebrow::before {
    content: ''; display: inline-block; width: 1.5rem; height: 2px;
    background: var(--color-eyebrow); border-radius: var(--radius-full);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 5.5vw, var(--text-6xl));
    color: var(--color-dark); line-height: 1.05; max-width: 24ch;
    margin-bottom: var(--space-5);
  }
  .hero-highlight {
    /* The light-blue hero has plenty of contrast for the literal button
       maroon, unlike the old navy background it was tuned to avoid. */
    background: var(--gradient-accent);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-engagement {
    font-size: var(--text-2xl); font-weight: var(--font-medium);
    color: var(--color-dark); margin-bottom: var(--space-4);
    max-width: var(--max-width-text);
  }
  .hero-supporting {
    font-size: var(--text-lg); color: var(--c-sky-700);
    max-width: var(--max-width-text); line-height: var(--line-relaxed);
  }
  .hero .hero-actions { margin-top: var(--space-10); }
