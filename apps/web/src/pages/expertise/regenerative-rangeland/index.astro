---
import ExpertisePage from '../../../components/ExpertisePage.astro';

const data = {
  eyebrow: 'Agricultural Production',
  title: 'Create More Value from Resilient Grazing Systems',
  lead: 'Terra Nexus helps livestock producers, protein companies, traders, and buyers design and manage regenerative rangeland programs that connect grazing management, producer economics, livestock performance, environmental outcomes, supply-chain value, and credible claims.',
  heroImage: 'https://images.pexels.com/photos/29474130/pexels-photo-29474130.jpeg?auto=compress&cs=tinysrgb&w=1600',
  primaryCta: { label: 'Discuss Your Rangeland Program', href: '/contact/' },
  secondaryCta: { label: 'Explore Our Capabilities', href: '/capabilities/' },
  metaTitle: 'Regenerative Rangeland | Terra Nexus',
  metaDescription: 'Terra Nexus helps livestock producers, protein companies, traders, and buyers design and manage regenerative rangeland programs that connect grazing management, producer economics, livestock performance, environmental outcomes, supply-chain value, and credible claims.',
  orientation: [
    'Rotational or prescribed grazing can be an important part of regenerative rangeland management, but a commercially viable program requires more than a movement schedule. Ranchers must manage forage, stocking, timing, intensity, rest, recovery, water, infrastructure, animal needs, weather, labor, and long-term land condition. Downstream companies may also need traceability, environmental evidence, product or sourcing claims, corporate accounting, or independently reviewed outcomes.',
    'Regenerative rangeland creates durable value when the ranch operating system and the downstream commercial system are designed to work together. Terra Nexus helps connect land and livestock management with producer economics, program infrastructure, evidence, markets, and recurring delivery.',
  ],
  performanceCategories: [
    { title: 'Forage and Livestock Performance', items: ['Greater forage utilization and recovery', 'Better alignment of stocking and forage availability', 'More stable feed resources through variable conditions', 'Improved animal distribution across the landscape', 'Potential improvements in livestock vigor, performance, or reduced purchased-feed dependence', 'More informed decisions about grazing periods, rest, and recovery'] },
    { title: 'Soil and Water Function', items: ['Improved soil cover and reduced erosion risk', 'Stronger root systems and soil structure', 'Improved infiltration and water retention', 'Better nutrient cycling and manure distribution', 'Maintenance or improvement of soil organic matter and soil carbon where supported by conditions and evidence'] },
    { title: 'Biodiversity and Landscape Resilience', items: ['More diverse and functional plant communities', 'Improved wildlife and pollinator habitat', 'Stronger riparian and watershed function', 'Reduced vulnerability to selected drought, flood, erosion, and wildfire risks', 'Improved capacity of working lands to recover from disturbance'] },
    { title: 'Producer and Supply-Chain Value', items: ['More productive and resilient ranch operations', 'Improved planning and management information', 'Transition support and access to technical assistance', 'Potential customer programs, product differentiation, incentives, or environmental markets', 'Stronger supply relationships and long-term access to livestock production', 'Improved evidence for sourcing, reporting, or claims'] },
  ],
  systemSteps: [
    { title: 'Define the Objective and Geography', body: 'The program may be intended to improve ranch resilience, support livestock performance, create a differentiated beef or dairy supply, reduce or remove emissions, improve water or biodiversity outcomes, qualify producers for a program, or create an environmental asset.', detail: 'Terra Nexus helps define the business objective, ranch and landscape boundary, relevant livestock supply chain, intended outcomes, participants, and users of the evidence or claim.' },
    { title: 'Understand Ranch and Landscape Context', body: 'Each ranch begins with different land condition, plant communities, soils, climate, water, infrastructure, livestock, management history, tenure, and commercial constraints.', detail: 'Terra Nexus helps clients evaluate ranch and landscape suitability, baseline management and data availability, producer goals and willingness to change, forage, water, fencing, labor, and capital constraints, interaction with animal performance and supply contracts, available technical assistance, incentives, or market pathways, and the evidence burden and cost associated with the intended outcome. Specialized grazing and ecological recommendations are developed with qualified local professionals.' },
    { title: 'Design the Producer Proposition and Transition Path', body: 'Management change may require fencing, water systems, planning, livestock movement, recordkeeping, technical support, working capital, or changes to production and marketing arrangements.', detail: 'Terra Nexus helps clients design producer participation, incentives, cost sharing, contracts, technical support, data obligations, performance risk, transition timing, and long-term value sharing. A strong producer proposition recognizes that payments for environmental outcomes may be only one source of value. Ranch productivity, resilience, reduced costs, land value, product markets, and operating flexibility may matter as much or more.' },
    { title: 'Establish the Management, Monitoring, and Evidence System', body: 'The evidence required depends on the program objective. Potential information may include grazing plans, paddock moves, stocking and animal records, forage and vegetation observations, photographs, soil sampling, remote sensing, water or biodiversity indicators, models, livestock emissions, chain-of-custody records, and independent review.', detail: 'Terra Nexus helps determine which practices and management records are required, which outcomes must be measured directly, which data may be modeled, remotely sensed, or monitored through indicators, how baselines, changes, uncertainty, and missing data are handled, how livestock, products, attributes, and claims are traced, how soil-carbon, livestock emissions, leakage, permanence, and reversals are treated where relevant, and what records and controls are needed for customers, accounting, certification, crediting, or verification.' },
    { title: 'Launch and Manage the Program', body: 'Rangeland programs operate across ranches with different conditions, management styles, data quality, and timing. Recurring work may include ranch recruitment, eligibility screening, contracting, planning, technical coordination, field visits, data collection, soil sampling, model updates, quality control, ledger management, buyer and producer reconciliation, exception handling, reporting, and assurance readiness.', detail: 'Terra Nexus can advise on these systems or manage defined workstreams within a client-owned program.' },
    { title: 'Connect Ranch Outcomes to Supply-Chain and Market Value', body: 'Potential pathways may include regenerative or sustainable livestock sourcing programs, grassfed, animal-welfare, or broader certification pathways, differentiated beef, dairy, leather, or ingredient claims, Scope 3 reductions and insets, soil-carbon or ecosystem-service credits, biodiversity, habitat, water, or resilience programs, procurement qualification and customer reporting, and producer resilience, supply security, and risk reduction. The appropriate route depends on the product, geography, evidence, ownership, contractual rights, accounting treatment, buyer demand, assurance requirements, and ability to use the outcome.', detail: 'Terra Nexus compares the complete value equation rather than assuming carbon credits or a consumer premium are always the best route.' },
  ],
  audiencePathways: [
    { title: 'Agricultural Producers & Integrated Protein Companies', description: 'We support ranch and producer-program strategy, operating models, economics, producer engagement, evidence systems, commercialization, and managed delivery. For integrated protein companies, we also connect ranch-level activity with procurement, livestock flows, processing, products, customers, accounting, and claims.' },
    { title: 'Commodity Traders, Livestock Buyers & Originators', description: 'We support sourcing strategy, producer networks, aggregation, contracting, traceability, attribute allocation, customer programs, value sharing, and recurring program operations.' },
    { title: 'Food, Beverage, Restaurant & Retail Companies', description: 'We support supply-chain strategy, supplier programs, Scope 3 and land-sector accounting, product and sourcing propositions, target alignment, claims, assurance, and customer communication.' },
    { title: 'Ingredient & Feed Companies', description: 'We help connect feed, forage, nutrition, grazing systems, livestock performance, upstream emissions, sourcing, and product opportunities without treating any single intervention as the complete solution.' },
    { title: 'Technology, MRV & Solution Providers', description: 'We support market strategy, customer requirements, technical and data diligence, pilot design, system integration, model and measurement evaluation, enterprise workflows, and partner selection.' },
    { title: 'Environmental-Market Participants & Investors', description: 'We support market and methodology assessment, program economics, project and portfolio diligence, risk review, partner selection, operating-model design, and commercialization strategy.' },
  ],
  decisionGroups: [
    { heading: 'Producers and Program Sponsors', items: ['Which ranches, geographies, and grazing systems fit the objective?', 'What transition costs, infrastructure, technical support, and management change are required?', 'How will ranchers be compensated for participation, performance, evidence, and risk?', 'How will ranch-specific flexibility be preserved within a consistent program?'] },
    { heading: 'Livestock, Sourcing, and Operations Teams', items: ['How will participating animals and products be identified or allocated?', 'What happens when animals move through multiple owners, grazing systems, feedyards, or processors?', 'Which records must travel with the animal, product, or environmental attribute?', 'How will supply commitments, quality, timing, and customer requirements be maintained?'] },
    { heading: 'Sustainability and Environmental-Market Teams', items: ['Is the intended outcome a sourcing claim, Scope 3 reduction, inset, carbon credit, certification, nature outcome, or combination?', 'How should livestock emissions and land-based removals or reductions be considered together?', 'Which methodology, accounting, certification, or assurance framework applies?', 'How will additionality, uncertainty, leakage, permanence, reversals, and double counting be addressed where relevant?'] },
    { heading: 'Program, Data, and Technology Teams', items: ['What data must be recorded at ranch, pasture, herd, animal, product, or landscape level?', 'Which outcomes require direct measurement and which may use models or indicators?', 'How will grazing records, soil data, remote sensing, livestock data, ledgers, and contracts connect?', 'How will corrections, missing data, nonconformance, and version changes be managed?'] },
    { heading: 'Finance, Commercial, and Risk Teams', items: ['What is the cost and expected value per ranch, acre, animal, product unit, or environmental outcome?', 'Which capital investments are required and who owns them?', 'How durable and scalable are the expected production and environmental benefits?', 'Does the value justify the program, measurement, assurance, and transaction costs?'] },
  ],
  workstreams: [
    { title: 'Evaluate the Opportunity', items: ['Market, geography, producer, and supply-chain assessment', 'Customer and product opportunity analysis', 'Business cases, scenarios, producer economics, and value allocation', 'Carbon, nature, certification, sourcing, and claims pathway assessment', 'Technology, methodology, project, program, and investment diligence'] },
    { title: 'Design the Program', items: ['Objectives, boundaries, outcomes, and participation criteria', 'Producer proposition, transition support, incentives, and contracts', 'Management, evidence, traceability, and claims architecture', 'Partner, technology, technical-assistance, and assurance strategy', 'Governance, responsibilities, controls, and commercialization'] },
    { title: 'Build the Operating Infrastructure', items: ['Producer enrollment and ranch-management workflows', 'Grazing, livestock, soil, vegetation, and evidence data requirements', 'MRV, calculations, model governance, and quality control', 'Livestock and product traceability, chain of custody, and attribute ledgers', 'Contracts, documentation, reporting, and exception management'] },
    { title: 'Launch and Scale', items: ['Pilot design, ranch screening, and success criteria', 'Technology and partner selection', 'Implementation planning and producer engagement', 'Buyer, processor, originator, technical, and assurance coordination', 'Expansion across ranches, geographies, supply chains, and market pathways'] },
    { title: 'Manage Client-Owned Programs', items: ['Recurring ranch and evidence workflows', 'Data review, calculations, and ledgers', 'Partner, lab, model, technology, and verifier coordination', 'Exceptions, nonconformance, reconciliation, and reporting', 'Audit and verification preparation', 'Performance review and continuous improvement'] },
    { title: 'Connect Performance to Commercial Value', items: ['Sourcing and product propositions', 'Producer and customer incentive structures', 'Scope 3, inset, credit, certification, and nature pathways', 'Environmental-asset valuation and commercialization', 'Claims governance, attribute allocation, and communication boundaries', 'Resilience, supply-security, and strategic value'] },
  ],
  valuePathways: [
    { label: 'Regenerative or sustainable livestock sourcing programs' },
    { label: 'Grassfed, animal-welfare, or broader certification pathways' },
    { label: 'Differentiated beef, dairy, leather, or ingredient claims' },
    { label: 'Scope 3 reductions and insets' },
    { label: 'Soil-carbon or ecosystem-service credits' },
    { label: 'Biodiversity, habitat, water, or resilience programs' },
    { label: 'Procurement qualification and customer reporting' },
    { label: 'Producer resilience, supply security, and risk reduction' },
  ],
  validationRows: [
    { category: 'Viability', pitfall: 'The program is positioned as carbon-only and overlooks ranch economics and livestock performance.', validation: 'Position the program around ranch economics and livestock performance, with carbon as one component.' },
    { category: 'Feasibility', pitfall: 'One grazing practice is treated as universally appropriate.', validation: 'Match grazing practices to local conditions rather than applying one approach universally.' },
    { category: 'Viability', pitfall: 'Infrastructure, labor, water, fencing, and transition costs are underestimated.', validation: 'Quantify infrastructure, labor, water, fencing, and transition costs before committing.' },
    { category: 'Viability', pitfall: 'Ranchers are asked to carry risk without a clear long-term value proposition.', validation: 'Build a clear long-term value proposition so ranchers do not carry risk without reward.' },
    { category: 'Feasibility', pitfall: 'Livestock emissions, soil outcomes, product flows, and claims are evaluated in separate systems.', validation: 'Integrate livestock emissions, soil outcomes, product flows, and claims into one evidence system.' },
    { category: 'Feasibility', pitfall: 'Baseline condition and ranch-to-ranch variability are not reflected in program design.', validation: 'Reflect baseline conditions and ranch-to-ranch variability in program design from the start.' },
    { category: 'Feasibility', pitfall: 'Soil sampling, models, remote sensing, and management records are not governed as one evidence system.', validation: 'Govern soil sampling, models, remote sensing, and management records as one integrated evidence system.' },
    { category: 'Strategic Fit', pitfall: 'Animals or products cannot be traced or allocated at the level required for the intended claim.', validation: 'Design traceability and allocation to match the level the intended claim requires.' },
    { category: 'Strategic Fit', pitfall: 'Permanence, leakage, reversals, uncertainty, and overlapping claims are addressed after commercialization.', validation: 'Address permanence, leakage, reversals, uncertainty, and overlapping claims before commercialization.' },
    { category: 'Feasibility', pitfall: 'Ongoing field coordination, data review, exceptions, and assurance are not adequately resourced.', validation: 'Resource ongoing field coordination, data review, exceptions, and assurance as core program costs.' },
  ],
  ctaHeading: 'Build a Rangeland Program That Works for Producers and Markets',
  ctaBody: 'Whether you are evaluating a new opportunity, designing a ranch or sourcing program, selecting technology and partners, building measurement and traceability, scaling implementation, or preparing claims for independent review, Terra Nexus helps identify and execute the next steps.',
  ctaButton: { label: 'Discuss Your Rangeland Program', href: '/contact/' },
};
---

<ExpertisePage data={data} />
