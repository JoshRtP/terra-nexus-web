    pointer-events: none;
  }
  .scroll-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--gradient-accent);
    transition: width 0.1s linear;
  }

  /* ── Scroll-reveal (fade + rise) ──
     [data-reveal] elements default to fully visible — the base rule below
     is what a no-JS visitor (or a `prefers-reduced-motion` visitor, since
     the script skips adding .js-reveal in that case) sees: plain, static,
     fully readable content, nothing hidden behind a script that might not
     run. The script adds .js-reveal (which hides + arms the transition)
     and then removes .is-pending as each element crosses into view via
     IntersectionObserver. --reveal-i (set inline per list item above)
     staggers siblings within the same group. */
  [data-reveal] { opacity: 1; transform: none; }
  [data-reveal].js-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-i, 0) * 70ms);
  }
  [data-reveal].js-reveal.is-visible { opacity: 1; transform: none; }

  /* ── Reduced motion ── */
  /* The sticky-stack effect itself is native `position: sticky`, not
     motion, so it stays under reduced-motion. The scroll-reveal system
     above IS motion and needs an explicit opt-out beyond the global
     transition-duration override (an element stuck at opacity:0 forever
     because its IntersectionObserver never fired would be a real content
     bug, not just an animation preference) — handled in the script by
     skipping .js-reveal entirely when prefers-reduced-motion is set, so
     reduced-motion visitors get the same plain, always-visible base rule
     as no-JS visitors, never a hidden-and-waiting state. */
</style>

<script>
  // Scroll-reveal (fade + rise on scroll-into-view). Skipped entirely
  // under prefers-reduced-motion — reveal elements simply stay at their
  // CSS-default fully-visible state (same as the no-JS fallback), never a
  // hidden-and-waiting one.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion && 'IntersectionObserver' in window) {
    const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    revealEls.forEach((el) => el.classList.add('js-reveal'));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    revealEls.forEach((el) => observer.observe(el));
  }

  // Scroll progress bar — plain scrollY / scrollable-height readout,
  // throttled to one update per animation frame. Not scroll-hijacking:
  // purely reflects native scroll position, never sets it.
  const progressFill = document.querySelector<HTMLElement>('[data-scroll-progress-fill]');
  if (progressFill) {
    let ticking = false;
    const updateProgress = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
      progressFill.style.width = `${pct}%`;
      ticking = false;
    };
    updateProgress();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', updateProgress);
  }
</script>
