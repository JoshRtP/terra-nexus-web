// Regenerative Agriculture — scroll-stack composition prototype
// (feature/about-team-component-trial, design-prototype mode). This route
// intentionally does NOT render the shared <ExpertisePage> component —
// ExpertisePage.astro is untouched and every other Expertise page still
// uses it unchanged. This is a page-local alternate composition of the
// exact same `data` object (content is 100% preserved from the previous
// version of this file, only regrouped/re-presented — see the section
// comments below for what moved where). See ScrollPanel.astro (colocated
// in this folder) for the sticky-stack mechanism itself.
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ClosingCta from '../../../components/ClosingCta.astro';
import { getBuildMode } from '../../../lib/build-mode.js';
import ScrollPanel from './_ScrollPanel.astro';
import StrategyFrameworkDVF from '../../../components/StrategyFrameworkDVF.astro';
import SegmentSlider from '../../../components/SegmentSlider.astro';

const mode = getBuildMode();

// Terra Nexus's site-wide Capabilities (same 5, same slugs, as the
// homepage's `capabilities` list and /capabilities/<slug>/ pages) — used
// below to group each "Who We Support" participant's specific support
// activities under the capability that actually delivers them, each
// with a link out to that capability's full page.
//
// `offerings` is each capability's real, top-level offering names —
// copied verbatim from that capability's own page (apps/web/src/pages/
// capabilities/<slug>/index.astro's `data.offerings[].name`), not
// hand-picked or paraphrased — so what shows here matches what's really
// on that page. Deliberately the offering level, not the more granular
// subOffering level nested under each one (17–34 items per capability,
// noticeably more than a panel accordion should hold): the "See
// <Capability>" link is what takes an interested user to the full page
// to see those. Kept local to this page rather than imported from the
// homepage/capability pages, since none of those export their data.
const CAPABILITIES = {
  strategy: {
    name: 'Strategy & Innovation',
    href: '/capabilities/strategy-and-innovation/',
    offerings: ['Corporate & Business Unit Strategy', 'Market Entry & Competitive Strategy', 'Business Model & Growth Strategy', 'Customer Experience', 'Product, Innovation & Design', 'Sustainability & Climate Change Strategy'],
  },
  investment: {
    name: 'Financial Investments & New Venture Development',
    href: '/capabilities/financial-investments-and-new-venture-development/',
    offerings: ['Financial Planning & Analysis', 'Business Case & Initiative Prioritization', 'Corporate Ventures', 'Investor Due Diligence'],
  },
  supplyChain: {
    name: 'Sustainable Supply Chain & Operations',
    href: '/capabilities/sustainable-supply-chain-and-operations/',
    offerings: ['Digital Supply Chain Strategy', 'Value Chain Interventions (Influence-to-Impact)', 'Responsible Sourcing & Procurement', 'Resource Efficiency & Lean Operations', 'Low Impact Logistics', 'Joint Business Planning & Supply Chain Collaboration', 'Circular Economy, Waste & Diversion'],
  },
  corporateSustainability: {
    name: 'Corporate Sustainability',
    href: '/capabilities/corporate-sustainability/',
    offerings: ['Sustainability Strategy', 'Measurement, Impact & Disclosure', 'Stakeholder Engagement', 'Building Purpose-Driven Products & Services', 'Sustainable Supply Chain & Operations'],
  },
  carbon: {
    name: 'Carbon & Ecosystem Services',
    href: '/capabilities/carbon-and-ecosystem-services/',
    offerings: ['VCM & Scope 3 Markets', 'Commercialization Pathways', 'Asset & Portfolio Valuation', 'Pilot Development & Partner Selection', 'Program Design & Operations', 'Impact Verification & Claims Translation', 'Full-Service GHG Accounting'],
  },
};
// Every participant shows all 5 Capabilities, not a per-participant
// subset — Terra Nexus can bring any of them to bear for any
// participant, and singling some out as "not applicable" per audience
// read as more definitive than intended.
const ALL_CAPABILITIES = [CAPABILITIES.strategy, CAPABILITIES.investment, CAPABILITIES.supplyChain, CAPABILITIES.corporateSustainability, CAPABILITIES.carbon];

const data = {
  eyebrow: 'Agricultural Production',
  title: 'Scale Regenerative Agriculture from Field to Market',
  lead: 'Terra Nexus helps commodity traders and food-system companies design, diligence, launch, and manage regenerative agriculture programs that align producer economics, supply-chain operations, environmental outcomes, and credible claims.',
  heroImage: 'https://images.pexels.com/photos/38514489/pexels-photo-38514489.jpeg?auto=compress&cs=tinysrgb&w=1600',
  primaryCta: { label: 'Discuss Your Program', href: '/contact/' },
  secondaryCta: { label: 'Explore Our Capabilities', href: '/capabilities/' },
  metaTitle: 'Regenerative Agriculture | Terra Nexus',
  metaDescription: 'Terra Nexus helps commodity traders and food-system companies design, diligence, launch, and manage regenerative agriculture programs that align producer economics, supply-chain operations, environmental outcomes, and credible claims.',
  orientation: [
    'Regenerative agriculture begins with how crops are produced, but it does not scale through agronomy alone. Farmers decide what can work in a particular field and production system. Originators and processors connect producers to physical markets. Food, beverage, feed, fiber, and energy companies create demand and determine what evidence they need. Technology providers collect and analyze data. Accounting, certification, environmental-market, and assurance frameworks determine what can be reported or claimed.',
    'A successful program must connect all of those decisions without losing sight of the farm business that makes implementation possible. Terra Nexus works across the complete system so regenerative agriculture can move from a broad ambition to a commercially relevant, operationally executable, measurable, and credible program.',
  ],
  performanceCategories: [
    { title: 'Healthier and More Functional Soils', items: ['Improved soil structure and biological activity', 'Greater protection from erosion', 'Improved nutrient cycling', 'More effective water infiltration and retention', 'Maintenance or improvement of soil organic matter and soil carbon'] },
    { title: 'More Resilient Crop Production', items: ['Greater ability to manage drought, excess water, heat, and other production risks', 'More diverse rotations and biological functions', 'Improved input efficiency', 'More stable productivity and quality over time', 'Reduced exposure to selected operating costs or supply disruptions'] },
    { title: 'Better Water and Biodiversity Outcomes', items: ['Reduced runoff, erosion, and nutrient loss', 'Improved water-use efficiency', 'Increased plant, soil, pollinator, and habitat diversity', 'Stronger ecological function within and around working lands'] },
    { title: 'Stronger Farm and Supply-Chain Economics', items: ['Transition support that reflects producer cost and risk', 'Potential input, yield, quality, or resilience benefits', 'Access to customer programs, differentiated markets, or incentives', 'Improved long-term supply security for buyers', 'More durable relationships among producers, originators, and downstream customers'] },
  ],
  systemSteps: [
    { title: 'Define the Objective and Program Boundary', body: 'Start with the business decision rather than the practice list. The objective may be to strengthen a strategic supply shed, reduce agricultural emissions, improve water or soil outcomes, create a differentiated product, qualify suppliers, support corporate targets, access an incentive, or build a new environmental-market offering.', detail: 'Terra Nexus helps define the crops, products, geographies, participants, reporting boundary, commercial objective, and intended users of the outcome.' },
    { title: 'Understand the Local Production and Market Context', body: 'Regenerative agriculture must fit the production system. The relevant context includes soil, climate, crop rotation, water, current management, equipment, tenancy, agronomic risk, producer economics, local advisors, infrastructure, commodity flows, buyer requirements, and available programs or incentives.', detail: 'Terra Nexus combines field and supply-shed context with customer demand and commercial feasibility so clients can prioritize where a program has a credible path to adoption and value.' },
    { title: 'Design the Producer Proposition', body: 'Producers need a clear reason and practical path to participate. A producer offer may include technical support, cost sharing, premiums, outcome payments, multi-year commitments, access to markets, technology, financing, risk-sharing mechanisms, or combinations of these.', detail: 'Terra Nexus helps clients model transition costs, value allocation, enrollment criteria, contracting, evidence requirements, timing, and the treatment of existing adopters, new adopters, tenants, landowners, and incomplete data.' },
    { title: 'Build Evidence, Data, and Traceability Around the Intended Use', body: 'The evidence system should be designed for the decision or claim it must support, not assembled after implementation. Depending on the program, evidence may include producer attestations, field records, input and practice data, soil samples, remote sensing, models, transaction records, chain-of-custody controls, product allocation, calculation workbooks, quality checks, and independent assurance.', detail: 'Terra Nexus helps determine what must be measured directly, what may be modeled or remotely sensed, what must be traceable to field or farm, how uncertainty and exceptions are handled, how physical products and environmental attributes are allocated, and what documentation must be retained.' },
    { title: 'Launch, Operate, and Improve the Program', body: 'Commercial-scale programs need recurring operations, not just a methodology and a software platform. Core activities may include producer outreach, enrollment, contract management, data collection, quality control, calculation, ledger management, supplier and buyer reconciliation, partner coordination, exception handling, reporting, verification readiness, and continuous improvement.', detail: 'Terra Nexus can advise on the operating model or manage defined workstreams within a client-owned program.' },
    { title: 'Connect Improved Performance to the Right Form of Value', body: 'The same field-level improvement may support different forms of value for different participants. Pathways have different evidence, traceability, ownership, assurance, commercial reach, and cost requirements. Some may coexist; others may require exclusive allocation or careful claims controls.', detail: 'Terra Nexus helps clients compare the realizable value, cost, risk, timing, utilization, market capacity, and strategic benefit of each pathway to find the highest-value supportable play.' },
  ],
  // Each participant shows all 5 Capabilities (ALL_CAPABILITIES, above)
  // — lets "How We Support X" link out to each capability's own full
  // page instead of dead-ending in a single undifferentiated accordion.
  // Each capability group shows that capability's own real offering
  // names (CAPABILITIES.<key>.offerings — copied verbatim from that
  // capability's own page, see the comment above), not custom text
  // picked per participant, so the same capability reads identically no
  // matter which participant surfaces it.
  audiencePathways: [
    {
      title: 'Commodity Traders & Originators',
      description: 'Identify attractive crops, geographies, customers, and supply sheds; assess whether to build, buy, partner, or participate; design regenerative commodity and environmental-attribute offerings; structure producer enrollment, incentives, evidence, and contracts; establish origination, aggregation, traceability, and chain-of-custody controls; model premiums, program costs, value sharing, and margin; select technology, agronomy, MRV, and assurance partners; manage data quality; prepare customer documentation, reporting, and audit packages; and scale programs across producers, locations, crops, and buyers.',
      image: 'https://images.pexels.com/photos/38514489/pexels-photo-38514489.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
    },
    {
      title: 'Food, Beverage, Feed, Fiber & Consumer-Product Companies',
      description: 'Sourcing strategy, supply-shed prioritization, supplier programs, Scope 3 and land-sector accounting, investment planning, product strategy, claims controls, and managed value-chain execution.',
      image: 'https://images.pexels.com/photos/15455017/pexels-photo-15455017.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
    },
    {
      title: 'Agricultural Producers & Integrated Agricultural Companies',
      description: 'Evaluate program opportunities, commercial structures, data and evidence requirements, partner choices, implementation burdens, and routes to market. Specialized agronomic recommendations are developed with qualified local experts.',
      image: 'https://images.pexels.com/photos/29474130/pexels-photo-29474130.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
      note: 'Specialized agronomic recommendations are developed with qualified local experts.',
    },
    {
      title: 'Inputs Companies',
      description: 'Connect input products, services, agronomy, producer programs, outcome measurement, channel strategy, customer partnerships, and credible product or program claims.',
      image: 'https://images.pexels.com/photos/17475325/pexels-photo-17475325.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
    },
    {
      title: 'Ingredient & Feed Processors',
      description: 'Supplier engagement, traceable sourcing, processing and allocation controls, customer reporting, product differentiation, and integration with broader sourcing or environmental programs.',
      image: 'https://images.pexels.com/photos/4487383/pexels-photo-4487383.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
    },
    {
      title: 'Enabling Technology & Solution Providers',
      description: 'Market strategy, customer discovery, methodology alignment, technology and model diligence, enterprise-program requirements, data architecture, pilot design, partner selection, and integration into real commodity and corporate workflows.',
      image: 'https://images.pexels.com/photos/5230957/pexels-photo-5230957.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
    },
    {
      title: 'Investors & Environmental-Market Participants',
      description: 'Market assessment, commercial and technical diligence, project or program economics, methodology review, value-creation planning, portfolio assessment, and operating-risk evaluation.',
      image: 'https://images.pexels.com/photos/9261334/pexels-photo-9261334.jpeg?auto=compress&cs=tinysrgb&w=1200',
      capabilities: ALL_CAPABILITIES,
    },
  ],
  decisionGroups: [
    { heading: 'Strategy & Commercial Leaders', items: ['Which regenerative opportunities fit the business strategy and customer demand?', 'Which crops, supply sheds, products, and outcomes offer a credible business case?', 'Should the company build, buy, partner, invest, or participate?', 'How should value, transition costs, and risk be shared?'] },
    { heading: 'Origination, Procurement & Operations', items: ['Which producers and suppliers are ready to participate?', 'How should volumes be sourced, aggregated, contracted, and reconciled?', 'How should existing adopters and incomplete traceability be treated?', 'What evidence must move with the commodity or environmental attribute?'] },
    { heading: 'Sustainability, Climate & Claims Teams', items: ['Is the program intended for inventory progress, Scope 3, insetting, certification, product claims, carbon credits, resilience, water, biodiversity, or a combination?', 'Which accounting, target, certification, or market framework applies?', 'How should reductions, removals, avoided emissions, and broader outcomes be separated?', 'What may be reported credibly, by whom, and at what level of assurance?'] },
    { heading: 'Program, Technology & Data Teams', items: ['What data must be collected directly and what may be modeled?', 'Which systems, vendors, models, field evidence, and ledgers must connect?', 'How will data quality, versioning, corrections, exceptions, and access be managed?', 'Which activities belong internally, with partners, or in a managed service?'] },
    { heading: 'Finance, Investment & Risk Teams', items: ['What is the expected cost and value per acre, tonne, supplier, or product unit?', 'How sensitive is the business case to participation, outcomes, market demand, and assurance cost?', 'What methodology, counterparty, operational, fraud, and claims risks exist?', 'Is the program, platform, project, or portfolio investment supportable?'] },
  ],
  workstreams: [
    { title: 'Evaluate the Opportunity', items: ['Market, customer, competitor, and program landscape analysis', 'Supply-shed and producer opportunity assessment', 'Business cases, economics, scenarios, and value allocation', 'Technology, methodology, partner, project, and transaction diligence', 'Build-buy-partner and investment decisions'] },
    { title: 'Design the Program', items: ['Objectives, boundaries, outcomes, and participation criteria', 'Producer proposition, incentives, contracts, and risk allocation', 'Practice-based, outcome-based, or hybrid program architecture', 'Commercial model and routes to market', 'Governance, roles, controls, and assurance strategy'] },
    { title: 'Build the Operating Infrastructure', items: ['Producer and supplier workflows', 'Data requirements and system architecture', 'MRV, calculation, and quality-control processes', 'Traceability, chain of custody, mass balance, and attribute controls', 'Ledgers, documentation, reporting, and exception management'] },
    { title: 'Launch and Scale', items: ['Pilot design and success criteria', 'Partner and technology selection', 'Implementation planning and change management', 'Producer, originator, supplier, and buyer coordination', 'Program expansion across crops, geographies, and customers'] },
    { title: 'Manage Client-Owned Programs', items: ['Recurring producer and evidence workflows', 'Data review and calculation processes', 'Program and attribute ledgers', 'Vendor and partner coordination', 'Exception resolution and management reporting', 'Audit and verification preparation', 'Continuous program improvement'] },
    { title: 'Connect Performance to Claims and Market Value', items: ['Corporate inventory and target alignment', 'Certification and sourcing claims', 'Product, customer, and commercial propositions', 'Scope 3 and inset pathways', 'Carbon and ecosystem-service market assessment', 'Low-carbon feedstock and regulatory opportunities', 'Claims governance and communication boundaries'] },
  ],
  valuePathways: [
    { label: 'Regenerative sourcing or participation claims' },
    { label: 'Certification and product differentiation' },
    { label: 'Scope 3 reductions and insets' },
    { label: 'Carbon or ecosystem-service credits' },
    { label: 'Low-carbon feedstock or regulatory value' },
    { label: 'Procurement qualification and customer reporting' },
    { label: 'Resilience, supply-security, and risk-reduction value' },
  ],
  validationRows: [
    { category: 'Desirability', pitfall: 'The program starts with a practice list rather than a clear business objective.', validation: 'Start with the customer or commercial problem the program must solve, then map practices to that objective.' },
    { category: 'Viability', pitfall: 'Producer costs, risk, timing, and operational burden are underestimated.', validation: 'Build a producer economics model that quantifies cost, risk, timing, and operational burden before committing.' },
    { category: 'Feasibility', pitfall: 'A technology platform is selected before the operating model and evidence requirements are defined.', validation: 'Define the operating model and evidence requirements first, then select technology that fits them.' },
    { category: 'Feasibility', pitfall: 'Models, field data, contracts, commodity flows, and claims use different boundaries.', validation: 'Align all program boundaries (models, data, contracts, commodity flows, and claims) from the outset.' },
    { category: 'Feasibility', pitfall: 'Traceability is not sufficient for the intended accounting or product claim.', validation: 'Design traceability to match the accounting or claim level the program intends to support.' },
    { category: 'Strategic Fit', pitfall: 'Environmental attributes and usage rights are unclear or allocated more than once.', validation: 'Establish clear ownership and single-use allocation of environmental attributes before commercialization.' },
    { category: 'Viability', pitfall: 'The customer proposition does not cover the cost of origination, data, assurance, and management.', validation: 'Validate that the customer proposition fully covers origination, data, assurance, and management costs.' },
    { category: 'Strategic Fit', pitfall: 'Pilot success criteria do not test the assumptions required for commercial scale.', validation: 'Design pilot success criteria that explicitly test the assumptions needed for commercial-scale decisions.' },
    { category: 'Feasibility', pitfall: 'Ongoing program management, corrections, exceptions, and verification readiness are not adequately resourced.', validation: 'Resource recurring management, exception handling, and verification readiness as core program costs.' },
  ],
  ctaHeading: 'Build Regenerative Agriculture That Works from Field to Market',
  ctaBody: 'Whether you are evaluating a new opportunity, designing a producer program, selecting technology, building traceability and controls, scaling an existing initiative, or preparing evidence and claims for independent review, Terra Nexus helps identify and execute the next steps.',
  ctaButton: { label: 'Discuss Your Program', href: '/contact/' },
};

// validationRows grouped by category, in first-seen order — computed from
// the real data (Desirability, Viability, Feasibility, Strategic Fit fall
// out naturally in that order), not hardcoded.
const validationGroups: Array<{ category: string; rows: typeof data.validationRows }> = [];
for (const row of data.validationRows) {
  let group = validationGroups.find((g) => g.category === row.category);
  if (!group) {
    group = { category: row.category, rows: [] };
    validationGroups.push(group);
  }
  group.rows.push(row);
}

// Feeds the grouped before/after pairs into the interactive DVF framework
// as each base dimension's `beforeAfter` list, so the diagram, its short
// framework explanation, AND the concrete pitfall/fix guidance render as
// one unified panel instead of a separate block stacked underneath —
// same real validationRows data as before, just merged into the
// interactive component rather than duplicated alongside it.
const CATEGORY_TO_REGION: Record<string, 'desirable' | 'viable' | 'feasible' | 'strategic-fit'> = {
  Desirability: 'desirable',
  Viability: 'viable',
  Feasibility: 'feasible',
  'Strategic Fit': 'strategic-fit',
};
const dvfContent: Record<string, { beforeAfter: Array<{ pitfall: string; validation: string }> }> = {};
for (const group of validationGroups) {
  const regionId = CATEGORY_TO_REGION[group.category];
  if (regionId) {
    dvfContent[regionId] = {
      beforeAfter: group.rows.map((row) => ({ pitfall: row.pitfall, validation: row.validation })),
    };
  }
}
---

<SiteLayout title={data.metaTitle} description={data.metaDescription} preview={mode === 'preview'}>

  <!-- Scroll progress indicator — fixed thin bar above the header,
       filled by JS based on page scroll position. Informational, not
       gratuitous: reduced-motion just removes the easing on its width
       transition (global design-system.css override), the bar itself
       stays since it's not really "motion" so much as a live readout. -->
  <div class="scroll-progress" aria-hidden="true">
    <div class="scroll-progress-fill" data-scroll-progress-fill></div>
  </div>

  <!-- Chapter 1 — Hero. Normal (non-sticky) flow; the stacking behavior
       begins at Chapter 2. -->
  <PageHero
    variant="media"
    heroImage={data.heroImage}
    eyebrow={data.eyebrow}
    title={data.title}
    lead={data.lead}
    primaryCta={data.primaryCta}
    secondaryCta={data.secondaryCta}
  />

  <div class="scroll-stack">

    <!-- Chapter 2 — Overview + Key Benefits, one chapter/act (a single
         sticky-release spacer — two separate acts back-to-back produced
         a much bigger dead gap between them than the rest of the page's
         rhythm). Overview is a full-width, horizontal editorial intro
         (two-column paragraph spread at desktop, like a magazine lede).
         Key Benefits is a plain, high-contrast 2x2 grid reusing the same
         type scale, numbered-index treatment, and tight-list bullets as
         every other numbered section on this page (Key Questions, Our
         Approach, How It Works) — after a full-bleed photo/accordion
         treatment tested hard to read and visually inconsistent with the
         rest of the page (see QA screenshots), this trades novelty for
         legibility and consistency. No image: none of the candidate
         stock photos actually depicted "benefits" any better than
         generic farmland, so a photo backdrop wasn't earning its keep
         here — the numbered index + heading + bullets carry the content
         on their own, same as they do everywhere else on this page. -->
    <ScrollPanel index={1} aria-labelledby="overview-heading">
      <div class="overview-block" data-reveal>
        <span class="eyebrow">Overview</span>
        <h2 id="overview-heading">{data.title}</h2>
        <div class="overview-columns">
          {data.orientation.map((para) => <p class="chapter-lead">{para}</p>)}
        </div>
      </div>

      <div class="benefits-block" data-reveal>
        <h3 class="chapter-secondary-title">Key Benefits</h3>
        <div class="benefits-grid">
          {data.performanceCategories.map((cat, i) => (
            <div class="benefit-tile">
              <span class="numbered-index benefit-tile-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="benefit-tile-body">
                <h4 class="benefit-tile-title">{cat.title}</h4>
                <ul class="tight-list" role="list">
                  {cat.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </ScrollPanel>

    <!-- Chapter 4 — Market Validation (moved above Our Approach). The
         interactive Desirability/Feasibility/Viability + Strategic Fit
         framework (StrategyFrameworkDVF.astro) IS the section now — each
         base-dimension state's content panel includes both the short
         framework explanation and that dimension's real before/after
         pitfall/fix pairs (fed in via the `content` prop below), so the
         diagram + explanation + validation guidance read as one unified
         part instead of a diagram with a separate block stacked under it.
         decisionGroups render below as an interactive "Validation
         Questions" accordion (2026-08-18 — was a static 3-column grid;
         the "Forms of Value This Can Support" tag block that used to sit
         under it was removed, per owner feedback, as redundant with the
         Market Validation framework above it). data.valuePathways is left
         in place unused, same convention as data.systemSteps elsewhere in
         this file, in case this content returns in another form later.
         The DVF component's own click/keyboard interaction is untouched
         and independent of page scroll — this chapter is just one more
         sticky "act" containing it, same as before. -->
    <ScrollPanel index={2} tone="alt" aria-labelledby="validation-heading">
      <header class="section-header">
        <span class="eyebrow">Market Validation</span>
        <h2 id="validation-heading">Market Validation</h2>
        <p class="section-lead validation-lead">A customer-centric approach, starting with desirability, then validating viability, feasibility, and strategic fit, prevents the most common reasons programs struggle. Select any region of the framework below to explore that combination, including the pitfall it prevents and the practice that replaces it.</p>
      </header>

      <div class="dvf-block" data-reveal>
        <StrategyFrameworkDVF heading="Where Does an Opportunity Sit?" eyebrow="Interactive Framework" content={dvfContent} />
      </div>

      <div class="decisions-block" data-reveal>
        <h3 class="chapter-secondary-title">Validation Questions</h3>
        <div class="accordion decisions-list">
          {data.decisionGroups.map((group, i) => (
            <details class="accordion-item decision-item">
              <summary class="decision-summary">
                <span class="numbered-index decision-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="decision-summary-body">
                  <span class="decision-heading">{group.heading}</span>
                  <span class="decision-count">{group.items.length} question{group.items.length === 1 ? '' : 's'}</span>
                </span>
                <svg class="decision-chevron" width="14" height="8" viewBox="0 0 14 8" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="decision-question-list">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </details>
          ))}
        </div>
      </div>
    </ScrollPanel>

    <!-- Chapter 8 — Our Approach (workstreams), presented as a horizontal
         01→06 scroll timeline (unchanged from before — only its parent
         act's index/z-index moved). Reformatted from a horizontal-scroll
         single row (cut content off at narrower viewports, required
         sideways scrolling to read past step 4) to a 2-column grid —
         same numbered-index + title + bullet-list treatment used
         elsewhere on this page (Key Questions / How It Works), so every
         workstream is visible without horizontal scrolling. -->
    <ScrollPanel index={3} aria-labelledby="approach-heading">
      <header class="section-header">
        <span class="eyebrow">Our Approach</span>
        <h2 id="approach-heading">Our Approach</h2>
      </header>
      <ol class="approach-grid" role="list">
        {data.workstreams.map((ws, i) => (
          <li class="approach-item" data-reveal style={`--reveal-i: ${i}`}>
            <span class="numbered-index">{String(i + 1).padStart(2, '0')}</span>
            <div class="approach-item-body">
              <h3>{ws.title}</h3>
              <ul class="tight-list">
                {ws.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </ScrollPanel>

    <!-- Chapter 9 — How It Works (systemSteps) removed for now — judged
         redundant alongside Our Approach and Market Validation's Key
         Questions above. `data.systemSteps` itself is left in place
         (unused) in case this comes back later; only the rendered
         ScrollPanel was removed. -->

    <!-- Chapter 10 — Who We Support (audiencePathways) — same dark
         segment-slider webpart as the homepage's "Who We Work With"
         section (src/components/SegmentSlider.astro), reused here per
         design feedback rather than the large numbered-index list this
         used before. Same seven participant titles/descriptions,
         unchanged. Unlike the homepage's value-chain segments (which
         each link to their own detail page), each participant here maps
         to multiple Capabilities — so the in-panel accordion is grouped
         by capability instead of one flat list, and each group links out
         to that capability's own /capabilities/<slug>/ page. -->
    <ScrollPanel index={4} aria-labelledby="audiences-heading">
      <header class="section-header">
        <span class="eyebrow">Who We Support</span>
        <h2 id="audiences-heading">How We Support Different Participants</h2>
      </header>
      <SegmentSlider
        label="By Participant"
        items={data.audiencePathways.map((aud) => ({
          name: aud.title,
          description: aud.description,
          image: aud.image,
          note: aud.note,
          accordionGroups: aud.capabilities.map((capability) => ({
            heading: capability.name,
            items: capability.offerings,
            href: capability.href,
          })),
        }))}
      />
    </ScrollPanel>

  </div>

  <!-- Chapter 11 — Closing CTA. Deliberately outside .scroll-stack so it
       releases back into plain document flow and is never sticky/covered. -->
  <ClosingCta
    headingId="final-cta-heading"
    heading={data.ctaHeading}
    description={data.ctaBody}
    primaryCta={data.ctaButton}
  />
</SiteLayout>

