    { title: 'Food-Rescue, Recovery & Community Organizations', description: 'Program design, corporate partnerships, logistics, data, measurement, commercial models, governance, and scale planning.' },
  ],
  decisionGroups: [
    { heading: 'Assessment & Prevention', items: ['Where is food or material value being lost and why?', 'Which losses can be prevented rather than managed downstream?', 'What is edible, safe, stable, and commercially usable?'] },
