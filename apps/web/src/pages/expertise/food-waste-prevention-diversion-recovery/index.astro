    { heading: 'Technology, Partners & Scale', items: ['Which technologies and partners fit the operating environment?', 'Who owns the material, output, claim, and environmental attribute?', 'How will the program scale without shifting cost or impact elsewhere?'] },
  ],
  workstreams: [
    { title: 'Evaluate the Opportunity', items: ['Material-flow and value-loss assessment', 'Root-cause and operational analysis', 'Market, customer, technology, and partner research', 'Business cases and initiative prioritization', 'Project, company, technology, and investment diligence'] },
    { title: 'Design the Portfolio and Business Model', items: ['Prevention, redistribution, upcycling, feed, recycling, and recovery strategy', 'Product and co-product business models', 'Customer, partner, pricing, and route-to-market design', 'Capital, operating, value-allocation, and financing models', 'Program targets, measurement, claims, and governance'] },
    { title: 'Build the Operating Infrastructure', items: ['Facility, supplier, customer, and partner workflows', 'Segregation, quality, safety, data, and inventory controls', 'Contracts, logistics, specifications, and documentation', 'Technology and vendor selection', 'Reporting, accounting, and claim-support systems'] },
    { title: 'Launch and Scale', items: ['Pilot design and decision gates', 'Partner and customer onboarding', 'Operational rollout and training', 'First transactions and performance review', 'Expansion across sites, materials, products, and markets'] },
    { title: 'Manage Delivery', items: ['Recurring data and performance review', 'Partner, customer, and facility coordination', 'Material and outlet reconciliation', 'Exception, quality, and corrective-action management', 'Reporting, claims support, and continuous improvement'] },
