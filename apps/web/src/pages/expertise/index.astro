---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
const mode = getBuildMode();

const expertiseAreas = [
  { title: 'Regenerative Agriculture', slug: 'regenerative-agriculture', description: 'Connect better crop-production systems with producer economics, supply-chain requirements, credible evidence, and market value.', heroImage: 'https://images.pexels.com/photos/38514489/pexels-photo-38514489.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Regenerative Rangeland', slug: 'regenerative-rangeland', description: 'Build resilient grazing and livestock systems that improve land performance, producer value, and downstream market opportunities.', heroImage: 'https://images.pexels.com/photos/29474130/pexels-photo-29474130.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Agroforestry', slug: 'agroforestry', description: 'Integrate trees, crops, livestock, long-term land value, environmental outcomes, and reliable routes to market.', heroImage: 'https://images.pexels.com/photos/5838949/pexels-photo-5838949.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Aquaculture', slug: 'aquaculture', description: 'Improve aquatic production, feed, operations, traceability, environmental performance, product strategy, and market access.', heroImage: 'https://images.pexels.com/photos/14992906/pexels-photo-14992906.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Biodiversity & Ecosystem Resilience', slug: 'biodiversity-and-ecosystem-resilience', description: 'Translate nature dependencies, impacts, risks, and opportunities into prioritized business and landscape action.', heroImage: 'https://images.pexels.com/photos/17475325/pexels-photo-17475325.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Sustainable Supply Chains', slug: 'sustainable-supply-chains', description: 'Connect responsible production with sourcing, traceability, operations, environmental attributes, products, customers, and credible claims.', heroImage: 'https://images.pexels.com/photos/4487383/pexels-photo-4487383.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Low Carbon Energy & Biofuels', slug: 'low-carbon-energy-and-biofuels', description: 'Create more value from feedstock, origination, processing, carbon-intensity, chain-of-custody, and regulatory opportunities.', heroImage: 'https://images.pexels.com/photos/35284297/pexels-photo-35284297.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Purpose-Driven Food Brands & Retailers', slug: 'purpose-driven-food-brands-and-retailers', description: 'Turn better products and sourcing into customer value through credible product, portfolio, pricing, channel, and claims strategies.', heroImage: 'https://images.pexels.com/photos/15455017/pexels-photo-15455017.jpeg?auto=compress&cs=tinysrgb&w=1600' },
  { title: 'Food Waste: Prevention, Diversion & Recovery', slug: 'food-waste-prevention-diversion-recovery', description: 'Prevent loss, keep edible food in use, create value from byproducts, and recover remaining resources through the highest practical use.', heroImage: 'https://images.pexels.com/photos/36751332/pexels-photo-36751332.jpeg?auto=compress&cs=tinysrgb&w=1600' },
];
---

<SiteLayout
  title="Areas of Expertise | Terra Nexus"
  description="Terra Nexus brings specialized knowledge to the production systems, supply chains, markets, products, and recovery pathways where food-and-climate performance can create commercial and environmental value."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Areas of Expertise"
    title="Expertise Across the Food and Agriculture System"
    lead="Terra Nexus brings specialized knowledge to the production systems, supply chains, markets, products, and recovery pathways where food-and-climate performance can create commercial and environmental value."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Capabilities', href: '/capabilities/' }}
  />

  <section class="section">
    <div class="container">
      <div class="expertise-grid">
        {expertiseAreas.map((area) => (
          <a href={`/expertise/${area.slug}/`} class="expertise-tile">
            <img src={area.heroImage} alt="" class="tile-img" loading="lazy" />
            <div class="tile-overlay"></div>
            <div class="tile-content">
              <h3 class="tile-title">{area.title}</h3>
              <p class="tile-desc">{area.description}</p>
              <span class="tile-cta">Learn More <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container text-container">
      <h2>What Connects the Topics</h2>
      <p>An Area of Expertise identifies the domain in which change is being pursued. Terra Nexus then brings the capabilities, value-chain perspective, partners, evidence, and market mechanisms needed to determine the best supportable path.</p>
      <p>The public pages explain the decisions and opportunities within each topic. Detailed intervention libraries, pricing, claim-stacking analysis, and client-specific pathways remain part of paid client work.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container text-center">
      <h2>Discuss Your Challenge</h2>
      <p class="cta-description">Tell us what you are evaluating, building, or trying to improve. Terra Nexus will identify the expertise and capabilities that fit.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
        <a href="/capabilities/" class="btn btn-secondary">Explore Our Capabilities</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 40rem) {
    .expertise-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64rem) {
    .expertise-grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  }

  .expertise-tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: var(--color-dark);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
    isolation: isolate;
  }
  .expertise-tile:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }
  .expertise-tile:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform var(--transition-slow);
  }
  .expertise-tile:hover .tile-img {
    transform: scale(1.05);
  }

  .tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.45) 55%, rgba(15, 23, 42, 0.2) 100%);
    z-index: -1;
    transition: background var(--transition-base);
  }
  .expertise-tile:hover .tile-overlay {
    background: linear-gradient(to top, rgba(15, 23, 42, 0.92) 0%, rgba(15, 23, 42, 0.6) 55%, rgba(15, 23, 42, 0.35) 100%);
  }

  .tile-content {
    padding: var(--space-6);
    width: 100%;
  }
  .tile-title {
    color: #fff;
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
    text-shadow: 0 2px 8px rgba(15, 23, 42, 0.3);
  }
  .tile-desc {
    color: rgba(248, 250, 252, 0.85);
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height var(--transition-base), opacity var(--transition-base), margin var(--transition-base);
  }
  .expertise-tile:hover .tile-desc,
  .expertise-tile:focus-visible .tile-desc {
    max-height: 10rem;
    opacity: 1;
    margin-bottom: var(--space-4);
  }

  .tile-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--c-primary-300);
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }
  .expertise-tile:hover .tile-cta,
  .expertise-tile:focus-visible .tile-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 40rem) {
    .tile-content { padding: var(--space-5); }
    .tile-desc { max-height: none; opacity: 1; margin-bottom: var(--space-3); }
    .tile-cta { opacity: 1; transform: none; }
  }
</style>
