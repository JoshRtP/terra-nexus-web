---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
const mode = getBuildMode();

const expertiseAreas = [
  {
    title: 'Regenerative Agriculture',
    slug: 'regenerative-agriculture',
    description: 'Connect better crop-production systems with producer economics, supply-chain requirements, credible evidence, and market value.',
    heroImage: 'https://images.pexels.com/photos/38514489/pexels-photo-38514489.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Regenerative Rangeland',
    slug: 'regenerative-rangeland',
    description: 'Build resilient grazing and livestock systems that improve land performance, producer value, and downstream market opportunities.',
    heroImage: 'https://images.pexels.com/photos/29474130/pexels-photo-29474130.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Agroforestry',
    slug: 'agroforestry',
    description: 'Integrate trees, crops, livestock, long-term land value, environmental outcomes, and reliable routes to market.',
    heroImage: 'https://images.pexels.com/photos/5838949/pexels-photo-5838949.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Aquaculture',
    slug: 'aquaculture',
    description: 'Improve aquatic production, feed, operations, traceability, environmental performance, product strategy, and market access.',
    heroImage: 'https://images.pexels.com/photos/14992906/pexels-photo-14992906.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Biodiversity & Ecosystem Resilience',
    slug: 'biodiversity-and-ecosystem-resilience',
    description: 'Translate nature dependencies, impacts, risks, and opportunities into prioritized business and landscape action.',
    heroImage: 'https://images.pexels.com/photos/17475325/pexels-photo-17475325.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Sustainable Supply Chains',
    slug: 'sustainable-supply-chains',
    description: 'Connect responsible production with sourcing, traceability, operations, environmental attributes, products, customers, and credible claims.',
    heroImage: 'https://images.pexels.com/photos/4487383/pexels-photo-4487383.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Low Carbon Energy & Biofuels',
    slug: 'low-carbon-energy-and-biofuels',
    description: 'Create more value from feedstock, origination, processing, carbon-intensity, chain-of-custody, and regulatory opportunities.',
    heroImage: 'https://images.pexels.com/photos/35284297/pexels-photo-35284297.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Purpose-Driven Food Brands & Retailers',
    slug: 'purpose-driven-food-brands-and-retailers',
    description: 'Turn better products and sourcing into customer value through credible product, portfolio, pricing, channel, and claims strategies.',
    heroImage: 'https://images.pexels.com/photos/15455017/pexels-photo-15455017.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
  {
    title: 'Food Waste: Prevention, Diversion & Recovery',
    slug: 'food-waste-prevention-diversion-recovery',
    description: 'Prevent loss, keep edible food in use, create value from byproducts, and recover remaining resources through the highest practical use.',
    heroImage: 'https://images.pexels.com/photos/36751332/pexels-photo-36751332.jpeg?auto=compress&cs=tinysrgb&w=1200',
  },
];
---

<SiteLayout
  title="Areas of Expertise | Terra Nexus"
  description="Terra Nexus brings specialized knowledge to the production systems, supply chains, markets, products, and recovery pathways where food-and-climate performance can create commercial and environmental value."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Areas of Expertise"
    title="Expertise Across the Food and Agriculture System"
    lead="Terra Nexus brings specialized knowledge to the production systems, supply chains, markets, products, and recovery pathways where food-and-climate performance can create commercial and environmental value."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Capabilities', href: '/capabilities/' }}
  />

  <section class="section">
    <div class="container">
      <ul class="expertise-grid" role="list">
        {expertiseAreas.map((area) => (
          <li>
            <a
              href={`/expertise/${area.slug}/`}
              class="expertise-tile"
              style={`background-image: url('${area.heroImage}')`}
              aria-label={area.title}
            >
              <div class="tile-overlay" aria-hidden="true"></div>
              <div class="tile-content">
                <h3 class="tile-title">{area.title}</h3>
                <p class="tile-desc">{area.description}</p>
                <span class="tile-cta" aria-hidden="true">Learn More &rarr;</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container text-container">
      <h2>What Connects the Topics</h2>
      <p>An Area of Expertise identifies the domain in which change is being pursued. Terra Nexus then brings the capabilities, value-chain perspective, partners, evidence, and market mechanisms needed to determine the best supportable path.</p>
      <p style="margin-top: 1rem;">Detailed intervention libraries, pricing, claim-stacking analysis, and client-specific pathways are part of paid client work. The pages below explain the decisions and opportunities within each topic.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container text-center">
      <h2>Discuss Your Challenge</h2>
      <p class="cta-description">Tell us what you are evaluating, building, or trying to improve. Terra Nexus will identify the expertise and capabilities that fit.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
        <a href="/capabilities/" class="btn btn-secondary">Explore Our Capabilities</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* ── Grid ─────────────────────────────────────────── */
  .expertise-grid {
    display: grid;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 1.5rem;
    grid-template-columns: repeat(1, 1fr);
  }
  @media (min-width: 640px) {
    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .expertise-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* ── Tile ─────────────────────────────────────────── */
  .expertise-tile {
    display: flex;
    align-items: flex-end;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    /* background-image set inline per tile */
    background-size: cover;
    background-position: center;
    background-color: #0f172a; /* fallback while image loads */
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.15);
    transition: box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .expertise-tile:hover {
    box-shadow: 0 20px 40px -8px rgba(15, 23, 42, 0.35);
    transform: translateY(-4px);
  }
  .expertise-tile:focus-visible {
    outline: 3px solid #0d9488;
    outline-offset: 3px;
  }

  /* Scale the bg image on hover — CSS only, no JS */
  .expertise-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: inherit;
    background-size: cover;
    background-position: center;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }
  .expertise-tile:hover::before {
    transform: scale(1.06);
  }

  /* ── Gradient overlay ─────────────────────────────── */
  .tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.90) 0%,
      rgba(15, 23, 42, 0.50) 50%,
      rgba(15, 23, 42, 0.15) 100%
    );
    transition: background 250ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }
  .expertise-tile:hover .tile-overlay {
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.95) 0%,
      rgba(15, 23, 42, 0.65) 55%,
      rgba(15, 23, 42, 0.30) 100%
    );
  }

  /* ── Content ──────────────────────────────────────── */
  .tile-content {
    position: relative;
    z-index: 2;
    padding: 1.5rem;
    width: 100%;
  }

  .tile-title {
    color: #fff;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    text-shadow: 0 1px 6px rgba(15, 23, 42, 0.5);
  }

  .tile-desc {
    color: rgba(248, 250, 252, 0.88);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    /* Animate in on hover */
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 300ms cubic-bezier(0.4, 0, 0.2, 1),
                opacity 250ms cubic-bezier(0.4, 0, 0.2, 1),
                margin-bottom 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .expertise-tile:hover .tile-desc,
  .expertise-tile:focus-visible .tile-desc {
    max-height: 8rem;
    opacity: 1;
    margin-bottom: 0.75rem;
  }

  .tile-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #5eead4; /* teal-300 */
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 250ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .expertise-tile:hover .tile-cta,
  .expertise-tile:focus-visible .tile-cta {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Mobile: always show desc + CTA ──────────────── */
  @media (max-width: 639px) {
    .tile-desc {
      max-height: 12rem;
      opacity: 1;
      margin-bottom: 0.75rem;
    }
    .tile-cta {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Reduced motion ───────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .expertise-tile,
    .expertise-tile::before,
    .tile-overlay,
    .tile-desc,
    .tile-cta {
      transition: none;
    }
    .expertise-tile:hover {
      transform: none;
    }
    .expertise-tile:hover::before {
      transform: none;
    }
  }
</style>
