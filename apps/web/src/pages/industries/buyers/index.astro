---
// Lightweight prototype child route — Industries/Insights IA prototype.
// Not final editorial content; demonstrates the IA only. See CLAUDE.md.
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';
import PageHero from '../../../components/PageHero.astro';
import ClosingCta from '../../../components/ClosingCta.astro';
const mode = getBuildMode();

const categories = [
  { title: 'Decarbonization & Scope 3 Progress', description: 'Progress toward corporate climate targets, supply-chain reduction goals, and Scope 3 accounting.' },
  { title: 'Certification & Product Differentiation', description: 'Certified sourcing, product claims, and differentiated positioning that require credible, verifiable evidence.' },
  { title: 'Regulatory Compliance & Reporting', description: 'Regulatory obligations, environmental reporting requirements, and low-carbon fuel or product standards.' },
  { title: 'Procurement Qualification', description: 'Customer requirements, supplier qualification criteria, and category-specific sourcing standards.' },
];
---

<SiteLayout
  title="Buyers | Industries | Terra Nexus"
  description="Organizations procuring and using differentiated products, verified environmental outcomes, attributes, certifications, and claims to achieve commercial, sustainability, and decarbonization objectives."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Industries — Buyers"
    title="Organizations That Procure and Use Value"
    lead="Buyers procure, contract for, acquire, incorporate, retire, or otherwise use the environmental value Producers create — not only tradable carbon credits, but physical products, verified outcomes, certifications, and claims-supporting evidence."
    primaryCta={{ label: 'Discuss Your Program', href: '/contact/' }}
    secondaryCta={{ label: 'Back to Industries', href: '/industries/' }}
  />

  <section class="section" aria-labelledby="categories-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Representative Categories</span>
        <h2 id="categories-heading">What Buyers Are Procuring</h2>
        <p class="section-lead">
          Physical products, environmental attributes, verified outcomes, certifications, and
          claims-supporting evidence — often in combination.
        </p>
      </header>
      <div class="card-grid card-grid-3">
        {categories.map((cat) => (
          <article class="card card-static">
            <h3>{cat.title}</h3>
            <p>{cat.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta
    heading="Sourcing Verified Environmental Value?"
    description="Tell us what you need to procure, prove, or report — Terra Nexus helps Buyers connect to credible, verifiable supply."
    primaryCta={{ label: 'Discuss Your Program', href: '/contact/' }}
    secondaryCta={{ label: 'See Producers', href: '/industries/producers/' }}
  />
</SiteLayout>
