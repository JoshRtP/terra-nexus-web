---
// Lightweight prototype child route — Industries/Insights IA prototype.
// Not final editorial content; demonstrates the IA only. See CLAUDE.md.
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';
import PageHero from '../../../components/PageHero.astro';
import ClosingCta from '../../../components/ClosingCta.astro';
const mode = getBuildMode();

const categories = [
  { title: 'Certified & Differentiated Products', description: 'Certified agricultural commodities, ingredients, regenerative and low-carbon products, traceable low-CI fuels and feedstocks.' },
  { title: 'Product-Level Evidence & Claims', description: 'Product Carbon Footprints, LCAs, environmental product claims, carbon-intensity claims, certified sourcing claims.' },
  { title: 'Supply-Chain Environmental Outcomes', description: 'Verified Scope 3 reductions, insets, regenerative agriculture outcomes, traceable low-carbon sourcing.' },
  { title: 'Environmental Assets', description: 'Carbon offsets, Environmental Attribute Certificates, ecosystem-service credits, carbon removals, and other transferable attributes.' },
];
---

<SiteLayout
  title="Producers | Industries | Terra Nexus"
  description="Organizations that create, originate, quantify, certify, or supply environmentally differentiated products, verified outcomes, environmental attributes, and credible claims."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Industries — Producers"
    title="Organizations That Create and Supply Value"
    lead="Producers create, originate, quantify, certify, or supply environmentally differentiated products, verified outcomes, environmental attributes, and credible claims — from agricultural producers and processors to fuel producers, project developers, and environmental-asset originators."
    primaryCta={{ label: 'Discuss Your Program', href: '/contact/' }}
    secondaryCta={{ label: 'Back to Industries', href: '/industries/' }}
  />

  <section class="section" aria-labelledby="categories-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Representative Categories</span>
        <h2 id="categories-heading">What Producers Bring to Market</h2>
        <p class="section-lead">
          This includes both physical products and environmental / accounting attributes — the
          category is not limited to farmers, ranchers, or project developers.
        </p>
      </header>
      <div class="card-grid card-grid-3">
        {categories.map((cat) => (
          <article class="card card-static">
            <h3>{cat.title}</h3>
            <p>{cat.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta
    heading="Producing or Certifying Environmental Value?"
    description="Tell us what you're bringing to market — Terra Nexus helps Producers connect verified value to real commercial demand."
    primaryCta={{ label: 'Discuss Your Program', href: '/contact/' }}
    secondaryCta={{ label: 'See Buyers', href: '/industries/buyers/' }}
  />
</SiteLayout>
