---
// Who We Work With — one scrollable page.
//
// Replaces the old three-page structure (this hub + a Food & Agribusiness
// Value Chain page + an Enabling Markets page) and absorbs the three
// /industries/<role>/ prototype routes, all of which now redirect here
// (astro.config.ts). Owner decision, 2026-09-13: bring the depth up one level
// rather than making people click twice for content that was thinner than the
// homepage teaser pointing at it.
//
// Everything renders from src/data/who-we-work-with.ts, which is also what the
// homepage's two-tab teaser reads — so the teaser and the deep page can no
// longer drift. The homepage shows name/node/opportunity/activities; this page
// shows all of it.
//
// Design pass, 2026-09-13 (owner review): the first build rendered this content
// as dark-text-on-white prose while the homepage renders the *same* content in
// a navy panel with gold labels and inset cards, so the page read as a
// different site. It now borrows that vocabulary translated to a light surface
// — .split-header section headers, maroon .eyebrow labels, a tinted labelled
// card for the opportunity, and the homepage's own <details> accordion for the
// activity rows, which also halves a page that ran to ~18,000px.
//
// Deliberately stacked rather than tabbed. Tabs are right on the homepage,
// where space is tight and the job is to tease. Here the job is depth and
// crawlability: every block is a real heading with a stable anchor, the
// Industries mega-menu deep-links straight into them, and accordion bodies stay
// in the DOM.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
import SectionRail from '../../components/SectionRail.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import {
  marketRoles,
  segments,
  enablers,
  expertiseLinks,
  EXAMPLES_DISCLAIMER,
} from '../../data/who-we-work-with';

const mode = getBuildMode();

// Capability links are deliberately not rendered (owner, 2026-09-13): every
// block would carry nearly the same four, so they added noise rather than
// navigation. Related expertise stays because it genuinely differs by segment.

// Rail labels only — the full names are far too long for a 10rem rail column.
const shortLabel: Record<string, string> = {
  'inputs-companies': 'Inputs',
  'agricultural-producers': 'Producers',
  'commodity-traders': 'Traders',
  'ingredient-feed-processors': 'Processors',
  'food-beverage-companies': 'Food & Beverage',
  'food-retail-distribution': 'Retail',
  'energy-biofuels-refiners': 'Energy & Biofuels',
  'food-waste-prevention-diversion-recovery': 'Food Waste',
  'environmental-markets': 'Environmental Markets',
  'enabling-tech': 'Enabling Tech',
  'capital-providers': 'Capital',
};

const railEntries = [
  { id: 'market-roles', label: 'Market roles' },
  ...segments.map((s) => ({ id: s.slug, label: shortLabel[s.slug] ?? s.name })),
  ...enablers.map((e) => ({ id: e.slug, label: shortLabel[e.slug] ?? e.name })),
];
const railSections = railEntries.map((e, i) => ({
  ...e,
  n: String(i + 1).padStart(2, '0'),
}));

// Each entry carries the same numeral the rail gives it, so the two read as one
// system and a 16,000px scroll has a sense of position rather than being
// fourteen interchangeable cards.
const indexFor = (id: string) => railSections.find((r) => r.id === id)?.n ?? '';
---

<SiteLayout
  title="Who We Work With | Terra Nexus"
  description="Terra Nexus works across the food and agribusiness value chain and with the markets, technology providers, assurance organizations, and capital partners that enable it."
  canonical="/who-we-work-with/"
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Who We Work With"
    title="Shared Value Requires the Whole System"
    lead="Terra Nexus works across the food and agribusiness value chain and with the markets, technology providers, assurance organizations, and capital partners that enable it. A client may hire Terra Nexus at one node, but we evaluate the actions, evidence, economics, incentives, and collaboration required across every participant needed to make the solution work."
    primaryCta={{ label: 'Discuss Your Value-Chain Challenge', href: '/contact/' }}
  />

  <SectionRail
    sections={railSections}
    revealAfter="[data-page-hero]"
    ariaLabel="Who we work with, by section"
  />

  {/* ── The chain, as a picture ────────────────────────────────────────── */}
  <section class="section" aria-labelledby="chain-heading">
    <div class="container">
      <header class="section-header split-header">
        <span class="eyebrow split-header-eyebrow">The Whole Chain</span>
        <div class="split-header-title">
          <h2 id="chain-heading">The Food &amp; Agribusiness Value Chain</h2>
        </div>
        <div class="split-header-lead">
          <p class="section-lead">
            Eight segments move food and agricultural material from input to end use, supported by
            three groups that make environmental performance measurable, tradable and financeable.
            The flow is not strictly linear: Energy &amp; Biofuels and Food Waste connect to
            several nodes at once.
          </p>
        </div>
      </header>

      <div
        class="diagram-container"
        role="figure"
        aria-label="Food and agribusiness value chain diagram showing eight value-chain segments and three enabling groups."
      >
        <img
          src="/diagrams/value-chain-with-associated-enablers.png"
          alt="Food and agribusiness value chain with associated enablers. Value-chain segments: Inputs, Agricultural Production, Commodity Trading, Ingredient and Feed Processing, Food and Beverage, Food Retail and Distribution, Energy and Biofuels, and Food Waste Prevention Diversion and Recovery. Enabling groups: Environmental Markets and Ecosystem Services, Enabling Tech and Solution Providers, and Private Equity Venture Capital and Impact Investors."
          width="1795"
          height="744"
          loading="lazy"
          decoding="async"
          class="diagram-img"
        />
      </div>
    </div>
  </section>

  {/* ── By market role ─────────────────────────────────────────────────── */}
  <section class="section section-alt" id="market-roles" aria-labelledby="roles-heading">
    <div class="container">
      <header class="section-header split-header">
        <span class="eyebrow split-header-eyebrow">By Market Role</span>
        <div class="split-header-title">
          <h2 id="roles-heading">A Role, Not Just an Industry</h2>
        </div>
        <div class="split-header-lead">
          <p class="section-lead">
            The same company can hold more than one of these positions at once — a trader
            originating a program is a producer of environmental value and a buyer of it in the
            same quarter. The role describes what you are doing in a given transaction, not what
            industry you are in.
          </p>
        </div>
      </header>

      <div class="wwt-entries">
        {marketRoles.map((role) => (
          <article class="card card-static wwt-entry" id={role.slug}>
            <div class="wwt-entry-head">
              <h3>{role.name}</h3>
              <p class="wwt-headline">{role.headline}</p>
              <p class="wwt-node">{role.node}</p>
            </div>
            <div class="wwt-entry-body">
              <div class="wwt-opportunity">
                <span class="wwt-opportunity-label">The Opportunity</span>
                <p>{role.opportunity}</p>
              </div>

              <h4 class="wwt-sub">What This Role Brings to Market</h4>
              <div class="wwt-categories">
                {role.categories.map((cat) => (
                  <div class="wwt-category">
                    <p class="wwt-category-title">{cat.title}</p>
                    <p class="wwt-category-desc">{cat.description}</p>
                  </div>
                ))}
              </div>

              <h4 class="wwt-sub">How We Work Together</h4>
              <div class="wwt-activities">
                {role.activities.map((act) => (
                  <details class="wwt-activity">
                    <summary>
                      <span class="wwt-activity-name">{act.name}</span>
                      <span class="wwt-activity-mark" aria-hidden="true"></span>
                    </summary>
                    <p class="wwt-activity-desc">{act.desc}</p>
                  </details>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── By value-chain segment ─────────────────────────────────────────── */}
  <section class="section" aria-labelledby="segments-heading">
    <div class="container">
      <header class="section-header split-header">
        <span class="eyebrow split-header-eyebrow">By Value-Chain Segment</span>
        <div class="split-header-title">
          <h2 id="segments-heading">Where You Sit Changes the Work</h2>
        </div>
        <div class="split-header-lead">
          <p class="section-lead">
            Each segment faces a different version of the same problem: environmental performance
            is created in one place, paid for in another, and claimed in a third. What follows is
            what that looks like from each position, and what Terra Nexus does about it.
          </p>
        </div>
      </header>

      <div class="wwt-entries">
        {segments.map((seg) => (
          <article class="card card-static wwt-entry" id={seg.slug}>
            <div class="wwt-entry-head">
              <span class="numbered-index wwt-index" aria-hidden="true">{indexFor(seg.slug)}</span>
              <h3>{seg.name}</h3>
              <p class="wwt-node">{seg.node}</p>
              {seg.examples.length > 0 && (
                <div class="wwt-examples">
                  <span class="wwt-examples-label">Organizations Like</span>
                  <p class="wwt-examples-list">{seg.examples.join(' · ')}</p>
                  <p class="wwt-examples-note">{EXAMPLES_DISCLAIMER}</p>
                </div>
              )}
              <div class="wwt-links">
                <span class="wwt-link-label">Related Expertise</span>
                <div class="wwt-tags">
                  {seg.expertise.map((e) => (
                    <a href={expertiseLinks[e]} class="tag">{e}</a>
                  ))}
                </div>
              </div>
            </div>
            <div class="wwt-entry-body">
              <div class="wwt-opportunity">
                <span class="wwt-opportunity-label">The Opportunity</span>
                <p>{seg.opportunity}</p>
              </div>

              <h4 class="wwt-sub">How We Work Together</h4>
              <div class="wwt-activities">
                {seg.activities.map((act) => (
                  <details class="wwt-activity">
                    <summary>
                      <span class="wwt-activity-name">{act.name}</span>
                      <span class="wwt-activity-mark" aria-hidden="true"></span>
                    </summary>
                    <p class="wwt-activity-desc">{act.desc}</p>
                  </details>
                ))}
              </div>

              <h4 class="wwt-sub">Decisions We Help Resolve</h4>
              <ul class="wwt-decisions" role="list">
                {seg.decisions.map((d) => <li>{d}</li>)}
              </ul>

            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── Enabling groups ────────────────────────────────────────────────── */}
  <section class="section section-alt" aria-labelledby="enablers-heading">
    <div class="container">
      <header class="section-header split-header">
        <span class="eyebrow split-header-eyebrow">Enabling Markets, Technology &amp; Capital</span>
        <div class="split-header-title">
          <h2 id="enablers-heading">The Infrastructure the Chain Runs On</h2>
        </div>
        <div class="split-header-lead">
          <p class="section-lead">
            These groups do not move physical product. They decide what can be measured, what can
            be claimed, and what gets funded — which makes them the constraint on how fast anything
            else in the chain can move.
          </p>
        </div>
      </header>

      <div class="wwt-entries">
        {enablers.map((en) => (
          <article class="card card-static wwt-entry" id={en.slug}>
            <div class="wwt-entry-head">
              <span class="numbered-index wwt-index" aria-hidden="true">{indexFor(en.slug)}</span>
              <h3>{en.name}</h3>
              <p class="wwt-node">{en.node}</p>
              {en.examples.length > 0 && (
                <div class="wwt-examples">
                  <span class="wwt-examples-label">Organizations Like</span>
                  <p class="wwt-examples-list">{en.examples.join(' · ')}</p>
                  <p class="wwt-examples-note">{EXAMPLES_DISCLAIMER}</p>
                </div>
              )}
            </div>
            <div class="wwt-entry-body">
              <div class="wwt-opportunity">
                <span class="wwt-opportunity-label">The Opportunity</span>
                <p>{en.opportunity}</p>
              </div>

              <h4 class="wwt-sub">How We Work Together</h4>
              <div class="wwt-activities">
                {en.activities.map((act) => (
                  <details class="wwt-activity">
                    <summary>
                      <span class="wwt-activity-name">{act.name}</span>
                      <span class="wwt-activity-mark" aria-hidden="true"></span>
                    </summary>
                    <p class="wwt-activity-desc">{act.desc}</p>
                  </details>
                ))}
              </div>

              <div class="wwt-scope">
                <span class="wwt-scope-label">Scope</span>
                <p>{en.note}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── The principle ──────────────────────────────────────────────────── */}
  <section class="wwt-statement" aria-labelledby="principle-heading">
    <div class="container">
      <h2 id="principle-heading" class="wwt-statement-label">The Principle Behind the Work</h2>
      <p class="wwt-statement-text">
        The objective is not to maximize value for one node by shifting cost or risk to another. It
        is to build a workable path that rewards the participants whose actions make the outcome
        possible.
      </p>
    </div>
  </section>

  <ClosingCta
    heading="Where Do You Sit in the Chain?"
    description="Tell us what you are trying to change, and which participants have to move for it to work."
    primaryCta={{ label: 'Start the Conversation', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Capabilities', href: '/capabilities/' }}
    links={[
      { label: 'Areas of expertise', href: '/expertise/' },
      { label: 'Our approach & capabilities', href: '/capabilities/' },
      { label: 'Digital solutions', href: '/digital-solutions/' },
      { label: 'Case studies', href: '/case-studies/' },
    ]}
  />
</SiteLayout>

<style>
  .diagram-container {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg);
  }
  /* Intrinsic width/height on the <img> reserve the box before the file
     loads. Without them the diagram popped in at 477px tall after an anchor
     jump had already been calculated, landing every deep link ~570px short. */
  .diagram-img { width: 100%; height: auto; display: block; aspect-ratio: 1795 / 744; }

  /* One entry pattern for all fourteen blocks — roles, segments and enablers
     differ in which parts they fill in, not in how they are laid out. Each is a
     .card so it reads as a contained object rather than prose separated by a
     hairline, which after 1,200px of content was not signalling a new section. */
  .wwt-entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .wwt-entry {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-8);
    /* Clears the 70px sticky header when the mega-menu deep-links to an anchor. */
    scroll-margin-top: var(--space-24);
  }

  @media (min-width: 64rem) {
    .wwt-entry {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-10);
    }
    /* Top-aligned with the detail column, not sticky. Sticky with a 6rem
       offset detached the name from the card whenever the card's top was near
       the viewport top, leaving an obvious gap above it (owner review,
       2026-09-13). Alignment beats the small convenience of a following label. */
    .wwt-entry-head { align-self: start; }
  }

  .wwt-index {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
    color: var(--c-sky-500);
    letter-spacing: 0.02em;
  }
  .wwt-entry-head h3 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2);
    text-wrap: balance;
  }
  .wwt-headline {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--c-sky-700);
  }
  .wwt-node {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
  }

  /* Examples are governed content: the disclaimer travels inside the same box
     rather than floating under the section header, where it read as pasted
     compliance text rather than part of the design. */
  .wwt-examples {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .wwt-examples-label,
  .wwt-link-label,
  .wwt-scope-label,
  .wwt-opportunity-label,
  .wwt-sub {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    /* The brand's label colour on a light surface — the on-navy counterpart of
       the homepage's gold. Previously an invented grey. */
    color: var(--color-eyebrow);
  }
  .wwt-examples-list {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
    /* 4.76:1 — not --color-text-muted, which fails AA at 2.56:1. */
    color: var(--c-secondary-500);
  }
  .wwt-examples-note {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    line-height: var(--line-normal);
    color: var(--c-secondary-500);
  }

  /* The homepage puts this same paragraph in a gold-tinted inset card with a
     gold label. On a light surface the equivalent is the cream accent step with
     a maroon label — same idea, same hierarchy, legible ground. */
  .wwt-opportunity {
    margin: 0 0 var(--space-8);
    padding: var(--space-5);
    background: var(--c-accent-50);
    border: 1px solid var(--c-accent-200);
    border-radius: var(--radius-lg);
  }
  .wwt-opportunity p {
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    line-height: var(--line-relaxed);
    color: var(--color-text);
  }

  .wwt-sub { margin: 0 0 var(--space-4); }
  .wwt-sub:not(:first-of-type) { margin-top: var(--space-8); }

  .wwt-categories { display: grid; gap: var(--space-3); }
  @media (min-width: 48rem) {
    .wwt-categories { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .wwt-category {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .wwt-category-title {
    margin: 0 0 var(--space-1);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
  }
  .wwt-category-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
  }

  /* Same <details> accordion the homepage uses for these exact rows. The names
     are the scannable layer; the descriptions stay in the DOM for crawlers and
     for anyone who wants them. Collapsing 69 rows roughly halves the page. */
  .wwt-activities { display: grid; gap: var(--space-2); }
  .wwt-activity {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .wwt-activity summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    list-style: none;
    cursor: pointer;
  }
  .wwt-activity summary::-webkit-details-marker { display: none; }
  .wwt-activity summary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .wwt-activity:hover { border-color: var(--c-sky-400); }
  .wwt-activity-name {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }
  /* A CSS-drawn plus that becomes a minus when open — no icon dependency. */
  .wwt-activity-mark {
    position: relative;
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    color: var(--c-sky-600);
  }
  .wwt-activity-mark::before,
  .wwt-activity-mark::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }
  .wwt-activity-mark::before { inset: 45% 0 45% 0; }
  .wwt-activity-mark::after { inset: 0 45% 0 45%; }
  .wwt-activity[open] .wwt-activity-mark::after { transform: scaleY(0); opacity: 0; }
  .wwt-activity-desc {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
  }

  .wwt-decisions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .wwt-decisions li {
    position: relative;
    padding-inline-start: var(--space-5);
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
  }
  .wwt-decisions li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.6em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-full);
    background: var(--c-sky-600);
  }

  /* A stated scope limit, presented as part of the block rather than as a
     trailing italic afterthought. */
  .wwt-scope {
    margin-top: var(--space-8);
    padding: var(--space-4);
    background: var(--color-surface);
    border-inline-start: 3px solid var(--c-secondary-300);
    border-radius: var(--radius-sm);
  }
  .wwt-scope p {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-relaxed);
  }

  .wwt-links {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .wwt-link-label { margin-bottom: var(--space-3); }
  .wwt-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .wwt-tags a { text-decoration: none; }
  .wwt-tags a:hover { border-color: var(--c-sky-600); color: var(--c-sky-700); }
  .wwt-tags a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  /* The page's one dark moment, immediately before the light-blue CTA band —
     the sharpest line on the page was previously a lone paragraph in a white
     section and read as unfinished. */
  .wwt-statement {
    background: var(--gradient-dark);
    padding-block: var(--space-20);
  }
  .wwt-statement-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-accent-400);
    margin: 0 0 var(--space-5);
  }
  .wwt-statement-text {
    margin: 0;
    max-width: 52rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, var(--text-3xl));
    line-height: var(--line-snug);
    color: #fff;
    text-wrap: pretty;
  }
</style>
