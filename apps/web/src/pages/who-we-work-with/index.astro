---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
const mode = getBuildMode();

const valueChainSegments = [
  'Inputs Companies',
  'Agricultural Producers & Integrated Protein Companies',
  'Commodity Traders',
  'Ingredient & Feed Processors',
  'Food & Beverage Companies',
  'Food Retail & Distribution',
  'Energy & Biofuels Refiners',
  'Food Waste Prevention, Diversion & Recovery',
];

const enablerSegments = [
  'Environmental Markets & Ecosystem Services',
  'Enabling Tech & Solution Providers',
  'Private Equity, Venture Capital & Impact Investors',
];
---

<SiteLayout
  title="Who We Work With | Terra Nexus"
  description="Terra Nexus works across the food and agribusiness value chain and with the markets, technology providers, assurance organizations, and capital partners that enable it."
  preview={mode === 'preview'}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Who We Work With</span>
      <h1>Shared Value Requires the Whole System</h1>
      <p class="hero-lead">Terra Nexus works across the food and agribusiness value chain and with the markets, technology providers, assurance organizations, and capital partners that enable it.</p>
      <p class="hero-lead">A client may hire Terra Nexus at one node. Terra Nexus still evaluates the actions, evidence, economics, incentives, and collaboration required across every participant needed to make the solution work.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Value-Chain Challenge</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>The Food &amp; Agribusiness Value Chain</h2>
      </header>

      <div class="diagram-container" role="figure" aria-label="Food and agribusiness value chain diagram showing eight value-chain segments and three enabling groups.">
        <img
          src="/diagrams/value-chain-with-associated-enablers.png"
          alt="Food and agribusiness value chain with associated enablers. Value-chain segments: Inputs, Agricultural Production, Commodity Trading, Ingredient and Feed Processing, Food and Beverage, Food Retail and Distribution, Energy and Biofuels, and Food Waste Prevention Diversion and Recovery. Enabling groups: Environmental Markets and Ecosystem Services, Enabling Tech and Solution Providers, and Private Equity Venture Capital and Impact Investors."
          loading="lazy"
          class="diagram-img"
        />
      </div>

      <details class="text-alt">
        <summary>Text description of the value chain</summary>
        <div class="text-alt-content">
          <h3>Food &amp; Agribusiness Value Chain Segments</h3>
          <ul>
            {valueChainSegments.map((seg) => <li>{seg}</li>)}
          </ul>
          <h3>Enabling Markets, Technology &amp; Capital</h3>
          <ul>
            {enablerSegments.map((seg) => <li>{seg}</li>)}
          </ul>
          <p>The value chain is not always a single strictly linear flow. Energy &amp; Biofuels and Food Waste Prevention, Diversion &amp; Recovery are value-chain segments that may connect to multiple nodes.</p>
        </div>
      </details>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Explore by Group</h2>
      </header>

      <div class="card-grid">
        <a href="/who-we-work-with/food-and-agribusiness-value-chain/" class="card-link">
          <article class="card">
            <h3>Food &amp; Agribusiness Value Chain</h3>
            <p>Organizations that produce, move, transform, sell, distribute, and recover food and agricultural materials.</p>
          </article>
        </a>
        <a href="/who-we-work-with/enabling-markets-technology-and-capital/" class="card-link">
          <article class="card">
            <h3>Enabling Markets, Technology &amp; Capital</h3>
            <p>Organizations that provide environmental markets, data, technology, assurance, partnerships, and investment.</p>
          </article>
        </a>
      </div>

      <div class="section-cta">
        <a href="/contact/" class="btn btn-primary">Discuss Your Value-Chain Challenge</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .diagram-container { border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; background: var(--color-bg); }
  .diagram-img { width: 100%; height: auto; }
  .text-alt { margin-top: var(--space-6); padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .text-alt summary { font-weight: 600; font-size: var(--text-sm); cursor: pointer; color: var(--color-text-secondary); }
  .text-alt summary:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .text-alt-content { margin-top: var(--space-4); }
  .text-alt-content h3 { font-size: var(--text-base); margin-bottom: var(--space-2); margin-top: var(--space-4); }
  .text-alt-content h3:first-child { margin-top: 0; }
  .text-alt-content ul { padding-left: var(--space-5); color: var(--color-text-secondary); font-size: var(--text-sm); }
  .text-alt-content li { margin-bottom: var(--space-1); }
  .text-alt-content p { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }
  .section-cta { margin-top: var(--space-8); display: flex; justify-content: center; }
</style>
