  .tile-content { position: relative; z-index: 2; padding: 1.5rem; width: 100%; }
  .tile-title { color: #fff; font-size: 1.125rem; font-weight: 600; line-height: 1.3; margin: 0 0 0.5rem; text-shadow: 0 1px 6px rgba(15, 23, 42, 0.5); }
  .tile-desc {
