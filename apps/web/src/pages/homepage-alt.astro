<script>
  // Who We Work With — segment slider tabs (mirrors the nav-toggle pattern in Header.astro)
  (function () {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.segment-tab'));
    const slides = Array.from(document.querySelectorAll<HTMLDivElement>('.segment-slide'));
    const panel = document.querySelector('.segment-slider-panel');
    if (!tabs.length || !slides.length) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function activate(index: number) {
      current = index;
      tabs.forEach((tab, idx) => {
        const active = idx === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      slides.forEach((slide, idx) => slide.classList.toggle('is-active', idx === index));
    }
    function advance() { activate((current + 1) % tabs.length); }
    function resetAuto() {
      if (timer) clearInterval(timer);
      if (!reduceMotion) timer = setInterval(advance, 6000);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { activate(i); resetAuto(); });
    });
    if (panel) {
      panel.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
      panel.addEventListener('mouseleave', resetAuto);
    }
    resetAuto();
  })();
</script>

<script>
  // How We Work — approach rail tabs. Step→capability relationships come from
  // each button's data-caps attribute (set server-side from approachSteps in
  // the frontmatter above), so this script has no content of its own to keep
  // in sync — it just reads the DOM.
  (function () {
    const stops = Array.from(document.querySelectorAll<HTMLButtonElement>('.approach-stop'));
    const capCards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.approach-cap'));
    const descElMaybe = document.getElementById('approach-desc');
    const gridElMaybe = document.getElementById('approach-cap-grid');
    const panelEl = document.getElementById('approach-panel');
    if (!stops.length || !descElMaybe || !gridElMaybe) return;
    const descEl = descElMaybe;
    const gridEl = gridElMaybe;

    function activate(index: number) {
      stops.forEach((stop, idx) => {
        const active = idx === index;
        stop.classList.toggle('is-active', active);
        stop.setAttribute('aria-selected', String(active));
      });
      const step = stops[index];
      const title = step.dataset.title ?? '';
      const desc = step.dataset.desc ?? '';
      panelEl?.setAttribute('aria-labelledby', `approach-tab-${index}`);
      descEl.innerHTML = `<strong>${title}</strong> — ${desc}`;

      const caps = (step.dataset.caps ?? '').split(',').filter(Boolean);
      if (step.dataset.loop === 'true') {
        gridEl.classList.remove('is-filtering');
        capCards.forEach((card) => card.classList.remove('is-linked'));
        gridEl.classList.remove('is-loop');
        void gridEl.offsetWidth; // force reflow so the sweep animation replays every time
        gridEl.classList.add('is-loop');
      } else {
        gridEl.classList.remove('is-loop');
        gridEl.classList.add('is-filtering');
        capCards.forEach((card) => card.classList.toggle('is-linked', caps.includes(card.dataset.cap ?? '')));
      }
    }
    stops.forEach((stop, i) => {
      stop.addEventListener('click', () => activate(i));
      stop.addEventListener('mouseenter', () => activate(i));
    });
  })();
</script>

