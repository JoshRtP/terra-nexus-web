  // the header's normal solid navy once you scroll past the hero, and (2) a
  // small star mark drifts and grows across the hero as you scroll, echoing
  // the live site's Elementor "scroll effects" on its star graphic.
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Transparent-over-photo header. Scoped to this page via a body class
    // (see the is:global style below) so /index.astro and every other page
    // keep the header's normal always-solid look. The header is normally
    // `position: sticky`, which still reserves its own row above the hero —
    // switching it to `fixed` here (see the global style) removes it from
    // flow so the hero photo can run full-bleed underneath it, then this
    // pulls the hero up by the header's measured height to close the gap.
    document.body.classList.add('has-photo-hero');
    const header = document.getElementById('site-header');
    const heroSection = document.querySelector<HTMLElement>('.photo-hero');
    function syncHeaderHeight() {
      if (header && heroSection) {
        heroSection.style.marginTop = `-${header.offsetHeight}px`;
      }
    }
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);

    // Header.astro's own script flips #site-header to data-scrolled="true"
    // after just 20px of scroll — fine for its normal always-solid look,
    // but far too early here: it was solidifying the header while the
    // canyon photo (and the star/logo scroll effects on it) were still the
    // whole screen. This page needs its own, later threshold instead: stay
    // transparent for the entire hero and only solidify once the user has
    // scrolled past .photo-hero-band (the "Developing a more resilient…"
    // bar, now pinned to the very bottom of the hero — see its CSS) so the
    // solid header reads as picking up right where that bar left off. Adds
    // body.past-hero, which the is:global style below keys off instead of
    // the shared data-scrolled attribute.
    const heroBand = document.querySelector<HTMLElement>('.photo-hero-band');
    function syncPastHero() {
      if (!heroBand) return;
      const bandBottom = heroBand.getBoundingClientRect().bottom + window.scrollY;
      const solidifyAt = bandBottom - (header ? header.offsetHeight : 0);
      document.body.classList.toggle('past-hero', window.scrollY >= solidifyAt);
    }

    // 2 & 3. Star and wordmark — both read directly off screenshots of the
    // live site's own Motion Effects panels:
    //
    //   Star vertical    — Direction: Up,      Speed: 6,  Viewport: 35%–70%
    //   Star horizontal  — Direction: To Left, Speed: 50, Viewport: 35%–80%
    //   Star scale       — Speed: 20, Viewport: 60%–100% ("out-in")
    //
    //   Logo vertical    — Direction: Down, Speed: 5, Viewport: 55%–80%
    //   Logo transparency— Fade Out, Level: 8, Viewport: 61%–100%
    //   Logo blur        — Fade Out, Level: 5, Viewport: 67%–100%
    //   Logo scale       — Speed: 3, Viewport: 53%–70%
    //
    // All of Elementor's "Viewport" ranges are percentages of the
    // element's own transit through the viewport (0% = entering at the
    // bottom edge, 100% = reached the top edge). The star is `position:
    // fixed` and moved entirely by this script, so it has no "real"
    // geometry of its own to measure — it uses `progress` (0–1.3 across
    // this hero) as a stand-in timeline instead, which keeps every range's
    // relative order and spacing intact while guaranteeing it starts at
    // rest. The wordmark is a normal in-flow element that really does
    // travel through the viewport as the page scrolls, so it uses its own
    // measured position (see wordmarkViewportPct below) rather than the
    // same proxy — using the hero-height proxy for it too, as an earlier
    // version of this did, meant its 53–100% window didn't finish
    // ramping until the user had scrolled nearly the entire (very tall)
    // hero, by which point the wordmark had already scrolled off-screen —
    // technically running, but never actually visible happening.
    const star = document.querySelector<HTMLElement>('.photo-hero-star');
    const wordmark = document.querySelector<HTMLElement>('.photo-hero-wordmark');
    const hero = document.querySelector<HTMLElement>('.photo-hero');
    if (!star || !hero) return;

    const rampBetween = (value: number, start: number, end: number) =>
      Math.min(Math.max((value - start) / (end - start), 0), 1);

    // The wordmark's ramps need real geometry, not the hero-height proxy
    // used for the star below: driving them off `progress` (scroll ÷ full
    // hero height) meant the effect's 53–100% window didn't finish until
    // the user had scrolled nearly the whole hero — by which point the
    // wordmark itself (an ordinary in-flow element, not fixed) had almost
    // always already scrolled off-screen, so the fade/blur/scale was
    // technically running but never actually visible. Tracking its own
    // on-screen travel instead ties the ramp to when it's still visible.
    // `wordmarkBasePct` is captured once, from its resting position on
    // load, so the ramp is guaranteed to start at exactly 0 (full
    // strength) and then fills the 55–100% range over what's left of its
    // real trip to the top of the viewport — rather than either measuring
    // raw position (which starts pre-faded, since it rests mid-viewport,
    // not at the bottom edge) or using the hero-height proxy (which
    // starts safely but runs too slowly to ever be seen).
    let wordmarkBasePct: number | null = null;
    function wordmarkViewportPct(): number {
      if (!wordmark) return 0;
      const rect = wordmark.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const raw = ((vh - rect.top) / vh) * 100;
      if (wordmarkBasePct === null) wordmarkBasePct = raw;
      return rampBetween(raw, wordmarkBasePct, 100) * 100;
    }

    function update() {
      if (!hero) return;
      const heroHeight = hero.offsetHeight || 1;
      const viewportWidth = window.innerWidth;
      const progress = Math.min(Math.max(window.scrollY / heroHeight, 0), 1.3);
      const timeline = progress * 100; // stand-in for Elementor's 0–100% "Viewport" scale

      if (!reduceMotion) {
        // Straight shot from bottom-right to top-left — one shooting star,
        // not three independently-timed motions. The previous version gave
        // rise (0–60%), sweep (15–85%), and scale (40–90%) each their own
        // window; mathematically every one of them was still monotonic,
        // but because they finished at different points, the *path* bent —
        // vertical motion would lock in place while horizontal motion kept
        // going, which reads as an arc even though nothing was ever
        // reversing. A single ramp driving all three in lockstep keeps
        // them moving together the whole time, so the path is one straight
        // diagonal line. `eased` applies smoothstep (ease-in, ease-out) to
        // that ramp for a natural shooting-star deceleration instead of a
        // constant-speed, robotic one.
        //
        // transform-origin is set to bottom-right in this element's CSS,
        // matching the X:Right / Y:Bottom anchor point from the reference
        // settings — scale grows away from that corner rather than from
        // its own center, so it reads as trailing off from where it
        // started rather than swelling in place.
        const travel = rampBetween(timeline, 10, 85);
        const eased = travel * travel * (3 - 2 * travel); // smoothstep
        const fadeInRamp = rampBetween(timeline, 0, 6);
        const fadeOutRamp = rampBetween(timeline, 88, 98);
        const ty = -eased * (window.innerHeight * 0.85);
        const tx = -eased * (viewportWidth * 0.55);
        const scale = 1 + eased * 1.1;
        const starOpacity = Math.min(fadeInRamp, 1 - fadeOutRamp);
        star!.style.setProperty('--star-tx', `${tx.toFixed(1)}px`);
        star!.style.setProperty('--star-ty', `${ty.toFixed(1)}px`);
        star!.style.setProperty('--star-scale', scale.toFixed(3));
        star!.style.setProperty('--star-opacity', starOpacity.toFixed(3));
      }

      if (wordmark) {
        const wmPct = wordmarkViewportPct();
        const verticalRamp = rampBetween(wmPct, 55, 80); // Speed 5, Down
        const opacityRamp = rampBetween(wmPct, 61, 100); // Level 8, Fade Out
        const blurRamp = rampBetween(wmPct, 67, 100); // Level 5, Fade Out
        const scaleRamp = rampBetween(wmPct, 53, 70); // Speed 3

        const logoLift = verticalRamp * (5 * 8);
        const logoOpacity = 1 - opacityRamp;
        const logoBlur = blurRamp * 5;
        const logoScale = 1 + scaleRamp * 0.45;

        wordmark.style.setProperty('--logo-opacity', logoOpacity.toFixed(3));
        wordmark.style.setProperty('--logo-blur', `${logoBlur.toFixed(2)}px`);
        wordmark.style.setProperty('--logo-ty', `${logoLift.toFixed(1)}px`);
        wordmark.style.setProperty('--logo-scale', logoScale.toFixed(3));
      }

      syncPastHero();
    }
    // A continuous rAF loop rather than only recalculating from 'scroll'
    // events — under a fast flick or trackpad fling, scroll events can
    // fire in an uneven burst, and event-driven updates (even throttled
    // to one per frame) can end up applying several scroll-position's
    // worth of change in a single jump instead of gliding through the
    // positions in between. Reading window.scrollY fresh every animation
    // frame regardless of event timing keeps the star's motion tied to
    // actual elapsed frames rather than to however the browser happens to
    // batch scroll events, which is what "gliding" actually requires.
    function loop() {
      update();
      window.requestAnimationFrame(loop);
    }
    window.addEventListener('resize', syncPastHero);
    window.requestAnimationFrame(loop);
  })();
</script>

<style is:global>
  /* Transparent-over-photo header — scoped to this page only via
     body.has-photo-hero (set in the script above). Header.astro's own
     data-scrolled attribute flips after just 20px of scroll, which is
     right for its normal always-solid look elsewhere on the site but far
     too early here — this keys off body.past-hero instead (also set in
     the script above, once the user has scrolled past .photo-hero-band),
     so the header stays transparent for the entire photo hero. Header.astro
     itself is untouched, so every other page keeps its default behavior. */
  body.has-photo-hero .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }
  body.has-photo-hero.past-hero .site-header {
    background: var(--color-dark);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-md);
  }
  /* The shared wordmark is a thin outline mark tuned for the header's normal
     solid-navy background — over the busy photo it needs more contrast. */
  body.has-photo-hero .site-header .wordmark-logo {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 6px rgba(0, 0, 0, 0.5));
  }
  /* The hero already carries its own giant "TERRA NEXUS" wordmark front
     and center — showing the header's small copy too, on top of the same
     photo, would be a redundant second logo on screen at once. Hidden
     while transparent, then revealed at exactly the same moment the header
     itself solidifies (body.past-hero), so the logo "arrives" together
     with the bar it's sitting on rather than as a separate beat. */
  body.has-photo-hero .site-header .wordmark-logo {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  body.has-photo-hero.past-hero .site-header .wordmark-logo {
    opacity: 1;
  }
</style>

<style>
  /* ── Photo Hero ───────────────────────────────────── */
  .photo-hero {
    position: relative;
    overflow: hidden;
    min-height: 44rem;
    height: 86vh;
    display: flex;
    flex-direction: column;
    /* No justify-content: center here — .photo-hero-content below takes
       flex: 1 and centers itself within it, which leaves .photo-hero-band
       (the "Developing a more resilient…" bar) as a normal sibling that
       lands at the very bottom of the hero instead of directly under the
       tagline. That's deliberate: it puts the band right where the header
       switches from transparent to solid (see the script + is:global style
       below), so the transparent-over-photo menu holds for the entire
       canyon photo and only turns solid navy once the user scrolls past
       the band — reading as the band handing off into the header rather
       than the two being unrelated elements. */
  }
  @media (max-width: 48rem) {
    .photo-hero { height: auto; min-height: 38rem; }
  }
  .photo-hero-bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 46%;
  }
  .photo-hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(19, 31, 72, 0.55) 0%, rgba(19, 31, 72, 0.35) 45%, rgba(19, 31, 72, 0.85) 100%);
  }
  .photo-hero-content {
    /* Deliberately no z-index here (position: relative alone doesn't open a
       new stacking context). The tagline's mix-blend-mode below needs to
       blend against .photo-hero-bg/.photo-hero-scrim behind it — an
       explicit z-index would wall this off into its own isolated paint
       layer and the blend would only ever see black, not the photo. Paint
       order still puts this above the photo because it comes later in the
       DOM; .photo-hero-star stays on top because it carries its own
       positive z-index. */
    position: relative;
    flex: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding-block: var(--space-20) var(--space-10);
  }
  .photo-hero-wordmark {
    width: min(27.5rem, 77vw); height: auto; margin-bottom: var(--space-8);
    --logo-opacity: 1; --logo-blur: 0px; --logo-ty: 0px; --logo-scale: 1;
    opacity: var(--logo-opacity);
    transform: translateY(var(--logo-ty)) scale(var(--logo-scale));
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.45)) blur(var(--logo-blur));
    transition: opacity 100ms linear, transform 100ms linear, filter 100ms linear;
    will-change: opacity, transform, filter;
  }
  /* Star that drifts up-and-left, grows, and fades across the hero on
     scroll — mirrors the live site's Elementor scroll-effect on its star
     graphic. `position: fixed` (not absolute) is the fix that makes this
     visible at all: an absolutely-positioned element inside the hero still
     scrolls with the page, so it was leaving the viewport from ordinary
     scrolling alone before the scroll-linked transform below ever got a
     chance to show. Fixed to the viewport, its percentage top/left resolve
     against the viewport too. Rests low and to the right, past the bottom
     edge of the screen — matching the live site, where the star starts
     hidden below the fold and off toward the right margin rather than
     sitting up by the logo — then only comes into view once the
     Up/To Left scroll effects below start carrying it up and across.
     --star-* custom properties are written from the script on every
     scroll frame. */
  .photo-hero-star {
    /* z-index: 20, not 2 — this is `position: fixed`, so as the user
       scrolls it can end up visually overlapping any later section on the
       page, and several (.engagement-panel among them) set z-index: 3.
       At z-index: 2 the star was losing that stacking fight and briefly
       vanishing behind them before its own fade-out ever kicked in, which
       read as flickering/erratic on top of the motion itself. Still below
       the header's z-index: 50, so it correctly tucks behind the nav bar
       once scrolled near the top. */
    position: fixed; z-index: 20;
    top: 102%; left: 90%;
    width: 2.75rem; height: auto;
    /* Matches the reference settings' X:Right / Y:Bottom anchor point —
       scale grows away from this corner instead of from the star's own
       center, so it reads as trailing off from where it started. */
    transform-origin: bottom right;
    --star-tx: 0px; --star-ty: 0px; --star-scale: 1; --star-opacity: 0;
    transform: translate(var(--star-tx), var(--star-ty)) scale(var(--star-scale));
    opacity: var(--star-opacity);
    transition: transform 100ms linear, opacity 100ms linear;
    will-change: transform, opacity;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-hero-star { display: none; }
  }
  .photo-hero-tagline {
    /* Matches the live site's heading treatment exactly: color-dodge blend
       mode against a dark-orange base color (computed from terra.nexus:
       rgb(204, 65, 0)) rather than a flat fill — the blend mode lets the
       photo underneath "burn through" the letterforms, so the text's
       apparent color and brightness shift with the sky/rock behind it
       instead of sitting as a flat overlay. */
    color: #cc4100;
    mix-blend-mode: color-dodge;
    font-size: clamp(1.8rem, 4.8vw, calc(var(--text-4xl) * 1.2));
    font-weight: var(--font-medium);
    letter-spacing: 0.04em; text-transform: uppercase; max-width: 34ch;
    /* Extra breathing room below the wordmark, on top of the wordmark's own
       margin-bottom — pushes the tagline further down toward the bend of
       the canyon per creative direction, without touching .photo-hero's
       height/min-height or .photo-hero-content's padding-block, which are
       what keep the engagement panel in view on load. Because
       .photo-hero-content centers this stack via justify-content: center
       inside a fixed-height flex:1 area (not one sized by its own
       content), growing the gap here only redistributes space within that
       stack — it doesn't change .photo-hero-band's position below it. */
    margin-top: var(--space-24);
  }
  .photo-hero-tagline span { color: #cc4100; }
  .photo-hero-band {
    position: relative; z-index: 1; margin: 0;
    background: rgba(19, 31, 72, 0.92);
    color: #d7deef; text-align: center;
    font-size: var(--text-sm); font-weight: var(--font-medium);
    letter-spacing: 0.04em; text-transform: uppercase;
    padding-inline: var(--space-4);
    /* Extra bottom padding — this bar now sits at the very bottom edge of
       the hero (see .photo-hero's comment above), and .engagement-panel
       overlaps upward by 2rem to form its rounded shelf. That overlap used
       to land on plain photo; now it would cut directly into this bar's
       own text unless it has 2rem of its own background to spare below
       the label first. */
    padding-block: var(--space-4) calc(var(--space-4) + 2rem);
  }

  /* ── Engagement panel ─────────────────────────────────
     Floats up over the hero's bottom band as a rounded, shadowed shelf —
     borrowed from how doktar.com and cultivo.land land a card over their
     photo hero instead of butting a flat-edged section straight up
     against it. Kept modest (2rem of overlap) so the band's own text
     stays legible. */
  .engagement-panel {
    position: relative; z-index: 3;
    background: linear-gradient(135deg, var(--c-sky-200) 0%, var(--c-sky-300) 100%);
    padding-block: var(--space-12);
    margin-top: -2rem;
    border-radius: 28px 28px 0 0;
    box-shadow: 0 -16px 40px rgba(15, 23, 42, 0.18);
