  .engagement-inner {
    display: grid; gap: var(--space-8);
    grid-template-columns: 1.4fr auto;
    align-items: center;
  }
  .engagement-inner h2 { font-size: var(--text-2xl); color: var(--color-dark); margin-bottom: var(--space-3); max-width: 34ch; }
  .engagement-inner p { color: var(--c-sky-700); max-width: var(--max-width-text); line-height: var(--line-relaxed); }
  .engagement-inner .hero-actions { display: flex; flex-direction: column; gap: var(--space-3); }
  @media (max-width: 56rem) {
    .engagement-inner { grid-template-columns: 1fr; }
    .engagement-inner .hero-actions { flex-direction: row; flex-wrap: wrap; }
  }
  .btn-lg { padding: var(--space-4) var(--space-8); font-size: var(--text-lg); }

  /* ── Expertise grid (shared with current homepage) ── */
  .expertise-grid {
    display: grid; list-style: none; padding: 0; margin: 0;
    gap: 1.5rem; grid-template-columns: repeat(1, 1fr);
  }
  @media (min-width: 640px) { .expertise-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .expertise-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }

  .expertise-tile {
    display: flex; align-items: flex-end; position: relative;
    aspect-ratio: 4 / 3; border-radius: 20px; overflow: hidden;
    text-decoration: none; color: #fff; background-color: #131f48;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.15);
    transition: box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1), transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .expertise-tile:hover { box-shadow: 0 20px 40px -8px rgba(15, 23, 42, 0.35); transform: translateY(-4px); }
  .expertise-tile:focus-visible { outline: 3px solid #427e90; outline-offset: 3px; }
  .tile-bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center;
    z-index: 0; transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
