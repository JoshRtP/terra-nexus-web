---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';
const mode = getBuildMode();

const offerings = [
  {
    id: 'fin-fpa',
    name: 'Financial Planning & Analysis',
    definition: 'Translate market, operating, environmental, and program assumptions into budgets, forecasts, profitability, margin, cash needs, and scenarios.',
    activities: [],
  },
  {
    id: 'fin-business-case',
    name: 'Business Case & Initiative Prioritization',
    definition: 'Compare initiatives using strategic fit, value, impact, risk, feasibility, timing, and capital requirements.',
    activities: [
      'ROI analysis',
      'Project and deal structuring',
      'Prioritization',
      'Portfolio models',
    ],
  },
  {
    id: 'fin-corporate-ventures',
    name: 'Corporate Ventures',
    definition: 'Design corporate venture activity around strategic markets, technologies, and partnerships.',
    activities: [
      'Focus areas',
      'Ecosystem mapping',
      'CVC strategy',
      'Investment thesis',
      'Fund design',
      'Portfolio governance',
    ],
  },
  {
    id: 'fin-diligence',
    name: 'Investor Due Diligence',
    definition: 'Evaluate companies, technologies, projects, programs, assets, and environmental claims across financial, commercial, technical, strategic, operational, and sustainability dimensions. Terra Nexus evaluates biological systems, fragmented supply chains, commodity markets, policy, environmental claims, technology adoption, and participant incentives together rather than treating impact as a separate diligence stream.',
    activities: [],
  },
];
---

<SiteLayout
  title="Financial Investments & New Venture Development | Terra Nexus"
  description="Terra Nexus connects strategic opportunity with economics, capital allocation, venture development, transaction diligence, and the operating realities of food, agriculture, climate, nature, and circularity."
  preview={mode === 'preview'}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Capabilities</span>
      <h1>Put Capital Behind the Food-and-Climate Opportunities That Can Deliver</h1>
      <p class="hero-lead">Terra Nexus connects strategic opportunity with economics, capital allocation, venture development, transaction diligence, and the operating realities of food, agriculture, climate, nature, and circularity.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Investment</a>
        <a href="/expertise/" class="btn btn-secondary">Explore Our Expertise</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>Who This Capability Supports</h2>
      </header>
      <ul class="audience-list">
        <li>Finance</li>
        <li>Corporate development</li>
        <li>Corporate venture</li>
        <li>Strategy</li>
        <li>Investment committees</li>
        <li>Private equity, venture, impact, infrastructure, and institutional investors</li>
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Decisions We Help Resolve</h2>
      </header>
      <ul class="decisions-list">
        <li>Which ideas, ventures, investments, assets, partnerships, or facilities should be screened, funded, incubated, acquired, or scaled?</li>
        <li>How should biological systems, fragmented supply chains, commodity markets, policy, environmental claims, technology adoption, and participant incentives be evaluated together?</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>How We Help</h2>
        <p class="section-lead">Financial Investments &amp; New Venture Development is organized around four offering modules that can be combined to match the decision at hand.</p>
      </header>
      <div class="accordion">
        {offerings.map((o) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false" aria-controls={`acc-${o.id}`}>{o.name}</button>
            <div class="accordion-content" id={`acc-${o.id}`} hidden>
              <p>{o.definition}</p>
              {o.activities.length > 0 && (
                <ul>
                  {o.activities.map((a) => <li>{a}</li>)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Related Expertise</h2>
      </header>
      <p>All nine Areas of Expertise connect to Financial Investments &amp; New Venture Development.</p>
      <div class="tag-row">
        <a href="/expertise/regenerative-agriculture/" class="segment-tag">Regenerative Agriculture</a>
        <a href="/expertise/regenerative-rangeland/" class="segment-tag">Regenerative Rangeland</a>
        <a href="/expertise/agroforestry/" class="segment-tag">Agroforestry</a>
        <a href="/expertise/aquaculture/" class="segment-tag">Aquaculture</a>
        <a href="/expertise/biodiversity-and-ecosystem-resilience/" class="segment-tag">Biodiversity &amp; Ecosystem Resilience</a>
        <a href="/expertise/low-carbon-energy-and-biofuels/" class="segment-tag">Low Carbon Energy &amp; Biofuels</a>
        <a href="/expertise/sustainable-supply-chains/" class="segment-tag">Sustainable Supply Chains</a>
        <a href="/expertise/food-waste-prevention-diversion-recovery/" class="segment-tag">Food Waste Prevention, Diversion &amp; Recovery</a>
        <a href="/expertise/purpose-driven-food-brands-and-retailers/" class="segment-tag">Purpose-Driven Food Brands &amp; Retailers</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>How We Engage</h2>
        <p class="section-lead">Terra Nexus engages with clients through two complementary models.</p>
      </header>
      <div class="card-grid">
        <article class="card">
          <h3>Advise</h3>
          <p>Terra Nexus evaluates opportunities, performs diligence, models economics, selects frameworks and partners, and designs programs, systems, controls, and commercial structures.</p>
        </article>
        <article class="card">
          <h3>Manage</h3>
          <p>Terra Nexus embeds within client-owned programs to coordinate recurring work, data, partners, reporting, and continuous improvement.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container text-center">
      <h2>Discuss an Investment, Venture, or Business Case</h2>
      <p class="cta-description">Tell us what you are evaluating, funding, or scaling.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Investment</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      const contentId = trigger.getAttribute('aria-controls');
      const content = contentId ? document.getElementById(contentId) : null;
      if (content) content.hidden = expanded;
    });
  });
</script>

<style>
  .audience-list, .decisions-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .audience-list li, .decisions-list li { color: var(--color-text-secondary); font-size: var(--text-base); }
  .decisions-list li { padding-left: var(--space-5); position: relative; }
  .decisions-list li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-accent); }
  .tag-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .segment-tag { display: inline-block; padding: var(--space-1) var(--space-3); border: 1px solid var(--color-border); border-radius: 999px; font-size: var(--text-sm); color: var(--color-text-secondary); text-decoration: none; }
  .segment-tag:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .text-center { text-align: center; }
  .text-center .hero-actions { justify-content: center; }
  .cta-description { color: #a3adb8; max-width: var(--max-width-text); margin: var(--space-4) auto var(--space-8); }
  .section-dark .btn-primary { background: #fff; color: #1a1f24; border-color: #fff; }
  .section-dark .btn-primary:hover { background: #e2e5e9; border-color: #e2e5e9; }
</style>
