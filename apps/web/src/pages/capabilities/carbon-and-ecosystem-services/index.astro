---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';

const mode = getBuildMode();

const offerings = [
  {
    id: 'vcm-scope3',
    title: 'VCM & Scope 3 Markets',
    description: 'Evaluate how organizations can access, buy, sell, develop, use, or participate in voluntary carbon, Scope 3, inset, and related markets.',
  },
  {
    id: 'commercialization',
    title: 'Commercialization Pathways',
    description: 'Compare product claims, insets, credits, certifications, regulatory pathways, customer programs, and other market mechanisms.',
  },
  {
    id: 'asset-valuation',
    title: 'Asset & Portfolio Valuation',
    description: 'Assess the quality, risk, value, strategic fit, and portfolio role of environmental assets, projects, programs, and claims.',
  },
  {
    id: 'pilot-development',
    title: 'Pilot Development & Partner Selection',
    description: 'Design pilots that test critical technical, operational, commercial, and market assumptions before scale.',
  },
  {
    id: 'program-design',
    title: 'Program Design & Operations',
    description: 'Build and manage program governance, workflows, data, contracts, controls, ledgers, chain of custody, partners, exceptions, and reporting.',
  },
  {
    id: 'impact-verification',
    title: 'Impact Verification & Claims Translation',
    description: 'Prepare evidence and programs for independent scrutiny and translate supportable outcomes into claims.',
    note: 'Terra Nexus does not represent itself as an accredited validator or verifier.',
  },
  {
    id: 'ghg-accounting',
    title: 'Full-Service GHG Accounting',
    description: 'Connect inventory, product, project, program, and disclosure accounting so performance is calculated, allocated, reported, and claimed consistently.',
  },
];
---

<SiteLayout
  title="Carbon & Ecosystem Services — Capabilities — Terra Nexus"
  description="Terra Nexus helps environmental-market, carbon, program, trade, finance, and sustainability leaders create, access, value, verify, account for, manage, and commercialize carbon and ecosystem-service outcomes."
  preview={mode === 'preview'}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/capabilities/">Capabilities</a></li>
        <li aria-current="page">Carbon & Ecosystem Services</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">CARBON & ECOSYSTEM SERVICES</span>
      <h1>Turn Environmental Performance into Credible Assets, Claims, and Value</h1>
      <p class="hero-lead">Terra Nexus helps environmental-market, carbon, program, trade, finance, and sustainability leaders create, access, value, verify, account for, manage, and commercialize carbon and ecosystem-service outcomes.</p>
    </div>
  </section>

  <!-- Decision Owners -->
  <section class="section" aria-labelledby="decision-owners-heading">
    <div class="container">
      <h2 id="decision-owners-heading">Decision Owners</h2>
      <p>Environmental markets and carbon teams; trading and origination desks; program and project owners; P&L and commercial leaders; sustainability and Scope 3 teams; developers, portfolio managers, investors, and buyers.</p>
    </div>
  </section>

  <!-- Offering Modules -->
  <section class="section section-alt" aria-labelledby="offerings-heading">
    <div class="container">
      <h2 id="offerings-heading">Offering Modules</h2>

      <div class="accordion">
        {offerings.map((offering) => (
          <div class="accordion-item">
            <button
              class="accordion-trigger"
              aria-expanded="false"
              aria-controls={`content-${offering.id}`}
              id={`trigger-${offering.id}`}
            >
              {offering.title}
            </button>
            <div
              class="accordion-content"
              id={`content-${offering.id}`}
              role="region"
              aria-labelledby={`trigger-${offering.id}`}
              hidden
            >
              <p>{offering.description}</p>
              {offering.note && <p><em>{offering.note}</em></p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="section" aria-labelledby="closing-heading">
    <div class="container">
      <h2 id="closing-heading">Value Beyond Price</h2>
      <p>The highest nominal price is not always the highest-value path. Terra Nexus compares participant economics, evidence and operating cost, ownership, market capacity, utilization, acceptance risk, timing, scalability, durability, stacking compatibility, and strategic value.</p>
      <p><em>Detailed pricing, intervention libraries, stacking logic, and client-specific optimization remain paid work.</em></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark" aria-labelledby="cta-heading">
    <div class="container section-header">
      <h2 id="cta-heading">Ready to Get Started?</h2>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Carbon or Ecosystem Opportunity</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .breadcrumb {
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
  }
  .breadcrumb ol {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-neutral-400);
  }
  .breadcrumb a {
    color: var(--color-primary-600);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb [aria-current="page"] {
    color: var(--color-neutral-600);
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      const contentId = trigger.getAttribute('aria-controls');
      if (!contentId) return;
      const content = document.getElementById(contentId);
      if (content) {
        content.hidden = expanded;
      }
    });
  });
</script>
