---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';
const mode = getBuildMode();

const offerings = [
  {
    id: 'sco-digital',
    name: 'Digital Supply Chain Strategy',
    definition: 'Use data, analytics, traceability, and decision-support tools to improve visibility, responsiveness, and environmental management.',
    activities: [
      'Supply-chain design',
      'System architecture',
      'Planning',
      'Analytics',
      'Traceability integration',
    ],
  },
  {
    id: 'sco-interventions',
    name: 'Value Chain Interventions: Influence to Impact',
    definition: 'Identify where a company can influence performance and design policies, incentives, support, evidence, and governance that turn influence into action.',
    activities: [
      'Spend and impact assessment',
      'Supplier segmentation',
      'Engagement',
      'Resilience',
      'Performance planning',
    ],
  },
  {
    id: 'sco-responsible-sourcing',
    name: 'Responsible Sourcing & Procurement',
    definition: 'Balance commercial value, quality, availability, risk, resilience, environmental performance, and supplier relationships.',
    activities: [
      'Category strategy',
      'Supplier evaluation',
      'Global sourcing',
      'Contracting',
      'Supplier relationship management',
    ],
  },
  {
    id: 'sco-resource-efficiency',
    name: 'Resource Efficiency & Lean Operations',
    definition: 'Improve process performance, material and energy use, quality, productivity, cost, and waste.',
    activities: [
      'Lean operations',
      'Inventory and process optimization',
      'Quality management',
      'Value engineering',
      'KPIs',
    ],
  },
  {
    id: 'sco-logistics',
    name: 'Low Impact Logistics',
    definition: 'Reduce cost and environmental impact while maintaining service and resilience.',
    activities: [
      'Network design',
      'Transportation',
      'Freight',
      'Mode and carrier decisions',
      'Reverse logistics',
    ],
  },
  {
    id: 'sco-joint-planning',
    name: 'Joint Business Planning & Supply Chain Collaboration',
    definition: 'Create shared plans, data, responsibilities, incentives, and governance across organizations.',
    activities: [
      'Joint planning',
      'Visibility',
      'Traceability',
      'Chain of custody',
      'Collaboration platforms',
      'Partner governance',
    ],
  },
  {
    id: 'sco-circular',
    name: 'Circular Economy, Waste & Diversion',
    definition: 'Keep products, materials, nutrients, and energy at their highest practical value.',
    activities: [
      'Material-flow assessment',
      'Diversion',
      'Secondary markets',
      'Byproduct commercialization',
      'Organics recovery',
      'Waste-to-energy pathways',
    ],
  },
];
---

<SiteLayout
  title="Sustainable Supply Chain & Operations | Terra Nexus"
  description="Terra Nexus helps procurement, sourcing, supply-chain, and operations leaders reduce impact, risk, cost, and volatility by changing what is bought and how it is produced, moved, processed, used, and recovered."
  preview={mode === 'preview'}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Capabilities</span>
      <h1>Improve What Is Sourced, How It Moves, and How Value Is Delivered</h1>
      <p class="hero-lead">Terra Nexus helps procurement, sourcing, supply-chain, and operations leaders reduce impact, risk, cost, and volatility by changing what is bought, who it is bought from, and how materials are produced, moved, processed, used, and recovered.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Supply Chain</a>
        <a href="/expertise/" class="btn btn-secondary">Explore Our Expertise</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>Who This Capability Supports</h2>
      </header>
      <ul class="audience-list">
        <li>Procurement</li>
        <li>Responsible sourcing</li>
        <li>Category management</li>
        <li>Supply chain</li>
        <li>Logistics</li>
        <li>Operations</li>
        <li>Manufacturing</li>
        <li>Supplier-program, quality, traceability, and data leaders</li>
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Decisions We Help Resolve</h2>
      </header>
      <ul class="decisions-list">
        <li>How can impact, risk, cost, and volatility be reduced by changing what is bought and how it is produced, moved, processed, used, or recovered?</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>How We Help</h2>
        <p class="section-lead">Sustainable Supply Chain &amp; Operations is organized around seven offering modules that can be combined to match the decision at hand.</p>
      </header>
      <div class="accordion">
        {offerings.map((o) => (
          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false" aria-controls={`acc-${o.id}`}>{o.name}</button>
            <div class="accordion-content" id={`acc-${o.id}`} hidden>
              <p>{o.definition}</p>
              {o.activities.length > 0 && (
                <ul>
                  {o.activities.map((a) => <li>{a}</li>)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Related Expertise</h2>
      </header>
      <div class="tag-row">
        <a href="/expertise/sustainable-supply-chains/" class="segment-tag">Sustainable Supply Chains</a>
        <a href="/expertise/food-waste-prevention-diversion-recovery/" class="segment-tag">Food Waste Prevention, Diversion &amp; Recovery</a>
        <a href="/expertise/regenerative-agriculture/" class="segment-tag">Regenerative Agriculture</a>
        <a href="/expertise/low-carbon-energy-and-biofuels/" class="segment-tag">Low Carbon Energy &amp; Biofuels</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2>How We Engage</h2>
        <p class="section-lead">Terra Nexus engages with clients through two complementary models.</p>
      </header>
      <div class="card-grid">
        <article class="card">
          <h3>Advise</h3>
          <p>Terra Nexus evaluates opportunities, performs diligence, models economics, selects frameworks and partners, and designs programs, systems, controls, and commercial structures.</p>
        </article>
        <article class="card">
          <h3>Manage</h3>
          <p>Terra Nexus embeds within client-owned programs to coordinate recurring work, data, partners, reporting, and continuous improvement.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Relevant Proof</h2>
      </header>
      <p>The approved lower-emissions beef case study supports market mechanisms, value-chain claims, insetting, and commercialization.</p>
      <div class="section-cta">
        <a href="/case-studies/" class="btn btn-secondary">Read the Case Study</a>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container text-center">
      <h2>Discuss Your Supply Chain or Operations Challenge</h2>
      <p class="cta-description">Tell us what you are sourcing, moving, or trying to improve.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Supply Chain</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      const contentId = trigger.getAttribute('aria-controls');
      const content = contentId ? document.getElementById(contentId) : null;
      if (content) content.hidden = expanded;
    });
  });
</script>

<style>
  .audience-list, .decisions-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .audience-list li, .decisions-list li { color: var(--color-text-secondary); font-size: var(--text-base); }
  .decisions-list li { padding-left: var(--space-5); position: relative; }
  .decisions-list li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-accent); }
  .tag-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .segment-tag { display: inline-block; padding: var(--space-1) var(--space-3); border: 1px solid var(--color-border); border-radius: 999px; font-size: var(--text-sm); color: var(--color-text-secondary); text-decoration: none; }
  .segment-tag:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .section-cta { margin-top: var(--space-6); display: flex; justify-content: flex-start; }
  .text-center { text-align: center; }
  .text-center .hero-actions { justify-content: center; }
  .cta-description { color: #a3adb8; max-width: var(--max-width-text); margin: var(--space-4) auto var(--space-8); }
  .section-dark .btn-primary { background: #fff; color: #1a1f24; border-color: #fff; }
  .section-dark .btn-primary:hover { background: #e2e5e9; border-color: #e2e5e9; }
</style>
