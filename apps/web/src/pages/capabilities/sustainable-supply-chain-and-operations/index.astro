---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';

const mode = getBuildMode();

const offerings = [
  {
    id: 'digital-supply-chain',
    title: 'Digital Supply Chain Strategy',
    description: 'Use data, analytics, traceability, and decision-support tools to improve visibility, responsiveness, and environmental management.',
  },
  {
    id: 'value-chain-interventions',
    title: 'Value Chain Interventions: Influence to Impact',
    description: 'Identify where a company can influence performance and design policies, incentives, support, evidence, and governance that turn influence into action.',
  },
  {
    id: 'responsible-sourcing',
    title: 'Responsible Sourcing & Procurement',
    description: 'Balance commercial value, quality, availability, risk, resilience, environmental performance, and supplier relationships.',
  },
  {
    id: 'resource-efficiency',
    title: 'Resource Efficiency & Lean Operations',
    description: 'Improve process performance, material and energy use, quality, productivity, cost, and waste.',
  },
  {
    id: 'low-impact-logistics',
    title: 'Low Impact Logistics',
    description: 'Reduce cost and environmental impact while maintaining service and resilience.',
  },
  {
    id: 'joint-business-planning',
    title: 'Joint Business Planning & Supply Chain Collaboration',
    description: 'Create shared plans, data, responsibilities, incentives, and governance across organizations.',
  },
  {
    id: 'circular-economy',
    title: 'Circular Economy, Waste & Diversion',
    description: 'Keep products, materials, nutrients, and energy at their highest practical value.',
  },
];
---

<SiteLayout
  title="Sustainable Supply Chain & Operations — Capabilities — Terra Nexus"
  description="Terra Nexus helps procurement, sourcing, supply-chain, and operations leaders reduce impact, risk, cost, and volatility by changing what is bought, who it is bought from, and how materials are produced, moved, processed, used, and recovered."
  preview={mode === 'preview'}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/capabilities/">Capabilities</a></li>
        <li aria-current="page">Sustainable Supply Chain & Operations</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">SUSTAINABLE SUPPLY CHAIN & OPERATIONS</span>
      <h1>Improve What Is Sourced, How It Moves, and How Value Is Delivered</h1>
      <p class="hero-lead">Terra Nexus helps procurement, sourcing, supply-chain, and operations leaders reduce impact, risk, cost, and volatility by changing what is bought, who it is bought from, and how materials are produced, moved, processed, used, and recovered.</p>
    </div>
  </section>

  <!-- Decision Owners -->
  <section class="section" aria-labelledby="decision-owners-heading">
    <div class="container">
      <h2 id="decision-owners-heading">Decision Owners</h2>
      <p>Procurement; responsible sourcing; category management; supply chain; logistics; operations; manufacturing; supplier-program, quality, traceability, and data leaders.</p>
    </div>
  </section>

  <!-- Offering Modules -->
  <section class="section section-alt" aria-labelledby="offerings-heading">
    <div class="container">
      <h2 id="offerings-heading">Offering Modules</h2>

      <div class="accordion">
        {offerings.map((offering) => (
          <div class="accordion-item">
            <button
              class="accordion-trigger"
              aria-expanded="false"
              aria-controls={`content-${offering.id}`}
              id={`trigger-${offering.id}`}
            >
              {offering.title}
            </button>
            <div
              class="accordion-content"
              id={`content-${offering.id}`}
              role="region"
              aria-labelledby={`trigger-${offering.id}`}
              hidden
            >
              <p>{offering.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Boundary -->
  <section class="section" aria-labelledby="boundary-heading">
    <div class="container">
      <h2 id="boundary-heading">Boundary</h2>
      <p>The capability page explains what Terra Nexus does for supply-chain decision owners. The Sustainable Supply Chains Area of Expertise explains why the topic matters as a market-facing food-and-climate domain.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark" aria-labelledby="cta-heading">
    <div class="container section-header">
      <h2 id="cta-heading">Ready to Get Started?</h2>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Supply Chain or Operations Challenge</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .breadcrumb {
    padding: var(--space-4) 0;
    font-size: var(--text-sm);
  }
  .breadcrumb ol {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-neutral-400);
  }
  .breadcrumb a {
    color: var(--color-primary-600);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb [aria-current="page"] {
    color: var(--color-neutral-600);
  }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      const contentId = trigger.getAttribute('aria-controls');
      if (!contentId) return;
      const content = document.getElementById(contentId);
      if (content) {
        content.hidden = expanded;
      }
    });
  });
</script>
