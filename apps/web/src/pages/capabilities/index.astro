---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
const mode = getBuildMode();

const capabilities = [
  { title: 'Strategy & Innovation', slug: 'strategy-and-innovation', question: 'Where should we play, and how do we win at the intersection of food and climate?', description: 'Determine where to play, how to win, and how to create differentiated growth at the intersection of food and climate.' },
  { title: 'Financial Investments & New Venture Development', slug: 'financial-investments-and-new-venture-development', question: 'Which ideas, ventures, investments, assets, partnerships, or facilities should be screened, funded, incubated, acquired, or scaled?', description: 'Screen, value, fund, structure, incubate, acquire, and scale food, agriculture, climate, nature, and circularity opportunities.' },
  { title: 'Sustainable Supply Chain & Operations', slug: 'sustainable-supply-chain-and-operations', question: 'How can impact, risk, cost, and volatility be reduced by changing what is bought and how it is produced, moved, processed, used, or recovered?', description: 'Reduce impact, risk, cost, and volatility by changing what is sourced and how it is produced, moved, processed, used, and recovered.' },
  { title: 'Corporate Sustainability', slug: 'corporate-sustainability', question: 'How should the enterprise set targets and policies, prioritize action, account for progress, manage claims, and report performance?', description: 'Set enterprise ambition, prioritize action, account for progress, govern claims, engage stakeholders, and report performance.' },
  { title: 'Carbon & Ecosystem Services', slug: 'carbon-and-ecosystem-services', question: 'How are environmental assets, attributes, credits, insets, offsets, and claims created, accessed, valued, verified, accounted for, managed, and monetized?', description: 'Create, access, value, verify, account for, manage, and commercialize environmental assets, attributes, credits, insets, offsets, and claims.' },
];
---

<SiteLayout
  title="Capabilities | Terra Nexus"
  description="Terra Nexus combines five capability families to help clients make the right decision, build the right operating model, bring together the right partners, and capture the largest supportable sources of value."
  preview={mode === 'preview'}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Capabilities</span>
      <h1>Connect Strategy, Investment, Operations, Sustainability, and Market Value</h1>
      <p class="hero-lead">Food-and-climate opportunities rarely fit inside one business function. Terra Nexus combines five capability families to help clients make the right decision, build the right operating model, bring together the right partners, and capture the largest supportable sources of value.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
        <a href="/expertise/" class="btn btn-secondary">Explore Our Expertise</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {capabilities.map((cap) => (
          <a href={`/capabilities/${cap.slug}/`} class="card-link">
            <article class="card">
              <h3>{cap.title}</h3>
              <p class="capability-question">{cap.question}</p>
              <p>{cap.description}</p>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <h2>Integrated Support Across the Path to Value</h2>
        <p class="section-lead">A single engagement may require strategy, finance, operations, sustainability, and environmental-market capabilities working together. Terra Nexus organizes the work around the client functions that own each decision while integrating the complete path to value.</p>
      </header>
      <p>Each capability page contains its relevant offering modules. The 29 offerings are not standalone pages — they explain the types of decisions and engagement work inside a capability without forcing visitors to navigate a consulting-service catalogue.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container text-center">
      <h2>Discuss Your Challenge</h2>
      <p class="cta-description">Tell us what you are evaluating, building, or trying to improve.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Discuss Your Challenge</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .capability-question { font-style: italic; color: var(--color-text); margin-bottom: var(--space-2); font-size: var(--text-sm); }
  .text-center { text-align: center; }
  .text-center .hero-actions { justify-content: center; }
  .cta-description { color: #a3adb8; max-width: var(--max-width-text); margin: var(--space-4) auto var(--space-8); }
  .section-dark .btn-primary { background: #fff; color: #1a1f24; border-color: #fff; }
  .section-dark .btn-primary:hover { background: #e2e5e9; border-color: #e2e5e9; }
</style>
