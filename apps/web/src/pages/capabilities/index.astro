---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
import ClosingCta from '../../components/ClosingCta.astro';
const mode = getBuildMode();

const capabilities = [
  { title: 'Strategy & Innovation', slug: 'strategy-and-innovation', description: 'Determine where to play, how to win, and how to create differentiated growth at the intersection of food and climate.' },
  { title: 'Financial Investments & New Venture Development', slug: 'financial-investments-and-new-venture-development', description: 'Screen, value, fund, structure, incubate, acquire, and scale food, agriculture, climate, nature, and circularity opportunities.' },
  { title: 'Sustainable Supply Chain & Operations', slug: 'sustainable-supply-chain-and-operations', description: 'Reduce impact, risk, cost, and volatility by changing what is sourced and how it is produced, moved, processed, used, and recovered.' },
  { title: 'Corporate Sustainability', slug: 'corporate-sustainability', description: 'Set enterprise ambition, prioritize action, account for progress, govern claims, engage stakeholders, and report performance.' },
  { title: 'Carbon & Ecosystem Services', slug: 'carbon-and-ecosystem-services', description: 'Create, access, value, verify, account for, manage, and commercialize environmental assets, attributes, credits, insets, offsets, and claims.' },
];

const workstreams = [
  { title: 'Evaluate the Opportunity', items: ['Market, customer, competitor, and landscape analysis', 'Business cases, economics, scenarios, and value allocation', 'Technology, methodology, partner, project, and transaction diligence', 'Build-buy-partner and investment decisions', 'Risk, feasibility, and strategic-fit assessment'] },
  { title: 'Design the Program', items: ['Objectives, boundaries, outcomes, and participation criteria', 'Commercial model, incentives, contracts, and risk allocation', 'Practice-based, outcome-based, or hybrid architecture', 'Governance, roles, controls, and assurance strategy', 'Routes to market and stakeholder alignment'] },
  { title: 'Build the Operating Infrastructure', items: ['Workflows, roles, and process design', 'Data requirements and system architecture', 'Measurement, calculation, and quality-control processes', 'Traceability, chain of custody, and attribute controls', 'Ledgers, documentation, reporting, and exception management'] },
  { title: 'Launch and Scale', items: ['Pilot design and success criteria', 'Partner and technology selection', 'Implementation planning and change management', 'Coordination across producers, partners, and customers', 'Expansion across geographies, products, and customers'] },
  { title: 'Manage Client-Owned Programs', items: ['Recurring operational and evidence workflows', 'Data review and calculation processes', 'Program and attribute ledgers', 'Vendor and partner coordination', 'Exception resolution and management reporting', 'Audit and verification preparation', 'Continuous program improvement'] },
  { title: 'Connect Performance to Claims and Market Value', items: ['Corporate inventory and target alignment', 'Certification and sourcing claims', 'Product, customer, and commercial propositions', 'Scope 3 and inset pathways', 'Carbon and ecosystem-service market assessment', 'Low-carbon and regulatory opportunities', 'Claims governance and communication boundaries'] },
];
---

<SiteLayout
  title="Capabilities | Terra Nexus"
  description="Terra Nexus combines five capability families to help clients make the right decision, build the right operating model, bring together the right partners, and capture the largest supportable sources of value."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Capabilities"
    title="Connect Strategy, Investment, Operations, Sustainability, and Market Value"
    lead="Food-and-climate opportunities rarely fit inside one business function. Terra Nexus combines five capability families to help clients make the right decision, build the right operating model, bring together the right partners, and capture the largest supportable sources of value."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
    secondaryCta={{ label: 'Explore Our Expertise', href: '/expertise/' }}
  />

  <section class="section" aria-labelledby="approach-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Our Approach</span>
        <h2 id="approach-heading">Our Approach</h2>
      </header>
      <div class="workstream-grid">
        {workstreams.map((ws) => (
          <article class="card-plain">
            <h3>{ws.title}</h3>
            <ul class="bullet-list">
              {ws.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="delivery-heading">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Our Delivery</span>
        <h2 id="delivery-heading">Our Delivery</h2>
      </header>
      <div class="card-grid">
        {capabilities.map((cap) => (
          <a href={`/capabilities/${cap.slug}/`} class="card-link">
            <article class="card">
              <h3>{cap.title}</h3>
              <p>{cap.description}</p>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Integrated Support</span>
        <h2>One Engagement, Multiple Capabilities</h2>
        <p class="section-lead">A single engagement may require strategy, finance, operations, sustainability, and environmental-market capabilities working together. Terra Nexus organizes the work around the client functions that own each decision while integrating the complete path to value.</p>
      </header>
      <div class="pathway-tags">
        <span class="tag">Strategy</span>
        <span class="tag">Investment</span>
        <span class="tag">Operations</span>
        <span class="tag">Sustainability</span>
        <span class="tag">Environmental Markets</span>
      </div>
    </div>
  </section>

  <ClosingCta
    heading="Discuss Your Challenge"
    description="Tell us what you are evaluating, building, or trying to improve."
    primaryCta={{ label: 'Discuss Your Challenge', href: '/contact/' }}
  />
</SiteLayout>

<style>
  .pathway-tags { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 var(--space-4); }
  /* ── Our Approach ── */
  .workstream-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .workstream-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .workstream-grid { grid-template-columns: repeat(3, 1fr); } }
  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bullet-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
    margin-bottom: var(--space-2);
    line-height: var(--line-normal);
  }
  .bullet-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-sky-600);
  }
</style>
