---
// Smallest-needed prototype route for the Insights mega menu's "Research"
// item — no suitable existing page to reuse. Industries/Insights IA
// prototype (prototype/industries-insights-ia, 2026-08-17). Not final
// editorial content or taxonomy. See CLAUDE.md.
//
// 2026-09-16 (owner): hero and explanatory paragraph removed — a section
// with nothing in it should not open with a hero promising what it does not
// have. What is left is the ComingSoon band, whose heading is this page's
// <h1>, and the closing CTA carrying the onward-link row that replaces the
// navigation the hero used to provide. The band carries the seated-stargazer
// (man) brand scene; Case Studies carries the group. See data/brand-scenes.ts.
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../../lib/build-mode.js';
import ComingSoon from '../../../components/ComingSoon.astro';
import ClosingCta from '../../../components/ClosingCta.astro';
import { comingSoonOnwardLinks } from '../../../data/onward-links';
const mode = getBuildMode();
---

<SiteLayout
  title="Research | Insights | Terra Nexus"
  description="Terra Nexus research and technical analysis is not yet published. New research is on the horizon."
  preview={mode === 'preview'}
>
  <ComingSoon heading="New Research Is on the Horizon" treatment="photo" photo="man" />

  <ClosingCta
    heading="Have a Research Question in Mind?"
    description="Tell us what you're trying to understand — Terra Nexus can help scope the analysis."
    primaryCta={{ label: 'Discuss Your Question', href: '/contact/' }}
    links={[...comingSoonOnwardLinks]}
  />
</SiteLayout>
