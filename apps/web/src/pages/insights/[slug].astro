---
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicBuildMode } from '../../lib/build-mode.js';
import { isPubliclyVisible, zonedWallClockToUtc } from '../../lib/publication.js';
import Callout from '../../components/mdx/Callout.astro';
import CTA from '../../components/mdx/CTA.astro';
import DataTable from '../../components/mdx/DataTable.astro';
import Download from '../../components/mdx/Download.astro';
import Figure from '../../components/mdx/Figure.astro';
import FullBleedImage from '../../components/mdx/FullBleedImage.astro';
import Gallery from '../../components/mdx/Gallery.astro';
import InteractiveEmbed from '../../components/mdx/InteractiveEmbed.astro';
import PullQuote from '../../components/mdx/PullQuote.astro';
import RelatedContent from '../../components/mdx/RelatedContent.astro';
import SourceBox from '../../components/mdx/SourceBox.astro';
import Stat from '../../components/mdx/Stat.astro';
import Video from '../../components/mdx/Video.astro';

// On-demand, not static: same reasoning as src/pages/insights/index.astro —
// publication visibility depends on request time, not build time.
export const prerender = false;

const mode = getPublicBuildMode();
const { slug } = Astro.params;
const post: CollectionEntry<'posts'> | undefined = slug ? await getEntry('posts', slug) : undefined;

// Unpublished direct URLs 404 rather than leaking existence/content —
// applies uniformly to a nonexistent slug, a draft, and an approved post
// whose publishAt hasn't passed yet. Preview builds bypass gating (see
// index.astro's comment) so an editor can review via the preview URL.
if (!post || (mode !== 'preview' && !isPubliclyVisible(post.data))) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(post);
// `reference()` fields resolve to `{ collection, id }` objects, not plain
// strings — getEntry/getEntries take the resolved reference directly.
const author = await getEntry(post.data.author);
const topics: CollectionEntry<'topics'>[] = post.data.topics.length
  ? await getEntries(post.data.topics)
  : [];

// Registered names here must match the component names used in the MDX body
// (which in turn must match the keys of `mdxContentComponents` in
// apps/web/keystatic.content-components.tsx).
const mdxComponents = {
  Callout,
  CTA,
  DataTable,
  Download,
  Figure,
  FullBleedImage,
  Gallery,
  InteractiveEmbed,
  PullQuote,
  RelatedContent,
  SourceBox,
  Stat,
  Video,
};

const dateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'America/Denver' });
---

<SiteLayout
  title={`${post.data.seoTitle || post.data.title} | Terra Nexus`}
  description={post.data.seoDescription || post.data.excerpt}
  preview={mode === 'preview'}
>
  <article class="insight-article">
    <header class="insight-header">
      <div class="container">
        {topics.length > 0 && (
          <p class="insight-topics">
            {topics.map((topic) => topic.data.name).join(' · ')}
          </p>
        )}
        <h1>{post.data.title}</h1>
        <p class="insight-excerpt">{post.data.excerpt}</p>
        <div class="insight-meta">
          {author && <span>By {author.data.name}</span>}
          <span>{dateFormatter.format(zonedWallClockToUtc(post.data.publishAt))}</span>
          {post.data.updatedDate && (
            <span>Updated {dateFormatter.format(post.data.updatedDate)}</span>
          )}
        </div>
      </div>
    </header>

    <img class="insight-hero" src={post.data.heroImage} alt={post.data.heroImageAlt} />

    <div class="container insight-body">
      <Content components={mdxComponents} />
    </div>

    {author && (
      <div class="container">
        <div class="insight-author-card">
          {author.data.photo && <img src={author.data.photo} alt="" />}
          <div>
            <p class="insight-author-name">{author.data.name}</p>
            {author.data.title && <p class="insight-author-title">{author.data.title}</p>}
          </div>
        </div>
      </div>
    )}
  </article>
</SiteLayout>

<style>
  .insight-header {
    padding-block: var(--space-16) var(--space-8);
  }
  .insight-topics {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8125rem;
    font-weight: var(--font-semibold);
    color: var(--color-eyebrow);
    margin: 0 0 var(--space-3);
  }
  .insight-header h1 {
    max-width: var(--max-width-text);
  }
  .insight-excerpt {
    max-width: var(--max-width-text);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }
  .insight-meta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .insight-hero {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    display: block;
  }
  .insight-body {
    max-width: var(--max-width-text);
    padding-block: var(--space-10);
  }
  .insight-body :global(p:not(.mdx-cta-heading):not(.mdx-cta-body)) {
    color: var(--color-text);
    line-height: var(--line-relaxed);
  }
  .insight-body :global(p + p) {
    margin-top: var(--space-5);
  }
  .insight-body :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .insight-body :global(h3) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
  }
  .insight-body :global(ul),
  .insight-body :global(ol) {
    margin: var(--space-5) 0;
    padding-inline-start: var(--space-6);
    color: var(--color-text);
    line-height: var(--line-relaxed);
  }
  .insight-body :global(li + li) {
    margin-top: var(--space-2);
  }
  .insight-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .insight-author-card {
    max-width: var(--max-width-text);
    margin: 0 auto var(--space-16);
    padding: var(--space-5) var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .insight-author-card img {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }
  .insight-author-name {
    font-weight: var(--font-semibold);
    margin: 0;
  }
  .insight-author-title {
    color: var(--color-text-secondary);
    margin: 0;
    font-size: 0.875rem;
  }
</style>
