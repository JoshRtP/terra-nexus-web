---
// DESIGN LAB — Our Track Record, Option C2 refined (branch
// design/track-record-options, 2026-09-14, round 3).
//
// Round 1 (commit 0a03254): four treatments, owner chose C (headline figure
// beside a ledger). Round 2 (commit 3efcde4): C with the owner's new figures,
// grouped (C1) and flat (C2); owner chose the flat ledger — "clearer for a
// portfolio" — and tightened every label. This round keeps C2 and the
// owner's wording verbatim and varies one thing at a time:
//
//   V1  the flat ledger with the new text (the baseline)
//   V2  the headline side in its own colour: the navy panel the homepage
//       already uses, with $2.65B in gold
//   V2b the same idea at its quietest: only the numeral changes colour,
//       to the brand maroon the rule and eyebrow already use (added as a
//       cheap comparison for V2, not requested)
//   V3  a line icon ahead of each figure in the flat rows
//
// Still not for merge as-is: the chosen version is promoted into the
// homepage and the shared .stat-* primitives, and this route is deleted.
import SiteLayout from '../../../layouts/SiteLayout.astro';

type Stat = { value: string; count: number; prefix?: string; suffix: string; decimals?: number; label: string; icon: string };

const headline: Stat = { value: '$2.65B', count: 2.65, prefix: '$', suffix: 'B', decimals: 2, label: 'Enterprise value created for clients', icon: 'value' };

// Owner wording, 2026-09-14, verbatim (case normalised to sentence case to
// match the rest of the site's labels).
const stats: Stat[] = [
  { value: '25+', count: 25, suffix: '+', label: 'Countries with verified impact', icon: 'globe' },
  { value: '15+', count: 15, suffix: '+', label: 'Commodity value chains', icon: 'commodity' },
  { value: '8M+', count: 8, suffix: 'M+', label: 'Regenerative acres', icon: 'acres' },
  { value: '20+', count: 20, suffix: '+', label: 'Sustainable fisheries', icon: 'fish' },
  { value: '2,000+', count: 2000, suffix: '+', label: 'Resource efficient facilities', icon: 'facility' },
  { value: '10+', count: 10, suffix: '+', label: 'Carbon registries & regulated markets', icon: 'registry' },
  { value: '20+', count: 20, suffix: '+', label: 'Sustainable commodity & EACs', icon: 'certificate' },
];

// V4 levers — owner sketch, 2026-09-14: under the value, the ordinary good
// business decisions that produced it (up: revenue, margins, operating
// efficiencies; down: cost, risk). The payoff line the sketch had under
// them was dropped at owner review, round 5.
const levers = {
  up: { label: 'Increase', items: ['Revenue', 'Margins', 'Operating efficiencies'] },
  down: { label: 'Decrease', items: ['Cost', 'Risk'] },
};
const arrows = {
  up: '<path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/>',
  down: '<path d="M12 5v14M5.5 12.5 12 19l6.5-6.5"/>',
};

const variants = [
  { id: 'v4', name: 'Hybrid: navy value, lever cards, red icons', note: 'Owner pick, round 5. Left column is three boxes of one shape: the value in the navy panel, then the levers that produced it as two light cards (increase revenue, margins, operating efficiencies; decrease cost, risk). Right column is V3’s ledger with the icons in brand maroon and no disc.' },
  { id: 'v1', name: 'Flat ledger, new text', note: 'The round-2 flat ledger with the owner’s tightened labels. Baseline for the other three.' },
  { id: 'v2', name: 'Headline in colour: navy panel', note: 'The $2.65B side becomes the navy gradient panel the homepage already uses for How We Work and Who We Work With, with the figure in gold. The ledger stays on the light surface.' },
  { id: 'v2b', name: 'Headline in colour: maroon numeral', note: 'Not requested, added for comparison. The quietest reading of “a different colour on that side”: only the numeral changes, to the brand maroon the rule and eyebrow already use.' },
  { id: 'v3', name: 'Icons in the rows', note: 'A 1.5px line icon in a sky disc ahead of each figure. Placeholder drawings at the weight of the site’s existing inline marks; a chosen icon version gets a proper pass.' },
];

// 24×24 stroke icons, 1.5px, round caps. Placeholder drawings.
const icons: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z"/>',
  commodity: '<path d="M12 22V9"/><path d="M12 13c-3.2 0-5.2-2-5.2-5.2 3.2 0 5.2 2 5.2 5.2zM12 13c3.2 0 5.2-2 5.2-5.2-3.2 0-5.2 2-5.2 5.2zM12 18c-3.2 0-5.2-2-5.2-5.2 3.2 0 5.2 2 5.2 5.2zM12 18c3.2 0 5.2-2 5.2-5.2-3.2 0-5.2 2-5.2 5.2z"/>',
  acres: '<path d="M2.5 19h19"/><path d="M2.5 15.5c3-3.2 5.5-3.2 8.5 0 3 3.2 5.5 3.2 8.5 0"/><path d="M4 12c2.5-2.6 4.5-2.6 7 0"/><circle cx="17.5" cy="7" r="2.25"/>',
  fish: '<path d="M2.75 12c2.5-4 6-6 9.5-6 3 0 5.5 2 7.25 6-1.75 4-4.25 6-7.25 6-3.5 0-7-2-9.5-6z"/><path d="M19.5 12l2.75-3.25v6.5L19.5 12"/><circle cx="8.25" cy="11" r="0.6" fill="currentColor" stroke="none"/>',
  facility: '<path d="M3 21V9.5l5 3.25V9.5l5 3.25V9.5l5 3.25V21H3z"/><path d="M15.5 9.5V3.5h3v7.5"/><path d="M7 21v-4h3v4"/>',
  registry: '<path d="M5 3.5h10.5A3.5 3.5 0 0 1 19 7v13.5H8.5A3.5 3.5 0 0 1 5 17V3.5z"/><path d="M5 17a3.5 3.5 0 0 1 3.5-3.5H19M9 7.5h6M9 10.5h6"/>',
  certificate: '<path d="M12 2.75l7.25 2.9v5.6c0 4.9-3.1 8.4-7.25 10-4.15-1.6-7.25-5.1-7.25-10v-5.6L12 2.75z"/><path d="M8.75 12l2.25 2.25L15.5 9.75"/>',
};
---

<SiteLayout
  title="Track Record Options | Design Lab"
  description="Internal design lab: Option C2 of the homepage Our Track Record section, four versions."
  preview={true}
>
  <div class="lab-intro">
    <div class="container">
      <p class="lab-kicker">Design lab · not linked, not indexed · round 4</p>
      <h1 class="lab-title">Our Track Record: the flat ledger, five ways</h1>
      <p class="lab-text">Owner’s tightened labels throughout. One thing changes per version. Jump:</p>
      <nav class="lab-nav" aria-label="Versions">
        {variants.map((v) => <a href={`#option-${v.id}`}>{v.id.toUpperCase()} · {v.name}</a>)}
      </nav>
    </div>
  </div>

  {variants.map((v) => (
    <Fragment>
      <div class="lab-marker" id={`option-${v.id}`}>
        <div class="container">
          <p class="lab-marker-name">{v.id.toUpperCase()} — {v.name}</p>
          <p class="lab-marker-note">{v.note}</p>
        </div>
      </div>

      <section class={`section section-alt tr-section tr-${v.id}`} aria-labelledby={`tr-${v.id}-heading`}>
        <div class="container">
          <header class="section-header split-header">
            <span class="eyebrow split-header-eyebrow">Our Track Record</span>
            <div class="split-header-title">
              <h2 id={`tr-${v.id}-heading`}>Proven Portfolio of Successful Impact</h2>
            </div>
            <div class="split-header-lead">
              <p class="section-lead">There is absolutely no legitimate reason that creating a better planet should be so damn complicated, especially when it means the world to so many.</p>
            </div>
          </header>

          <div class="tr-headline" data-tr-stats>
            <div class="tr-headline-side">
              <div class={v.id === 'v2' || v.id === 'v4' ? 'tr-headline-lead tr-headline-lead-panel' : 'tr-headline-lead'}>
                <p class="stat-value tr-num tr-num-hero" data-count={headline.count} data-prefix={headline.prefix} data-suffix={headline.suffix} data-decimals={headline.decimals}>{headline.value}</p>
                <p class="stat-label tr-label tr-label-hero">{headline.label}</p>
              </div>

              {v.id === 'v4' && (
                <div class="tr-levers">
                  {(['up', 'down'] as const).map((dir) => (
                    <div class="card card-static tr-lever-card">
                      <p class="tr-lever-label">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrows[dir]} />
                        <span>{levers[dir].label}</span>
                      </p>
                      <ul class="tr-lever-list" role="list">
                        {levers[dir].items.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div class="tr-headline-list">
              {stats.map((s) => (
                <div class="tr-headline-item">
                  {(v.id === 'v3' || v.id === 'v4') && (
                    <span class={v.id === 'v4' ? 'tr-icon tr-icon-bare' : 'tr-icon'} aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
                    </span>
                  )}
                  <p class="stat-value tr-num tr-num-sm" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                  <p class="stat-label tr-label">{s.label}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="section-cta">
            <a href="/about/" class="btn btn-primary">Learn More About Us</a>
          </div>
        </div>
      </section>
    </Fragment>
  ))}
</SiteLayout>

<style>
  /* ── Lab chrome (never ships) ─────────────────────────────────────── */
  .lab-intro { padding: var(--space-12) 0 var(--space-8); border-bottom: 1px dashed var(--c-secondary-400); }
  .lab-kicker { margin: 0; font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .lab-title { margin: var(--space-2) 0 var(--space-3); font-size: var(--text-3xl); }
  .lab-text { margin: 0; color: var(--color-text-secondary); max-width: var(--max-width-text); }
  .lab-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .lab-nav a { font-size: var(--text-sm); padding: var(--space-1) var(--space-3); border: 1px solid var(--c-secondary-300); border-radius: var(--radius-full); text-decoration: none; color: var(--color-text); }
  .lab-nav a:hover { border-color: var(--color-text); }
  .lab-marker { padding: var(--space-5) 0; background: var(--color-bg); border-top: 1px dashed var(--c-secondary-400); border-bottom: 1px dashed var(--c-secondary-400); scroll-margin-top: 5rem; }
  .lab-marker-name { margin: 0; font-size: var(--text-sm); font-weight: var(--font-semibold); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text); }
  .lab-marker-note { margin: var(--space-1) 0 0; font-size: var(--text-sm); color: var(--color-text-secondary); max-width: var(--max-width-text); }

  /* ── Shared ───────────────────────────────────────────────────────── */
  /* .stat-value / .stat-label supply family, weight, colour and tracking
     (design-system.css). This block only sets size and layout. */
  .tr-num { font-variant-numeric: lining-nums tabular-nums; }
  .tr-label { margin: 0; font-size: var(--text-base); line-height: var(--line-relaxed); color: var(--color-text-secondary); }

  /* ── C2 · Headline figure beside a flat ledger ────────────────────── */
  /* Same column template as .split-header, so the headline figure sits
     under the heading and the ledger under the lead paragraph. */
  .tr-headline {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) 1fr;
    column-gap: var(--space-10);
    row-gap: var(--space-10);
    align-items: start;
  }
  .tr-headline-lead { padding-top: var(--space-5); border-top: 3px solid var(--color-eyebrow); }
  .tr-num-hero { font-size: clamp(3.75rem, 6.2vw, 5.5rem); letter-spacing: -0.03em; }
  .tr-label-hero { margin-top: var(--space-4); font-size: var(--text-lg); max-width: 20rem; }

  .tr-headline-list { display: flex; flex-direction: column; }
  .tr-headline-item {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--c-secondary-300);
  }
  .tr-headline-item:last-child { border-bottom: 1px solid var(--c-secondary-300); }
  .tr-num-sm { font-size: clamp(1.875rem, 2.2vw, 2.25rem); }
  /* Numeral column sized for the widest figure ("2,000+") so every label
     starts on the same line; ch scales with the font-size. */
  .tr-headline-item .tr-num { flex: 0 0 auto; min-width: 6.4ch; }

  @media (max-width: 56rem) {
    .tr-headline { grid-template-columns: 1fr; row-gap: var(--space-8); }
    .tr-num-hero { font-size: clamp(3.5rem, 12vw, 4.5rem); }
  }

  /* ── V2 · headline side as the navy panel ─────────────────────────── */
  /* Same recipe as the homepage's .approach-card; the maroon rule goes,
     the panel edge does that job. Figure in gold, label in sky. */
  .tr-headline-lead-panel {
    position: relative; overflow: hidden;
    padding: var(--space-8);
    border-top: 0;
    background: var(--gradient-dark);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-2xl);
  }
  .tr-headline-lead-panel::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 65% at 100% 100%, rgba(168, 208, 219, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }
  .tr-headline-lead-panel > * { position: relative; z-index: 1; }
  .tr-headline-lead-panel .tr-num-hero { color: var(--c-accent-400); }
  .tr-headline-lead-panel .tr-label-hero { color: var(--c-sky-300); }
  @media (max-width: 56rem) { .tr-headline-lead-panel { padding: var(--space-6); } }

  /* ── V2b · maroon numeral only ────────────────────────────────────── */
  .tr-v2b .tr-num-hero { color: var(--color-accent); }

  /* ── V3 · icon ahead of each figure ───────────────────────────────── */
  .tr-icon {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem;
    border-radius: var(--radius-full);
    background: var(--c-sky-100);
    color: var(--c-sky-700);
  }
  .tr-v3 .tr-headline-item { gap: var(--space-5); }
  @media (max-width: 34rem) {
    .tr-v3 .tr-headline-item { gap: var(--space-4); }
    .tr-v3 .tr-icon { width: 2.25rem; height: 2.25rem; }
    .tr-v3 .tr-icon svg { width: 18px; height: 18px; }
  }

  /* ── V4 · hybrid ──────────────────────────────────────────────────── */
  /* Bare icon, brand maroon, no disc: sized to the numeral's cap height
     and given the same fixed width so the numerals still line up. */
  .tr-icon-bare {
    width: 2rem; height: auto;
    background: none;
    color: var(--color-accent);
    justify-content: flex-start;
  }
  .tr-icon-bare svg { width: 28px; height: 28px; }
  .tr-v4 .tr-headline-item { gap: var(--space-5); }

  /* Levers: two cards under the panel, so the left column reads as three
     boxes of one shape — the value in navy, the levers in light. The cards
     are the site's static card recipe at the panel's radius; the arrow +
     label is the section's small uppercase mark in maroon, so it reads
     with the icons on the right; items are plain body text. */
  /* Increase carries the longer list ("Operating efficiencies"), so it
     takes the wider share; the split keeps that item on one line inside
     the 25rem title column. */
  .tr-levers {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .tr-lever-card {
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-xl);
  }
  .tr-lever-list li { white-space: nowrap; }
  .tr-lever-label {
    display: inline-flex; align-items: center; gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-eyebrow);
  }
  .tr-lever-list { margin: 0; padding: 0; list-style: none; }
  .tr-lever-list li { font-size: var(--text-base); line-height: var(--line-relaxed); color: var(--color-text); }
  @media (max-width: 34rem) {
    .tr-v4 .tr-headline-item { gap: var(--space-4); }
    .tr-icon-bare { width: 1.5rem; }
    .tr-icon-bare svg { width: 20px; height: 20px; }
    /* Phones narrower than 390 cannot hold "Operating efficiencies" on one
       line in a half-width card; wrapping beats overflow there. */
    .tr-lever-list li { white-space: normal; }
  }
</style>

<script>
  // Count-up, lifted from about/index.astro (same easing), triggered per
  // group by an IntersectionObserver. Decimals (data-decimals, for $2.65B),
  // thousands separators (2,000+), duration capped. Skipped under reduced
  // motion: the SSR text stays.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-tr-stats]'));
  const fmt = (n: number, decimals: number) =>
    n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  const run = (group: HTMLElement) => {
    group.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count || 0);
      const decimals = Number(el.dataset.decimals || 0);
      const pre = el.dataset.prefix || '';
      const suf = el.dataset.suffix || '';
      const duration = Math.min(1800, 1200 + target * 10);
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = pre + fmt(target * eased, decimals) + suf;
        if (k < 1) requestAnimationFrame(step);
      };
      el.textContent = pre + fmt(0, decimals) + suf;
      requestAnimationFrame(step);
    });
  };
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } });
    }, { threshold: 0.35 });
    groups.forEach((g) => io.observe(g));
  }
</script>
