---
// DESIGN LAB — Our Track Record options (branch design/track-record-options,
// 2026-09-14). Owner brief: the homepage stat strip reads as the flattest
// section on the page — six numbers stacked over their labels on a light
// surface, between two other light sections. Owner's own first sketch: put
// the number on the left and wrap the label beside it, larger, counting up.
//
// This page renders the SAME six approved figures (index.astro
// `portfolioStats`, approved 2026-08-10, copy untouched) and the same section
// header in four treatments so they can be compared in place, at every
// viewport, before one is promoted into the homepage and the shared `.stat-*`
// primitives in design-system.css. Nothing here is linked from the site; the
// page is noindex (`preview` prop) and excluded from the sitemap.
//
// Not for merge as-is: once an option is chosen, the winning CSS moves into
// design-system.css as an extension of `.stat-group/.stat-value/.stat-label`
// (design-system rule: don't fork a fourth stat implementation) and this
// route is deleted.
import SiteLayout from '../../../layouts/SiteLayout.astro';

type Stat = { value: string; count: number; prefix?: string; suffix: string; label: string; icon: string };
const stats: Stat[] = [
  { value: '$3B+', count: 3, prefix: '$', suffix: 'B+', label: 'Cumulative commercial value created for clients since Terra Nexus started', icon: 'value' },
  { value: '25+', count: 25, suffix: '+', label: 'Global Projects Across Countries', icon: 'globe' },
  { value: '15+', count: 15, suffix: '+', label: 'Commodities worked with', icon: 'commodity' },
  { value: '20+', count: 20, suffix: '+', label: 'Sustainable Food Systems Certifications', icon: 'certificate' },
  { value: '10+', count: 10, suffix: '+', label: 'Carbon Registries Focused on Food, Agriculture, Land Management, Energy, & Fuels', icon: 'registry' },
  { value: '5M+', count: 5, suffix: 'M+', label: 'Acres of regenerative ecosystems', icon: 'acres' },
];
const [headline, ...supporting] = stats;

const options = [
  { id: 'a', name: 'Ledger', note: 'The owner sketch. Same light surface and maroon rules as today; number left, label wraps beside it, figures larger and counting up. Smallest change, still a real upgrade.' },
  { id: 'b', name: 'Register', note: 'The six figures move into the navy panel the page already uses for How We Work and Who We Work With. Two columns, hairline rows, gold band label. Breaks the run of three light sections and reads as one system with the rest of the page.' },
  { id: 'c', name: 'Headline figure', note: 'One number is the story: $3B+ set very large in the title column, the other five as a quiet ledger in the lead column. The grid lines up with the section header above it, so the structure says which figure matters most.' },
  { id: 'd', name: 'Icon rail', note: 'The owner’s icon alternative. Number left, label beside it, with a line icon in a sky disc for each figure. No rules; the icons carry the structure. Icons are drawn to match the site’s existing 1.5px stroke marks.' },
];

// Simple 24×24 stroke icons, 1.5px, round caps — same weight as the site's
// existing inline marks (BackToTop, ProfileRoster). Placeholder drawings; a
// chosen icon option would get a proper pass.
const icons: Record<string, string> = {
  value: '<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.75"/><path d="M6 9.5v5M18 9.5v5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z"/>',
  commodity: '<path d="M12 22V9"/><path d="M12 13c-3.2 0-5.2-2-5.2-5.2 3.2 0 5.2 2 5.2 5.2zM12 13c3.2 0 5.2-2 5.2-5.2-3.2 0-5.2 2-5.2 5.2zM12 18c-3.2 0-5.2-2-5.2-5.2 3.2 0 5.2 2 5.2 5.2zM12 18c3.2 0 5.2-2 5.2-5.2-3.2 0-5.2 2-5.2 5.2z"/>',
  certificate: '<path d="M12 2.75l7.25 2.9v5.6c0 4.9-3.1 8.4-7.25 10-4.15-1.6-7.25-5.1-7.25-10v-5.6L12 2.75z"/><path d="M8.75 12l2.25 2.25L15.5 9.75"/>',
  registry: '<path d="M5 3.5h10.5A3.5 3.5 0 0 1 19 7v13.5H8.5A3.5 3.5 0 0 1 5 17V3.5z"/><path d="M5 17a3.5 3.5 0 0 1 3.5-3.5H19M9 7.5h6M9 10.5h6"/>',
  acres: '<path d="M2.5 19h19"/><path d="M2.5 15.5c3-3.2 5.5-3.2 8.5 0 3 3.2 5.5 3.2 8.5 0"/><path d="M4 12c2.5-2.6 4.5-2.6 7 0"/><circle cx="17.5" cy="7" r="2.25"/>',
};
---

<SiteLayout
  title="Track Record Options | Design Lab"
  description="Internal design lab: four treatments of the homepage Our Track Record section."
  preview={true}
>
  <div class="lab-intro">
    <div class="container">
      <p class="lab-kicker">Design lab · not linked, not indexed</p>
      <h1 class="lab-title">Our Track Record: four treatments</h1>
      <p class="lab-text">Same six approved figures, same header copy, same button. Each option below is the full homepage section rendered as it would appear in place. Scroll, or jump:</p>
      <nav class="lab-nav" aria-label="Options">
        {options.map((o) => <a href={`#option-${o.id}`}>{o.id.toUpperCase()} · {o.name}</a>)}
      </nav>
    </div>
  </div>

  {options.map((o) => (
    <Fragment>
      <div class="lab-marker" id={`option-${o.id}`}>
        <div class="container">
          <p class="lab-marker-name">Option {o.id.toUpperCase()} — {o.name}</p>
          <p class="lab-marker-note">{o.note}</p>
        </div>
      </div>

      <section class={`section section-alt tr-section tr-${o.id}`} aria-labelledby={`tr-${o.id}-heading`}>
        <div class="container">
          <header class="section-header split-header">
            <span class="eyebrow split-header-eyebrow">Our Track Record</span>
            <div class="split-header-title">
              <h2 id={`tr-${o.id}-heading`}>Proven Portfolio of Successful Impact</h2>
            </div>
            <div class="split-header-lead">
              <p class="section-lead">There is absolutely no legitimate reason that creating a better planet should be so damn complicated, especially when it means the world to so many.</p>
            </div>
          </header>

          {o.id === 'a' && (
            <div class="tr-ledger" data-tr-stats>
              {stats.map((s) => (
                <div class="tr-ledger-item">
                  <p class="stat-value tr-num" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                  <p class="stat-label tr-label">{s.label}</p>
                </div>
              ))}
            </div>
          )}

          {o.id === 'b' && (
            <div class="tr-panel">
              <div class="tr-panel-label">Portfolio</div>
              <div class="tr-register" data-tr-stats>
                {stats.map((s) => (
                  <div class="tr-register-item">
                    <p class="stat-value tr-num tr-num-light" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                    <p class="stat-label tr-label tr-label-light">{s.label}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {o.id === 'c' && (
            <div class="tr-headline" data-tr-stats>
              <div class="tr-headline-lead">
                <p class="stat-value tr-num tr-num-hero" data-count={headline.count} data-prefix={headline.prefix} data-suffix={headline.suffix}>{headline.value}</p>
                <p class="stat-label tr-label tr-label-hero">{headline.label}</p>
              </div>
              <div class="tr-headline-list">
                {supporting.map((s) => (
                  <div class="tr-headline-item">
                    <p class="stat-value tr-num tr-num-sm" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                    <p class="stat-label tr-label">{s.label}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {o.id === 'd' && (
            <div class="tr-icons" data-tr-stats>
              {stats.map((s) => (
                <div class="tr-icons-item">
                  <span class="tr-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
                  </span>
                  <div class="tr-icons-body">
                    <p class="stat-value tr-num tr-num-sm" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                    <p class="stat-label tr-label">{s.label}</p>
                  </div>
                </div>
              ))}
            </div>
          )}

          <div class="section-cta">
            <a href="/about/" class="btn btn-primary">Learn More About Us</a>
          </div>
        </div>
      </section>
    </Fragment>
  ))}
</SiteLayout>

<style>
  /* ── Lab chrome (never ships) ─────────────────────────────────────── */
  .lab-intro { padding: var(--space-12) 0 var(--space-8); border-bottom: 1px dashed var(--c-secondary-400); }
  .lab-kicker { margin: 0; font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .lab-title { margin: var(--space-2) 0 var(--space-3); font-size: var(--text-3xl); }
  .lab-text { margin: 0; color: var(--color-text-secondary); max-width: var(--max-width-text); }
  .lab-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .lab-nav a { font-size: var(--text-sm); padding: var(--space-1) var(--space-3); border: 1px solid var(--c-secondary-300); border-radius: var(--radius-full); text-decoration: none; color: var(--color-text); }
  .lab-nav a:hover { border-color: var(--color-text); }
  .lab-marker { padding: var(--space-5) 0; background: var(--color-bg); border-top: 1px dashed var(--c-secondary-400); border-bottom: 1px dashed var(--c-secondary-400); scroll-margin-top: 5rem; }
  .lab-marker-name { margin: 0; font-size: var(--text-sm); font-weight: var(--font-semibold); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text); }
  .lab-marker-note { margin: var(--space-1) 0 0; font-size: var(--text-sm); color: var(--color-text-secondary); max-width: var(--max-width-text); }

  /* ── Shared across options ────────────────────────────────────────── */
  /* .stat-value / .stat-label supply family, weight, colour and tracking
     (design-system.css). Each option only sets the size and the layout. */
  .tr-num { font-variant-numeric: lining-nums tabular-nums; }
  .tr-label { margin: 0; font-size: var(--text-base); line-height: var(--line-relaxed); color: var(--color-text-secondary); }

  /* ── A · Ledger ───────────────────────────────────────────────────── */
  .tr-ledger {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--space-10);
    row-gap: var(--space-8);
  }
  .tr-ledger-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 3px solid var(--color-eyebrow);
  }
  /* 3-up at 1440 gives each cell ~22rem; the numeral takes ~5.5rem of it,
     so the size is capped a step below the other options to keep the two
     long labels to three lines. */
  .tr-ledger .tr-num { flex: 0 0 auto; min-width: 4.4ch; font-size: clamp(2.5rem, 2.9vw, 3rem); }
  .tr-ledger .tr-label { max-width: 16rem; }
  @media (max-width: 64rem) { .tr-ledger { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 34rem) {
    .tr-ledger { grid-template-columns: 1fr; row-gap: var(--space-6); }
    .tr-ledger .tr-num { font-size: 2.5rem; }
  }

  /* ── B · Register (navy panel) ────────────────────────────────────── */
  /* Same recipe as the homepage's .approach-card and the Who We Work With
     panel; if chosen this becomes a shared surface class, not a copy. */
  .tr-panel {
    position: relative; overflow: hidden;
    background: var(--gradient-dark);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-2xl);
    padding: var(--space-10);
  }
  .tr-panel::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 65% at 100% 100%, rgba(168, 208, 219, 0.1) 0%, transparent 60%);
    pointer-events: none;
  }
  .tr-panel-label {
    position: relative; z-index: 1;
    font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--c-accent-400);
    margin-bottom: var(--space-3);
  }
  .tr-register {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-12);
  }
  .tr-register-item {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .tr-register .tr-num { flex: 0 0 auto; min-width: 4.6ch; font-size: clamp(2.75rem, 3.4vw, 3.5rem); }
  .tr-num-light { color: var(--color-text-inverse); }
  /* The lead figure is the one the section is really about. */
  .tr-register-item:first-child .tr-num { color: var(--c-accent-400); }
  .tr-label-light { color: var(--c-sky-300); max-width: 22rem; }
  @media (max-width: 48rem) {
    .tr-panel { padding: var(--space-8) var(--space-6); }
    .tr-register { grid-template-columns: 1fr; }
  }
  @media (max-width: 34rem) {
    .tr-register .tr-num { font-size: 2.5rem; }
    .tr-register-item { gap: var(--space-5); }
  }

  /* ── C · Headline figure ──────────────────────────────────────────── */
  /* Same column template as .split-header, so the giant figure sits under
     the heading and the ledger under the lead paragraph. */
  .tr-headline {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) 1fr;
    column-gap: var(--space-10);
    row-gap: var(--space-10);
    align-items: start;
  }
  .tr-headline-lead { padding-top: var(--space-5); border-top: 3px solid var(--color-eyebrow); }
  .tr-num-hero { font-size: clamp(4.5rem, 8vw, 7rem); letter-spacing: -0.03em; }
  .tr-label-hero { margin-top: var(--space-4); font-size: var(--text-lg); max-width: 20rem; }
  .tr-headline-list { display: flex; flex-direction: column; }
  .tr-headline-item {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--c-secondary-300);
  }
  .tr-headline-item:last-child { border-bottom: 1px solid var(--c-secondary-300); }
  .tr-num-sm { font-size: clamp(2rem, 2.4vw, 2.5rem); }
  .tr-headline-item .tr-num { flex: 0 0 auto; min-width: 4.6ch; }
  @media (max-width: 56rem) {
    .tr-headline { grid-template-columns: 1fr; }
  }

  /* ── D · Icon rail ────────────────────────────────────────────────── */
  .tr-icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--space-10);
    row-gap: var(--space-10);
  }
  .tr-icons-item { display: flex; align-items: flex-start; gap: var(--space-4); }
  .tr-icon {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    width: 3.25rem; height: 3.25rem;
    border-radius: var(--radius-full);
    background: var(--c-sky-100);
    color: var(--c-sky-700);
  }
  .tr-icons-body .tr-num { font-size: clamp(2.25rem, 2.6vw, 2.75rem); }
  .tr-icons-body .tr-label { margin-top: var(--space-2); max-width: 18rem; }
  @media (max-width: 64rem) { .tr-icons { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 34rem) { .tr-icons { grid-template-columns: 1fr; row-gap: var(--space-8); } }
</style>

<script>
  // Count-up, lifted from about/index.astro (same easing and timing) but
  // triggered by an IntersectionObserver per stat group rather than a scroll
  // handler. Skipped under reduced motion: the SSR text ("$3B+") stays.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-tr-stats]'));
  const run = (group: HTMLElement) => {
    group.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count || 0);
      const pre = el.dataset.prefix || '';
      const suf = el.dataset.suffix || '';
      const duration = 1200 + target * 10;
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = pre + Math.round(target * eased) + suf;
        if (k < 1) requestAnimationFrame(step);
      };
      el.textContent = pre + '0' + suf;
      requestAnimationFrame(step);
    });
  };
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } });
    }, { threshold: 0.35 });
    groups.forEach((g) => io.observe(g));
  }
</script>
