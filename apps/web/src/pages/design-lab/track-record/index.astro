---
// DESIGN LAB — Our Track Record, Option C refined (branch
// design/track-record-options, 2026-09-14).
//
// Round 1 showed four treatments (A ledger, B navy register, C headline
// figure, D icon rail — see commit 0a03254 for that page). Owner chose C
// ("makes the story cleaner") and supplied new figures and categories:
//
//   Enterprise value $2.65B · Countries 25+ · Value chains 15+ global
//   commodities · Acres 8M+ · Oceans 20+ fisheries · Operations 2000+
//   facilities · Carbon markets 10+ · Certifications 20+
//
// and the sentence the figures should add up to: value created by working
// with clients in 25+ countries across 15 value chains, changing 8M+ acres,
// 20+ fisheries and 2,000+ facilities, verified through 10+ carbon
// registries/regulated markets and 20+ certifications.
//
// That sentence has three beats — where the work happens, what changed,
// how it is verified — so the ledger is offered grouped under those three
// labels (C1) and flat (C2). Same figures, same order, in both.
//
// Still not for merge as-is: the chosen variant is promoted into the
// homepage and the shared .stat-* primitives, and this route is deleted.
import SiteLayout from '../../../layouts/SiteLayout.astro';

type Stat = { value: string; count: number; prefix?: string; suffix: string; decimals?: number; label: string };
type Group = { label: string; items: Stat[] };

const headline: Stat = { value: '$2.65B', count: 2.65, prefix: '$', suffix: 'B', decimals: 2, label: 'Enterprise value created for clients' };

const groups: Group[] = [
  {
    label: 'Where we work',
    items: [
      { value: '25+', count: 25, suffix: '+', label: 'Countries where we work with clients' },
      { value: '15+', count: 15, suffix: '+', label: 'Global commodity value chains' },
    ],
  },
  {
    label: 'What changed',
    items: [
      { value: '8M+', count: 8, suffix: 'M+', label: 'Acres of regenerative farmland' },
      { value: '20+', count: 20, suffix: '+', label: 'Sustainable fisheries' },
      { value: '2,000+', count: 2000, suffix: '+', label: 'Facilities with operational improvements' },
    ],
  },
  {
    label: 'How it’s verified',
    items: [
      { value: '10+', count: 10, suffix: '+', label: 'Carbon registries and regulated carbon markets' },
      { value: '20+', count: 20, suffix: '+', label: 'Sustainable commodity certifications' },
    ],
  },
];
const flat = groups.flatMap((g) => g.items);

const variants = [
  { id: 'c1', name: 'Headline figure, grouped ledger', note: 'The seven supporting figures sit under three small labels that follow the story: where the work happens, what changed, how it is verified. The labels are the same small uppercase mark the site uses for stat types elsewhere.' },
  { id: 'c2', name: 'Headline figure, flat ledger', note: 'Same figures and order, no group labels. Quieter; the reader has to infer the arc from the order alone.' },
];
---

<SiteLayout
  title="Track Record Options | Design Lab"
  description="Internal design lab: Option C of the homepage Our Track Record section, refined."
  preview={true}
>
  <div class="lab-intro">
    <div class="container">
      <p class="lab-kicker">Design lab · not linked, not indexed · round 2</p>
      <h1 class="lab-title">Our Track Record: Option C with the new figures</h1>
      <p class="lab-text">Owner-supplied figures and categories, ordered to read as one story. Two variants of the ledger beside the headline figure. Jump:</p>
      <nav class="lab-nav" aria-label="Variants">
        {variants.map((v) => <a href={`#option-${v.id}`}>{v.id.toUpperCase()} · {v.name}</a>)}
      </nav>
    </div>
  </div>

  {variants.map((v) => (
    <Fragment>
      <div class="lab-marker" id={`option-${v.id}`}>
        <div class="container">
          <p class="lab-marker-name">Option {v.id.toUpperCase()} — {v.name}</p>
          <p class="lab-marker-note">{v.note}</p>
        </div>
      </div>

      <section class={`section section-alt tr-section tr-${v.id}`} aria-labelledby={`tr-${v.id}-heading`}>
        <div class="container">
          <header class="section-header split-header">
            <span class="eyebrow split-header-eyebrow">Our Track Record</span>
            <div class="split-header-title">
              <h2 id={`tr-${v.id}-heading`}>Proven Portfolio of Successful Impact</h2>
            </div>
            <div class="split-header-lead">
              <p class="section-lead">There is absolutely no legitimate reason that creating a better planet should be so damn complicated, especially when it means the world to so many.</p>
            </div>
          </header>

          <div class="tr-headline" data-tr-stats>
            <div class="tr-headline-lead">
              <p class="stat-value tr-num tr-num-hero" data-count={headline.count} data-prefix={headline.prefix} data-suffix={headline.suffix} data-decimals={headline.decimals}>{headline.value}</p>
              <p class="stat-label tr-label tr-label-hero">{headline.label}</p>
            </div>

            {v.id === 'c1' ? (
              <div class="tr-headline-list">
                {groups.map((g) => (
                  <div class="tr-group">
                    <p class="stat-type tr-group-label">{g.label}</p>
                    {g.items.map((s) => (
                      <div class="tr-headline-item">
                        <p class="stat-value tr-num tr-num-sm" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                        <p class="stat-label tr-label">{s.label}</p>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            ) : (
              <div class="tr-headline-list tr-headline-list-flat">
                {flat.map((s) => (
                  <div class="tr-headline-item">
                    <p class="stat-value tr-num tr-num-sm" data-count={s.count} data-prefix={s.prefix} data-suffix={s.suffix}>{s.value}</p>
                    <p class="stat-label tr-label">{s.label}</p>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="section-cta">
            <a href="/about/" class="btn btn-primary">Learn More About Us</a>
          </div>
        </div>
      </section>
    </Fragment>
  ))}
</SiteLayout>

<style>
  /* ── Lab chrome (never ships) ─────────────────────────────────────── */
  .lab-intro { padding: var(--space-12) 0 var(--space-8); border-bottom: 1px dashed var(--c-secondary-400); }
  .lab-kicker { margin: 0; font-size: var(--text-xs); font-weight: var(--font-semibold); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .lab-title { margin: var(--space-2) 0 var(--space-3); font-size: var(--text-3xl); }
  .lab-text { margin: 0; color: var(--color-text-secondary); max-width: var(--max-width-text); }
  .lab-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .lab-nav a { font-size: var(--text-sm); padding: var(--space-1) var(--space-3); border: 1px solid var(--c-secondary-300); border-radius: var(--radius-full); text-decoration: none; color: var(--color-text); }
  .lab-nav a:hover { border-color: var(--color-text); }
  .lab-marker { padding: var(--space-5) 0; background: var(--color-bg); border-top: 1px dashed var(--c-secondary-400); border-bottom: 1px dashed var(--c-secondary-400); scroll-margin-top: 5rem; }
  .lab-marker-name { margin: 0; font-size: var(--text-sm); font-weight: var(--font-semibold); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text); }
  .lab-marker-note { margin: var(--space-1) 0 0; font-size: var(--text-sm); color: var(--color-text-secondary); max-width: var(--max-width-text); }

  /* ── Shared ───────────────────────────────────────────────────────── */
  /* .stat-value / .stat-label / .stat-type supply family, weight, colour
     and tracking (design-system.css). This block only sets size and layout. */
  .tr-num { font-variant-numeric: lining-nums tabular-nums; }
  .tr-label { margin: 0; font-size: var(--text-base); line-height: var(--line-relaxed); color: var(--color-text-secondary); }

  /* ── C · Headline figure ──────────────────────────────────────────── */
  /* Same column template as .split-header, so the headline figure sits
     under the heading and the ledger under the lead paragraph. */
  .tr-headline {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) 1fr;
    column-gap: var(--space-10);
    row-gap: var(--space-10);
    align-items: start;
  }
  .tr-headline-lead { padding-top: var(--space-5); border-top: 3px solid var(--color-eyebrow); }
  /* "$2.65B" is six glyphs against last round's four, so the hero size steps
     down to stay inside the 25rem title column. */
  .tr-num-hero { font-size: clamp(3.75rem, 6.2vw, 5.5rem); letter-spacing: -0.03em; }
  .tr-label-hero { margin-top: var(--space-4); font-size: var(--text-lg); max-width: 20rem; }

  .tr-headline-list { display: flex; flex-direction: column; }
  .tr-headline-item {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--c-secondary-300);
  }
  .tr-headline-list-flat .tr-headline-item:last-child,
  .tr-group:last-child .tr-headline-item:last-child { border-bottom: 1px solid var(--c-secondary-300); }
  .tr-num-sm { font-size: clamp(1.875rem, 2.2vw, 2.25rem); }
  /* Numeral column sized for the widest figure ("2,000+", six glyphs) so
     every label starts on the same line; ch scales with the font-size. */
  .tr-headline-item .tr-num { flex: 0 0 auto; min-width: 6.4ch; }

  /* Group labels: the site's .stat-type mark, placed as a row heading. The
     first group's label sits flush with the top of the headline figure's
     rule; later groups get a little air above. */
  .tr-group-label { margin: 0 0 var(--space-2); }
  .tr-group + .tr-group { margin-top: var(--space-6); }

  @media (max-width: 56rem) {
    .tr-headline { grid-template-columns: 1fr; row-gap: var(--space-8); }
    .tr-num-hero { font-size: clamp(3.5rem, 12vw, 4.5rem); }
  }
</style>

<script>
  // Count-up, lifted from about/index.astro (same easing), triggered per
  // group by an IntersectionObserver. Adds decimals (data-decimals, for
  // $2.65B) and thousands separators (2,000+) and caps the duration so the
  // 2,000 figure does not run for twenty seconds. Skipped under reduced
  // motion: the SSR text stays.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-tr-stats]'));
  const fmt = (n: number, decimals: number) =>
    n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  const run = (group: HTMLElement) => {
    group.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count || 0);
      const decimals = Number(el.dataset.decimals || 0);
      const pre = el.dataset.prefix || '';
      const suf = el.dataset.suffix || '';
      const duration = Math.min(1800, 1200 + target * 10);
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = pre + fmt(target * eased, decimals) + suf;
        if (k < 1) requestAnimationFrame(step);
      };
      el.textContent = pre + fmt(0, decimals) + suf;
      requestAnimationFrame(step);
    });
  };
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } });
    }, { threshold: 0.35 });
    groups.forEach((g) => io.observe(g));
  }
</script>
