---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
const mode = getBuildMode();
---

<SiteLayout
  title="Contact | Terra Nexus"
  description="Tell us what you are evaluating, building, operating, investing in, or trying to improve. Terra Nexus will help determine the expertise, capabilities, participants, and next step that fit the challenge."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Contact"
    title="Start with the Decision That Matters"
    lead="Tell us what you are evaluating, building, operating, investing in, or trying to improve. Terra Nexus will help determine the expertise, capabilities, participants, and next step that fit the challenge."
  />

  <section class="section">
    <div class="container narrow-container">
      <!-- PROTOTYPE NOTICE: This form is a visual prototype. It does not submit,
           process, or store any data. No CRM, backend, or privacy system is
           connected. Do not present this as a working form without implementation. -->
      <div class="prototype-notice" role="status">
        <p><strong>Prototype form:</strong> This form is for demonstration only. Submissions are not processed or stored. No backend, CRM, or privacy system is connected yet.</p>
      </div>

      <form class="contact-form" novalidate>
        <div class="form-field">
          <label for="name">Name <span class="required" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="form-field">
          <label for="email">Work email <span class="required" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" spellcheck="false" required />
        </div>

        <div class="form-field">
          <label for="organization">Organization</label>
          <input type="text" id="organization" name="organization" autocomplete="organization" />
        </div>

        <div class="form-field">
          <label for="role">Role</label>
          <input type="text" id="role" name="role" autocomplete="organization-title" />
        </div>

        <div class="form-field">
          <label for="org-type">Organization type</label>
          <select id="org-type" name="org_type">
            <option value="">Select an option</option>
            <option value="agricultural-producer">Agricultural Producer / Integrated Protein</option>
            <option value="commodity-trader">Commodity Trader</option>
            <option value="ingredient-processor">Ingredient &amp; Feed Processor</option>
            <option value="food-beverage">Food &amp; Beverage Company</option>
            <option value="retail-distribution">Food Retail &amp; Distribution</option>
            <option value="energy-biofuels">Energy &amp; Biofuels Refiner</option>
            <option value="food-waste">Food Waste Prevention / Diversion / Recovery</option>
            <option value="inputs">Inputs Company</option>
            <option value="environmental-markets">Environmental Markets / Ecosystem Services</option>
            <option value="technology">Enabling Tech / Solution Provider</option>
            <option value="investor">Private Equity / Venture / Impact Investor</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="routing">How can we help?</label>
          <select id="routing" name="routing">
            <option value="">Select an area</option>
            <option value="strategy">Strategy, market, product, or growth</option>
            <option value="investment">Investment, venture, or diligence</option>
            <option value="sourcing">Sourcing, supply chain, or operations</option>
            <option value="sustainability">Corporate sustainability, accounting, or reporting</option>
            <option value="carbon">Carbon, ecosystem services, claims, or verification readiness</option>
            <option value="other">Other</option>
          </select>
          <p class="field-hint">For routing only. You do not need to know our internal taxonomy.</p>
        </div>

        <div class="form-field">
          <label for="challenge">Challenge or objective <span class="required" aria-hidden="true">*</span></label>
          <textarea id="challenge" name="challenge" rows="5" required></textarea>
        </div>

        <div class="form-field">
          <label for="timing">Desired timing</label>
          <select id="timing" name="timing">
            <option value="">Select timing</option>
            <option value="immediate">Immediate (within 30 days)</option>
            <option value="near-term">Near-term (1-3 months)</option>
            <option value="quarter">This quarter</option>
            <option value="exploring">Exploring / no fixed timeline</option>
          </select>
        </div>

        <div class="form-field">
          <label for="link">Optional link</label>
          <input type="url" id="link" name="link" placeholder="https://" />
        </div>

        <div class="form-field form-checkbox">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">I understand this is a prototype form and my submission will not be processed or stored. <span class="required" aria-hidden="true">*</span></label>
        </div>

        <div class="form-actions">
          <button type="button" class="btn btn-primary" disabled>Discuss Your Challenge</button>
          <p class="form-disabled-note">Form submission is disabled in this prototype.</p>
        </div>
      </form>
    </div>
  </section>
</SiteLayout>

<style>
  .prototype-notice { padding: var(--space-4) var(--space-5); background: var(--color-surface-alt); border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); margin-bottom: var(--space-6); }
  .prototype-notice p { font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0; }
  .contact-form { display: flex; flex-direction: column; gap: var(--space-5); }
  .form-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-field label { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
  .form-field input, .form-field select, .form-field textarea {
    padding: var(--space-3); font-size: var(--text-base); font-family: var(--font-sans);
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text); transition: border-color var(--transition-fast);
    touch-action: manipulation;
  }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
    outline: var(--focus-ring); outline-offset: var(--focus-offset); border-color: var(--color-accent);
  }
  .form-field textarea { resize: vertical; min-height: 6rem; }
  .field-hint { font-size: var(--text-xs); color: var(--color-text-muted); }
  .required { color: #dc2626; }
  .form-checkbox { flex-direction: row; align-items: flex-start; gap: var(--space-3); }
  .form-checkbox input { margin-top: var(--space-1); flex-shrink: 0; }
  .form-checkbox label { font-size: var(--text-sm); font-weight: 400; color: var(--color-text-secondary); }
  .form-actions { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-4); }
  .form-actions .btn[disabled] { opacity: 0.6; cursor: not-allowed; }
  .form-disabled-note { font-size: var(--text-xs); color: var(--color-text-muted); font-style: italic; }
</style>
