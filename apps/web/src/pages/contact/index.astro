---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBuildMode } from '../../lib/build-mode.js';
import PageHero from '../../components/PageHero.astro';
const mode = getBuildMode();

// Cloudflare Turnstile site key — public by design (unlike
// TURNSTILE_SECRET_KEY, which the /api/contact route reads at request time
// from `cloudflare:workers` env; see plans/contact-form-production.md).
// This page is prerendered (static), so it must come from
// import.meta.env at build time, not a runtime env lookup — same rule as
// getPublicBuildMode() in src/lib/build-mode.ts. Falls back to Cloudflare's
// published "always passes, visible widget" test key
// (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
// so local/preview builds without a real site key still render a working
// (test-mode) widget instead of a broken one.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<SiteLayout
  title="Contact | Terra Nexus"
  description="Tell us what you are evaluating, building, operating, investing in, or trying to improve. Terra Nexus will help determine the expertise, capabilities, participants, and next step that fit the challenge."
  preview={mode === 'preview'}
>
  <PageHero
    eyebrow="Contact"
    title="Start with the Decision That Matters"
    lead="Tell us what you are evaluating, building, operating, investing in, or trying to improve. Terra Nexus will help determine the expertise, capabilities, participants, and next step that fit the challenge."
  />

  <section class="section">
    <div class="container narrow-container">
      <form id="contact-form" class="contact-form" action="/api/contact" method="post">
        <div class="form-field">
          <label for="name">Name <span class="required" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="form-field">
          <label for="email">Work email <span class="required" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" spellcheck="false" required />
        </div>

        <div class="form-field">
          <label for="organization">Organization</label>
          <input type="text" id="organization" name="organization" autocomplete="organization" />
        </div>

        <div class="form-field">
          <label for="role">Role</label>
          <input type="text" id="role" name="role" autocomplete="organization-title" />
        </div>

        <div class="form-field">
          <label for="org-type">Organization type</label>
          <select id="org-type" name="org_type">
            <option value="">Select an option</option>
            <option value="agricultural-producer">Agricultural Producer / Integrated Protein</option>
            <option value="commodity-trader">Commodity Trader</option>
            <option value="ingredient-processor">Ingredient &amp; Feed Processor</option>
            <option value="food-beverage">Food &amp; Beverage Company</option>
            <option value="retail-distribution">Food Retail &amp; Distribution</option>
            <option value="energy-biofuels">Energy &amp; Biofuels Refiner</option>
            <option value="food-waste">Food Waste Prevention / Diversion / Recovery</option>
            <option value="inputs">Inputs Company</option>
            <option value="environmental-markets">Environmental Markets / Ecosystem Services</option>
            <option value="technology">Enabling Tech / Solution Provider</option>
            <option value="investor">Private Equity / Venture / Impact Investor</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="routing">How can we help?</label>
          <select id="routing" name="routing">
            <option value="">Select an area</option>
            <option value="strategy">Strategy, market, product, or growth</option>
            <option value="investment">Investment, venture, or diligence</option>
            <option value="sourcing">Sourcing, supply chain, or operations</option>
            <option value="sustainability">Corporate sustainability, accounting, or reporting</option>
            <option value="carbon">Carbon, ecosystem services, claims, or verification readiness</option>
            <option value="other">Other</option>
          </select>
          <p class="field-hint">For routing only. You do not need to know our internal taxonomy.</p>
        </div>

        <div class="form-field">
          <label for="challenge">Challenge or objective <span class="required" aria-hidden="true">*</span></label>
          <textarea id="challenge" name="challenge" rows="5" required></textarea>
        </div>

        <div class="form-field">
          <label for="timing">Desired timing</label>
          <select id="timing" name="timing">
            <option value="">Select timing</option>
            <option value="immediate">Immediate (within 30 days)</option>
            <option value="near-term">Near-term (1-3 months)</option>
            <option value="quarter">This quarter</option>
            <option value="exploring">Exploring / no fixed timeline</option>
          </select>
        </div>

        <div class="form-field">
          <label for="link">Optional link</label>
          <input type="url" id="link" name="link" placeholder="https://" />
        </div>

        <div class="form-field form-checkbox">
          <input type="checkbox" id="consent" name="consent" required />
          <!-- Copy approved by the owner 2026-09-08 (no privacy policy page
               exists in this repo yet, so this deliberately doesn't link
               one, and only states what the form actually does — see
               src/lib/contact/email.ts): send this submission as an email
               notification only, no CRM/database storage. Add a privacy
               policy link here once one is published. -->
          <label for="consent">I agree that Terra Nexus may use the information above to respond to my inquiry. <span class="required" aria-hidden="true">*</span></label>
        </div>

        <div class="form-field">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Discuss What's Next</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</SiteLayout>

<!--
  Cloudflare Turnstile's loader script — renders the widget into the
  .cf-turnstile div above (implicit rendering: no explicit
  turnstile.render() call needed) and, because that div lives inside
  <form id="contact-form">, auto-injects a hidden
  `cf-turnstile-response` input into the form on completion. See
  https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/
  (checked 2026-09-07) and plans/contact-form-production.md.
-->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  // Progressive enhancement: the <form> has a real action/method, so it
  // still submits (full-page reload to /api/contact's JSON response, not
  // ideal but not broken) if this script fails to load. Turnstile itself
  // requires JS to render at all, so a true no-JS path isn't achievable
  // here regardless — see plans/contact-form-production.md.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = form?.querySelector<HTMLElement>('.form-status') ?? null;
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
  const defaultButtonLabel = submitButton?.textContent ?? '';

  // The Turnstile loader script (above) injects `window.turnstile` at
  // runtime — it has no bundled type declarations here, so it's typed
  // loosely rather than pulling in a dependency just for this.
  type TurnstileGlobal = { reset: () => void };
  function getTurnstile(): TurnstileGlobal | undefined {
    return (window as unknown as { turnstile?: TurnstileGlobal }).turnstile;
  }

  function setStatus(message: string, tone?: 'success' | 'error'): void {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('form-status-success', 'form-status-error');
    if (tone) statusEl.classList.add(`form-status-${tone}`);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus('');
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
    }

    const formData = new FormData(form);
    const payload: Record<string, FormDataEntryValue | boolean> = Object.fromEntries(formData.entries());
    payload.consent = formData.get('consent') === 'on';
    payload.turnstileToken = formData.get('cf-turnstile-response') || '';

    try {
      const response = await fetch(form.getAttribute('action') || '/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json()) as { ok: boolean; message?: string };
      if (response.ok && result.ok) {
        setStatus(result.message || 'Thank you — your message has been sent.', 'success');
        form.reset();
        getTurnstile()?.reset();
      } else {
        setStatus(result.message || 'Something went wrong. Please correct the highlighted fields and try again.', 'error');
      }
    } catch {
      setStatus('Network error — please check your connection and try again.', 'error');
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = defaultButtonLabel;
      }
    }
  });
</script>

<style>
  .contact-form { display: flex; flex-direction: column; gap: var(--space-5); }
  .form-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-field label { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
  .form-field input, .form-field select, .form-field textarea {
    padding: var(--space-3); font-size: var(--text-base); font-family: var(--font-sans);
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text); transition: border-color var(--transition-fast);
    touch-action: manipulation;
  }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
    outline: var(--focus-ring); outline-offset: var(--focus-offset); border-color: var(--c-sky-600);
  }
  .form-field textarea { resize: vertical; min-height: 6rem; }
  .field-hint { font-size: var(--text-xs); color: var(--color-text-muted); }
  .required { color: #dc2626; }
  .form-checkbox { flex-direction: row; align-items: flex-start; gap: var(--space-3); }
  .form-checkbox input { margin-top: var(--space-1); flex-shrink: 0; }
  .form-checkbox label { font-size: var(--text-sm); font-weight: 400; color: var(--color-text-secondary); }
  .form-actions { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-4); }
  .form-actions .btn[disabled] { opacity: 0.6; cursor: not-allowed; }
  .form-status { font-size: var(--text-sm); margin: 0; min-height: 1.25em; }
  .form-status-success { color: var(--c-success-600); font-weight: 600; }
  .form-status-error { color: var(--c-error-700); font-weight: 600; }
</style>
