{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src",
    "scripts",
    "test",
    "astro.config.ts",
    "vitest.config.ts",
    "keystatic.config.tsx",
    "keystatic.content-components.tsx"
  ]
}
