{
  "name": "@terra-nexus/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Static Astro foundation for the Terra Nexus governed website",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host",
    "build": "node scripts/run-astro.mjs build",
    "typecheck": "node scripts/run-astro.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:new": "tsx scripts/content-cli.ts new",
    "content:status": "tsx scripts/content-cli.ts status",
    "content:affected": "tsx scripts/content-cli.ts affected",
    "content:validate": "tsx scripts/content-cli.ts validate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^6.0.2",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "6.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "set-cookie-parser": "^2.7.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.121.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "22.17.0",
    "@types/set-cookie-parser": "^2.4.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "yaml": "2.8.1"
  }
}
