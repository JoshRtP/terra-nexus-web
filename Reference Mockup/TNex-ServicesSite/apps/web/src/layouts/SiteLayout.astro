---
import '../styles/design-system.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getBuildMode } from '../lib/build-mode.js';

interface Props {
  title: string;
  description?: string;
  preview?: boolean;
}

const { title, description, preview = false } = Astro.props;
const mode = getBuildMode();
const isPreview = preview || mode === 'preview';
const fullTitle = title.includes('Terra Nexus') ? title : `${title} | Terra Nexus`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {description && <meta name="description" content={description} />}
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#131f48" />

    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content="/brand/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {isPreview && (
      <div class="prototype-banner" role="status">
        Protected Preview — This is a prototype for review. Content is not approved for public production.
      </div>
    )}
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
